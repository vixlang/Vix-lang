#[no_main]

use "env.vix" as env
use "../type/subst.vix" as subst
use "../type/ty.vix" as ty
use "../type/scheme.vix" as scheme

// Both the environment and binding type must include constraints collected
// while inferring the initializer before quantifying its free variables.
pub fn hm_generalize_let(store: &ty::TyStore, env: &env::TypeEnv, subst: &subst::Subst, ty: ty::Ty): scheme::Scheme
{
    let applied_ty = subst::subst_apply_ty(store, subst, ty)
    return env::type_env_generalize_substituted(store, env, subst, applied_ty)
}
