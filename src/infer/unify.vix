#[no_main]

use "../type/ty.vix" as ty
use "../type/subst.vix" as subst
use "../util/pos.vix" as pos
use "constraint.vix" as constraint
use "error.vix" as error

pub type UnifyResult = struct {
    ok: i32,
    subst: subst::Subst,
    error: error::InferError
}

pub fn unify_ok(subst: subst::Subst): UnifyResult
{
    return UnifyResult{ ok: 1, subst: subst, error: error::infer_error_ok() }
}

pub fn unify_fail(error: error::InferError): UnifyResult
{
    return UnifyResult{ ok: 0, subst: subst::subst_empty(), error: error }
}

pub fn unify_bind(store: &ty::TyStore, subst: &subst::Subst, var_id: i32, ty: ty::Ty, pos: pos::SourcePos): UnifyResult
{
    let applied = subst::subst_apply_ty(store, subst, ty)
    match applied
    {
        ty::TyVar(other_id) -> {
            if (other_id == var_id) { return unify_ok(@subst) }
        }
        _ -> {}
    }
    if (ty::ty_occurs(store, var_id, applied) == 1)
    {
        return unify_fail(error::infer_error_occurs(store, var_id, applied, pos))
    }
    subst::subst_extend(subst, var_id, applied)
    return unify_ok(@subst)
}

pub fn unify_ty(store: &ty::TyStore, subst: &subst::Subst, left: ty::Ty, right: ty::Ty, pos: pos::SourcePos): UnifyResult
{
    let a = subst::subst_apply_ty(store, subst, left)
    let b = subst::subst_apply_ty(store, subst, right)
    match a
    {
        ty::TyError -> return unify_ok(@subst)
        ty::TyUnknown -> return unify_ok(@subst)
        ty::TyVar(id) -> return unify_bind(store, subst, id, b, pos)
        ty::TyPrim(ap) -> {
            match b
            {
                ty::TyError -> return unify_ok(@subst)
                ty::TyUnknown -> return unify_ok(@subst)
                ty::TyVar(idb) -> return unify_bind(store, subst, idb, a, pos)
                ty::TyPrim(bp) -> {
                    if (ty::ty_prim_can_assign(ap, bp) == 1) { return unify_ok(@subst) }
                    return unify_fail(error::infer_error_mismatch(store, a, b, pos))
                }
                ty::TyArray(bi) -> {
                    if (ap == ty::ty_prim_ptr()) { return unify_ok(@subst) }
                    if (ap == ty::ty_prim_string()) { return unify_ok(@subst) }
                    return unify_fail(error::infer_error_mismatch(store, a, b, pos))
                }
                _ -> return unify_fail(error::infer_error_mismatch(store, a, b, pos))
            }
        }
        ty::TyFun(ai) -> {
            match b
            {
                ty::TyVar(idb) -> return unify_bind(store, subst, idb, a, pos)
                ty::TyFun(bi) -> {
                    let af = store.funs[ai]
                    let bf = store.funs[bi]
                    if (af.is_var_arg == 1)
                    {
                        if (bf.params.length < af.params.length)
                        {
                            return unify_fail(error::infer_error_arity(af.params.length, bf.params.length, pos))
                        }
                    }
                    elif (bf.is_var_arg == 1)
                    {
                        if (af.params.length < bf.params.length)
                        {
                            return unify_fail(error::infer_error_arity(bf.params.length, af.params.length, pos))
                        }
                    }
                    elif (af.params.length != bf.params.length)
                    {
                        return unify_fail(error::infer_error_arity(af.params.length, bf.params.length, pos))
                    }
                    let param_count = if (af.params.length < bf.params.length) { af.params.length } else { bf.params.length }
                    for (i in 0 .. param_count)
                    {
                        let r = unify_ty(store, subst, af.params[i], bf.params[i], pos)
                        if (r.ok == 0) { return r }
                    }
                    return unify_ty(store, subst, af.ret, bf.ret, pos)
                }
                _ -> return unify_fail(error::infer_error_mismatch(store, a, b, pos))
            }
        }
        ty::TyTuple(ai) -> {
            match b
            {
                ty::TyVar(idb) -> return unify_bind(store, subst, idb, a, pos)
                ty::TyTuple(bi) -> {
                    let at = store.tuples[ai]
                    let bt = store.tuples[bi]
                    if (at.elems.length != bt.elems.length)
                    {
                        return unify_fail(error::infer_error_arity(at.elems.length, bt.elems.length, pos))
                    }
                    for (i in 0 .. at.elems.length)
                    {
                        let r = unify_ty(store, subst, at.elems[i], bt.elems[i], pos)
                        if (r.ok == 0) { return r }
                    }
                    return unify_ok(@subst)
                }
                _ -> return unify_fail(error::infer_error_mismatch(store, a, b, pos))
            }
        }
        ty::TyArray(ai) -> {
            match b
            {
                ty::TyVar(idb) -> return unify_bind(store, subst, idb, a, pos)
                ty::TyArray(bi) -> return unify_ty(store, subst, store.arrays[ai].elem, store.arrays[bi].elem, pos)
                _ -> return unify_fail(error::infer_error_mismatch(store, a, b, pos))
            }
        }
        ty::TyPtr(ai) -> {
            match b
            {
                ty::TyVar(idb) -> return unify_bind(store, subst, idb, a, pos)
                ty::TyArray(bi) -> return unify_ok(@subst)
                ty::TyPtr(bi) -> return unify_ty(store, subst, store.ptrs[ai].elem, store.ptrs[bi].elem, pos)
                ty::TyPrim(code) -> {
                    if (code == ty::ty_prim_ptr()) { return unify_ok(@subst) }
                    if (ty::ty_prim_is_integer(code) == 1) { return unify_ok(@subst) }
                    return unify_fail(error::infer_error_mismatch(store, a, b, pos))
                }
                _ -> return unify_ty(store, subst, store.ptrs[ai].elem, b, pos)
            }
        }
        ty::TyAdt(ai) -> {
            match b
            {
                ty::TyVar(idb) -> return unify_bind(store, subst, idb, a, pos)
                ty::TyAdt(bi) -> {
                    let aa = store.adts[ai]
                    let ba = store.adts[bi]
                    let mut same = aa.name == ba.name
                    if (aa.sym >= 0 and ba.sym >= 0) { same = if (aa.sym == ba.sym) { 1 } else { 0 } }
                    if (same == 0 or aa.args.length != ba.args.length)
                    {
                        return unify_fail(error::infer_error_mismatch(store, a, b, pos))
                    }
                    for (i in 0 .. aa.args.length)
                    {
                        let r = unify_ty(store, subst, aa.args[i], ba.args[i], pos)
                        if (r.ok == 0) { return r }
                    }
                    return unify_ok(@subst)
                }
                _ -> return unify_fail(error::infer_error_mismatch(store, a, b, pos))
            }
        }
    }
}

pub fn unify_constraints(store: &ty::TyStore, constraints: &constraint::ConstraintStore): UnifyResult
{
    let subst = subst::subst_empty()
    for (i in 0 .. constraints.constraints.length)
    {
        match constraints.constraints[i]
        {
            constraint::ConstraintEq(idx) -> {
                let data = constraints.eqs[idx]
                let r = unify_ty(store, &subst, data.left, data.right, data.pos)
                if (r.ok == 0) { return r }
            }
        }
    }
    return unify_ok(subst)
}
