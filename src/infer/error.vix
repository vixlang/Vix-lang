#[no_main]

use "../util/pos.vix" as pos
use "../type/ty.vix" as ty
use "../diag.vix" as diag

pub type InferErrorKind = InferUnboundName | InferMismatch | InferOccursCheck | InferArity | InferNotCallable | InferNoField | InferOther

pub type InferError = struct {
    kind: InferErrorKind,
    code: string,
    title: string,
    phase: diag::DiagPhase,
    message: string,
    expected: ty::Ty,
    actual: ty::Ty,
    pos: pos::SourcePos
}

pub fn infer_error_ok(): InferError
{
    return InferError{ kind: InferOther, code: "E3000", title: "type error", phase: diag::DiagType, message: "", expected: ty::TyUnknown, actual: ty::TyUnknown, pos: pos::pos_none() }
}

pub fn infer_error(kind: InferErrorKind, code: string, title: string, phase: diag::DiagPhase, message: string, expected: ty::Ty, actual: ty::Ty, pos: pos::SourcePos): InferError
{
    return InferError{ kind: kind, code: code, title: title, phase: phase, message: message, expected: expected, actual: actual, pos: pos }
}

pub fn infer_error_unbound(name: string, pos: pos::SourcePos): InferError
{
    return infer_error(InferUnboundName, "E2001", "undefined symbol", diag::DiagName, "unbound name '" + name + "'", ty::TyUnknown, ty::TyUnknown, pos)
}

pub fn infer_error_other(message: string, pos: pos::SourcePos): InferError
{
    return infer_error(InferOther, "E3000", "type error", diag::DiagType, message, ty::TyUnknown, ty::TyUnknown, pos)
}

pub fn infer_error_mismatch(store: &ty::TyStore, expected: ty::Ty, actual: ty::Ty, pos: pos::SourcePos): InferError
{
    return infer_error(InferMismatch, "E3002", "type mismatch", diag::DiagType, "type mismatch: expected " + ty::ty_to_string(store, expected) + ", got " + ty::ty_to_string(store, actual), expected, actual, pos)
}

pub fn infer_error_occurs(store: &ty::TyStore, var_id: i32, ty: ty::Ty, pos: pos::SourcePos): InferError
{
    return infer_error(InferOccursCheck, "E3009", "recursive type", diag::DiagType, "occurs-check failed: t" + ty::ty_i32_text(var_id) + " occurs in " + ty::ty_to_string(store, ty), ty::TyVar(var_id), ty, pos)
}

pub fn infer_error_arity(expected: i32, actual: i32, pos: pos::SourcePos): InferError
{
    return infer_error(InferArity, "E3020", "invalid function call", diag::DiagType, "arity mismatch: expected " + ty::ty_i32_text(expected) + " arguments, got " + ty::ty_i32_text(actual), ty::TyUnknown, ty::TyUnknown, pos)
}

pub fn infer_error_not_callable(store: &ty::TyStore, actual: ty::Ty, pos: pos::SourcePos): InferError
{
    return infer_error(InferNotCallable, "E3020", "value is not callable", diag::DiagType, "not callable: " + ty::ty_to_string(store, actual), ty::TyUnknown, actual, pos)
}
