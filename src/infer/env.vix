#[no_main]

import "../type/ty.vix"
import "../type/scheme.vix"
import "../type/subst.vix"

pub type TypeEnvEntry = struct {
    name: string,
    scheme: Scheme
}

pub type TypeEnv = struct {
    entries: [TypeEnvEntry]
}

pub fn type_env_new(): TypeEnv
{
    return TypeEnv{ entries: [] }
}

pub fn type_env_clone(env: &TypeEnv): TypeEnv
{
    let mut entries: [TypeEnvEntry] = []
    for (i in 0 .. env.entries.length)
    {
        entries.push(env.entries[i])
    }
    return TypeEnv{ entries: entries }
}

pub fn type_env_lookup(env: &TypeEnv, name: string): Scheme
{
    let mut i = env.entries.length - 1
    while (i >= 0)
    {
        if (env.entries[i].name == name) { return env.entries[i].scheme }
        i -= 1
    }
    return scheme_mono(TyUnknown)
}

pub fn type_env_has(env: &TypeEnv, name: string): i32
{
    let mut i = env.entries.length - 1
    while (i >= 0)
    {
        if (env.entries[i].name == name) { return 1 }
        i -= 1
    }
    return 0
}

pub fn type_env_extend(env: &TypeEnv, name: string, scheme: Scheme)
{
    env.entries.push(TypeEnvEntry{ name: name, scheme: scheme })
}

pub fn type_env_set(env: &TypeEnv, name: string, scheme: Scheme)
{
    let mut i = env.entries.length - 1
    while (i >= 0)
    {
        if (env.entries[i].name == name)
        {
            env.entries[i].scheme = scheme
            return
        }
        i -= 1
    }
    type_env_extend(env, name, scheme)
}

pub fn type_env_free_vars(store: &TyStore, env: &TypeEnv): [i32]
{
    let mut out: [i32] = []
    for (i in 0 .. env.entries.length)
    {
        let vars = scheme_free_vars(store, env.entries[i].scheme)
        for (j in 0 .. vars.length)
        {
            out = ty_array_append_unique_i32(out, vars[j])
        }
    }
    return out
}

pub fn type_env_generalize(store: &TyStore, env: &TypeEnv, ty: Ty): Scheme
{
    let ty_vars = ty_free_vars(store, ty)
    let env_vars = type_env_free_vars(store, env)
    let mut quantified: [i32] = []
    for (i in 0 .. ty_vars.length)
    {
        if (ty_array_contains_i32(env_vars, ty_vars[i]) == 0)
        {
            quantified = ty_array_append_unique_i32(quantified, ty_vars[i])
        }
    }
    return scheme_forall(quantified, ty)
}

pub fn type_env_apply(store: &TyStore, env: &TypeEnv, subst: &Subst): TypeEnv
{
    let out = type_env_new()
    for (i in 0 .. env.entries.length)
    {
        type_env_extend(&out, env.entries[i].name, scheme_apply(store, subst, env.entries[i].scheme))
    }
    return out
}
