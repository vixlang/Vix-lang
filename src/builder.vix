pub fn llvm_load_ptr_index_as_string(b: &LlvmBuilder, base: ptr, index: ptr): ptr
{
    let element_ty = LLVMPointerType(LLVMInt8Type(), 0)
    let indices = [index]
    let slot = vix_LLVMBuildGEP2(b.builder, element_ty, base, indices, 1, llvm_temp(b, "idx"))
    return vix_LLVMBuildLoad2(b.builder, element_ty, slot, llvm_temp(b, "loadidx"))
}

pub fn llvm_load_typed_index(b: &LlvmBuilder, base: ptr, index: ptr, element_ty_text: string, expected_ty: string): ptr
{
    let element_ty = llvm_type_for(element_ty_text)
    let indices = [index]
    let slot = vix_LLVMBuildGEP2(b.builder, element_ty, base, indices, 1, llvm_temp(b, "idx"))
    let value = vix_LLVMBuildLoad2(b.builder, element_ty, slot, llvm_temp(b, "loadidx"))
    return llvm_cast_value(b, value, element_ty_text, expected_ty)
}

pub fn llvm_load_string_char(b: &LlvmBuilder, base: ptr, index: ptr): ptr
{
    let element_ty = LLVMInt8Type()
    let indices = [index]
    let slot = vix_LLVMBuildGEP2(b.builder, element_ty, base, indices, 1, llvm_temp(b, "sidx"))
    let byte = vix_LLVMBuildLoad2(b.builder, element_ty, slot, llvm_temp(b, "sbyte"))
    return vix_LLVMBuildZExt(b.builder, byte, LLVMInt32Type(), llvm_temp(b, "schar"))
}

