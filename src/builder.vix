pub fn llvm_build_truthy_i1(b: &LlvmBuilder, value: ptr): ptr
{
    return vix_LLVMBuildICmp(b.builder, 33, value, llvm_const_i32(0), llvm_temp(b, "cond"))
}

pub fn llvm_build_truthy_typed_i1(b: &LlvmBuilder, value: ptr, ty: string): ptr
{
    if (ty == "f32" or ty == "f64")
    {
        return vix_LLVMBuildFCmp(b.builder, 6, value, llvm_const_float(0.0, ty), llvm_temp(b, "cond"))
    }
    if (ty == "i64")
    {
        return vix_LLVMBuildICmp(b.builder, 33, value, vix_LLVMConstInt(LLVMInt64Type(), 0, 0), llvm_temp(b, "cond"))
    }
    return vix_LLVMBuildICmp(b.builder, 33, value, llvm_const_i32(0), llvm_temp(b, "cond"))
}

pub fn llvm_build_not_value(b: &LlvmBuilder, value: ptr): ptr
{
    return llvm_build_icmp_value(b, 32, value, llvm_const_i32(0))
}

pub fn llvm_emit_ret_value(b: &LlvmBuilder, value: ptr)
{
    vix_LLVMBuildRet(b.builder, value)
}

pub fn llvm_emit_jnz_value(b: &LlvmBuilder, cond_value: ptr, then_label: string, else_label: string)
{
    let cond = llvm_build_truthy_i1(b, cond_value)
    let then_block = vix_LLVMAppendBasicBlock(b.current_fn, then_label)
    let else_block = vix_LLVMAppendBasicBlock(b.current_fn, else_label)
    vix_LLVMBuildCondBr(b.builder, cond, then_block, else_block)
}

pub fn llvm_emit_condbr_blocks(b: &LlvmBuilder, cond_value: ptr, then_block: ptr, else_block: ptr)
{
    let cond = llvm_build_truthy_i1(b, cond_value)
    vix_LLVMBuildCondBr(b.builder, cond, then_block, else_block)
}

pub fn llvm_build_call_value(b: &LlvmBuilder, func: string, args: [ptr]): ptr
{
    let mut fn_ref = vix_LLVMGetNamedFunction(b.module, func)
    let ret_ty = get_function_return_type(func)
    let param_count = get_function_param_count(func)
    let mut llvm_param_types: [ptr] = []
    for (i in 0 .. param_count)
    {
        llvm_param_types.push(llvm_type_for(get_function_param_type(func, i)))
    }
    let fn_ty = vix_LLVMFunctionTypeTypedN(llvm_type_for(ret_ty), llvm_param_types, param_count, get_function_is_var_arg(func))
    if (fn_ref == nil)
    {
        fn_ref = vix_LLVMAddFunction(b.module, func, fn_ty)
    }
    let call_name = if (ret_ty == "void") { "" } else { llvm_temp(b, "call") }
    return vix_LLVMBuildCall2(b.builder, fn_ty, fn_ref, args, args.length, call_name)
}

pub fn llvm_emit_printf_i32_value(b: &LlvmBuilder, value: ptr)
{
    let fmt_ptr = get_fmt_string(b)
    let args = [fmt_ptr, value]
    let __b0 = vix_LLVMBuildCall2(b.builder, vix_LLVMFunctionType1(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), 1), b.printf_fn, args, 2, "")
}

pub fn llvm_emit_printf_value(b: &LlvmBuilder, value: ptr, ty: string)
{
    let fmt = if (ty == "i64" or ty == "u64" or ty == "usize") { "%ld\n" } elif (ty == "f32" or ty == "f64") { "%f\n" } elif (ty == "string") { "%s\n" } else { "%d\n" }
    let fmt_ptr = get_c_string_global(b, ".fmt." + ty, fmt)
    let print_value = if (ty == "f32") { llvm_cast_value(b, value, "f32", "f64") } elif (ty == "i8" or ty == "u8" or ty == "char") { llvm_cast_value(b, value, ty, "i32") } else { value }
    let args = [fmt_ptr, print_value]
    let __b1 = vix_LLVMBuildCall2(b.builder, vix_LLVMFunctionType1(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), 1), b.printf_fn, args, 2, "")
}

pub fn llvm_build_eq_string_value(b: &LlvmBuilder, left: string, right_literal: string): ptr
{
    if (left == right_literal)
    {
        return llvm_const_i32(1)
    }
    return llvm_build_icmp_value(b, 32, llvm_const_i32(0), llvm_const_i32(0))
}

pub fn llvm_build_string_eq_value(b: &LlvmBuilder, left: ptr, right: ptr): ptr
{
    let args = [left, right]
    let call = vix_LLVMBuildCall2(b.builder, vix_LLVMFunctionType2(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), LLVMPointerType(LLVMInt8Type(), 0), 0), b.strcmp_fn, args, 2, llvm_temp(b, "strcmp"))
    return llvm_build_icmp_value(b, 32, call, llvm_const_i32(0))
}

pub fn llvm_emit_jmp(b: &LlvmBuilder, label: string)
{
    let block = vix_LLVMAppendBasicBlock(b.current_fn, label)
    vix_LLVMBuildBr(b.builder, block)
}

pub fn llvm_emit_jmp_block(b: &LlvmBuilder, block: ptr)
{
    vix_LLVMBuildBr(b.builder, block)
}

pub fn llvm_build_struct_field_from_ptr(b: &LlvmBuilder, struct_ty: string, base_ptr: ptr, field_index: i32, field_ty: string, expected_ty: string): ptr
{
    let llvm_struct_ty = llvm_type_for(struct_ty)
    let struct_ptr_ty = LLVMPointerType(llvm_struct_ty, 0)
    let casted_ptr = vix_LLVMBuildBitCast(b.builder, base_ptr, struct_ptr_ty, llvm_temp(b, "cast"))
    let indices = [llvm_const_i32(0), llvm_const_i32(field_index)]
    let field_ptr = vix_LLVMBuildGEP2(b.builder, llvm_struct_ty, casted_ptr, indices, 2, llvm_temp(b, "field"))
    let field_val = vix_LLVMBuildLoad2(b.builder, llvm_type_for(field_ty), field_ptr, llvm_temp(b, "fieldval"))
    return llvm_cast_value(b, field_val, field_ty, expected_ty)
}

pub fn llvm_build_struct_field_ptr_from_ptr(b: &LlvmBuilder, struct_ty: string, base_ptr: ptr, field_index: i32): ptr
{
    let llvm_struct_ty = llvm_type_for(struct_ty)
    let struct_ptr_ty = LLVMPointerType(llvm_struct_ty, 0)
    let casted_ptr = vix_LLVMBuildBitCast(b.builder, base_ptr, struct_ptr_ty, llvm_temp(b, "cast"))
    let indices = [llvm_const_i32(0), llvm_const_i32(field_index)]
    return vix_LLVMBuildGEP2(b.builder, llvm_struct_ty, casted_ptr, indices, 2, llvm_temp(b, "fieldptr"))
}
