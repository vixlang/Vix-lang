pub fn builder_i32_to_str(n: i32): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%d", n)
    return buf
}

pub fn i32_to_i64(n: i32): i64
{
    return n
}

pub fn i32_to_f64(n: i32): f64
{
    return n
}

pub type LlvmVarEntry = struct {
    name: string,
    value: ptr
}

pub type LlvmBuilder = struct {
    module: ptr,
    builder: ptr,
    current_fn: ptr,
    current_block: ptr,
    temp_counter: i32,
    label_counter: i32,
    printf_fn: ptr,
    malloc_fn: ptr,
    strcmp_fn: ptr,
    strlen_fn: ptr
}

pub fn get_var(b: &LlvmBuilder, name: string): ptr
{
    let var = vix_get_var(name)
    if (var != nil)
    {
        return var
    }
    return vix_LLVMGetNamedFunction(b.module, name)
}

pub fn set_var(b: &LlvmBuilder, name: string, value: ptr)
{
    vix_set_var(name, value)
}

pub fn get_var_type(b: &LlvmBuilder, name: string): string
{
    let ty = vix_get_var_type(name)
    if (ty == nil) { return "i32" }
    return ty
}

pub fn set_var_type(b: &LlvmBuilder, name: string, ty: string)
{
    vix_set_var_type(name, ty)
}

pub fn reset_local_vars()
{
    vix_reset_vars()
}

pub fn set_local_var_type(name: string, ty: string)
{
    vix_set_var_type(name, ty)
}

pub fn get_local_var_type(name: string): string
{
    let ty = vix_get_var_type(name)
    if (ty == nil) { return "i32" }
    return ty
}

pub fn reset_function_sigs()
{
    vix_reset_function_sigs()
}

pub fn register_function_sig(name: string, ret_ty: string, param_types: [string])
{
    register_function_sig_vararg(name, ret_ty, param_types, 0)
}

pub fn register_function_sig_vararg(name: string, ret_ty: string, param_types: [string], is_var_arg: i32)
{
    vix_register_function_sig_vararg(name, ret_ty, param_types, param_types.length, is_var_arg)
