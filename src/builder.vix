    return vix_LLVMBuildCall2(b.builder, vix_LLVMFunctionType1(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), 0), b.strlen_fn, args, 1, llvm_temp(b, "strlen"))
