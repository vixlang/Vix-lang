    return vix_LLVMBuildZExt(b.builder, cmp, LLVMInt32Type(), llvm_temp(b, "bool"))
}

pub fn llvm_cast_value(b: &LlvmBuilder, value: ptr, from_ty: string, to_ty: string): ptr
{
    if (from_ty == to_ty) { return value }
    if ((to_ty == "f32" or to_ty == "f64") and (from_ty == "i32" or from_ty == "i64"))
    {
        return vix_LLVMBuildSIToFP(b.builder, value, llvm_type_for(to_ty), llvm_temp(b, "sitofp"))
    }
    if (to_ty == "f64" and from_ty == "f32")
    {
        return vix_LLVMBuildFPExt(b.builder, value, llvm_type_for(to_ty), llvm_temp(b, "fpext"))
    }
    if (to_ty == "f32" and from_ty == "f64")
    {
        return vix_LLVMBuildFPTrunc(b.builder, value, llvm_type_for(to_ty), llvm_temp(b, "fptrunc"))
    }
    if ((to_ty == "i64" or to_ty == "u64" or to_ty == "usize") and (from_ty == "i32" or from_ty == "u32" or from_ty == "i8" or from_ty == "u8" or from_ty == "char"))
    {
        return vix_LLVMBuildZExt(b.builder, value, llvm_type_for(to_ty), llvm_temp(b, "zext"))
    }
    if ((to_ty == "i32" or to_ty == "u32") and (from_ty == "i8" or from_ty == "u8" or from_ty == "char"))
    {
        return vix_LLVMBuildZExt(b.builder, value, llvm_type_for(to_ty), llvm_temp(b, "zext"))
    }
    if ((to_ty == "i8" or to_ty == "u8" or to_ty == "char") and (from_ty == "i32" or from_ty == "u32" or from_ty == "i64" or from_ty == "u64" or from_ty == "usize"))
    {
        return vix_LLVMBuildTrunc(b.builder, value, llvm_type_for(to_ty), llvm_temp(b, "trunc"))
    }
    return value
}

