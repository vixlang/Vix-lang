{
    vix_register_struct_sig(name, field_names, field_types, field_names.length)
}

pub fn type_text_is_array(ty: string): i32
{
    if (ty.length > 0 and ty[0] == '[') { return 1 }
    return 0
}

pub fn type_array_element(ty: string): string
{
    if (type_text_is_array(ty) == 0 or ty.length <= 2) { return "unknown" }
    let mut result = ""
    for (i in 1 .. ty.length - 1)
    {
        let s: string = malloc(2)
        s[0] = ty[i]
        s[1] = 0
        result = result + s
    }
    return result
}

pub fn is_ptr_to_struct(ty: string): i32
{
    if (ty.length > 4 and ty[0] == 'p' and ty[1] == 't' and ty[2] == 'r' and ty[3] == ':') { return 1 }
    return 0
}

pub fn strip_ptr_prefix(ty: string): string
{
    if (is_ptr_to_struct(ty) == 0) { return ty }
    let mut result = ""
    for (i in 4 .. ty.length)
    {
        let s: string = malloc(2)
        s[0] = ty[i]
        s[1] = 0
        result = result + s
    }
    return result
}

pub fn type_text_is_ptr_to_array(ty: string): i32
{
    if (is_ptr_to_struct(ty) == 0) { return 0 }
    return type_text_is_array(strip_ptr_prefix(ty))
}

pub fn type_text_index_element(ty: string): string
{
    if (type_text_is_array(ty) == 1) { return type_array_element(ty) }
    if (type_text_is_ptr_to_array(ty) == 1) { return type_array_element(strip_ptr_prefix(ty)) }
    if (ty == "string" or ty == "ptr") { return "i8" }
    if (is_ptr_to_struct(ty) == 1) { return strip_ptr_prefix(ty) }
    return "i32"
}

pub fn type_text_is_option(ty: string): i32
{
    if (ty.length > 7 and ty[0] == 'O' and ty[1] == 'p' and ty[2] == 't' and ty[3] == 'i' and ty[4] == 'o' and ty[5] == 'n' and ty[6] == '[') { return 1 }
    return 0
}

pub fn type_text_base_name_builder(ty: string): string
{
    let mut result = ""
    for (i in 0 .. ty.length)
    {
        if (ty[i] == ':' or ty[i] == '[') { return result }
        let s: string = malloc(2)
        s[0] = ty[i]
        s[1] = 0
        result = result + s
    }
    return result
}

pub fn type_text_option_inner(ty: string): string
{
    if (type_text_is_option(ty) == 0) { return "unknown" }
    let mut result = ""
    for (i in 7 .. ty.length - 1)
    {
        let s: string = malloc(2)
        s[0] = ty[i]
        s[1] = 0
        result = result + s
    }
    return result
}

pub fn type_is_struct(name: string): i32
{
    return vix_is_struct_type(name)
}

pub fn get_struct_field_index(struct_name: string, field_name: string): i32
{
    return vix_get_struct_field_index(struct_name, field_name)
}

pub fn get_struct_field_type(struct_name: string, field_name: string): string
{
    return vix_get_struct_field_type(struct_name, field_name)
}

pub fn llvm_type_for(ty: string): ptr
{
    if (vix_is_struct_type(ty) == 1)
    {
        return vix_get_llvm_type_for_struct(ty)
    }
    let base_ty = type_text_base_name_builder(ty)
    if (base_ty != ty and vix_is_struct_type(base_ty) == 1)
    {
        return vix_get_llvm_type_for_struct(base_ty)
    }
    if (type_text_is_array(ty) == 1 or type_text_is_option(ty) == 1)
    {
        return LLVMPointerType(LLVMInt8Type(), 0)
    }
    if (is_ptr_to_struct(ty) == 1)
    {
        return LLVMPointerType(LLVMInt8Type(), 0)
    }
    if (ty == "void") { return LLVMVoidType() }
    if (ty == "bool") { return LLVMInt32Type() }
    if (ty == "i8" or ty == "u8" or ty == "char") { return LLVMInt8Type() }
    if (ty == "i64" or ty == "u64" or ty == "usize") { return LLVMInt64Type() }
    if (ty == "f32") { return LLVMFloatType() }
    if (ty == "f64") { return LLVMDoubleType() }
    if (ty == "ptr" or ty == "string") { return LLVMPointerType(LLVMInt8Type(), 0) }
    return LLVMInt32Type()
}

pub fn get_fmt_string(b: &LlvmBuilder): ptr
{
    return get_c_string_global(b, ".fmt.i32", "%d\n")
}

pub fn get_c_string_global(b: &LlvmBuilder, name: string, text: string): ptr
{
    let mut global = vix_LLVMGetNamedGlobal(b.module, name)
    let str_len = text.length
    if (global == nil)
    {
        let str_val = vix_LLVMConstString(text, str_len, 0)
        let str_ty = vix_LLVMArrayType(LLVMInt8Type(), str_len + 1)
        global = vix_LLVMAddGlobal(b.module, str_ty, name)
        vix_LLVMSetInitializer(global, str_val)
        vix_LLVMSetGlobalConstant(global, 1)
        vix_LLVMSetLinkage(global, 8)
    }
    let indices = [vix_LLVMConstInt(LLVMInt32Type(), 0, 0), vix_LLVMConstInt(LLVMInt32Type(), 0, 0)]
    return vix_LLVMBuildGEP2(b.builder, vix_LLVMArrayType(LLVMInt8Type(), str_len + 1), global, indices, 2, "str_ptr")
}

pub fn llvm_new(): LlvmBuilder
{
    return llvm_new_for_target("")
}

pub fn llvm_new_for_target(target_triple: string): LlvmBuilder
{
    vix_reset_vars()
    let module = LLVMModuleCreateWithName("vixc0")
    if (target_triple != "")
    {
        LLVMSetTarget(module, target_triple)
    }
    let builder = LLVMCreateBuilder()
    let printf_ty = vix_LLVMFunctionType1(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), 1)
    let printf_fn = vix_LLVMAddFunction(module, "printf", printf_ty)
    let malloc_ty = vix_LLVMFunctionType1(LLVMPointerType(LLVMInt8Type(), 0), LLVMInt64Type(), 0)
    let malloc_fn = vix_LLVMAddFunction(module, "malloc", malloc_ty)
    let strcmp_ty = vix_LLVMFunctionType2(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), LLVMPointerType(LLVMInt8Type(), 0), 0)
    let strcmp_fn = vix_LLVMAddFunction(module, "strcmp", strcmp_ty)
    let strlen_ty = vix_LLVMFunctionType1(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), 0)
    let strlen_fn = vix_LLVMAddFunction(module, "strlen", strlen_ty)
    return LlvmBuilder{ module: module, builder: builder, current_fn: nil, current_block: nil, temp_counter: 0, label_counter: 0, printf_fn: printf_fn, malloc_fn: malloc_fn, strcmp_fn: strcmp_fn, strlen_fn: strlen_fn }
}

pub fn llvm_get_code(b: &LlvmBuilder): string
{
    return LLVMPrintModuleToString(b.module)
}

pub fn llvm_temp(b: &LlvmBuilder, prefix: string): string
{
    let val = b.temp_counter
    b.temp_counter = val + 1
    return prefix + builder_i32_to_str(val)
}

pub fn llvm_label_name(b: &LlvmBuilder, prefix: string): string
{
    let val = b.label_counter
    b.label_counter = val + 1
    return prefix + builder_i32_to_str(val)
}

pub fn llvm_emit_function_header(b: &LlvmBuilder, name: string, ret_ty: string)
{
    llvm_emit_function_header_with_params(b, name, ret_ty, [], [])
}

pub fn llvm_declare_function_with_params(b: &LlvmBuilder, name: string, ret_ty: string, param_types: [string]): ptr
{
    return llvm_declare_function_with_params_vararg(b, name, ret_ty, param_types, 0)
}

pub fn llvm_declare_function_with_params_vararg(b: &LlvmBuilder, name: string, ret_ty: string, param_types: [string], is_var_arg: i32): ptr
{
    let llvm_ret_ty = llvm_type_for(ret_ty)
    let mut llvm_param_types: [ptr] = []
    for (i in 0 .. param_types.length)
    {
        llvm_param_types.push(llvm_type_for(param_types[i]))
    }
    let fn_ty = vix_LLVMFunctionTypeTypedN(llvm_ret_ty, llvm_param_types, param_types.length, is_var_arg)
    let mut fn_ref = vix_LLVMGetNamedFunction(b.module, name)
    if (fn_ref == nil)
    {
        fn_ref = vix_LLVMAddFunction(b.module, name, fn_ty)
    }
    return fn_ref
}

pub fn llvm_emit_function_header_with_params(b: &LlvmBuilder, name: string, ret_ty: string, param_names: [string], param_types: [string])
{
    vix_reset_vars()
    let mut fn_ref = llvm_declare_function_with_params(b, name, ret_ty, param_types)
    b.current_fn = fn_ref
    let entry = vix_LLVMAppendBasicBlock(b.current_fn, "entry")
    vix_LLVMPositionBuilderAtEnd(b.builder, entry)
    b.current_block = entry
    for (i in 0 .. param_names.length)
    {
        let param_value = vix_LLVMGetParam(b.current_fn, i)
        let alloca = llvm_alloc_var(b, param_names[i], param_types[i])
        vix_LLVMBuildStore(b.builder, param_value, alloca)
    }
}

pub fn llvm_emit_end_function(b: &LlvmBuilder)
{
    b.current_fn = nil
    b.current_block = nil
}

pub fn llvm_emit_label(b: &LlvmBuilder, name: string)
{
    let block = llvm_append_block(b, name)
    llvm_position_at_end(b, block)
}

pub fn llvm_append_block(b: &LlvmBuilder, name: string): ptr
{
    return vix_LLVMAppendBasicBlock(b.current_fn, name)
}

pub fn llvm_position_at_end(b: &LlvmBuilder, block: ptr)
{
    vix_LLVMPositionBuilderAtEnd(b.builder, block)
    b.current_block = block
}

pub fn llvm_emit_ret_void(b: &LlvmBuilder)
{
    vix_LLVMBuildRetVoid(b.builder)
}

pub fn llvm_current_block_terminated(b: &LlvmBuilder): i32
{
    if (b.current_block == nil) { return 1 }
    if (vix_LLVMGetBasicBlockTerminator(b.current_block) != nil) { return 1 }
    return 0
}

pub fn llvm_const_i32(value: i32): ptr
{
    return vix_LLVMConstInt(LLVMInt32Type(), i32_to_i64(value), 0)
}

pub fn llvm_const_i64(value: i32): ptr
{
    return vix_LLVMConstInt(LLVMInt64Type(), i32_to_i64(value), 0)
}

pub fn llvm_const_bool(value: i32): ptr
{
    return llvm_const_i32(value)
}

pub fn llvm_const_float(value: f64, ty: string): ptr
{
    return vix_LLVMConstReal(llvm_type_for(ty), value)
}

pub fn llvm_const_null_ptr(): ptr
{
    return vix_LLVMConstPointerNull(LLVMPointerType(LLVMInt8Type(), 0))
}

pub fn llvm_zero_value_for(ty: string): ptr
{
    if (ty == "f32" or ty == "f64") { return llvm_const_float(0.0, ty) }
    if (ty == "i64" or ty == "u64" or ty == "usize") { return llvm_const_i64(0) }
    if (ty == "ptr" or ty == "string" or is_ptr_to_struct(ty) == 1 or type_text_is_array(ty) == 1 or type_text_is_option(ty) == 1) { return llvm_const_null_ptr() }
    if (vix_is_struct_type(type_text_base_name_builder(ty)) == 1) { return llvm_undef(type_text_base_name_builder(ty)) }
    return llvm_const_i32(0)
}

pub fn llvm_undef(ty: string): ptr
{
    return vix_LLVMGetUndef(llvm_type_for(ty))
}

pub fn llvm_alloc_i32_var(b: &LlvmBuilder, name: string): ptr
{
    return llvm_alloc_var(b, name, "i32")
}

pub fn llvm_alloc_var(b: &LlvmBuilder, name: string, ty: string): ptr
{
    let alloca = vix_LLVMBuildAlloca(b.builder, llvm_type_for(ty), name)
    set_var(b, name, alloca)
    set_var_type(b, name, ty)
    return alloca
}

pub fn llvm_load_i32_var(b: &LlvmBuilder, name: string): ptr
{
    return llvm_load_var(b, name)
}

pub fn llvm_load_var(b: &LlvmBuilder, name: string): ptr
{
    return vix_LLVMBuildLoad2(b.builder, llvm_type_for(get_var_type(b, name)), get_var(b, name), llvm_temp(b, "load"))
}

pub fn llvm_var_address(b: &LlvmBuilder, name: string): ptr
{
    return get_var(b, name)
}

pub fn llvm_load_i32_pointer(b: &LlvmBuilder, ptr_value: ptr): ptr
{
    return vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), ptr_value, llvm_temp(b, "deref"))
}

pub fn llvm_load_typed_pointer(b: &LlvmBuilder, ptr_value: ptr, pointee_ty: string): ptr
{
    return vix_LLVMBuildLoad2(b.builder, llvm_type_for(pointee_ty), ptr_value, llvm_temp(b, "deref"))
}

pub fn llvm_store_typed_pointer(b: &LlvmBuilder, ptr_value: ptr, value: ptr)
{
    vix_LLVMBuildStore(b.builder, value, ptr_value)
}

pub fn llvm_load_ptr_pointer(b: &LlvmBuilder, ptr_value: ptr): ptr
{
    let ptr_ty = LLVMPointerType(LLVMInt8Type(), 0)
    return vix_LLVMBuildLoad2(b.builder, ptr_ty, ptr_value, llvm_temp(b, "loadptr"))
}

