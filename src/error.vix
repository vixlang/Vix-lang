#[no_main]

import "lexer.vix"

extern "C"
{
    fn malloc(size: usize): string
    fn snprintf(buf: string, size: usize, fmt: string, ...): i32
    fn vix_diag_strlen(s: string): i32
}

pub fn diag_red(): string { return "\033[31m" }
pub fn diag_yellow(): string { return "\033[33m" }
pub fn diag_blue(): string { return "\033[34m" }
pub fn diag_magenta(): string { return "\033[35m" }
pub fn diag_cyan(): string { return "\033[36m" }
pub fn diag_bold(): string { return "\033[1m" }
pub fn diag_dim(): string { return "\033[2m" }
pub fn diag_reset(): string { return "\033[0m" }

pub fn diag_strlen(text: string): i32
{
    return vix_diag_strlen(text)
}

pub fn str_starts_with(text: string, prefix: string): i32
{
    let text_len = diag_strlen(text)
    let prefix_len = diag_strlen(prefix)
    if (text_len < prefix_len) { return 0 }
    for (i in 0 .. prefix_len)
    {
        if (text[i] != prefix[i]) { return 0 }
    }
    return 1
}

pub fn str_from(text: string, start: i32): string
{
    let mut out = ""
    let mut i = start
    let text_len = diag_strlen(text)
    while (i < text_len)
    {
        out = out + char_string(text[i])
        i += 1
    }
    return out
}

pub fn strip_func_prefix(message: string): string
{
    let prefix = "in function "
    if (str_starts_with(message, prefix) == 0) { return message }
    let start = prefix.length
    let mut i = start
    while (i + 1 < message.length)
    {
        if (message[i] == ':' and message[i + 1] == ' ') { return str_from(message, i + 2) }
        i += 1
    }
    return message
}

pub fn parse_error_code(msg: string): string
{
    if (str_starts_with(msg, "expected '") == 1) { return "E1001" }
    if (str_starts_with(msg, "unexpected token") == 1) { return "E1002" }
    if (str_starts_with(msg, "unexpected statement") == 1) { return "E1002" }
    if (str_starts_with(msg, "unexpected token after identifier") == 1) { return "E1002" }
    if (str_starts_with(msg, "expected if or elif") == 1) { return "E1003" }
    if (str_starts_with(msg, "empty source") == 1) { return "E1004" }
    if (str_starts_with(msg, "expected function") == 1) { return "E1005" }
    return "E1000"
}

pub fn name_error_code(msg: string): string
{
    if (str_starts_with(msg, "undefined symbol '") == 1) { return "E2001" }
    if (str_starts_with(msg, "duplicate symbol '") == 1) { return "E2002" }
    if (str_starts_with(msg, "undefined function '") == 1) { return "E2003" }
    if (str_starts_with(msg, "duplicate function '") == 1) { return "E2004" }
    if (str_starts_with(msg, "duplicate struct '") == 1) { return "E2006" }
    if (str_starts_with(msg, "duplicate parameter '") == 1) { return "E2007" }
    if (str_starts_with(msg, "duplicate field '") == 1) { return "E2008" }
    if (str_starts_with(msg, "for iterator '") == 1) { return "E2009" }
    if (str_starts_with(msg, "function '") == 1) { return "E2010" }
    return "E2000"
}

pub fn type_error_code(msg: string): string
{
    if (str_starts_with(msg, "cannot initialize '") == 1) { return "E3001" }
    if (str_starts_with(msg, "cannot assign to immutable binding '") == 1) { return "E3013" }
    if (str_starts_with(msg, "cannot assign field '") == 1) { return "E3013" }
    if (str_starts_with(msg, "cannot assign '") == 1) { return "E3002" }
    if (str_starts_with(msg, "cannot dereference value of type '") == 1) { return "E3003" }
    if (str_starts_with(msg, "cannot store through value of type '") == 1) { return "E3004" }
    if (str_starts_with(msg, "cannot store '") == 1) { return "E3015" }
    if (str_starts_with(msg, "unknown field '") == 1) { return "E3005" }
    if (str_starts_with(msg, "unknown struct '") == 1) { return "E3006" }
    if (str_starts_with(msg, "cannot index value of type '") == 1) { return "E3007" }
    if (str_starts_with(msg, "index expression expects integer index") == 1) { return "E3014" }
    if (str_starts_with(msg, "struct '") == 1) { return "E3021" }
    if (str_starts_with(msg, "missing field '") == 1) { return "E3022" }
    if (str_starts_with(msg, "duplicate initializer field '") == 1) { return "E3023" }
    if (str_starts_with(msg, "array element type '") == 1) { return "E3024" }
    if (str_starts_with(msg, "method 'push'") == 1) { return "E3025" }
    if (str_starts_with(msg, "cannot compare '") == 1) { return "E3011" }
    if (str_starts_with(msg, "return value type '") == 1) { return "E3012" }
    if (str_starts_with(msg, "match pattern type '") == 1) { return "E3018" }
    if (str_starts_with(msg, "match return value type '") == 1) { return "E3012" }
    if (str_starts_with(msg, "while condition must be bool") == 1) { return "E3016" }
    if (str_starts_with(msg, "if condition must be bool") == 1) { return "E3016" }
    if (str_starts_with(msg, "for range start must be integer") == 1) { return "E3017" }
    if (str_starts_with(msg, "for range end must be integer") == 1) { return "E3017" }
    if (str_starts_with(msg, "operator '+' cannot mix") == 1) { return "E3010" }
    if (str_starts_with(msg, "operator '") == 1) { return "E3008" }
    if (str_starts_with(msg, "function '") == 1) { return "E3020" }
    if (str_starts_with(msg, "'break' used outside loop") == 1) { return "E3019" }
    if (str_starts_with(msg, "'continue' used outside loop") == 1) { return "E3019" }
    return "E3000"
}

pub fn semantic_error_code(msg: string): string
{
    if (str_starts_with(msg, "no 'main' function defined") == 1) { return "E4001" }
    if (str_starts_with(msg, "entry function 'main'") == 1) { return "E4002" }
    return "E4000"
}

pub fn semantic_warning_code(msg: string): string
{
    if (str_starts_with(msg, "unused variable '") == 1) { return "W4001" }
    if (str_starts_with(msg, "no 'main' function defined") == 1) { return "W4002" }
    if (str_starts_with(msg, "entry function 'main'") == 1) { return "W4003" }
    return "W4000"
}

pub fn error_code_for_type(error_type: string, message: string): string
{
    let msg = strip_func_prefix(message)
    return match error_type
    {
        "ParseError" -> parse_error_code(msg)
        "NameError" -> name_error_code(msg)
        "TypeError" -> type_error_code(msg)
        "SemanticError" -> semantic_error_code(msg)
        "SemanticWarning" -> semantic_warning_code(msg)
        _ -> "E0000"
    }
}

pub fn error_explanation(code: string): string
{
    return match code
    {
        "E0000" -> "E0000: unknown diagnostic\n\nThe compiler emitted a diagnostic that does not match a known error category.\n\nHow to fix: read the full diagnostic message and source location; if this appears for a common error, report it so the compiler can assign a specific code."
        "E1000" -> "E1000: parse error\n\nThe source text is not valid Vix syntax.\n\nHow to fix: check the token and source location shown in the diagnostic, then correct the surrounding syntax."
        "E1001" -> "E1001: expected token\n\nThe parser expected a specific token, such as a delimiter, operator, or keyword, but found something else.\n\nHow to fix: add the missing token or remove the unexpected text near the reported location."
        "E1002" -> "E1002: unexpected token or statement\n\nThe parser found a token or statement that is not valid in the current grammar position.\n\nHow to fix: move the statement to a valid position, correct the expression syntax, or remove the extra token."
        "E1003" -> "E1003: invalid conditional branch\n\nAn elif/else-style branch was found where the parser expected an if or elif form.\n\nHow to fix: check the if/elif/else chain and make sure each branch uses the correct keyword and block structure."
        "E1004" -> "E1004: empty source\n\nThe input file has no source code for the compiler to parse.\n\nHow to fix: add Vix declarations, or pass the intended non-empty input file."
        "E1005" -> "E1005: expected function\n\nThe parser expected a function declaration at this point in the file.\n\nHow to fix: start the declaration with fn, or move unsupported top-level code inside a function."
        "E2000" -> "E2000: name error\n\nName resolution failed, but the exact case does not have a more specific code.\n\nHow to fix: check symbol spelling, declaration order, duplicates, and scope."
        "E2001" -> "E2001: undefined symbol\n\nA variable, value, or type name was used but no matching symbol is visible in scope.\n\nHow to fix: declare the symbol before use, import it if needed, or correct the spelling."
        "E2002" -> "E2002: duplicate symbol\n\nTwo symbols with the same name were declared in a scope where only one is allowed.\n\nHow to fix: rename one declaration or remove the duplicate."
        "E2003" -> "E2003: undefined function\n\nA function call refers to a function that the compiler cannot find.\n\nHow to fix: define the function, import it, or correct the function name."
        "E2004" -> "E2004: duplicate function\n\nMore than one function with the same name was declared.\n\nHow to fix: rename or remove one function declaration."
        "E2006" -> "E2006: duplicate struct\n\nMore than one struct with the same name was declared.\n\nHow to fix: rename or remove one struct declaration."
        "E2007" -> "E2007: duplicate parameter\n\nA function parameter name is repeated.\n\nHow to fix: give each parameter a unique name."
        "E2008" -> "E2008: duplicate field\n\nA struct contains multiple fields with the same name.\n\nHow to fix: give each field a unique name."
        "E2009" -> "E2009: invalid for iterator\n\nThe for-loop iterator conflicts with an existing binding or is otherwise invalid.\n\nHow to fix: rename the iterator or adjust the surrounding scope."
        "E2010" -> "E2010: invalid function name usage\n\nA function name is being used in a way that name resolution rejects.\n\nHow to fix: check whether you intended to call the function, declare a value, or use a different name."
        "E3000" -> "E3000: type error\n\nType checking failed, but the exact case does not have a more specific code.\n\nHow to fix: compare the expected and actual types in the diagnostic and adjust annotations, expressions, or conversions."
        "E3001" -> "E3001: invalid initialization\n\nA value cannot be used to initialize the target binding or storage location.\n\nHow to fix: make the initializer type match the declared type, or change the declaration type."
        "E3002" -> "E3002: invalid assignment\n\nThe assigned value type does not match the destination type.\n\nHow to fix: assign a compatible value or change the destination type."
        "E3003" -> "E3003: invalid dereference\n\nThe code tries to dereference a value that is not a pointer-like value.\n\nHow to fix: dereference only pointer values, or remove the dereference operator."
        "E3004" -> "E3004: invalid store target\n\nThe code tries to store through a value that cannot be written through.\n\nHow to fix: store through a mutable pointer-like value or assign to a mutable binding instead."
        "E3005" -> "E3005: unknown field\n\nA field access names a field that does not exist on the target struct type.\n\nHow to fix: correct the field name or use a value with the expected struct type."
        "E3006" -> "E3006: unknown struct\n\nA struct type name was used but no matching struct declaration exists.\n\nHow to fix: declare the struct, import it if needed, or correct the type name."
        "E3007" -> "E3007: invalid index target\n\nThe code indexes a value whose type does not support indexing.\n\nHow to fix: index only arrays or other indexable values."
        "E3008" -> "E3008: invalid operator operands\n\nAn operator was applied to operand types it does not support.\n\nHow to fix: use operands of compatible types or choose the correct operator."
        "E3010" -> "E3010: mixed addition operands\n\nThe + operator was used with incompatible operand categories.\n\nHow to fix: make both operands numeric, or both operands valid for string concatenation if supported."
        "E3011" -> "E3011: invalid comparison\n\nThe compared values have incompatible types.\n\nHow to fix: compare values of compatible types."
        "E3012" -> "E3012: invalid return type\n\nA returned value does not match the function or match-expression return type.\n\nHow to fix: return the expected type or change the declared return type."
        "E3013" -> "E3013: assignment to immutable or invalid field\n\nThe code assigns to an immutable binding or to a field that cannot be assigned.\n\nHow to fix: declare the binding mutable when mutation is intended, or assign to a mutable valid target."
        "E3014" -> "E3014: non-integer index\n\nAn index expression uses a non-integer index value.\n\nHow to fix: use an integer index."
        "E3015" -> "E3015: invalid store value\n\nThe stored value is incompatible with the destination.\n\nHow to fix: store a value whose type matches the pointed-to or target type."
        "E3016" -> "E3016: non-bool condition\n\nAn if or while condition is not bool.\n\nHow to fix: use a boolean expression as the condition."
        "E3017" -> "E3017: invalid for range bound\n\nA for-range start or end expression is not an integer.\n\nHow to fix: use integer expressions for range bounds."
        "E3018" -> "E3018: invalid match pattern type\n\nA match pattern type is incompatible with the matched value.\n\nHow to fix: make each pattern match the scrutinee type."
        "E3019" -> "E3019: break or continue outside loop\n\nA break or continue statement appears outside a loop.\n\nHow to fix: move it inside a loop or replace it with appropriate control flow."
        "E3020" -> "E3020: invalid function call\n\nA function call has incompatible argument types or arity.\n\nHow to fix: pass the expected number and types of arguments."
        "E3021" -> "E3021: invalid struct initializer\n\nA struct initializer does not match the struct definition.\n\nHow to fix: use valid field names and values for the target struct."
        "E3022" -> "E3022: missing struct field\n\nA struct initializer omits a required field.\n\nHow to fix: add the missing field initializer."
        "E3023" -> "E3023: duplicate initializer field\n\nA struct initializer sets the same field more than once.\n\nHow to fix: keep only one initializer for each field."
        "E3024" -> "E3024: inconsistent array element type\n\nArray elements have incompatible types.\n\nHow to fix: make all elements match the expected array element type."
        "E3025" -> "E3025: invalid array push\n\nA push operation uses an invalid receiver or value type.\n\nHow to fix: call push on an array-like value with an element of the correct type."
        "E4000" -> "E4000: semantic error\n\nSemantic analysis failed, but the exact case does not have a more specific code.\n\nHow to fix: read the diagnostic and correct the program-level rule violation."
        "E4001" -> "E4001: missing main function\n\nThe program has no main function where one is required.\n\nHow to fix: define fn main with the expected signature."
        "E4002" -> "E4002: invalid main function\n\nThe main function exists but does not satisfy entry-point requirements.\n\nHow to fix: adjust main to the required parameters and return type."
        "W4000" -> "W4000: semantic warning\n\nThe compiler found a semantic issue that does not stop compilation.\n\nHow to fix: read the warning and simplify or correct the code if appropriate."
        "W4001" -> "W4001: unused variable\n\nA variable is declared but never used.\n\nHow to fix: remove it, use it, or rename it according to the project's convention for intentionally unused bindings."
        "W4002" -> "W4002: missing main function warning\n\nThe current mode allowed compilation to continue, but no main function was found.\n\nHow to fix: add main when building an executable."
        "W4003" -> "W4003: invalid main function warning\n\nThe current mode allowed compilation to continue, but main does not look like a valid entry point.\n\nHow to fix: adjust main to the required signature before building an executable."
        _ -> ""
    }
}

pub fn diag_error_level(): i32 { return 0 }
pub fn diag_warning_level(): i32 { return 1 }

pub fn diagnostic_level_is_warning(level: i32): i32
{
    if (level == diag_warning_level()) { return 1 }
    return 0
}

pub type Diagnostic = struct {
    code: string,
    level: i32,
    error_type: string,
    message: string,
    line: i32,
    col: i32,
    span_len: i32,
    func_name: string
}

pub fn diagnostic_new(code: string, level: i32, error_type: string, message: string): Diagnostic
{
    return Diagnostic{ code: code, level: level, error_type: error_type, message: message, line: 0, col: 0, span_len: 1, func_name: "" }
}

pub fn source_get_line(src: string, target_line: i32): string
{
    if (target_line <= 0) { return "" }
    let src_len = diag_strlen(src)
    let mut current = 1
    let mut line_start = 0
    let mut found = 0
    let mut i = 0

    while (i < src_len)
    {
        if (current == target_line)
        {
            line_start = i
            found = 1
            break
        }
        if (src[i] == 10)
        {
            current += 1
            if (current == target_line)
            {
                line_start = i + 1
                found = 1
                break
            }
        }
        i += 1
    }

    if (found == 0)
    {
        if (current == target_line and target_line == 1)
        {
            line_start = 0
            found = 1
        }
        elif (current == target_line and src_len > 0 and src[src_len - 1] == 10)
        {
            line_start = src_len
            found = 1
        }
        else
        {
            return ""
        }
    }

    let mut end = line_start
    while (end < src_len and src[end] != 10)
    {
        end += 1
    }
    let mut len = end - line_start
    if (len > 0 and src[end - 1] == 13) { len = len - 1 }

    let buf: string = malloc(len + 1)
    for (line_i in 0 .. len)
    {
        buf[line_i] = src[line_start + line_i]
    }
    buf[len] = '\0'
    return buf
}

pub fn expand_tabs(line: string): string
{
    let mut out = ""
    let mut col = 1
    let line_len = diag_strlen(line)
    for (i in 0 .. line_len)
    {
        if (line[i] == 9)
        {
            let next_stop = ((col - 1) / 8 + 1) * 8 + 1
            while (col < next_stop)
            {
                out = out + " "
                col += 1
            }
        }
        else
        {
            out = out + char_string(line[i])
            col += 1
        }
    }
    return out
}

pub fn format_highlighted_line(line: string, col: i32, length: i32, color: string): string
{
    let expanded = expand_tabs(line)
    let line_len = diag_strlen(expanded)
    let safe_col = if (col <= 0) { 1 } else { col }
    let safe_len = if (length <= 0) { 1 } else { length }
    let effective_col = if (safe_col > line_len) { line_len } else { safe_col }

    let start = effective_col - 1
    let mut end = start + safe_len
    if (end > line_len) { end = line_len }
    if (end < start) { end = start }

    let mut out = ""
    let mut i = 0
    while (i < start)
    {
        out = out + char_string(expanded[i])
        i += 1
    }
    out = out + color + diag_bold()
    while (i < end)
    {
        out = out + char_string(expanded[i])
        i += 1
    }
    out = out + diag_reset()
    while (i < line_len)
    {
        out = out + char_string(expanded[i])
        i += 1
    }
    return out
}

pub fn format_caret_line(line: string, col: i32, length: i32, color: string): string
{
    let expanded = expand_tabs(line)
    let line_len = diag_strlen(expanded)
    let safe_col = if (col <= 0) { 1 } else { col }
    let mut safe_len = if (length <= 0) { 1 } else { length }
    let effective_col = if (safe_col > line_len) { line_len + 1 } else { safe_col }
    let max_len = line_len - effective_col + 1
    if (max_len > 0 and safe_len > max_len) { safe_len = max_len }
    if (safe_len <= 0) { safe_len = 1 }

    let mut out = ""
    for (__c in 0 .. effective_col - 1)
    {
        out = out + " "
    }
    out = out + color + diag_bold()
    for (__i in 0 .. safe_len)
    {
        out = out + "^"
    }
    out = out + diag_reset()
    return out
}

pub fn line_number_width(line: i32): i32
{
    if (line <= 0) { return 1 }
    let mut width = 1
    let mut n = line + 1
    while (n >= 10)
    {
        n = n / 10
        width += 1
    }
    return width
}

pub fn i32_digit_width(n: i32): i32
{
    if (n <= 0) { return 1 }
    let mut width = 1
    let mut value = n
    while (value >= 10)
    {
        value = value / 10
        width += 1
    }
    return width
}

pub fn line_num_str(line: i32, width: i32): string
{
    let num = i32_to_str(line)
    let padding = width - i32_digit_width(line)
    let mut out = ""
    for (__p in 0 .. padding)
    {
        out = out + " "
    }
    return out + num
}

pub fn line_blank_str(width: i32): string
{
    let mut out = ""
    for (__w in 0 .. width)
    {
        out = out + " "
    }
    return out
}

pub fn show_source_context(src: string, line: i32, col: i32, length: i32, level: i32): string
{
    if (line <= 0 or src == "") { return "" }

    let width = line_number_width(line)
    let is_warning = diagnostic_level_is_warning(level)
    let highlight_color = if (is_warning == 1) { diag_yellow() } else { diag_red() }
    let gutter = diag_dim()
    let reset = diag_reset()
    let mut out = ""

    out = out + gutter + line_blank_str(width) + " |" + reset + "\n"

    if (line > 1)
    {
        let prev = source_get_line(src, line - 1)
        if (prev != "")
        {
            out = out + gutter + line_num_str(line - 1, width) + " | " + reset + prev + "\n"
        }
    }

    let err_line = source_get_line(src, line)
    if (err_line != "")
    {
        out = out + diag_bold() + line_num_str(line, width) + gutter + " |" + reset + " "
        out = out + format_highlighted_line(err_line, col, length, highlight_color)
        out = out + "\n"

        out = out + gutter + line_blank_str(width) + " |" + reset + " "
        out = out + format_caret_line(err_line, col, length, highlight_color)
        out = out + "\n"
    }

    let next = source_get_line(src, line + 1)
    if (next != "")
    {
        out = out + gutter + line_num_str(line + 1, width) + " | " + reset + next + "\n"
    }

    out = out + gutter + line_blank_str(width) + " |" + reset + "\n"
    return out
}

pub fn format_header(level: i32, error_type: string, message: string): string
{
    let is_warning = diagnostic_level_is_warning(level)
    let level_text = if (is_warning == 1) { "warning" } else { "error" }
    let level_color = if (is_warning == 1) { diag_yellow() } else { diag_red() }
    let type_color = match error_type {
        "ParseError" -> diag_magenta()
        "TypeError" -> diag_blue()
        "NameError" -> diag_cyan()
        "SemanticError" -> diag_yellow()
        "SemanticWarning" -> diag_yellow()
        _ -> diag_red()
    }
    let code = error_code_for_type(error_type, message)

    let mut out = level_color + diag_bold() + level_text + diag_reset()
    out = out + " " + diag_dim() + "[" + type_color + error_type + "(" + code + ")" + diag_reset() + diag_dim() + "]" + diag_reset()
    out = out + ": " + message + "\n"
    return out
}

pub fn format_diagnostic(src: string, filename: string, level: i32, error_type: string, message: string, line: i32, col: i32, length: i32): string
{
    let mut out = format_header(level, error_type, message)
    if (filename != "" and line > 0)
    {
        out = out + line_blank_str(line_number_width(line)) + diag_blue() + "-->" + diag_reset() + " " + filename + ":" + i32_to_str(line) + ":" + i32_to_str(col) + "\n"
        out = out + show_source_context(src, line, col, length, level)
    }
    return out
}

pub fn format_diagnostic_no_loc(level: i32, error_type: string, message: string, filename: string): string
{
    let mut out = format_header(level, error_type, message)
    if (filename != "")
    {
        out = out + "  " + diag_blue() + "-->" + diag_reset() + " " + filename + "\n"
    }
    return out
}
