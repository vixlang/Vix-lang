#[no_main]

extern "C"
{
    fn malloc(size: usize): string
    fn snprintf(buf: string, size: usize, fmt: string, ...): i32
    fn atof(text: string): f64
    fn fopen(filename: ptr, mode: ptr): ptr
    fn fclose(file: ptr): i32
    fn fread(buf: ptr, size: i64, count: i64, file: ptr): i64
    fn fseek(file: ptr, offset: i64, whence: i32): i32
    fn ftell(file: ptr): i64
}

pub fn i32_to_str(n: i32): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%d", n)
    return buf
}

pub fn f64_to_str(n: f64): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%g", n)
    return buf
}

pub fn tk_ident(): i32 { return 1 }
pub fn tk_number(): i32 { return 2 }
pub fn tk_keyword(): i32 { return 3 }
pub fn tk_symbol(): i32 { return 4 }
pub fn tk_string(): i32 { return 5 }
pub fn tk_eof(): i32 { return 6 }
pub fn tk_bool(): i32 { return 7 }
pub fn tk_float(): i32 { return 8 }

pub type TokenStream = struct {
    kinds: [i32],
    texts: [string],
    ints: [i32],
    floats: [f64],
    lines: [i32],
    columns: [i32]
}

pub fn stream_new(): TokenStream
{
    return TokenStream{ kinds: [], texts: [], ints: [], floats: [], lines: [], columns: [] }
}

pub fn stream_push(stream: &TokenStream, kind: i32, text: string, int_value: i32, line: i32, column: i32)
{
    stream_push_full(stream, kind, text, int_value, 0.0, line, column)
}

pub fn stream_push_full(stream: &TokenStream, kind: i32, text: string, int_value: i32, float_value: f64, line: i32, column: i32)
{
    stream.kinds.push(kind)
    stream.texts.push(text)
    stream.ints.push(int_value)
    stream.floats.push(float_value)
    stream.lines.push(line)
    stream.columns.push(column)
}

pub fn stream_len(stream: &TokenStream): i32
{
    return stream.kinds.length
}

pub fn stream_kind_at(stream: &TokenStream, index: i32): i32
{
    return stream.kinds[index]
}

pub fn stream_text_at(stream: &TokenStream, index: i32): string
{
    return stream.texts[index]
}

pub fn stream_int_at(stream: &TokenStream, index: i32): i32
{
    return stream.ints[index]
}

pub fn stream_float_at(stream: &TokenStream, index: i32): f64
{
    return stream.floats[index]
}

pub fn stream_line_at(stream: &TokenStream, index: i32): i32
{
    return stream.lines[index]
}

pub fn stream_col_at(stream: &TokenStream, index: i32): i32
{
    return stream.columns[index]
}

pub fn peek_char(src: string, pos: i32): ?i8
{
    if (pos < 0 or src.length <= pos)
    {
        return None
    }
    return Some(src[pos])
}
pub fn is_alpha(c: i8): i32
{
    if ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_') { return 1 }
    return 0
}

pub fn is_digit(c: i8): i32
{
    if (c >= '0' and c <= '9') { return 1 }
    return 0
}

pub fn is_ident(c: i8): i32
{
    if (is_alpha(c) == 1 or is_digit(c) == 1) { return 1 }
    return 0
}

pub fn char_string(c: i8): string
{
    let s: string = malloc(2)
    s[0] = c
    s[1] = 0
    return s
}

pub fn token_can_end_statement(kind: i32, text: string): i32
{
    if (kind == tk_ident() or kind == tk_number() or kind == tk_float() or kind == tk_string() or kind == tk_bool()) { return 1 }
    if (text == ")" or text == "]" or text == "}" or text == "break" or text == "continue" or text == "return") { return 1 }
    return 0
}

pub fn next_non_space_char(src: string, pos: i32): ?i8
{
    let mut i = pos
    while (i < src.length)
    {
        if (src[i] == 32 or src[i] == 9 or src[i] == 13 or src[i] == 10)
        {
            i += 1
        }
        elif (src[i] == '/' and i + 1 < src.length and src[i + 1] == '/')
        {
            while (i < src.length and src[i] != 10) { i += 1 }
        }
        else
        {
            return Some(src[i])
        }
    }
    return None
}

pub fn newline_should_insert_semicolon(src: string, pos: i32, stream: &TokenStream): i32
{
    if (stream_len(stream) == 0) { return 0 }
    let last = stream_len(stream) - 1
    if (token_can_end_statement(stream_kind_at(stream, last), stream_text_at(stream, last)) == 0) { return 0 }
    return match next_non_space_char(src, pos) {
        Some(c) -> {
            if (c == '}' or c == '"' or is_alpha(c) == 1 or is_digit(c) == 1)
            {
                1
            }
            else
            {
                0
            }
        }
        None -> 0
    }
}

pub fn is_keyword(text: string): i32
{
    if (text == "fn" or text == "return" or text == "let" or text == "mut" or text == "if" or text == "elif" or text == "else" or text == "while" or text == "for" or text == "in") { return 1 }
    if (text == "match" or text == "struct" or text == "type" or text == "pub" or text == "import" or text == "extern" or text == "break" or text == "continue") { return 1 }
    if (text == "i32" or text == "i64" or text == "i8" or text == "f32" or text == "f64" or text == "string" or text == "void" or text == "nil" or text == "true" or text == "false") { return 1 }
    if (text == "and" or text == "or" or text == "print") { return 1 }
    return 0
}

pub fn tokenize(src: string): TokenStream
{
    let stream = stream_new()
    let mut pos = 0
    let mut line = 1
    let mut column = 1

    while (pos < src.length)
    {
        match peek_char(src, pos)
        {
            Some(c) -> {
                if (c == 32 or c == 13)
                {
                    pos += 1
                    column += 1
                }
                elif (c == 9)
                {
                    pos += 1
                    column = ((column - 1) / 8 + 1) * 8 + 1
                }
                elif (c == 10)
                {
                    pos += 1
                    if (newline_should_insert_semicolon(src, pos, &stream) == 1)
                    {
                        stream_push(&stream, tk_symbol(), ";", 0, line, column)
                    }
                    line += 1
                    column = 1
                }
                elif (c == '/' and pos + 1 < src.length and src[pos + 1] == '/')
                {
                    while (pos < src.length and src[pos] != 10)
                    {
                        pos += 1
                        column += 1
                    }
                }
                elif (is_alpha(c) == 1)
                {
                    let start_col = column
                    let mut text = ""
                    while (pos < src.length and is_ident(src[pos]) == 1)
                    {
                        text = text + char_string(src[pos])
                        pos += 1
                        column += 1
                    }
                    if (text == "true")
                    {
                        stream_push(&stream, tk_bool(), text, 1, line, start_col)
                    }
                    elif (text == "false")
                    {
                        stream_push(&stream, tk_bool(), text, 0, line, start_col)
                    }
                    elif (is_keyword(text) == 1)
                    {
                        stream_push(&stream, tk_keyword(), text, 0, line, start_col)
                    }
                    else
                    {
                        stream_push(&stream, tk_ident(), text, 0, line, start_col)
                    }
                }
                elif (is_digit(c) == 1)
                {
                    let start_col = column
                    let mut value = 0
                    let mut text = ""
                    while (pos < src.length and is_digit(src[pos]) == 1)
                    {
                        value = value * 10 + (src[pos] - '0')
                        text = text + char_string(src[pos])
                        pos += 1
                        column += 1
                    }
                    if (pos < src.length and src[pos] == '.' and pos + 1 < src.length and is_digit(src[pos + 1]) == 1)
                    {
                        text = text + "."
                        pos += 1
                        column += 1
                        while (pos < src.length and is_digit(src[pos]) == 1)
                        {
                            text = text + char_string(src[pos])
                            pos += 1
                            column += 1
                        }
                        stream_push_full(&stream, tk_float(), text, 0, atof(text), line, start_col)
                    }
                    else
                    {
                        stream_push(&stream, tk_number(), "", value, line, start_col)
                    }
                }
                elif (c == 39)
                {
                    let start_col = column
                    pos += 1
                    column += 1
                    let mut value: i32 = 0
                    if (pos < src.length)
                    {
                        if (src[pos] == 92 and pos + 1 < src.length)
                        {
                            let next = src[pos + 1]
                            if (next == '0' and pos + 3 < src.length and src[pos + 2] == '3' and src[pos + 3] == '3')
                            {
                                value = 27
                                pos += 4
                                column += 4
                            }
                            else
                            {
                                value = match next {
                                    'n' -> 10
                                    't' -> 9
                                    'r' -> 13
                                    '0' -> 0
                                    92 -> 92
                                    39 -> 39
                                    '"' -> 34
                                    _ -> next
                                }
                                pos += 2
                                column += 2
                            }
                        }
                        else
                        {
                            value = src[pos]
                            pos += 1
                            column += 1
                        }
                    }
                    if (pos < src.length and src[pos] == 39)
                    {
                        pos += 1
                        column += 1
                    }
                    stream_push(&stream, tk_number(), "", value, line, start_col)
                }
                elif (c == '"')
                {
                    let start_col = column
                    let mut text = ""
                    pos += 1
                    column += 1
                    while (pos < src.length and src[pos] != '"')
                    {
                        if (src[pos] == 92 and pos + 1 < src.length)
                        {
                            let next = src[pos + 1]
                            if (next == '0' and pos + 3 < src.length and src[pos + 2] == '3' and src[pos + 3] == '3')
                            {
                                text = text + char_string(27)
                                pos += 4
                                column += 4
                            }
                            else
                            {
                                text = text + match next {
                                    'n' -> char_string(10)
                                    't' -> char_string(9)
                                    92 -> char_string(92)
                                    '"' -> char_string('"')
                                    _ -> char_string(next)
                                }
                                pos += 2
                                column += 2
                            }
                        }
                        else
                        {
                            text = text + char_string(src[pos])
                            pos += 1
                            column += 1
                        }
                    }
                    if (pos < src.length and src[pos] == '"')
                    {
                        pos += 1
                        column += 1
                    }
                    stream_push(&stream, tk_string(), text, 0, line, start_col)
                }
                elif (c == '=' and pos + 1 < src.length and src[pos + 1] == '>')
                {
                    stream_push(&stream, tk_symbol(), "=>", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '=' and pos + 1 < src.length and src[pos + 1] == '=')
                {
                    stream_push(&stream, tk_symbol(), "==", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '!' and pos + 1 < src.length and src[pos + 1] == '=')
                {
                    stream_push(&stream, tk_symbol(), "!=", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '<' and pos + 1 < src.length and src[pos + 1] == '=')
                {
                    stream_push(&stream, tk_symbol(), "<=", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '<' and pos + 1 < src.length and src[pos + 1] == '<')
                {
                    stream_push(&stream, tk_symbol(), "<<", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '>' and pos + 1 < src.length and src[pos + 1] == '=')
                {
                    stream_push(&stream, tk_symbol(), ">=", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '>' and pos + 1 < src.length and src[pos + 1] == '>')
                {
                    stream_push(&stream, tk_symbol(), ">>", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '+' and pos + 1 < src.length and src[pos + 1] == '=')
                {
                    stream_push(&stream, tk_symbol(), "+=", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '-' and pos + 1 < src.length and src[pos + 1] == '=')
                {
                    stream_push(&stream, tk_symbol(), "-=", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '-' and pos + 1 < src.length and src[pos + 1] == '>')
                {
                    stream_push(&stream, tk_symbol(), "->", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '*' and pos + 1 < src.length and src[pos + 1] == '*')
                {
                    stream_push(&stream, tk_symbol(), "**", 0, line, column)
                    pos += 2
                    column += 2
                }
                elif (c == '.' and pos + 2 < src.length and src[pos + 1] == '.' and src[pos + 2] == '.')
                {
                    stream_push(&stream, tk_symbol(), "...", 0, line, column)
                    pos += 3
                    column += 3
                }
                elif (c == '.' and pos + 1 < src.length and src[pos + 1] == '.')
                {
                    stream_push(&stream, tk_symbol(), "..", 0, line, column)
                    pos += 2
                    column += 2
                }
                else
                {
                    stream_push(&stream, tk_symbol(), char_string(c), 0, line, column)
                    pos += 1
                    column += 1
                }
            }
            None -> pos = src.length
        }
    }

    stream_push(&stream, tk_eof(), "", 0, line, column)
    return stream
}

pub fn tokenize_debug(src: string): string
{
    let stream = tokenize(src)
    let mut out = ""
    for (i in 0 .. stream_len(stream))
    {
        let kind = stream_kind_at(stream, i)
        let text = stream_text_at(stream, i)
        if (kind == tk_number())
        {
            out = out + "Token(kind=number, int=" + i32_to_str(stream_int_at(stream, i)) + ")\n"
        }
        elif (kind == tk_float())
        {
            out = out + "Token(kind=float, text='" + text + "', value=" + f64_to_str(stream_float_at(stream, i)) + ")\n"
        }
        elif (kind == tk_bool())
        {
            out = out + "Token(kind=bool, text='" + text + "', value=" + i32_to_str(stream_int_at(stream, i)) + ")\n"
        }
        elif (kind == tk_ident())
        {
            out = out + "Token(kind=ident, text='" + text + "')\n"
        }
        elif (kind == tk_keyword())
        {
            out = out + "Token(kind=keyword, text='" + text + "')\n"
        }
        elif (kind == tk_symbol())
        {
            out = out + "Token(kind=symbol, text='" + text + "')\n"
        }
        elif (kind == tk_string())
        {
            out = out + "Token(kind=string, text='" + text + "')\n"
        }
        else
        {
            out = out + "Token(kind=eof)\n"
        }
    }
    return out
}
