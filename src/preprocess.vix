#[no_main]
import "lexer.vix"

pub type ImportSet = struct {
    paths: [string]
}

pub type MacroSet = struct {
    names: [string],
    params: [string],
    repeat_params: [i32],
    repeat_param_names: [string],
    bracket_calls: [i32],
    bodies: [string]
}

pub fn import_set_new(): ImportSet
{
    return ImportSet{ paths: [] }
}

pub fn macro_set_new(): MacroSet
{
    return MacroSet{ names: [], params: [], repeat_params: [], repeat_param_names: [], bracket_calls: [], bodies: [] }
}

pub fn macro_set_add(macros: &MacroSet, name: string, param: string, repeat_param: i32, repeat_param_name: string, bracket_call: i32, body: string)
{
    macros.names.push(name)
    macros.params.push(param)
    macros.repeat_params.push(repeat_param)
    macros.repeat_param_names.push(repeat_param_name)
    macros.bracket_calls.push(bracket_call)
    macros.bodies.push(body)
}

pub fn macro_set_find(macros: &MacroSet, name: string): i32
{
    let mut found = -1
    for (i in 0 .. macros.names.length)
    {
        if (macros.names[i] == name) { found = i }
    }
    return found
}

pub fn import_set_contains(imports: &ImportSet, path: string): i32
{
    for (i in 0 .. imports.paths.length)
    {
        if (imports.paths[i] == path) { return 1 }
    }
    return 0
}

pub fn import_set_add(imports: &ImportSet, path: string)
{
    if (import_set_contains(imports, path) == 1) { return }
    imports.paths.push(path)
}

pub fn read_file_content(path: string): string
{
    let file = fopen(path, "r")
    if (file == 0) { return "" }
    fseek(file, 0, 2)
    let size = ftell(file)
    fseek(file, 0, 0)
    let buf = malloc(size + 1)
    let n = fread(buf, 1, size, file)
    buf[n] = 0
    fclose(file)
    return buf
}

pub fn resolve_import_path(importer: string, import_path: string): string
{
    let mut last_slash = -1
    for (i in 0 .. importer.length)
    {
        if (importer[i] == '/') { last_slash = i }
    }
    if (last_slash < 0)
    {
        return import_path
    }
    let mut dir = ""
    for (i in 0 .. (last_slash + 1))
    {
        dir = dir + char_string(importer[i])
    }
    return dir + import_path
}

pub fn skip_attr_line(src: string, start: i32): i32
{
    let mut i = start
    while (i < src.length and src[i] != ']') { i += 1 }
    if (i < src.length) { i += 1 }
    let mut done = 0
    while (i < src.length and done == 0)
    {
        if (src[i] == 10)
        {
            i += 1
            done = 1
        }
        elif (src[i] != 32 and src[i] != 9 and src[i] != 13)
        {
            done = 1
        }
        else
        {
            i += 1
        }
    }
    return i
}

pub fn scan_import_line(src: string, start: i32): i32
{
    if (start > 0)
    {
        let mut j = start - 1
        while (j >= 0 and src[j] != 10)
        {
            if (src[j] != 32 and src[j] != 9 and src[j] != 13) { return -1 }
            j -= 1
        }
    }
    let mut i = start
    if (i + 6 > src.length) { return -1 }
    let keyword = "import"
    for (k in 0 .. 6)
    {
        if (src[i + k] != keyword[k]) { return -1 }
    }
    i += 6
    while (i < src.length and (src[i] == 32 or src[i] == 9)) { i += 1 }
    if (i >= src.length or src[i] != '"') { return -1 }
    i += 1
    while (i < src.length and src[i] != 10 and src[i] != '"') { i += 1 }
    if (i >= src.length or src[i] != '"') { return -1 }
    i += 1
    while (i < src.length and src[i] != 10) { i += 1 }
    if (i < src.length) { i += 1 }
    return i
}

pub fn extract_import_path(src: string, start: i32): string
{
    let mut i = start + 6
    while (i < src.length and (src[i] == 32 or src[i] == 9)) { i += 1 }
    if (i >= src.length or src[i] != '"') { return "" }
    i += 1
    let mut path = ""
    while (i < src.length and src[i] != '"')
    {
        path = path + char_string(src[i])
        i += 1
    }
    return path
}

pub fn slice_text(src: string, start: i32, end: i32): string
{
    let len = end - start
    let out = malloc(len + 4)
    let mut j = 0
    for (i in start .. end)
    {
        out[j] = src[i]
        j += 1
    }
    out[len] = 0
    return out
}

pub fn newline_padding(src: string, start: i32, end: i32): string
{
    let mut out = ""
    for (i in start .. end)
    {
        if (src[i] == 10) { out = out + char_string(10) }
    }
    return out
}

pub fn trim_text(src: string): string
{
    let mut start = 0
    while (start < src.length and is_space_or_newline(src[start]) == 1) { start += 1 }
    let mut end = src.length
    while (end > start and is_space_or_newline(src[end - 1]) == 1) { end -= 1 }
    return slice_text(src, start, end)
}

pub fn is_space_or_newline(c: i8): i32
{
    if (c == 32 or c == 9 or c == 10 or c == 13) { return 1 }
    return 0
}

pub fn is_macro_ident_char(c: i8): i32
{
    if (is_alpha(c) == 1 or is_digit(c) == 1 or c == '_') { return 1 }
    return 0
}

pub fn skip_spaces(src: string, start: i32): i32
{
    let mut i = start
    while (i < src.length and is_space_or_newline(src[i]) == 1) { i += 1 }
    return i
}

pub fn text_at(src: string, start: i32, text: string): i32
{
    if (start < 0 or start + text.length > src.length) { return 0 }
    for (i in 0 .. text.length)
    {
        if (src[start + i] != text[i]) { return 0 }
    }
    return 1
}

pub fn scan_balanced(src: string, start: i32, open_ch: i8, close_ch: i8): i32
{
    if (start >= src.length or src[start] != open_ch) { return -1 }
    let mut depth = 1
    let mut i = start + 1
    while (i < src.length and depth > 0)
    {
        if (src[i] == '"')
        {
            i += 1
            while (i < src.length and src[i] != '"')
            {
                if (src[i] == 92 and i + 1 < src.length) { i += 2 }
                else { i += 1 }
            }
        }
        elif (src[i] == open_ch)
        {
            depth += 1
        }
        elif (src[i] == close_ch)
        {
            depth -= 1
        }
        i += 1
    }
    if (depth == 0) { return i }
    return -1
}

pub fn top_level_comma(src: string): i32
{
    let mut paren_depth = 0
    let mut bracket_depth = 0
    let mut brace_depth = 0
    let mut i = 0
    while (i < src.length)
    {
        if (src[i] == '"')
        {
            i += 1
            while (i < src.length and src[i] != '"')
            {
                if (src[i] == 92 and i + 1 < src.length) { i += 2 }
                else { i += 1 }
            }
        }
        elif (src[i] == '(') { paren_depth += 1 }
        elif (src[i] == ')') { paren_depth -= 1 }
        elif (src[i] == '[') { bracket_depth += 1 }
        elif (src[i] == ']') { bracket_depth -= 1 }
        elif (src[i] == '{') { brace_depth += 1 }
        elif (src[i] == '}') { brace_depth -= 1 }
        elif (src[i] == ',' and paren_depth == 0 and bracket_depth == 0 and brace_depth == 0)
        {
            return i
        }
        i += 1
    }
    return -1
}

pub fn first_macro_arg(arg_text: string): string
{
    let comma = top_level_comma(arg_text)
    if (comma < 0) { return trim_text(arg_text) }
    return trim_text(slice_text(arg_text, 0, comma))
}

pub fn rest_macro_args(arg_text: string): string
{
    let comma = top_level_comma(arg_text)
    if (comma < 0) { return "" }
    return trim_text(slice_text(arg_text, comma + 1, arg_text.length))
}

pub fn macro_repeat_param_name(params_text: string, fallback: string): string
{
    let mut p = 0
    while (p + 1 < params_text.length)
    {
        if (params_text[p] == '$' and params_text[p + 1] == '(')
        {
            p += 2
            while (p < params_text.length and is_space_or_newline(params_text[p]) == 1) { p += 1 }
            let start = p
            while (p < params_text.length and is_macro_ident_char(params_text[p]) == 1) { p += 1 }
            if (p > start) { return slice_text(params_text, start, p) }
        }
        p += 1
    }
    p = 0
    while (p < params_text.length)
    {
        if (params_text[p] == '*') { return fallback }
        p += 1
    }
    return ""
}

pub fn remove_trailing_macro_separator(text: string): string
{
    let mut end = text.length
    while (end > 0)
    {
        let prev = end - 1
        if (text[prev] == 32 or text[prev] == 9 or text[prev] == 13 or text[prev] == 10)
        {
            end -= 1
        }
        else
        {
            break
        }
    }
    if (end > 0)
    {
        let comma_pos = end - 1
        if (text[comma_pos] == ',')
        {
            return slice_text(text, 0, comma_pos)
        }
    }
    return text
}

pub fn skip_macro_definition(src: string, start: i32, macros: &MacroSet): i32
{
    if (text_at(src, start, "macro") == 0) { return -1 }
    if (start > 0 and is_macro_ident_char(src[start - 1]) == 1) { return -1 }
    if (start + 5 < src.length and is_macro_ident_char(src[start + 5]) == 1) { return -1 }

    let mut i = skip_spaces(src, start + 5)
    if (i < src.length and src[i] == '$') { i += 1 }
    let name_start = i
    while (i < src.length and is_macro_ident_char(src[i]) == 1) { i += 1 }
    if (i == name_start) { return -1 }
    let name = slice_text(src, name_start, i)
    let mut bracket_call = 0
    if (i < src.length and src[i] == '!')
    {
        bracket_call = 1
        i += 1
    }
    i = skip_spaces(src, i)
    let open_ch = if (i < src.length and src[i] == '[') { '[' } else { '(' }
    let close_ch = if (open_ch == '[') { ']' } else { ')' }
    if (open_ch == '[') { bracket_call = 1 }
    let params_end = scan_balanced(src, i, open_ch, close_ch)
    if (params_end < 0) { return -1 }
    let params_text = slice_text(src, i + 1, params_end - 1)
    let mut param = ""
    let mut repeat_param = 0
    let mut p = 0
    while (p < params_text.length and is_space_or_newline(params_text[p]) == 1) { p += 1 }
    let param_start = p
    while (p < params_text.length and is_macro_ident_char(params_text[p]) == 1) { p += 1 }
    if (p > param_start) { param = slice_text(params_text, param_start, p) }
    while (p < params_text.length)
    {
        if (params_text[p] == '*') { repeat_param = 1 }
        p += 1
    }
    let repeat_param_name = macro_repeat_param_name(params_text, param)
    if (repeat_param == 1 and repeat_param_name == param) { param = "" }

    i = skip_spaces(src, params_end)
    let body_end = scan_balanced(src, i, '{', '}')
    if (body_end < 0) { return -1 }
    let body = slice_text(src, i + 1, body_end - 1)
    macro_set_add(macros, name, param, repeat_param, repeat_param_name, bracket_call, body)
    return body_end
}

pub fn replace_macro_param(body: string, param: string, arg: string, repeat_param: i32, repeat_param_name: string, repeat_arg: string): string
{
    let mut out = ""
    let mut i = 0
    let spread_pat = "$(" + repeat_param_name + "),*"
    let paren_spread_pat = "$((" + repeat_param_name + "),*)"
    let plain_pat = "$" + param
    while (i < body.length)
    {
        if (repeat_param == 1 and text_at(body, i, paren_spread_pat) == 1)
        {
            out = out + repeat_arg
            i += paren_spread_pat.length
        }
        elif (repeat_param == 1 and text_at(body, i, spread_pat) == 1)
        {
            if (repeat_arg == "")
            {
                out = remove_trailing_macro_separator(out)
            }
            else
            {
                out = out + repeat_arg
            }
            i += spread_pat.length
        }
        elif (param != "" and text_at(body, i, plain_pat) == 1)
        {
            out = out + arg
            i += plain_pat.length
        }
        else
        {
            out = out + char_string(body[i])
            i += 1
        }
    }
    return out
}

pub fn macro_expansion_is_item(text: string): i32
{
    let i = skip_spaces(text, 0)
    if (text_at(text, i, "fn ") == 1) { return 1 }
    if (text_at(text, i, "pub fn ") == 1) { return 1 }
    if (text_at(text, i, "type ") == 1) { return 1 }
    if (text_at(text, i, "pub type ") == 1) { return 1 }
    if (text_at(text, i, "extern") == 1) { return 1 }
    return 0
}

pub fn expand_macros_once(src: string, macros: &MacroSet): string
{
    let mut out = ""
    let mut hoisted = ""
    let mut i = 0
    let mut segment_start = 0
    let mut changed = 0
    while (i < src.length)
    {
        if (src[i] == '"')
        {
            i += 1
            while (i < src.length and src[i] != '"')
            {
                if (src[i] == 92 and i + 1 < src.length) { i += 2 }
                else { i += 1 }
            }
            if (i < src.length) { i += 1 }
            continue
        }
        elif (src[i] == '$' and i + 1 < src.length and is_macro_ident_char(src[i + 1]) == 1)
        {
            let name_start = i + 1
            let mut name_end = name_start
            while (name_end < src.length and is_macro_ident_char(src[name_end]) == 1) { name_end += 1 }
            let name = slice_text(src, name_start, name_end)
            let macro_idx = macro_set_find(macros, name)
            if (macro_idx >= 0)
            {
                let mut call_pos = skip_spaces(src, name_end)
                let open_ch = if (macros.bracket_calls[macro_idx] == 1) { '[' } else { '(' }
                let close_ch = if (open_ch == '[') { ']' } else { ')' }
                if (call_pos < src.length and src[call_pos] == open_ch)
                {
                    let call_end = scan_balanced(src, call_pos, open_ch, close_ch)
                    if (call_end > call_pos)
                    {
                        let arg_text = slice_text(src, call_pos + 1, call_end - 1)
                        let mut normal_arg = trim_text(arg_text)
                        let mut repeat_arg = trim_text(arg_text)
                        if (macros.repeat_params[macro_idx] == 1 and macros.params[macro_idx] != "")
                        {
                            normal_arg = first_macro_arg(arg_text)
                            repeat_arg = rest_macro_args(arg_text)
                        }
                        let replacement = replace_macro_param(macros.bodies[macro_idx], macros.params[macro_idx], normal_arg, macros.repeat_params[macro_idx], macros.repeat_param_names[macro_idx], repeat_arg)
                        if (segment_start < i)
                        {
                            out = out + slice_text(src, segment_start, i)
                        }
                        if (macro_expansion_is_item(replacement) == 1)
                        {
                            hoisted = hoisted + replacement + "\n"
                        }
                        else
                        {
                            out = out + replacement
                        }
                        i = call_end
                        segment_start = i
                        changed = 1
                        continue
                    }
                }
            }
        }
        i += 1
    }
    if (changed == 0 and hoisted == "") { return src }
    if (segment_start < src.length)
    {
        out = out + slice_text(src, segment_start, src.length)
    }
    if (hoisted != "") { return hoisted + out }
    return out
}

pub fn expand_macros(src: string, macros: &MacroSet): string
{
    let mut expanded = src
    for (_round in 0 .. 8)
    {
        let next = expand_macros_once(expanded, macros)
        if (next == expanded) { return expanded }
        expanded = next
    }
    return expanded
}

pub fn preprocess_source_with_macros(src: string, filename: string, imports: &ImportSet, macros: &MacroSet): string
{
    import_set_add(imports, filename)
    let mut out = ""
    let mut i = 0
    let mut segment_start = 0
    
    while (i < src.length)
    {
        if (src[i] == '#' and i + 1 < src.length and src[i + 1] == '[')
        {
            if (segment_start < i)
            {
                out = out + slice_text(src, segment_start, i)
            }
            i = skip_attr_line(src, i)
            segment_start = i
            continue
        }

        let macro_end = skip_macro_definition(src, i, macros)
        if (macro_end > i)
        {
            if (segment_start < i)
            {
                out = out + slice_text(src, segment_start, i)
            }
            let skipped_start = i
            i = macro_end
            while (i < src.length and (src[i] == 10 or src[i] == 13)) { i += 1 }
            out = out + newline_padding(src, skipped_start, i)
            segment_start = i
            continue
        }
        
        let import_end = scan_import_line(src, i)
        if (import_end > i)
        {
            if (segment_start < i)
            {
                out = out + slice_text(src, segment_start, i)
            }
            let path = extract_import_path(src, i)
            if (path != "")
            {
                let resolved = resolve_import_path(filename, path)
                if (import_set_contains(imports, resolved) == 0)
                {
                    import_set_add(imports, resolved)
                    let content = read_file_content(resolved)
                    if (content != "")
                    {
                        let processed = preprocess_source_with_macros(content, resolved, imports, macros)
                        out = out + processed + "\n"
                    }
                }
            }
            i = import_end
            segment_start = i
            continue
        }
        
        i += 1
    }
    if (segment_start < src.length)
    {
        out = out + slice_text(src, segment_start, src.length)
    }
    return expand_macros(out, macros)
}

pub fn preprocess_source(src: string, filename: string, imports: &ImportSet): string
{
    let mut macros = macro_set_new()
    return preprocess_source_with_macros(src, filename, imports, &macros)
}
