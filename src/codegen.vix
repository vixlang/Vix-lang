#[no_main]
import "ast.vix"
import "builder.vix"
import "semantic.vix"

extern "C"
{
    fn vix_array_len(arr: ptr): i32
    fn vix_array_push_i32(arr: ptr, val: i32): ptr
    fn vix_array_push_ptr(arr: ptr, val: ptr): ptr
    fn vix_array_push_bytes(arr: ptr, val: ptr, elem_size: usize): ptr
}

pub fn codegen_type_is_numeric(ty: string): i32
{
    if (type_is_concrete_int(ty) == 1 or ty == "f32" or ty == "f64") { return 1 }
    return 0
}

pub fn codegen_type_is_float(ty: string): i32
{
    if (ty == "f32" or ty == "f64") { return 1 }
    return 0
}

pub fn codegen_type_is_pointer_like(ty: string): i32
{
    if (ty == "ptr" or ty == "string" or is_ptr_to_struct(ty) == 1 or type_text_is_array(ty) == 1 or type_text_is_option(ty) == 1) { return 1 }
    return 0
}

pub fn codegen_expected_type_accepts_null(ty: string): i32
{
    if (ty == "ptr" or ty == "string") { return 1 }
    if (ty.length > 0 and ty[0] == '[') { return 1 }
    if (ty.length > 3 and ty[0] == 'p' and ty[1] == 't' and ty[2] == 'r' and ty[3] == ':') { return 1 }
    if (ty.length > 6 and ty[0] == 'O' and ty[1] == 'p' and ty[2] == 't' and ty[3] == 'i' and ty[4] == 'o' and ty[5] == 'n' and ty[6] == '[') { return 1 }
    return 0
}

pub fn codegen_expr_type(b: &LlvmBuilder, es: &ExprStore, expr: AstExpr): string
{
    if (expr.tag == "int") { return "i32" }
    if (expr.tag == "float") { return "f64" }
    if (expr.tag == "bool") { return "bool" }
    if (expr.tag == "string") { return "string" }
    if (expr.tag == "ident") { return get_var_type(b, expr.text) }
    if (expr.tag == "addr") { return "ptr" }
    if (expr.tag == "deref")
    {
        let base_ty = codegen_expr_type(b, es, expr_store_get(es, expr.left_idx))
        if (is_ptr_to_struct(base_ty) == 1) { return strip_ptr_prefix(base_ty) }
        if (base_ty == "string") { return "i8" }
        return "i32"
    }
    if (expr.tag == "field")
    {
        let base_ty = codegen_expr_type(b, es, expr_store_get(es, expr.left_idx))
        if (base_ty == "string" and expr.text == "length") { return "i32" }
        if (expr.text == "length") { return "i32" }
        return get_struct_field_type(type_text_base_name_builder(strip_ptr_prefix(base_ty)), expr.text)
    }
    if (expr.tag == "struct_literal") { return expr.text }
    if (expr.tag == "index")
    {
        let base_ty = codegen_expr_type(b, es, expr_store_get(es, expr.left_idx))
        return type_text_index_element(base_ty)
    }
    if (expr.tag == "unaryop")
    {
        if (expr.text == "!") { return "bool" }
        return codegen_expr_type(b, es, expr_store_get(es, expr.left_idx))
    }
    if (expr.tag == "binop")
    {
        if (expr.text == "==" or expr.text == "!=" or expr.text == "<" or expr.text == "<=" or expr.text == ">" or expr.text == ">=" or expr.text == "and" or expr.text == "or")
        {
            return "bool"
        }
        let left_ty = codegen_expr_type(b, es, expr_store_get(es, expr.left_idx))
        let right_ty = codegen_expr_type(b, es, expr_store_get(es, expr.right_idx))
        if (expr.text == "+" and (left_ty == "string" or left_ty == "ptr") and type_is_integer(right_ty) == 1) { return left_ty }
        if (expr.text == "+" and type_is_integer(left_ty) == 1 and (right_ty == "string" or right_ty == "ptr")) { return right_ty }
        if (expr.text == "+" and (left_ty == "string" or left_ty == "ptr") and (right_ty == "string" or right_ty == "ptr")) { return "string" }
        return type_numeric_result(left_ty, right_ty)
    }
    if (expr.tag == "call") { return get_function_return_type(expr.text) }
    if (expr.tag == "array_literal") { return "[i32]" }
    if (expr.tag == "block_expr")
    {
        if (expr.right_idx >= 0) { return codegen_expr_type(b, es, expr_store_get(es, expr.right_idx)) }
        return "i32"
    }
    if (expr.tag == "if_expr") { return codegen_expr_type(b, es, expr_store_get(es, expr.right_idx)) }
    if (expr.tag == "match_expr")
    {
        let mut result_ty = "unknown"
        let mut num_arms = expr.args.length / 2
        for (i in 0 .. num_arms)
        {
            let body_idx = expr.args[i * 2 + 1]
            if (body_idx >= 0)
            {
                if (result_ty == "unknown")
                {
                    result_ty = codegen_expr_type(b, es, expr_store_get(es, body_idx))
                }
                elif (type_can_assign(result_ty, codegen_expr_type(b, es, expr_store_get(es, body_idx))) == 1)
                {
                }
                elif (type_can_assign(codegen_expr_type(b, es, expr_store_get(es, body_idx)), result_ty) == 1)
                {
                    result_ty = codegen_expr_type(b, es, expr_store_get(es, body_idx))
                }
            }
        }
        if (result_ty != "unknown") { return result_ty }
    }
    return "i32"
}

pub fn codegen_field_expr_value_typed(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, expr: AstExpr, expected_ty: string): ptr
{
    let base_expr = expr_store_get(es, expr.left_idx)
    let base_ty = codegen_expr_type(b, es, base_expr)
    if (base_ty == "string" and expr.text == "length")
    {
        let base = codegen_expr_value_typed(b, es, store, base_expr, "string")
        return llvm_build_strlen(b, base)
    }
    if (expr.text == "length")
    {
        let base = codegen_expr_value_typed(b, es, store, base_expr, "ptr")
        let args = [base]
        return llvm_build_call_value(b, "vix_array_len", args)
    }
    let struct_ty = type_text_base_name_builder(strip_ptr_prefix(base_ty))
    let field_index = get_struct_field_index(struct_ty, expr.text)
    let field_ty = get_struct_field_type(struct_ty, expr.text)
    if (field_index < 0)
    {
        return llvm_zero_value_for(expected_ty)
    }
    if (expected_ty == "ptr:" + field_ty)
    {
        return codegen_field_address(b, es, store, expr)
    }
    if (is_ptr_to_struct(base_ty) == 1)
    {
        let base_ptr = codegen_expr_value_typed(b, es, store, base_expr, "ptr")
        return llvm_build_struct_field_from_ptr(b, struct_ty, base_ptr, field_index, field_ty, expected_ty)
    }
    let base_val = codegen_expr_value_typed(b, es, store, base_expr, base_ty)
    let field_val = llvm_extract_value(b, base_val, field_index)
    return llvm_cast_value(b, field_val, field_ty, expected_ty)
}

pub fn codegen_binop_expr_value_typed(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, expr: AstExpr, expected_ty: string): ptr
{
    let left_expr = expr_store_get(es, expr.left_idx)
    let right_expr = expr_store_get(es, expr.right_idx)
    let left_ty = codegen_expr_type(b, es, left_expr)
    let right_ty = codegen_expr_type(b, es, right_expr)

    if (expr.text == "and")
    {
        let left_val = codegen_expr_value_typed(b, es, store, left_expr, left_ty)
        let left_i1 = llvm_build_truthy_typed_i1(b, left_val, left_ty)

        let rhs_block = llvm_append_block(b, "and.rhs")
        let false_block = llvm_append_block(b, "and.false")
        let merge_block = llvm_append_block(b, "and.merge")
        vix_LLVMBuildCondBr(b.builder, left_i1, rhs_block, false_block)

        llvm_position_at_end(b, rhs_block)
        let right_val = codegen_expr_value_typed(b, es, store, right_expr, right_ty)
        let right_i1 = llvm_build_truthy_typed_i1(b, right_val, right_ty)
        let rhs_end_block = vix_LLVMGetInsertBlock(b.builder)
        vix_LLVMBuildCondBr(b.builder, right_i1, merge_block, false_block)

        llvm_position_at_end(b, false_block)
        vix_LLVMBuildBr(b.builder, merge_block)
        let false_end_block = vix_LLVMGetInsertBlock(b.builder)

        llvm_position_at_end(b, merge_block)
        let result = vix_LLVMBuildPHI(b.builder, LLVMInt32Type(), llvm_temp(b, "andval"))
        vix_LLVMAddIncoming(result, llvm_const_i32(1), rhs_end_block)
        vix_LLVMAddIncoming(result, llvm_const_i32(0), false_end_block)
        return result
    }
    if (expr.text == "or")
    {
        let left_val = codegen_expr_value_typed(b, es, store, left_expr, left_ty)
        let left_i1 = llvm_build_truthy_typed_i1(b, left_val, left_ty)

        let true_block = llvm_append_block(b, "or.true")
        let rhs_block = llvm_append_block(b, "or.rhs")
        let merge_block = llvm_append_block(b, "or.merge")
        vix_LLVMBuildCondBr(b.builder, left_i1, true_block, rhs_block)

        llvm_position_at_end(b, rhs_block)
        let right_val = codegen_expr_value_typed(b, es, store, right_expr, right_ty)
        let right_i1 = llvm_build_truthy_typed_i1(b, right_val, right_ty)
        let rhs_end_block = vix_LLVMGetInsertBlock(b.builder)
        vix_LLVMBuildCondBr(b.builder, right_i1, true_block, merge_block)

        llvm_position_at_end(b, true_block)
        vix_LLVMBuildBr(b.builder, merge_block)
        let true_end_block = vix_LLVMGetInsertBlock(b.builder)

        llvm_position_at_end(b, merge_block)
        let result = vix_LLVMBuildPHI(b.builder, LLVMInt32Type(), llvm_temp(b, "orval"))
        vix_LLVMAddIncoming(result, llvm_const_i32(1), true_end_block)
        vix_LLVMAddIncoming(result, llvm_const_i32(0), rhs_end_block)
        return result
    }

    if (expr.text == "+" and (left_ty == "string" or left_ty == "ptr") and type_is_integer(right_ty) == 1)
    {
        let base = codegen_expr_value_typed(b, es, store, left_expr, "ptr")
        let index = codegen_expr_value_typed(b, es, store, right_expr, "i32")
        return llvm_ptr_offset_i8(b, base, index)
    }
    if (expr.text == "+" and type_is_integer(left_ty) == 1 and (right_ty == "string" or right_ty == "ptr"))
    {
        let index = codegen_expr_value_typed(b, es, store, left_expr, "i32")
        let base = codegen_expr_value_typed(b, es, store, right_expr, "ptr")
        return llvm_ptr_offset_i8(b, base, index)
    }
    let result_ty = if ((expr.text == "==" or expr.text == "!=") and left_ty == "string" and right_ty == "string") { "string" } elif ((expr.text == "==" or expr.text == "!=") and (codegen_type_is_pointer_like(left_ty) == 1 or codegen_type_is_pointer_like(right_ty) == 1)) { "ptr" } elif (expr.text == "+" and (left_ty == "string" or left_ty == "ptr") and (right_ty == "string" or right_ty == "ptr")) { "string" } elif (expected_ty != "" and codegen_type_is_numeric(expected_ty) == 1 and expr.text != "==" and expr.text != "!=" and expr.text != "<" and expr.text != "<=" and expr.text != ">" and expr.text != ">=") { expected_ty } else { type_numeric_result(left_ty, right_ty) }
    let left = if (result_ty == "ptr" and left_expr.tag == "int" and left_expr.int_value == 0) { llvm_const_null_ptr() } else { codegen_expr_value_typed(b, es, store, left_expr, result_ty) }
    let right = if (result_ty == "ptr" and right_expr.tag == "int" and right_expr.int_value == 0) { llvm_const_null_ptr() } else { codegen_expr_value_typed(b, es, store, right_expr, result_ty) }
    if (expr.text == "+")
    {
        if (result_ty == "string") { return llvm_build_call_value(b, "vix_string_concat", [left, right]) }
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fadd_value(b, left, right) }
        return llvm_build_add_value(b, left, right)
    }
    if (expr.text == "-")
    {
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fsub_value(b, left, right) }
        return llvm_build_sub_value(b, left, right)
    }
    if (expr.text == "*")
    {
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fmul_value(b, left, right) }
        return llvm_build_mul_value(b, left, right)
    }
    if (expr.text == "/")
    {
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fdiv_value(b, left, right) }
        return llvm_build_div_value(b, left, right)
    }
    if (expr.text == "%") { return llvm_build_mod_value(b, left, right) }
    if (expr.text == "&") { return llvm_build_and_value(b, left, right) }
    if (expr.text == "|") { return llvm_build_or_value(b, left, right) }
    if (expr.text == "<<") { return llvm_build_shl_value(b, left, right) }
    if (expr.text == ">>") { return llvm_build_ashr_value(b, left, right) }
    if (expr.text == "==")
    {
        if (result_ty == "string") { return llvm_build_string_eq_value(b, left, right) }
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fcmp_value(b, 1, left, right) }
        return llvm_build_icmp_value(b, 32, left, right)
    }
    if (expr.text == "!=")
    {
        if (result_ty == "string") { return llvm_build_not_value(b, llvm_build_string_eq_value(b, left, right)) }
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fcmp_value(b, 6, left, right) }
        return llvm_build_icmp_value(b, 33, left, right)
    }
    if (expr.text == "<")
    {
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fcmp_value(b, 4, left, right) }
        return llvm_build_icmp_value(b, 40, left, right)
    }
    if (expr.text == "<=")
    {
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fcmp_value(b, 5, left, right) }
        return llvm_build_icmp_value(b, 41, left, right)
    }
    if (expr.text == ">")
    {
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fcmp_value(b, 2, left, right) }
        return llvm_build_icmp_value(b, 38, left, right)
    }
    if (expr.text == ">=")
    {
        if (codegen_type_is_float(result_ty) == 1) { return llvm_build_fcmp_value(b, 3, left, right) }
        return llvm_build_icmp_value(b, 39, left, right)
    }
    return llvm_const_i32(0)
}

pub fn codegen_unary_expr_value_typed(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, expr: AstExpr): ptr
{
    if (expr.text == "-")
    {
        let operand_expr = expr_store_get(es, expr.left_idx)
        let operand_ty = codegen_expr_type(b, es, operand_expr)
        let operand = codegen_expr_value_typed(b, es, store, operand_expr, operand_ty)
        if (codegen_type_is_float(operand_ty) == 1) { return llvm_build_fneg_value(b, operand) }
        return llvm_build_neg_value(b, operand)
    }
    if (expr.text == "!")
    {
        let operand_expr = expr_store_get(es, expr.left_idx)
        let operand = codegen_expr_value_typed(b, es, store, operand_expr, codegen_expr_type(b, es, operand_expr))
        return llvm_build_not_value(b, operand)
    }
    return llvm_const_i32(0)
}

pub fn codegen_option_expr_value_typed(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, expr: AstExpr): ptr
{
    if (expr.option_has_value == 0) { return llvm_const_null_ptr() }
    let value_expr = expr_store_get(es, expr.left_idx)
    let value_ty = codegen_expr_type(b, es, value_expr)
    let value = codegen_expr_value_typed(b, es, store, value_expr, value_ty)
    if (value_ty == "ptr" or value_ty == "string" or type_text_is_array(value_ty) == 1 or is_ptr_to_struct(value_ty) == 1)
    {
        return value
    }
    let encoded = if (value_ty == "i64" or value_ty == "u64" or value_ty == "usize") { llvm_build_add_value(b, value, llvm_const_i64(1)) } else { llvm_build_add_value(b, value, llvm_const_i32(1)) }
    return llvm_int_to_ptr(b, encoded)
}

pub fn codegen_expr_value_typed(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, expr: AstExpr, expected_ty: string): ptr
{
    if (expr.tag == "int")
    {
        if (codegen_expected_type_accepts_null(expected_ty) == 1 and expr.int_value == 0) { return llvm_const_null_ptr() }
        if (expected_ty == "i64" or expected_ty == "u64" or expected_ty == "usize") { return llvm_const_i64(expr.int_value) }
        if (expected_ty == "i8" or expected_ty == "u8" or expected_ty == "char") { return vix_LLVMConstInt(LLVMInt8Type(), i32_to_i64(expr.int_value), 0) }
        if (expected_ty == "f32" or expected_ty == "f64") { return llvm_const_float(i32_to_f64(expr.int_value), expected_ty) }
        return llvm_const_i32(expr.int_value)
    }
    if (expr.tag == "float")
    {
        if (expected_ty == "f32") { return llvm_const_float(expr.float_value, "f32") }
        return llvm_const_float(expr.float_value, "f64")
    }
    if (expr.tag == "bool")
    {
        if (expected_ty == "bool") { return llvm_const_bool(expr.int_value) }
        return llvm_const_i32(expr.int_value)
    }
    if (expr.tag == "option") { return codegen_option_expr_value_typed(b, es, store, expr) }
    if (expr.tag == "ident")
    {
        let var_ty = get_var_type(b, expr.text)
        if (type_text_is_ptr_to_array(expected_ty) == 1 and type_text_is_array(var_ty) == 1) { return llvm_load_var(b, expr.text) }
        if (expected_ty == "ptr:" + var_ty) { return llvm_var_address(b, expr.text) }
        if (is_ptr_to_struct(var_ty) == 1 and codegen_type_is_pointer_like(expected_ty) == 1) { return llvm_load_var(b, expr.text) }
        if (vix_is_struct_type(var_ty) == 1 and codegen_type_is_pointer_like(expected_ty) == 1) { return llvm_var_address(b, expr.text) }
        return llvm_cast_value(b, llvm_load_var(b, expr.text), var_ty, expected_ty)
    }
    if (expr.tag == "string") { return get_c_string_global(b, ".strlit" + llvm_temp(b, ""), expr.text) }
    if (expr.tag == "addr")
    {
        let var_ty = get_var_type(b, expr.text)
        if (type_text_is_array(var_ty) == 1) { return llvm_load_var(b, expr.text) }
        return llvm_var_address(b, expr.text)
    }
    if (expr.tag == "deref")
    {
        let ptr_expr = expr_store_get(es, expr.left_idx)
        let base_ty = codegen_expr_type(b, es, ptr_expr)
        let ptr_val = codegen_expr_value_typed(b, es, store, ptr_expr, "ptr")
        let pointee_ty = if (is_ptr_to_struct(base_ty) == 1) { strip_ptr_prefix(base_ty) } elif (base_ty == "string") { "i8" } else { "i32" }
        let loaded = llvm_load_typed_pointer(b, ptr_val, pointee_ty)
        return llvm_cast_value(b, loaded, pointee_ty, expected_ty)
    }
    if (expr.tag == "field") { return codegen_field_expr_value_typed(b, es, store, expr, expected_ty) }
    if (expr.tag == "struct_literal")
    {
        let mut agg = llvm_undef(expr.text)
        for (i in 0 .. expr.args.length)
        {
            let field_name = expr.field_names[i]
            let field_ty = get_struct_field_type(expr.text, field_name)
            let field_index = get_struct_field_index(expr.text, field_name)
            let field_expr = expr_store_get(es, expr.args[i])
            let val = if (codegen_expected_type_accepts_null(field_ty) == 1 and field_expr.tag == "int" and field_expr.int_value == 0) { llvm_const_null_ptr() } else { codegen_expr_value_typed(b, es, store, field_expr, field_ty) }
            agg = llvm_insert_value(b, agg, val, field_index)
        }
        return agg
    }
    if (expr.tag == "index")
    {
        let base_expr = expr_store_get(es, expr.left_idx)
        let index_expr = expr_store_get(es, expr.right_idx)
        let base_ty = codegen_expr_type(b, es, base_expr)
        let base = codegen_expr_value_typed(b, es, store, base_expr, base_ty)
        let index = codegen_expr_value_typed(b, es, store, index_expr, "i32")
        let element_ty_text = type_text_index_element(base_ty)
        if (base_ty == "string") { return llvm_load_string_char(b, base, index) }
        if (is_ptr_to_struct(base_ty) == 1 or base_ty == "ptr") { return llvm_load_typed_index(b, base, index, element_ty_text, expected_ty) }
        let element_ty = llvm_type_for(element_ty_text)
        let indices = [index]
        let slot = vix_LLVMBuildGEP2(b.builder, element_ty, base, indices, 1, llvm_temp(b, "idx"))
        return vix_LLVMBuildLoad2(b.builder, element_ty, slot, llvm_temp(b, "loadidx"))
    }
    if (expr.tag == "binop") { return codegen_binop_expr_value_typed(b, es, store, expr, expected_ty) }
    if (expr.tag == "unaryop") { return codegen_unary_expr_value_typed(b, es, store, expr) }
    if (expr.tag == "call")
    {
        let mut args: [ptr] = []
        for (i in 0 .. expr.args.length)
        {
            let arg_expr = expr_store_get(es, expr.args[i])
            let expected_arg_ty = get_function_param_type(expr.text, i)
            let arg = codegen_expr_value_typed(b, es, store, arg_expr, expected_arg_ty)
            args.push(arg)
        }
        let call_val = llvm_build_call_value(b, expr.text, args)
        return llvm_cast_value(b, call_val, get_function_return_type(expr.text), expected_ty)
    }
    if (expr.tag == "array_literal")
    {
        let mut arr = llvm_const_null_ptr()
        for (i in 0 .. expr.args.length)
        {
            let elem_expr = expr_store_get(es, expr.args[i])
            let elem_ty = codegen_expr_type(b, es, elem_expr)
            if (codegen_type_is_pointer_like(elem_ty) == 1)
            {
                let val = codegen_expr_value_typed(b, es, store, elem_expr, "ptr")
                arr = llvm_build_call_value(b, "vix_array_push_ptr", [arr, val])
            }
            elif (elem_ty != "i32" and elem_ty != "bool" and elem_ty != "i8" and elem_ty != "u8" and elem_ty != "char")
            {
                let val = codegen_expr_value_typed(b, es, store, elem_expr, elem_ty)
                let slot = vix_LLVMBuildAlloca(b.builder, llvm_type_for(elem_ty), llvm_temp(b, "elem"))
                vix_LLVMBuildStore(b.builder, val, slot)
                arr = llvm_build_call_value(b, "vix_array_push_bytes", [arr, slot, llvm_sizeof_i64(b, elem_ty)])
            }
            else
            {
                let val = codegen_expr_value_typed(b, es, store, elem_expr, "i32")
                arr = llvm_build_call_value(b, "vix_array_push_i32", [arr, val])
            }
        }
        return arr
    }
    if (expr.tag == "block_expr")
    {
        codegen_stmt(b, es, store, expr.left_idx, if (expected_ty == "void") { 1 } else { 0 })
        let mut value = llvm_const_i32(0)
        if (expr.right_idx >= 0)
        {
            let value_expr = expr_store_get(es, expr.right_idx)
            value = codegen_expr_value_typed(b, es, store, value_expr, expected_ty)
        }
        return value
    }
    if (expr.tag == "if_expr")
    {
        let inferred_ty = codegen_expr_type(b, es, expr)
        let result_ty = if (expected_ty != "" and expected_ty != "unknown") { expected_ty } else { inferred_ty }
        let result_alloca = vix_LLVMBuildAlloca(b.builder, llvm_type_for(result_ty), llvm_temp(b, "ifexpr"))
        let then_block = llvm_append_block(b, llvm_label_name(b, "ifexpr.then"))
        let else_block = llvm_append_block(b, llvm_label_name(b, "ifexpr.else"))
        let end_block = llvm_append_block(b, llvm_label_name(b, "ifexpr.end"))
        let cond_expr = expr_store_get(es, expr.left_idx)
        let cond_ty = codegen_expr_type(b, es, cond_expr)
        let cond_val = codegen_expr_value_typed(b, es, store, cond_expr, cond_ty)
        let cond_i1 = llvm_build_truthy_typed_i1(b, cond_val, cond_ty)
        vix_LLVMBuildCondBr(b.builder, cond_i1, then_block, else_block)

        llvm_position_at_end(b, then_block)
        let then_expr = expr_store_get(es, expr.right_idx)
        let then_val = codegen_expr_value_typed(b, es, store, then_expr, result_ty)
        vix_LLVMBuildStore(b.builder, then_val, result_alloca)
        if (llvm_current_block_terminated(b) == 0) { llvm_emit_jmp_block(b, end_block) }

        llvm_position_at_end(b, else_block)
        let else_expr = expr_store_get(es, expr.args[0])
        let else_val = codegen_expr_value_typed(b, es, store, else_expr, result_ty)
        vix_LLVMBuildStore(b.builder, else_val, result_alloca)
        if (llvm_current_block_terminated(b) == 0) { llvm_emit_jmp_block(b, end_block) }

        llvm_position_at_end(b, end_block)
        return vix_LLVMBuildLoad2(b.builder, llvm_type_for(result_ty), result_alloca, llvm_temp(b, "ifexprval"))
    }
    if (expr.tag == "match_expr")
    {
        let inferred_ty = codegen_expr_type(b, es, expr)
        let result_ty = if (expected_ty != "" and expected_ty != "unknown") { expected_ty } else { inferred_ty }
        let subject_expr = expr_store_get(es, expr.left_idx)
        let subject_ty = codegen_expr_type(b, es, subject_expr)
        let subject_val = codegen_expr_value_typed(b, es, store, subject_expr, subject_ty)

        let result_alloca = vix_LLVMBuildAlloca(b.builder, llvm_type_for(result_ty), llvm_temp(b, "matchres"))
        let end_block = llvm_append_block(b, llvm_label_name(b, "match.end"))
        let mut next_test = llvm_append_block(b, llvm_label_name(b, "match.test"))

        if (llvm_current_block_terminated(b) == 0) { llvm_emit_jmp_block(b, next_test) }

        let mut num_arms = expr.args.length / 2
        for (i in 0 .. num_arms)
        {
            let pattern_idx = expr.args[i * 2]
            let body_idx = expr.args[i * 2 + 1]
            if (body_idx < 0) { continue }

            if (pattern_idx < 0)
            {
                llvm_position_at_end(b, next_test)
                let body_expr = expr_store_get(es, body_idx)
                let val = codegen_expr_value_typed(b, es, store, body_expr, result_ty)
                vix_LLVMBuildStore(b.builder, val, result_alloca)
                if (llvm_current_block_terminated(b) == 0) { llvm_emit_jmp_block(b, end_block) }
            }
            else
            {
                llvm_position_at_end(b, next_test)
                let body_block = llvm_append_block(b, llvm_label_name(b, "match.body"))
                let after_block = llvm_append_block(b, llvm_label_name(b, "match.test"))
                let cmp = codegen_match_compare(b, es, store, subject_val, subject_ty, pattern_idx)
                let cmp_i1 = llvm_build_truthy_typed_i1(b, cmp, "bool")
                vix_LLVMBuildCondBr(b.builder, cmp_i1, body_block, after_block)

                llvm_position_at_end(b, body_block)
                codegen_bind_option_pattern(b, es, pattern_idx, subject_val, subject_ty)
                let body_expr = expr_store_get(es, body_idx)
                let val = codegen_expr_value_typed(b, es, store, body_expr, result_ty)
                vix_LLVMBuildStore(b.builder, val, result_alloca)
                if (llvm_current_block_terminated(b) == 0) { llvm_emit_jmp_block(b, end_block) }

                next_test = after_block
            }
        }

        llvm_position_at_end(b, next_test)
        if (llvm_current_block_terminated(b) == 0)
        {
            vix_LLVMBuildStore(b.builder, llvm_zero_value_for(result_ty), result_alloca)
            llvm_emit_jmp_block(b, end_block)
        }

        llvm_position_at_end(b, end_block)
        return vix_LLVMBuildLoad2(b.builder, llvm_type_for(result_ty), result_alloca, llvm_temp(b, "matchval"))
    }
    if (expr.tag == "method_call")
    {
        let mut out = llvm_const_i32(0)
        if (expr.text == "push")
        {
            let base_expr = expr_store_get(es, expr.left_idx)
            let base_ty = codegen_expr_type(b, es, base_expr)
            let element_ty = if (type_text_is_array(base_ty) == 1) { type_array_element(base_ty) } else { "i32" }
            let base = codegen_expr_value_typed(b, es, store, base_expr, "ptr")
            let val_expr = expr_store_get(es, expr.args[0])
            let val = codegen_expr_value_typed(b, es, store, val_expr, element_ty)
            let args = [base, val]
            let mut result = llvm_const_null_ptr()
            if (codegen_type_is_pointer_like(element_ty) == 1)
            {
                result = llvm_build_call_value(b, "vix_array_push_ptr", args)
            }
            elif (element_ty == "i32" or element_ty == "bool" or element_ty == "i8" or element_ty == "u8" or element_ty == "char")
            {
                result = llvm_build_call_value(b, "vix_array_push_i32", args)
            }
            else
            {
                let slot = vix_LLVMBuildAlloca(b.builder, llvm_type_for(element_ty), llvm_temp(b, "elem"))
                vix_LLVMBuildStore(b.builder, val, slot)
                result = llvm_build_call_value(b, "vix_array_push_bytes", [base, slot, llvm_sizeof_i64(b, element_ty)])
            }
            let base_addr = codegen_field_address(b, es, store, base_expr)
            vix_LLVMBuildStore(b.builder, result, base_addr)
            if (expected_ty == "ptr") { out = result }
        }
        return out
    }
    return llvm_const_i32(0)
}

pub fn codegen_expr_value(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, expr: AstExpr): ptr
{
    return codegen_expr_value_typed(b, es, store, expr, codegen_expr_type(b, es, expr))
}

pub fn codegen_match_compare(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, subject_val: ptr, subject_ty: string, pattern_idx: i32): ptr
{
    let pattern_expr = expr_store_get(es, pattern_idx)
    if (type_text_is_option(subject_ty) == 1 and pattern_expr.tag == "option")
    {
        if (pattern_expr.option_has_value == 0)
        {
            return llvm_build_icmp_value(b, 32, subject_val, llvm_const_null_ptr())
        }
        return llvm_build_icmp_value(b, 33, subject_val, llvm_const_null_ptr())
    }
    let pattern_val = codegen_expr_value_typed(b, es, store, pattern_expr, subject_ty)
    if (subject_ty == "string")
    {
        return llvm_build_string_eq_value(b, subject_val, pattern_val)
    }
    if (subject_ty == "f32" or subject_ty == "f64")
    {
        return llvm_build_fcmp_value(b, 1, subject_val, pattern_val)
    }
    return llvm_build_icmp_value(b, 32, subject_val, pattern_val)
}

pub fn codegen_bind_option_pattern(b: &LlvmBuilder, es: &ExprStore, pattern_idx: i32, subject_val: ptr, subject_ty: string)
{
    if (type_text_is_option(subject_ty) == 0 or pattern_idx < 0) { return }
    let pattern_expr = expr_store_get(es, pattern_idx)
    if (pattern_expr.tag != "option" or pattern_expr.option_has_value == 0 or pattern_expr.left_idx < 0) { return }
    let bind_expr = expr_store_get(es, pattern_expr.left_idx)
    if (bind_expr.tag != "ident" or bind_expr.text == "_") { return }
    let inner_ty = type_text_option_inner(subject_ty)
    let mut bind_val = subject_val
    if (inner_ty != "ptr" and inner_ty != "string" and type_text_is_array(inner_ty) == 0 and is_ptr_to_struct(inner_ty) == 0)
    {
        bind_val = llvm_ptr_to_i64(b, subject_val)
        bind_val = llvm_build_sub_value(b, bind_val, llvm_const_i64(1))
        if (inner_ty != "i64" and inner_ty != "u64" and inner_ty != "usize")
        {
            bind_val = llvm_cast_value(b, bind_val, "i64", inner_ty)
        }
    }
    llvm_define_var(b, bind_expr.text, inner_ty, bind_val)
}

pub fn codegen_field_address(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, expr: AstExpr): ptr
{
    if (expr.tag == "ident")
    {
        return llvm_var_address(b, expr.text)
    }
    if (expr.tag == "field")
    {
        let base_expr = expr_store_get(es, expr.left_idx)
        let base_ty = codegen_expr_type(b, es, base_expr)
        let struct_ty = type_text_base_name_builder(strip_ptr_prefix(base_ty))
        let field_index = get_struct_field_index(struct_ty, expr.text)
        let base_ptr = if (is_ptr_to_struct(base_ty) == 1) { codegen_expr_value_typed(b, es, store, base_expr, "ptr") } else { codegen_field_address(b, es, store, base_expr) }
        return llvm_build_struct_field_ptr_from_ptr(b, struct_ty, base_ptr, field_index)
    }
    if (expr.tag == "index")
    {
        let base_expr = expr_store_get(es, expr.left_idx)
        let index_expr = expr_store_get(es, expr.right_idx)
        let base_ty = codegen_expr_type(b, es, base_expr)
        let element_ty_text = type_text_index_element(base_ty)
        let base = codegen_expr_value_typed(b, es, store, base_expr, "ptr")
        let index = codegen_expr_value_typed(b, es, store, index_expr, "i32")
        let indices = [index]
        return vix_LLVMBuildGEP2(b.builder, llvm_type_for(element_ty_text), base, indices, 1, llvm_temp(b, "idxaddr"))
    }
    return codegen_expr_value_typed(b, es, store, expr, "ptr")
}

pub fn codegen_match_statement_body(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, body_idx: i32, break_block: ptr, continue_block: ptr, return_is_void: i32)
{
    codegen_stmt_in_loop(b, es, store, body_idx, break_block, continue_block, return_is_void)
}

pub fn codegen_stmt_in_loop(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, stmt_idx: i32, break_block: ptr, continue_block: ptr, return_is_void: i32)
{
    let stmt = stmt_store_get(store, stmt_idx)
    match stmt.tag {
        "return" -> {
            if (return_is_void == 1) { llvm_emit_ret_void(b) } else { llvm_emit_ret_value(b, llvm_zero_value_for(get_var_type(b, "__return"))) }
        }
        "return_expr" -> {
            let ret_ty = get_var_type(b, "__return")
            let val = codegen_expr_value_typed(b, es, store, expr_store_get(es, stmt.value_idx), ret_ty)
            llvm_emit_ret_value(b, val)
        }
        "let" -> {
            let expr = expr_store_get(es, stmt.assign_idx)
            let ty = if (stmt.type_text != "") { stmt.type_text } else { codegen_expr_type(b, es, expr) }
            let val = codegen_expr_value_typed(b, es, store, expr, ty)
            llvm_define_var(b, stmt.assign_name, ty, val)
        }
        "assign" -> {
            let ty = get_var_type(b, stmt.assign_name)
            let val = codegen_expr_value_typed(b, es, store, expr_store_get(es, stmt.assign_idx), ty)
            llvm_store_value(b, val, stmt.assign_name)
        }
        "field_assign" -> {
            let base_expr = expr_store_get(es, stmt.value_idx)
            let base_ty = codegen_expr_type(b, es, base_expr)
            let struct_ty = type_text_base_name_builder(strip_ptr_prefix(base_ty))
            let field_index = get_struct_field_index(struct_ty, stmt.assign_name)
            let field_ty = get_struct_field_type(struct_ty, stmt.assign_name)
            let base_ptr = if (is_ptr_to_struct(base_ty) == 1) { codegen_expr_value_typed(b, es, store, base_expr, "ptr") } else { codegen_field_address(b, es, store, base_expr) }
            let field_ptr = llvm_build_struct_field_ptr_from_ptr(b, struct_ty, base_ptr, field_index)
            let val = codegen_expr_value_typed(b, es, store, expr_store_get(es, stmt.assign_idx), field_ty)
            vix_LLVMBuildStore(b.builder, val, field_ptr)
        }
        "store_deref" -> {
            let ptr_expr = expr_store_get(es, stmt.value_idx)
            let base_ty = codegen_expr_type(b, es, ptr_expr)
            let ptr_val = codegen_expr_value_typed(b, es, store, ptr_expr, "ptr")
            let pointee_ty = if (is_ptr_to_struct(base_ty) == 1) { strip_ptr_prefix(base_ty) } elif (base_ty == "string") { "i8" } else { "i32" }
            let val = codegen_expr_value_typed(b, es, store, expr_store_get(es, stmt.assign_idx), pointee_ty)
            llvm_store_typed_pointer(b, ptr_val, val)
        }
        "store_index" -> {
            let base_expr = expr_store_get(es, stmt.value_idx)
            let base_ty = codegen_expr_type(b, es, base_expr)
            let element_ty_text = type_text_index_element(base_ty)
            let base = codegen_expr_value_typed(b, es, store, base_expr, "ptr")
            let index = codegen_expr_value_typed(b, es, store, expr_store_get(es, stmt.direct_ret), "i32")
            let value_expr = expr_store_get(es, stmt.assign_idx)
            let value_ty = codegen_expr_type(b, es, value_expr)
            let raw_val = codegen_expr_value_typed(b, es, store, value_expr, element_ty_text)
            let val = llvm_cast_value(b, raw_val, value_ty, element_ty_text)
            let element_ty = llvm_type_for(element_ty_text)
            let indices = [index]
            let slot = vix_LLVMBuildGEP2(b.builder, element_ty, base, indices, 1, llvm_temp(b, "storeidx"))
            vix_LLVMBuildStore(b.builder, val, slot)
        }
        "print" -> {
            let expr = expr_store_get(es, stmt.print_idx)
            let ty = codegen_expr_type(b, es, expr)
            let val = codegen_expr_value_typed(b, es, store, expr, ty)
            llvm_emit_printf_value(b, val, ty)
        }
        "expr" -> {
            let ignored_expr_value = codegen_expr_value(b, es, store, expr_store_get(es, stmt.value_idx))
        }
        "break" -> {
            if (break_block != nil)
            {
                llvm_emit_jmp_block(b, break_block)
            }
        }
        "continue" -> {
            if (continue_block != nil)
            {
                llvm_emit_jmp_block(b, continue_block)
            }
        }
        "if_eq_return" -> {
            let then_label = llvm_label_name(b, "L")
            let else_label = llvm_label_name(b, "L")
            let then_block = llvm_append_block(b, then_label)
            let else_block = llvm_append_block(b, else_label)
            let cmp = llvm_build_eq_string_value(b, stmt.cond_left, stmt.cond_right)
            llvm_emit_condbr_blocks(b, cmp, then_block, else_block)
            llvm_position_at_end(b, then_block)
            llvm_emit_ret_value(b, llvm_const_i32(stmt.then_ret))
            llvm_position_at_end(b, else_block)
            llvm_emit_ret_value(b, llvm_const_i32(stmt.else_ret))
        }
        "match_option_string" -> {
            let some_label = llvm_label_name(b, "L")
            let none_label = llvm_label_name(b, "L")
            let then_label = llvm_label_name(b, "L")
            let else_label = llvm_label_name(b, "L")
            let some_block = llvm_append_block(b, some_label)
            let none_block = llvm_append_block(b, none_label)
            let then_block = llvm_append_block(b, then_label)
            let else_block = llvm_append_block(b, else_label)
            let opt_expr = expr_store_get(es, stmt.value_idx)
            llvm_emit_condbr_blocks(b, llvm_const_i32(opt_expr.option_has_value), some_block, none_block)
            llvm_position_at_end(b, some_block)
            let cmp = llvm_build_eq_string_value(b, stmt.match_bind, stmt.match_compare_right)
            llvm_emit_condbr_blocks(b, cmp, then_block, else_block)
            llvm_position_at_end(b, then_block)
            llvm_emit_ret_value(b, llvm_const_i32(stmt.match_some_then_ret))
            llvm_position_at_end(b, else_block)
            llvm_emit_ret_value(b, llvm_const_i32(stmt.match_some_else_ret))
            llvm_position_at_end(b, none_block)
            llvm_emit_ret_value(b, llvm_const_i32(stmt.match_none_ret))
        }
        "while" -> {
            let cond_label = llvm_label_name(b, "while.cond")
            let body_label = llvm_label_name(b, "while.body")
            let end_label = llvm_label_name(b, "while.end")
            let cond_block = llvm_append_block(b, cond_label)
            let body_block = llvm_append_block(b, body_label)
            let end_block = llvm_append_block(b, end_label)

            if (llvm_current_block_terminated(b) == 0)
            {
                llvm_emit_jmp_block(b, cond_block)
            }

            llvm_position_at_end(b, cond_block)
            let cond_expr = expr_store_get(es, stmt.value_idx)
            let cond_ty = codegen_expr_type(b, es, cond_expr)
            let cond_val = codegen_expr_value_typed(b, es, store, cond_expr, cond_ty)
            let cond_i1 = llvm_build_truthy_typed_i1(b, cond_val, cond_ty)
            vix_LLVMBuildCondBr(b.builder, cond_i1, body_block, end_block)

            llvm_position_at_end(b, body_block)
            codegen_stmt_in_loop(b, es, store, stmt.body_idx, end_block, cond_block, return_is_void)
            if (llvm_current_block_terminated(b) == 0)
            {
                llvm_emit_jmp_block(b, cond_block)
            }

            llvm_position_at_end(b, end_block)
        }
        "for_range" -> {
            let cond_label = llvm_label_name(b, "for.cond")
            let body_label = llvm_label_name(b, "for.body")
            let step_label = llvm_label_name(b, "for.step")
            let end_label = llvm_label_name(b, "for.end")
            let cond_block = llvm_append_block(b, cond_label)
            let body_block = llvm_append_block(b, body_label)
            let step_block = llvm_append_block(b, step_label)
            let end_block = llvm_append_block(b, end_label)
            let start_expr = expr_store_get(es, stmt.value_idx)
            let end_expr = expr_store_get(es, stmt.assign_idx)
            let start_val = codegen_expr_value_typed(b, es, store, start_expr, "i32")
            let end_val = codegen_expr_value_typed(b, es, store, end_expr, "i32")
            llvm_define_var(b, stmt.assign_name, "i32", start_val)
            let end_name = "__for_end_" + stmt.assign_name + llvm_label_name(b, "")
            llvm_define_var(b, end_name, "i32", end_val)

            if (llvm_current_block_terminated(b) == 0)
            {
                llvm_emit_jmp_block(b, cond_block)
            }

            llvm_position_at_end(b, cond_block)
            let iter_val = llvm_load_var(b, stmt.assign_name)
            let limit_val = llvm_load_var(b, end_name)
            let cond_val = llvm_build_icmp_value(b, 40, iter_val, limit_val)
            let cond_i1 = llvm_build_truthy_typed_i1(b, cond_val, "bool")
            vix_LLVMBuildCondBr(b.builder, cond_i1, body_block, end_block)

            llvm_position_at_end(b, body_block)
            codegen_stmt_in_loop(b, es, store, stmt.body_idx, end_block, step_block, return_is_void)
            if (llvm_current_block_terminated(b) == 0)
            {
                llvm_emit_jmp_block(b, step_block)
            }

            llvm_position_at_end(b, step_block)
            let current_val = llvm_load_var(b, stmt.assign_name)
            let next_val = llvm_build_add_value(b, current_val, llvm_const_i32(1))
            llvm_store_value(b, next_val, stmt.assign_name)
            llvm_emit_jmp_block(b, cond_block)

            llvm_position_at_end(b, end_block)
        }
        "if" -> {
            let then_label = llvm_label_name(b, "if.then")
            let else_label = llvm_label_name(b, "if.else")
            let end_label = llvm_label_name(b, "if.end")
            let then_block = llvm_append_block(b, then_label)
            let else_block = llvm_append_block(b, else_label)
            let end_block = llvm_append_block(b, end_label)
            let cond_expr = expr_store_get(es, stmt.value_idx)
            let cond_ty = codegen_expr_type(b, es, cond_expr)
            let cond_val = codegen_expr_value_typed(b, es, store, cond_expr, cond_ty)
            let cond_i1 = llvm_build_truthy_typed_i1(b, cond_val, cond_ty)
            vix_LLVMBuildCondBr(b.builder, cond_i1, then_block, else_block)

            llvm_position_at_end(b, then_block)
            codegen_stmt_in_loop(b, es, store, stmt.body_idx, break_block, continue_block, return_is_void)
            if (llvm_current_block_terminated(b) == 0)
            {
                llvm_emit_jmp_block(b, end_block)
            }

            llvm_position_at_end(b, else_block)
            if (stmt.assign_idx >= 0)
            {
                codegen_stmt_in_loop(b, es, store, stmt.assign_idx, break_block, continue_block, return_is_void)
            }
            if (llvm_current_block_terminated(b) == 0)
            {
                llvm_emit_jmp_block(b, end_block)
            }

            llvm_position_at_end(b, end_block)
        }
        "match" -> {
            let subject_expr = expr_store_get(es, stmt.value_idx)
            let subject_ty = codegen_expr_type(b, es, subject_expr)
            let subject_val = codegen_expr_value_typed(b, es, store, subject_expr, subject_ty)
            let end_block = llvm_append_block(b, llvm_label_name(b, "match.end"))
            let mut default_body = -1
            let mut next_test = llvm_append_block(b, llvm_label_name(b, "match.test"))
            if (llvm_current_block_terminated(b) == 0)
            {
                llvm_emit_jmp_block(b, next_test)
            }
            for (i in 0 .. stmt.match_pattern_indices.length)
            {
                if (stmt.match_pattern_indices[i] < 0)
                {
                    default_body = stmt.match_body_indices[i]
                }
                else
                {
                    llvm_position_at_end(b, next_test)
                    let body_block = llvm_append_block(b, llvm_label_name(b, "match.body"))
                    let after_test = llvm_append_block(b, llvm_label_name(b, "match.test"))
                    let cmp = codegen_match_compare(b, es, store, subject_val, subject_ty, stmt.match_pattern_indices[i])
	                    let cmp_i1 = llvm_build_truthy_typed_i1(b, cmp, "bool")
	                    vix_LLVMBuildCondBr(b.builder, cmp_i1, body_block, after_test)
	                    llvm_position_at_end(b, body_block)
	                    codegen_bind_option_pattern(b, es, stmt.match_pattern_indices[i], subject_val, subject_ty)
	                    codegen_match_statement_body(b, es, store, stmt.match_body_indices[i], break_block, continue_block, return_is_void)
                    if (llvm_current_block_terminated(b) == 0)
                    {
                        llvm_emit_jmp_block(b, end_block)
                    }
                    next_test = after_test
                }
            }
            llvm_position_at_end(b, next_test)
            if (default_body >= 0)
            {
                codegen_match_statement_body(b, es, store, default_body, break_block, continue_block, return_is_void)
            }
            if (llvm_current_block_terminated(b) == 0)
            {
                llvm_emit_jmp_block(b, end_block)
            }
            llvm_position_at_end(b, end_block)
        }
        "block" -> {
            if (stmt.stmt_indices.length > 0)
            {
                for (i in 0 .. stmt.stmt_indices.length)
                {
                    if (llvm_current_block_terminated(b) == 0)
                    {
                        codegen_stmt_in_loop(b, es, store, stmt.stmt_indices[i], break_block, continue_block, return_is_void)
                    }
                }
            }
            else
            {
                for (i in 0 .. stmt.block_count)
                {
                    if (llvm_current_block_terminated(b) == 0)
                    {
                        codegen_stmt_in_loop(b, es, store, stmt.block_start + i, break_block, continue_block, return_is_void)
                    }
                }
            }
        }
        _ -> {}
    }
}

pub fn codegen_stmt(b: &LlvmBuilder, es: &ExprStore, store: &StmtStore, stmt_idx: i32, return_is_void: i32)
{
    codegen_stmt_in_loop(b, es, store, stmt_idx, nil, nil, return_is_void)
}

pub fn codegen_program(program: AstProgram): string
{
    return codegen_program_target(program, "")
}

pub fn codegen_program_target(program: AstProgram, target_triple: string): string
{
    if (program.ok == 0)
    {
        return program.error
    }
    let b = llvm_new_for_target(target_triple)
    reset_function_sigs()
    reset_struct_sigs()
    for (i in 0 .. program.structs.length)
    {
        declare_struct_sig(program.structs[i].name)
    }
    for (i in 0 .. program.structs.length)
    {
        register_struct_sig(program.structs[i].name, program.structs[i].field_names, program.structs[i].field_types)
    }
    for (i in 0 .. program.extern_functions.length)
    {
        register_function_sig_vararg(program.extern_functions[i].name, program.extern_functions[i].ret_ty, program.extern_functions[i].param_types, program.extern_functions[i].is_var_arg)
        llvm_declare_function_with_params_vararg(b, program.extern_functions[i].name, program.extern_functions[i].ret_ty, program.extern_functions[i].param_types, program.extern_functions[i].is_var_arg)
    }
    for (i in 0 .. program.functions.length)
    {
        register_function_sig(program.functions[i].name, program.functions[i].ret_ty, program.functions[i].param_types)
    }
    register_function_sig_vararg("vix_string_concat", "string", ["string", "string"], 0)
    register_function_sig_vararg("vix_array_len", "i32", ["ptr"], 0)
    register_function_sig_vararg("vix_array_push_i32", "ptr", ["ptr", "i32"], 0)
    register_function_sig_vararg("vix_array_push_ptr", "ptr", ["ptr", "ptr"], 0)
    register_function_sig_vararg("vix_array_push_bytes", "ptr", ["ptr", "ptr", "usize"], 0)
    for (i in 0 .. program.functions.length)
    {
        llvm_emit_function_header_with_params(b, program.functions[i].name, program.functions[i].ret_ty, program.functions[i].param_names, program.functions[i].param_types)
        set_var(b, "__return", b.current_fn)
        set_var_type(b, "__return", program.functions[i].ret_ty)
        codegen_stmt(b, program.expr_store, program.store, program.functions[i].body_idx, if (program.functions[i].ret_ty == "void") { 1 } else { 0 })
        if (llvm_current_block_terminated(b) == 0 and program.functions[i].ret_ty == "void")
        {
            llvm_emit_ret_void(b)
        }
        elif (llvm_current_block_terminated(b) == 0)
        {
            llvm_emit_ret_value(b, llvm_zero_value_for(program.functions[i].ret_ty))
        }
        llvm_emit_end_function(b)
    }
    return llvm_get_code(b)
}
