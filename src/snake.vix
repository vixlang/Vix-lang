extern "C"
{
    fn printf(format: ptr, ...): i32
    fn getchar(): i32
}

type SnakeGame = struct {
    xs: [i32],
    ys: [i32],
    len: i32,
    dir: i32,
    food_x: i32,
    food_y: i32,
    score: i32,
    alive: i32
}

fn board_width(): i32 { return 20 }
fn board_height(): i32 { return 10 }
fn max_cells(): i32 { return 128 }

fn dir_dx(dir: i32): i32
{
    if (dir == 1) { return 1 }
    if (dir == 3) { return -1 }
    return 0
}

fn dir_dy(dir: i32): i32
{
    if (dir == 0) { return -1 }
    if (dir == 2) { return 1 }
    return 0
}

fn is_reverse(old_dir: i32, new_dir: i32): i32
{
    if (old_dir == 0 and new_dir == 2) { return 1 }
    if (old_dir == 2 and new_dir == 0) { return 1 }
    if (old_dir == 1 and new_dir == 3) { return 1 }
    if (old_dir == 3 and new_dir == 1) { return 1 }
    return 0
}

fn make_game(): SnakeGame
{
    let mut xs: [i32] = []
    let mut ys: [i32] = []
    for (i in 0 .. max_cells())
    {
        xs.push(0)
        ys.push(0)
    }
    xs[0] = 5
    ys[0] = 5
    xs[1] = 4
    ys[1] = 5
    xs[2] = 3
    ys[2] = 5
    return SnakeGame{ xs: xs, ys: ys, len: 3, dir: 1, food_x: 12, food_y: 5, score: 0, alive: 1 }
}

fn snake_at(game: &SnakeGame, x: i32, y: i32): i32
{
    for (i in 0 .. game.len)
    {
        if (game.xs[i] == x and game.ys[i] == y)
        {
            if (i == 0) { return 2 }
            return 1
        }
    }
    return 0
}

fn place_food(game: &SnakeGame)
{
    let mut tries = 0
    let mut done = 0
    while (done == 0 and tries < 40)
    {
        game.food_x = ((game.food_x + 7) % board_width()) + 1
        game.food_y = ((game.food_y + 3) % board_height()) + 1
        if (snake_at(game, game.food_x, game.food_y) == 0)
        {
            done = 1
        }
        tries += 1
    }
}

fn draw(game: &SnakeGame)
{
    printf("\n")
    printf("Snake score=%d length=%d\n", game.score, game.len)
    printf("Controls: w/a/s/d then Enter, q to quit\n")
    for (x in 0 .. (board_width() + 2)) { printf("#") }
    printf("\n")
    for (y in 1 .. (board_height() + 1))
    {
        printf("#")
        for (x in 1 .. (board_width() + 1))
        {
            let part = snake_at(game, x, y)
            if (part == 2)
            {
                printf("@")
            }
            elif (part == 1)
            {
                printf("o")
            }
            elif (game.food_x == x and game.food_y == y)
            {
                printf("*")
            }
            else
            {
                printf(" ")
            }
        }
        printf("#\n")
    }
    for (x in 0 .. (board_width() + 2)) { printf("#") }
    printf("\n")
}

fn apply_input(game: &SnakeGame, input: i32)
{
    let mut new_dir = game.dir
    if (input == 'w') { new_dir = 0 }
    elif (input == 'd') { new_dir = 1 }
    elif (input == 's') { new_dir = 2 }
    elif (input == 'a') { new_dir = 3 }
    if (is_reverse(game.dir, new_dir) == 0)
    {
        game.dir = new_dir
    }
}

fn step(game: &SnakeGame)
{
    let new_x = game.xs[0] + dir_dx(game.dir)
    let new_y = game.ys[0] + dir_dy(game.dir)
    if (new_x < 1 or new_x > board_width() or new_y < 1 or new_y > board_height())
    {
        game.alive = 0
        return
    }
    for (i in 1 .. game.len)
    {
        if (game.xs[i] == new_x and game.ys[i] == new_y)
        {
            game.alive = 0
            return
        }
    }

    let ate = if (new_x == game.food_x and new_y == game.food_y) { 1 } else { 0 }
    if (ate == 1 and game.len < max_cells())
    {
        game.len += 1
        game.score += 10
    }

    let mut i = game.len - 1
    while (i > 0)
    {
        game.xs[i] = game.xs[i - 1]
        game.ys[i] = game.ys[i - 1]
        i -= 1
    }
    game.xs[0] = new_x
    game.ys[0] = new_y

    if (ate == 1)
    {
        place_food(game)
    }
}

fn main(): i32
{
    let mut game = make_game()
    while (game.alive == 1)
    {
        draw(&game)
        let input = getchar()
        if (input == 'q')
        {
            print("quit")
            return 0
        }
        apply_input(&game, input)
        step(&game)
    }
    draw(&game)
    printf("game over, score=%d\n", game.score)
    return 0
}
