#[no_main]

import "ast.vix"
import "../symtable.vix"
import "error.vix"


pub fn type_is_int64(ty: string): i32
{
    if (ty == "i64" or ty == "u64" or ty == "usize") { return 1 }
    return 0
}

pub fn type_is_int32(ty: string): i32
{
    if (ty == "i32" or ty == "u32") { return 1 }
    return 0
}

pub fn type_is_small_int(ty: string): i32
{
    if (ty == "i8" or ty == "u8" or ty == "i16" or ty == "u16" or ty == "char") { return 1 }
    return 0
}

pub fn type_is_concrete_int(ty: string): i32
{
    if (type_is_int64(ty) == 1 or type_is_int32(ty) == 1) { return 1 }
    return 0
}

pub fn type_int_width(ty: string): i32
{
    if (type_is_int64(ty) == 1) { return 64 }
    if (type_is_int32(ty) == 1) { return 32 }
    if (ty == "i16" or ty == "u16") { return 16 }
    if (ty == "i8" or ty == "u8" or ty == "char") { return 8 }
    return 0
}

pub fn type_is_float(ty: string): i32
{
    if (ty == "f32" or ty == "f64" or ty == "unknown") { return 1 }
    return 0
}

pub fn type_is_integer(ty: string): i32
{
    if (type_is_concrete_int(ty) == 1 or type_is_small_int(ty) == 1 or ty == "unknown") { return 1 }
    return 0
}

pub fn type_is_numeric(ty: string): i32
{
    if (type_is_integer(ty) == 1 or type_is_float(ty) == 1) { return 1 }
    return 0
}

pub fn type_is_truthy(ty: string): i32
{
    if (ty == "bool" or ty == "i32" or ty == "i64" or ty == "unknown") { return 1 }
    return 0
}

pub fn type_numeric_result(left_ty: string, right_ty: string): string
{
    if (left_ty == "unknown") { return right_ty }
    if (right_ty == "unknown") { return left_ty }
    if (left_ty == "f64" or right_ty == "f64") { return "f64" }
    if (left_ty == "f32" or right_ty == "f32") { return "f32" }
    if (type_is_int64(left_ty) == 1 or type_is_int64(right_ty) == 1) { return "i64" }
    return "i32"
}

pub fn type_is_option_text(ty: string): i32
{
    if (ty.length > 7 and ty[0] == 'O' and ty[1] == 'p' and ty[2] == 't' and ty[3] == 'i' and ty[4] == 'o' and ty[5] == 'n' and ty[6] == '[') { return 1 }
    return 0
}
pub fn type_is_array_text_semantic(ty: string): i32
{
    if (ty.length > 2 and ty[0] == '[') { return 1 }
    return 0
}

pub fn type_option_inner(ty: string): string
{
    if (type_is_option_text(ty) == 0) { return "unknown" }
    let mut result = ""
    for (i in 7 .. ty.length - 1)
    {
        let s: string = malloc(2)
        s[0] = ty[i]
        s[1] = 0
        result = result + s
    }
    return result
}

pub fn type_can_assign(target_ty: string, value_ty: string): i32
{
    if (target_ty == "" or target_ty == "unknown" or value_ty == "unknown") { return 1 }
    if (target_ty == value_ty) { return 1 }
    if (ast_type_base_name(target_ty) != "" and ast_type_base_name(target_ty) == ast_type_base_name(value_ty)) { return 1 }
    if (type_is_array_text_semantic(target_ty) == 1 and value_ty == "[unknown]") { return 1 }
    if (type_is_option_text(target_ty) == 1 and type_is_option_text(value_ty) == 1)
    {
        let target_inner = type_option_inner(target_ty)
        let value_inner = type_option_inner(value_ty)
        if (value_inner == "unknown") { return 1 }
        return type_can_assign(target_inner, value_inner)
    }
    if (type_is_integer(target_ty) == 1 and type_is_integer(value_ty) == 1)
    {
        return 1
    }
    if ((target_ty == "f32" or target_ty == "f64") and type_is_numeric(value_ty) == 1) { return 1 }
    if (is_ptr_to_struct_semantic(target_ty) == 1 and value_ty == "ptr") { return 1 }
    if (is_ptr_to_struct_semantic(target_ty) == 1 and strip_ptr_prefix_semantic(target_ty) == value_ty) { return 1 }
    if (target_ty == "ptr" and is_ptr_to_struct_semantic(value_ty) == 1) { return 1 }
    if (target_ty == "ptr" and value_ty == "string") { return 1 }
    if (target_ty == "string" and value_ty == "ptr") { return 1 }
    if (target_ty == "ptr" and type_is_array_text_semantic(value_ty) == 1) { return 1 }
    return 0
}

pub fn type_accepts_null_literal(target_ty: string): i32
{
    if (target_ty == "ptr" or target_ty == "string") { return 1 }
    if (type_is_array_text_semantic(target_ty) == 1) { return 1 }
    if (is_ptr_to_struct_semantic(target_ty) == 1) { return 1 }
    return 0
}

pub fn type_can_assign_expr(target_ty: string, value_ty: string, expr: AstExpr): i32
{
    if (type_can_assign(target_ty, value_ty) == 1) { return 1 }
    if (type_accepts_null_literal(target_ty) == 1 and expr.tag == "int" and expr.int_value == 0) { return 1 }
    return 0
}

pub fn is_ptr_to_struct_semantic(ty: string): i32
{
    if (ty.length > 4 and ty[0] == 'p' and ty[1] == 't' and ty[2] == 'r' and ty[3] == ':') { return 1 }
    return 0
}

pub fn strip_ptr_prefix_semantic(ty: string): string
{
    if (is_ptr_to_struct_semantic(ty) == 0) { return ty }
    let mut result = ""
    for (i in 4 .. ty.length)
    {
        let s: string = malloc(2)
        s[0] = ty[i]
        s[1] = 0
        result = result + s
    }
    return result
}

pub fn type_category(ty: string): string
{
    return match ty {
        "bool" -> "bool"
        "string" -> "string"
        "ptr" -> "pointer"
        "void" -> "void"
        "f32" | "f64" -> "float"
        _ -> if (type_is_integer(ty) == 1) { "integer" } else { "other" }
    }
}

pub type FunctionSymbols = struct {
    names: [string],
    return_types: [string],
    arg_counts: [i32],
    param_offsets: [i32],
    param_types: [string],
    is_var_args: [i32],
    lines: [i32],
    cols: [i32],
    ok: i32,
    error: string,
    error_line: i32,
    error_col: i32
}

pub type StructSymbols = struct {
    names: [string],
    field_names: [string],
    field_types: [string],
    field_structs: [string],
    lines: [i32],
    cols: [i32],
    ok: i32,
    error: string,
    error_line: i32,
    error_col: i32
}

pub type TypeInferResult = struct {
    ok: i32,
    error: string,
    return_type: string,
    error_func: string,
    line: i32,
    col: i32,
    span_len: i32
}

pub fn typeinfer_ok(return_type: string): TypeInferResult
{
    return TypeInferResult{ ok: 1, error: "", return_type: return_type, error_func: "", line: 0, col: 0, span_len: 1 }
}

pub fn typeinfer_error(message: string, return_type: string, error_func: string, line: i32, col: i32): TypeInferResult
{
    return TypeInferResult{ ok: 0, error: message, return_type: return_type, error_func: error_func, line: line, col: col, span_len: 1 }
}

pub fn typeinfer_error_from_env(env: &SymbolTable, return_type: string, error_func: string): TypeInferResult
{
    return TypeInferResult{ ok: 0, error: env.error, return_type: return_type, error_func: error_func, line: env.error_line, col: env.error_col, span_len: env.error_length }
}

pub fn is_ptr_to_struct_typeinfer(ty: string): i32
{
    if (ty.length > 4 and ty[0] == 'p' and ty[1] == 't' and ty[2] == 'r' and ty[3] == ':') { return 1 }
    return 0
}

pub fn strip_ptr_prefix_typeinfer(ty: string): string
{
    if (ty.length > 4 and ty[0] == 'p' and ty[1] == 't' and ty[2] == 'r' and ty[3] == ':')
    {
        let mut result = ""
        for (i in 4 .. ty.length)
        {
            let s: string = malloc(2)
            s[0] = ty[i]
            s[1] = 0
            result = result + s
        }
        return result
    }
    return ty
}

pub fn expr_text_length(expr: AstExpr): i32
{
    if (expr.text == "")
    {
        return 1
    }
    return diag_strlen(expr.text)
}

pub fn symtable_fail_expr(env: &SymbolTable, message: string, expr: AstExpr)
{
    symtable_fail_at_len(env, message, expr.line, expr.col, expr_text_length(expr))
}

pub fn stmt_error_length(stmt: AstStmt): i32
{
    if (stmt.tag == "return") { return 6 }
    if (stmt.tag == "return_expr") { return 6 }
    if (stmt.tag == "break") { return 5 }
    if (stmt.tag == "continue") { return 8 }
    if (stmt.tag == "while") { return 5 }
    if (stmt.tag == "for_range") { return 3 }
    if (stmt.tag == "if") { return 2 }
    if (stmt.assign_name != "") { return diag_strlen(stmt.assign_name) }
    return 1
}

pub fn symtable_fail_stmt(env: &SymbolTable, message: string, stmt: AstStmt)
{
    symtable_fail_at_len(env, message, stmt.line, stmt.col, stmt_error_length(stmt))
}

pub fn infer_field_base_name(es: &ExprStore, idx: i32): string
{
    if (idx < 0) { return "" }
    let expr = expr_store_get(es, idx)
    if (expr.tag == "ident") { return expr.text }
    if (expr.tag == "field") { return infer_field_base_name(es, expr.left_idx) }
    return ""
}

pub fn infer_declare_option_match_binding(env: &SymbolTable, es: &ExprStore, pattern_idx: i32, inner_ty: string)
{
    if (pattern_idx < 0) { return }
    let pattern_expr = expr_store_get(es, pattern_idx)
    if (pattern_expr.tag == "option" and pattern_expr.option_has_value == 1 and pattern_expr.left_idx >= 0)
    {
        let bind_expr = expr_store_get(es, pattern_expr.left_idx)
        if (bind_expr.tag == "ident" and bind_expr.text != "_")
        {
            symtable_declare(env, bind_expr.text, inner_ty)
        }
    }
}

pub fn function_symbols_new(): FunctionSymbols
{
    return FunctionSymbols{ names: [], return_types: [], arg_counts: [], param_offsets: [], param_types: [], is_var_args: [], lines: [], cols: [], ok: 1, error: "", error_line: 0, error_col: 0 }
}

pub fn struct_symbols_new(): StructSymbols
{
    return StructSymbols{ names: [], field_names: [], field_types: [], field_structs: [], lines: [], cols: [], ok: 1, error: "", error_line: 0, error_col: 0 }
}

pub fn struct_symbols_fail_at(symbols: &StructSymbols, message: string, line: i32, col: i32)
{
    if (symbols.ok == 1)
    {
        symbols.ok = 0
        symbols.error = message
        symbols.error_line = line
        symbols.error_col = col
    }
}

pub fn struct_symbols_fail(symbols: &StructSymbols, message: string)
{
    struct_symbols_fail_at(symbols, message, 0, 0)
}

pub fn struct_symbols_find(symbols: &StructSymbols, name: string): i32
{
    for (i in 0 .. symbols.names.length)
    {
        if (symbols.names[i] == name) { return i }
    }
    return -1
}

pub fn struct_symbols_declare(symbols: &StructSymbols, decl: AstStructDecl)
{
    if (struct_symbols_find(symbols, decl.name) >= 0)
    {
        struct_symbols_fail_at(symbols, "duplicate struct '" + decl.name + "'", decl.line, decl.col)
        return
    }
    symbols.names.push(decl.name)
    symbols.lines.push(decl.line)
    symbols.cols.push(decl.col)
    for (i in 0 .. decl.field_names.length)
    {
        symbols.field_structs.push(decl.name)
        symbols.field_names.push(decl.field_names[i])
        symbols.field_types.push(decl.field_types[i])
    }
}

pub fn struct_symbols_field_type(symbols: &StructSymbols, struct_name: string, field_name: string): string
{
    let base_struct_name = ast_type_base_name(struct_name)
    if (struct_symbols_find(symbols, struct_name) < 0 and struct_symbols_find(symbols, base_struct_name) < 0)
    {
        struct_symbols_fail(symbols, "unknown struct '" + struct_name + "'")
        return "unknown"
    }
    for (i in 0 .. symbols.field_names.length)
    {
        if ((symbols.field_structs[i] == struct_name or symbols.field_structs[i] == base_struct_name) and symbols.field_names[i] == field_name)
        {
            return symbols.field_types[i]
        }
    }
    struct_symbols_fail(symbols, "unknown field '" + field_name + "' on struct '" + struct_name + "'")
    return "unknown"
}

pub fn function_symbols_fail_at(symbols: &FunctionSymbols, message: string, line: i32, col: i32)
{
    if (symbols.ok == 1)
    {
        symbols.ok = 0
        symbols.error = message
        symbols.error_line = line
        symbols.error_col = col
    }
}

pub fn function_symbols_fail(symbols: &FunctionSymbols, message: string)
{
    function_symbols_fail_at(symbols, message, 0, 0)
}

pub fn function_symbols_find(symbols: &FunctionSymbols, name: string): i32
{
    for (i in 0 .. symbols.names.length)
    {
        if (symbols.names[i] == name) { return i }
    }
    return -1
}

pub fn function_symbols_signature_equal(symbols: &FunctionSymbols, idx: i32, ret_ty: string, param_types: [string], arg_count: i32, is_var_arg: i32): i32
{
    if (symbols.return_types[idx] != ret_ty) { return 0 }
    if (symbols.arg_counts[idx] != arg_count) { return 0 }
    if (symbols.is_var_args[idx] != is_var_arg) { return 0 }
    let offset = symbols.param_offsets[idx]
    for (i in 0 .. arg_count)
    {
        let expected = if (i < param_types.length) { param_types[i] } else { "unknown" }
        if (symbols.param_types[offset + i] != expected) { return 0 }
    }
    return 1
}

pub fn function_symbols_declare(symbols: &FunctionSymbols, name: string, ret_ty: string, arg_count: i32)
{
    function_symbols_declare_vararg_loc(symbols, name, ret_ty, arg_count, 0, 0, 0)
}

pub fn function_symbols_declare_vararg(symbols: &FunctionSymbols, name: string, ret_ty: string, arg_count: i32, is_var_arg: i32)
{
    function_symbols_declare_vararg_loc(symbols, name, ret_ty, arg_count, is_var_arg, 0, 0)
}

pub fn function_symbols_declare_loc(symbols: &FunctionSymbols, name: string, ret_ty: string, arg_count: i32, line: i32, col: i32)
{
    function_symbols_declare_vararg_loc(symbols, name, ret_ty, arg_count, 0, line, col)
}

pub fn function_symbols_declare_vararg_loc(symbols: &FunctionSymbols, name: string, ret_ty: string, arg_count: i32, is_var_arg: i32, line: i32, col: i32)
{
    function_symbols_declare_full_loc(symbols, name, ret_ty, [], arg_count, is_var_arg, line, col)
}

pub fn function_symbols_declare_full_loc(symbols: &FunctionSymbols, name: string, ret_ty: string, param_types: [string], arg_count: i32, is_var_arg: i32, line: i32, col: i32)
{
    let idx = function_symbols_find(symbols, name)
    if (idx >= 0)
    {
        if (function_symbols_signature_equal(symbols, idx, ret_ty, param_types, arg_count, is_var_arg) == 1)
        {
            return
        }
        function_symbols_fail_at(symbols, "duplicate function '" + name + "'", line, col)
        return
    }
    symbols.names.push(name)
    symbols.return_types.push(ret_ty)
    symbols.arg_counts.push(arg_count)
    symbols.param_offsets.push(symbols.param_types.length)
    for (i in 0 .. arg_count)
    {
        if (i < param_types.length) { symbols.param_types.push(param_types[i]) } else { symbols.param_types.push("unknown") }
    }
    symbols.is_var_args.push(is_var_arg)
    symbols.lines.push(line)
    symbols.cols.push(col)
}

pub fn function_symbols_param_type(symbols: &FunctionSymbols, name: string, arg_index: i32): string
{
    let idx = function_symbols_find(symbols, name)
    if (idx < 0)
    {
        function_symbols_fail(symbols, "undefined function '" + name + "'")
        return "unknown"
    }
    let offset = symbols.param_offsets[idx]
    if (arg_index < 0 or arg_index >= symbols.arg_counts[idx]) { return "unknown" }
    return symbols.param_types[offset + arg_index]
}

pub fn type_text_is_array_typeinfer(ty: string): i32
{
    if (ty.length > 0 and ty[0] == '[') { return 1 }
    return 0
}

pub fn type_array_element_typeinfer(ty: string): string
{
    if (type_text_is_array_typeinfer(ty) == 0 or ty.length <= 2) { return "unknown" }
    let mut result = ""
    for (i in 1 .. ty.length - 1)
    {
        let s: string = malloc(2)
        s[0] = ty[i]
        s[1] = 0
        result = result + s
    }
    return result
}

pub fn type_text_is_ptr_to_array_typeinfer(ty: string): i32
{
    if (is_ptr_to_struct_typeinfer(ty) == 0) { return 0 }
    return type_text_is_array_typeinfer(strip_ptr_prefix_typeinfer(ty))
}

pub fn type_index_element_typeinfer(ty: string): string
{
    if (type_text_is_array_typeinfer(ty) == 1) { return type_array_element_typeinfer(ty) }
    if (type_text_is_ptr_to_array_typeinfer(ty) == 1) { return type_array_element_typeinfer(strip_ptr_prefix_typeinfer(ty)) }
    if (ty == "string" or ty == "ptr") { return "i8" }
    if (is_ptr_to_struct_typeinfer(ty) == 1) { return strip_ptr_prefix_typeinfer(ty) }
    return "i32"
}

pub fn function_symbols_return_type(symbols: &FunctionSymbols, name: string): string
{
    let idx = function_symbols_find(symbols, name)
    if (idx >= 0) { return symbols.return_types[idx] }
    function_symbols_fail(symbols, "undefined function '" + name + "'")
    return "unknown"
}

pub fn function_symbols_arg_count(symbols: &FunctionSymbols, name: string): i32
{
    let idx = function_symbols_find(symbols, name)
    if (idx >= 0) { return symbols.arg_counts[idx] }
    function_symbols_fail(symbols, "undefined function '" + name + "'")
    return 0
}

pub fn function_symbols_is_var_arg(symbols: &FunctionSymbols, name: string): i32
{
    let idx = function_symbols_find(symbols, name)
    if (idx >= 0) { return symbols.is_var_args[idx] }
    function_symbols_fail(symbols, "undefined function '" + name + "'")
    return 0
}

pub fn infer_index_expr_type(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, expr: AstExpr): string
{
    let base_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
    if (env.ok == 0) { return "unknown" }
    let index_ty = infer_expr_type(env, funcs, structs, es, store, expr.right_idx)
    if (env.ok == 0) { return "unknown" }
    let mut out_ty = "unknown"
    if (type_is_integer(index_ty) == 0)
    {
        symtable_fail_expr(env, "index expression expects integer index, got '" + index_ty + "'", expr)
    }
    elif (base_ty == "string" or base_ty == "ptr" or type_text_is_array_typeinfer(base_ty) == 1 or is_ptr_to_struct_typeinfer(base_ty) == 1)
    {
        out_ty = type_index_element_typeinfer(base_ty)
    }
    else
    {
        symtable_fail_expr(env, "cannot index value of type '" + base_ty + "'", expr)
    }
    return out_ty
}

pub fn infer_unary_expr_type(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, expr: AstExpr): string
{
    let mut out_ty = "unknown"
    if (expr.text == "-")
    {
        let minus_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
        if (env.ok == 0) { return "unknown" }
        if (type_is_numeric(minus_ty) == 0)
        {
            symtable_fail_expr(env, "operator '-' expects numeric operand", expr)
        }
        out_ty = minus_ty
    }
    elif (expr.text == "!")
    {
        let bang_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
        if (env.ok == 0) { return "unknown" }
        if (type_is_truthy(bang_ty) == 0)
        {
            symtable_fail_expr(env, "operator '!' expects bool or i32 operand", expr)
        }
        out_ty = "bool"
    }
    return out_ty
}

pub fn infer_binop_expr_type(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, expr: AstExpr): string
{
    let left_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
    if (env.ok == 0) { return "unknown" }
    let right_ty = infer_expr_type(env, funcs, structs, es, store, expr.right_idx)
    if (env.ok == 0) { return "unknown" }
    let mut out_ty = "unknown"
    if (expr.text == "==" or expr.text == "!=" or expr.text == "<" or expr.text == "<=" or expr.text == ">" or expr.text == ">=")
    {
        let ptr_int_compare_ok = if ((left_ty == "ptr" and type_is_integer(right_ty) == 1) or (right_ty == "ptr" and type_is_integer(left_ty) == 1)) { 1 } else { 0 }
        let ptr_string_compare_ok = if ((left_ty == "ptr" and right_ty == "string") or (right_ty == "ptr" and left_ty == "string")) { 1 } else { 0 }
        let string_int_compare_ok = if ((left_ty == "string" and type_is_integer(right_ty) == 1) or (right_ty == "string" and type_is_integer(left_ty) == 1)) { 1 } else { 0 }
        if (ptr_int_compare_ok == 0 and ptr_string_compare_ok == 0 and string_int_compare_ok == 0 and left_ty != right_ty and left_ty != "unknown" and right_ty != "unknown" and (type_is_numeric(left_ty) == 0 or type_is_numeric(right_ty) == 0))
        {
            symtable_fail_expr(env, "cannot compare operands", expr)
        }
        out_ty = "bool"
    }
    elif (expr.text == "and" or expr.text == "or")
    {
        if (type_is_truthy(left_ty) == 0)
        {
            symtable_fail_expr(env, "logical operator expects bool or i32 left operand", expr)
        }
        if (type_is_truthy(right_ty) == 0)
        {
            symtable_fail_expr(env, "logical operator expects bool or i32 right operand", expr)
        }
        out_ty = "bool"
    }
    elif (expr.text == "+")
    {
        if (left_ty == "string" or right_ty == "string" or left_ty == "ptr" or right_ty == "ptr")
        {
            let left_string_like = if (left_ty == "string" or left_ty == "ptr") { 1 } else { 0 }
            let right_string_like = if (right_ty == "string" or right_ty == "ptr") { 1 } else { 0 }
            let left_int = type_is_integer(left_ty)
            let right_int = type_is_integer(right_ty)
            if (left_string_like == 1 and right_int == 1)
            {
                out_ty = if (left_ty == "ptr") { "ptr" } else { "string" }
            }
            elif (left_int == 1 and right_string_like == 1)
            {
                out_ty = if (right_ty == "ptr") { "ptr" } else { "string" }
            }
            elif (left_string_like == 0 or right_string_like == 0)
            {
                symtable_fail_expr(env, "operator '+' cannot mix string with non-string", expr)
                out_ty = "unknown"
            }
            else
            {
                out_ty = "string"
            }
        }
        else
        {
            if (type_is_numeric(left_ty) == 0 or type_is_numeric(right_ty) == 0)
            {
                symtable_fail_expr(env, "operator '+' expects numeric operands", expr)
            }
            out_ty = type_numeric_result(left_ty, right_ty)
        }
    }
    elif (expr.text == "&" or expr.text == "|" or expr.text == "<<" or expr.text == ">>")
    {
        if (type_is_integer(left_ty) == 0 or type_is_integer(right_ty) == 0)
        {
            symtable_fail_expr(env, "bitwise operator expects integer operands", expr)
        }
        out_ty = type_numeric_result(left_ty, right_ty)
    }
    else
    {
        if (type_is_numeric(left_ty) == 0 or type_is_numeric(right_ty) == 0)
        {
            symtable_fail_expr(env, "binary operator expects numeric operands", expr)
        }
        out_ty = type_numeric_result(left_ty, right_ty)
    }
    return out_ty
}

pub fn infer_expr_type(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, idx: i32): string
{
    if (idx < 0) { return "unknown" }
    let expr = expr_store_get(es, idx)
    return match expr.tag
    {
        "int" -> "i32"
        "bool" -> "bool"
        "float" -> "f64"
        "string" -> "string"
        "ident" -> {
            if (expr.text == "")
            {
                symtable_fail_expr(env, "empty identifier in expression", expr)
                return "unknown"
            }
            let ty = symtable_lookup(env, expr.text)
            if (env.ok == 0) { symtable_set_error_loc(env, expr.line, expr.col) }
            ty
        }
        "option" -> {
            if (expr.option_has_value == 0) { return "Option[unknown]" }
            let value_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            "Option[" + value_ty + "]"
        }
        "addr" -> {
            if (expr.text == "")
            {
                symtable_fail_expr(env, "empty address-of target", expr)
                return "unknown"
            }
            let value_ty = symtable_lookup(env, expr.text)
            if (env.ok == 0) { symtable_set_error_loc(env, expr.line, expr.col) }
            if (env.ok == 0) { return "unknown" }
            "ptr:" + value_ty
        }
        "deref" -> {
            let ptr_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            if (ptr_ty == "unknown") { return "unknown" }
            if (ptr_ty == "string") { return "i8" }
            if (is_ptr_to_struct_typeinfer(ptr_ty) == 1)
            {
                return strip_ptr_prefix_typeinfer(ptr_ty)
            }
            if (ptr_ty != "ptr")
            {
                symtable_fail_expr(env, "cannot dereference value of type '" + ptr_ty + "'", expr)
                return "unknown"
            }
            "i32"
        }
        "field" -> {
            let base_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            if (base_ty == "string" and expr.text == "length")
            {
                return "i32"
            }
            if (type_text_is_array_typeinfer(base_ty) == 1 and expr.text == "length")
            {
                return "i32"
            }
            let struct_ty = strip_ptr_prefix_typeinfer(base_ty)
            let field_ty = struct_symbols_field_type(structs, struct_ty, expr.text)
            if (structs.ok == 0)
            {
                symtable_fail_expr(env, structs.error, expr)
                return "unknown"
            }
            field_ty
        }
        "struct_literal" -> {
            if (struct_symbols_find(structs, expr.text) < 0)
            {
                symtable_fail_expr(env, "unknown struct '" + expr.text + "'", expr)
                return "unknown"
            }
            let mut decl_field_count = 0
            for (i in 0 .. structs.field_structs.length)
            {
                if (structs.field_structs[i] == expr.text) { decl_field_count += 1 }
            }
            if (expr.field_names.length != decl_field_count)
            {
                symtable_fail_expr(env, "struct '" + expr.text + "' expects " + ast_i32(decl_field_count) + " fields, got " + ast_i32(expr.field_names.length), expr)
                return "unknown"
            }
            for (i in 0 .. expr.args.length)
            {
                let field_name = expr.field_names[i]
                for (j in (i + 1) .. expr.field_names.length)
                {
                    if (field_name == expr.field_names[j])
                    {
                        symtable_fail_expr(env, "duplicate initializer field '" + field_name + "' in struct '" + expr.text + "'", expr)
                        return "unknown"
                    }
                }
                let expected_ty = struct_symbols_field_type(structs, expr.text, field_name)
                if (structs.ok == 0)
                {
                    symtable_fail_expr(env, structs.error, expr)
                    return "unknown"
                }
                let actual_ty = infer_expr_type(env, funcs, structs, es, store, expr.args[i])
                if (env.ok == 0) { return "unknown" }
                let actual_expr = expr_store_get(es, expr.args[i])
                let empty_array_ok = if (actual_expr.tag == "array_literal" and actual_expr.args.length == 0 and type_text_is_array_typeinfer(expected_ty) == 1) { 1 } else { 0 }
                if (empty_array_ok == 0 and type_can_assign_expr(expected_ty, actual_ty, actual_expr) == 0)
                {
                    symtable_fail_expr(env, "cannot initialize field '" + field_name + "' of struct '" + expr.text + "' with '" + actual_ty + "'", expr)
                    return "unknown"
                }
            }
            for (i in 0 .. structs.field_structs.length)
            {
                if (structs.field_structs[i] == expr.text)
                {
                    let mut found = 0
                    for (j in 0 .. expr.field_names.length)
                    {
                        if (structs.field_names[i] == expr.field_names[j]) { found = 1 }
                    }
                    if (found == 0)
                    {
                        symtable_fail_expr(env, "missing field '" + structs.field_names[i] + "' in struct '" + expr.text + "'", expr)
                        return "unknown"
                    }
                }
            }
            expr.text
        }
        "call" -> {
            let func_idx = function_symbols_find(funcs, expr.text)
            if (func_idx < 0)
            {
                function_symbols_fail(funcs, "undefined function '" + expr.text + "'")
                symtable_fail_expr(env, funcs.error, expr)
                return "unknown"
            }
            let expected_args = funcs.arg_counts[func_idx]
            let is_var_arg = funcs.is_var_args[func_idx]
            if ((is_var_arg == 0 and expected_args != expr.args.length) or (is_var_arg == 1 and expr.args.length < expected_args))
            {
                symtable_fail_expr(env, "function '" + expr.text + "' expects " + ast_i32(expected_args) + " arguments, got " + ast_i32(expr.args.length), expr)
                return "unknown"
            }
            for (i in 0 .. expr.args.length)
            {
                let actual_ty = infer_expr_type(env, funcs, structs, es, store, expr.args[i])
                if (env.ok == 0) { return "unknown" }
                if (i < expected_args)
                {
                    let expected_ty = funcs.param_types[funcs.param_offsets[func_idx] + i]
                    let arg_expr = expr_store_get(es, expr.args[i])
                    let empty_array_arg_ok = if (arg_expr.tag == "array_literal" and arg_expr.args.length == 0 and type_text_is_array_typeinfer(expected_ty) == 1) { 1 } else { 0 }
                    if (empty_array_arg_ok == 0 and type_can_assign_expr(expected_ty, actual_ty, arg_expr) == 0)
                    {
                        symtable_fail_expr(env, "function '" + expr.text + "' argument " + ast_i32(i + 1) + " expects '" + expected_ty + "', got '" + actual_ty + "'", arg_expr)
                        return "unknown"
                    }
                }
            }
            funcs.return_types[func_idx]
        }
        "index" -> {
            infer_index_expr_type(env, funcs, structs, es, store, expr)
        }
        "unaryop" -> {
            infer_unary_expr_type(env, funcs, structs, es, store, expr)
        }
        "binop" -> {
            infer_binop_expr_type(env, funcs, structs, es, store, expr)
        }
        "array_literal" -> {
            if (expr.args.length == 0) { return "[unknown]" }
            let element_ty = infer_expr_type(env, funcs, structs, es, store, expr.args[0])
            if (env.ok == 0) { return "unknown" }
            for (i in 1 .. expr.args.length)
            {
                let actual_ty = infer_expr_type(env, funcs, structs, es, store, expr.args[i])
                if (env.ok == 0) { return "unknown" }
                if (type_can_assign(element_ty, actual_ty) == 0 and type_can_assign(actual_ty, element_ty) == 0)
                {
                    let elem_expr = expr_store_get(es, expr.args[i])
                    symtable_fail_expr(env, "array element type '" + actual_ty + "' does not match '" + element_ty + "'", elem_expr)
                    return "unknown"
                }
            }
            "[" + element_ty + "]"
        }
        "block_expr" -> {
            symtable_push_scope(env)
            infer_block_stmt_type_in_current_scope(env, funcs, structs, es, store, expr.left_idx, "unknown", 0)
            if (env.ok == 0)
            {
                symtable_pop_scope(env)
                return "unknown"
            }
            if (expr.right_idx >= 0)
            {
                let block_ty = infer_expr_type(env, funcs, structs, es, store, expr.right_idx)
                symtable_pop_scope(env)
                return block_ty
            }
            symtable_pop_scope(env)
            "i32"
        }
        "if_expr" -> {
            let cond_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            if (type_is_truthy(cond_ty) == 0)
            {
                symtable_fail_expr(env, "if expression condition expects bool or i32, got '" + cond_ty + "'", expr)
                return "unknown"
            }
            let then_ty = infer_expr_type(env, funcs, structs, es, store, expr.right_idx)
            if (env.ok == 0) { return "unknown" }
            let else_ty = infer_expr_type(env, funcs, structs, es, store, expr.args[0])
            if (env.ok == 0) { return "unknown" }
            if (type_can_assign(then_ty, else_ty) == 1)
            {
                return then_ty
            }
            if (type_can_assign(else_ty, then_ty) == 1)
            {
                return else_ty
            }
            symtable_fail_expr(env, "if expression branch type '" + else_ty + "' does not match '" + then_ty + "'", expr)
            "unknown"
        }
        "match_expr" -> {
            let subject_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            let mut result_ty = "unknown"
            let num_arms = expr.args.length / 2
            for (i in 0 .. num_arms)
            {
                let pattern_idx = expr.args[i * 2]
                let body_idx = expr.args[i * 2 + 1]
                if (pattern_idx >= 0)
                {
                    if (type_is_option_text(subject_ty) == 1)
                    {
                        let pattern_expr = expr_store_get(es, pattern_idx)
                        if (pattern_expr.tag != "option")
                        {
                            symtable_fail_expr(env, "match pattern type does not match subject type '" + subject_ty + "'", pattern_expr)
                            return "unknown"
                        }
                    }
                    else
                    {
                        let pattern_ty = infer_expr_type(env, funcs, structs, es, store, pattern_idx)
                        if (env.ok == 0) { return "unknown" }
                        if (type_can_assign(subject_ty, pattern_ty) == 0 and type_can_assign(pattern_ty, subject_ty) == 0)
                        {
                            let pattern_expr2 = expr_store_get(es, pattern_idx)
                            symtable_fail_expr(env, "match pattern type '" + pattern_ty + "' does not match subject type '" + subject_ty + "'", pattern_expr2)
                            return "unknown"
                        }
                    }
                }
                if (body_idx < 0) { continue }
                symtable_push_scope(env)
                if (type_is_option_text(subject_ty) == 1)
                {
                    infer_declare_option_match_binding(env, es, pattern_idx, type_option_inner(subject_ty))
                    if (env.ok == 0)
                    {
                        symtable_pop_scope(env)
                        return "unknown"
                    }
                }
                if (result_ty == "unknown")
                {
                    result_ty = infer_expr_type(env, funcs, structs, es, store, body_idx)
                    if (env.ok == 0)
                    {
                        symtable_pop_scope(env)
                        return "unknown"
                    }
                }
                else
                {
                    infer_expr_type(env, funcs, structs, es, store, body_idx)
                    if (env.ok == 0)
                    {
                        symtable_pop_scope(env)
                        return "unknown"
                    }
                    if (type_can_assign(result_ty, infer_expr_type(env, funcs, structs, es, store, body_idx)) == 1)
                    {
                    }
                    elif (type_can_assign(infer_expr_type(env, funcs, structs, es, store, body_idx), result_ty) == 1)
                    {
                        result_ty = infer_expr_type(env, funcs, structs, es, store, body_idx)
                    }
                    else
                    {
                        let body_expr = expr_store_get(es, body_idx)
                        symtable_fail_expr(env, "match return value type '" + infer_expr_type(env, funcs, structs, es, store, body_idx) + "' does not match '" + result_ty + "'", body_expr)
                        symtable_pop_scope(env)
                        return "unknown"
                    }
                }
                symtable_pop_scope(env)
            }
            result_ty
        }
        "method_call" -> {
            let base_ty = infer_expr_type(env, funcs, structs, es, store, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            if (expr.text == "push")
            {
                if (type_text_is_array_typeinfer(base_ty) == 0 and base_ty != "ptr")
                {
                    symtable_fail_expr(env, "method 'push' expects array receiver, got '" + base_ty + "'", expr)
                    return "unknown"
                }
                if (expr.args.length != 1)
                {
                    symtable_fail_expr(env, "method 'push' expects 1 argument, got " + ast_i32(expr.args.length), expr)
                    return "unknown"
                }
                let actual_ty = infer_expr_type(env, funcs, structs, es, store, expr.args[0])
                if (env.ok == 0) { return "unknown" }
                let element_ty = if (type_text_is_array_typeinfer(base_ty) == 1) { type_array_element_typeinfer(base_ty) } else { "unknown" }
                if (element_ty != "unknown" and type_can_assign(element_ty, actual_ty) == 0)
                {
                    let arg_expr = expr_store_get(es, expr.args[0])
                    symtable_fail_expr(env, "method 'push' expects element type '" + element_ty + "', got '" + actual_ty + "'", arg_expr)
                    return "unknown"
                }
                return "void"
            }
            for (i in 0 .. expr.args.length)
            {
                let __t2 = infer_expr_type(env, funcs, structs, es, store, expr.args[i])
                if (env.ok == 0) { return "unknown" }
            }
            "unknown"
        }
        _ -> "unknown"
    }
}

pub fn infer_stmt_type_in_loop(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, stmt_idx: i32, ret_ty: string, loop_depth: i32)
{
    if (stmt_idx < 0 or env.ok == 0) { return }
    let stmt = stmt_store_get(store, stmt_idx)
    match stmt.tag
    {
        "let" -> {
            let mut ty = infer_expr_type(env, funcs, structs, es, store, stmt.assign_idx)
            if (env.ok == 0) { return }
            if (stmt.type_text != "")
            {
                let init_expr = expr_store_get(es, stmt.assign_idx)
                let empty_array_init_ok = if (init_expr.tag == "array_literal" and init_expr.args.length == 0 and type_text_is_array_typeinfer(stmt.type_text) == 1) { 1 } else { 0 }
                if (empty_array_init_ok == 0 and type_can_assign_expr(stmt.type_text, ty, init_expr) == 0)
                {
                    symtable_fail_at(env, "cannot initialize '" + stmt.assign_name + "' of type '" + stmt.type_text + "' with '" + ty + "'", stmt.line, stmt.col)
                    return
                }
                ty = stmt.type_text
            }
            symtable_declare_mut(env, stmt.assign_name, ty, stmt.is_mut)
            if (env.ok == 0) { symtable_set_error_loc(env, stmt.line, stmt.col) }
        }
        "assign" -> {
            if (stmt.assign_name == "")
            {
                symtable_fail_stmt(env, "empty assignment target", stmt)
                return
            }
            let current_ty = symtable_lookup(env, stmt.assign_name)
            if (env.ok == 0) { symtable_set_error_loc(env, stmt.line, stmt.col) }
            if (env.ok == 0) { return }
            if (symtable_is_mutable(env, stmt.assign_name) == 0)
            {
                symtable_fail_stmt(env, "cannot assign to immutable binding '" + stmt.assign_name + "'", stmt)
                return
            }
            if (env.ok == 0) { symtable_set_error_loc(env, stmt.line, stmt.col) }
            let value_ty = infer_expr_type(env, funcs, structs, es, store, stmt.assign_idx)
            if (env.ok == 0) { return }
            let value_expr = expr_store_get(es, stmt.assign_idx)
            if (type_can_assign_expr(current_ty, value_ty, value_expr) == 0)
            {
                symtable_fail_stmt(env, "cannot assign '" + value_ty + "' to '" + stmt.assign_name + "' of type '" + current_ty + "'", stmt)
            }
        }
        "store_deref" -> {
            let ptr_ty = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
            if (env.ok == 0) { return }
            if (ptr_ty != "ptr" and ptr_ty != "unknown" and is_ptr_to_struct_typeinfer(ptr_ty) == 0 and ptr_ty != "string")
            {
                symtable_fail_stmt(env, "cannot store through value of type '" + ptr_ty + "'", stmt)
                return
            }
            let value_ty = infer_expr_type(env, funcs, structs, es, store, stmt.assign_idx)
            if (env.ok == 0) { return }
            let pointee_ty = if (is_ptr_to_struct_typeinfer(ptr_ty) == 1) { strip_ptr_prefix_typeinfer(ptr_ty) } elif (ptr_ty == "string") { "i8" } else { "i32" }
            if (type_can_assign(pointee_ty, value_ty) == 0)
            {
                symtable_fail_stmt(env, "cannot store '" + value_ty + "' through pointer of pointee type '" + pointee_ty + "'", stmt)
            }
        }
        "store_index" -> {
            let base_ty = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
            if (env.ok == 0) { return }
            let index_ty = infer_expr_type(env, funcs, structs, es, store, stmt.direct_ret)
            if (env.ok == 0) { return }
            if (type_is_integer(index_ty) == 0)
            {
                let index_expr = expr_store_get(es, stmt.direct_ret)
                symtable_fail_expr(env, "index expression expects integer index, got '" + index_ty + "'", index_expr)
                return
            }
            if (type_text_is_array_typeinfer(base_ty) == 0 and base_ty != "ptr" and base_ty != "string" and is_ptr_to_struct_typeinfer(base_ty) == 0)
            {
                symtable_fail_stmt(env, "cannot index value of type '" + base_ty + "'", stmt)
                return
            }
            let element_ty = type_index_element_typeinfer(base_ty)
            let value_ty = infer_expr_type(env, funcs, structs, es, store, stmt.assign_idx)
            if (env.ok == 0) { return }
            let indexed_value_expr = expr_store_get(es, stmt.assign_idx)
            if (type_can_assign_expr(element_ty, value_ty, indexed_value_expr) == 0)
            {
                symtable_fail_stmt(env, "cannot store '" + value_ty + "' into index of element type '" + element_ty + "'", stmt)
            }
        }
        "field_assign" -> {
            let base_ty = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
            if (env.ok == 0) { return }
            let base_name = infer_field_base_name(es, stmt.value_idx)
            if (base_name != "")
            {
                if (is_ptr_to_struct_typeinfer(base_ty) == 0 and symtable_is_mutable(env, base_name) == 0)
                {
                    symtable_fail_stmt(env, "cannot assign field '" + stmt.assign_name + "' through immutable binding '" + base_name + "'", stmt)
                    return
                }
            }
            if (env.ok == 0) { return }
            if (base_ty == "string")
            {
                symtable_fail_stmt(env, "cannot assign field '" + stmt.assign_name + "' on immutable string", stmt)
                return
            }
            let struct_ty = strip_ptr_prefix_typeinfer(base_ty)
            let field_ty = struct_symbols_field_type(structs, struct_ty, stmt.assign_name)
            if (structs.ok == 0)
            {
                symtable_fail_stmt(env, structs.error, stmt)
                return
            }
            let value_ty = infer_expr_type(env, funcs, structs, es, store, stmt.assign_idx)
            if (env.ok == 0) { return }
            let field_value_expr = expr_store_get(es, stmt.assign_idx)
            if (type_can_assign_expr(field_ty, value_ty, field_value_expr) == 0)
            {
                symtable_fail_stmt(env, "cannot assign '" + value_ty + "' to field '" + stmt.assign_name + "' of type '" + field_ty + "'", stmt)
            }
        }
        "return" -> {
            if (ret_ty == "void" or ret_ty == "unknown")
            {
                return
            }
            if (ret_ty != "i32" and ret_ty != "unknown")
            {
                symtable_fail_at_len(env, "return value type 'i32' does not match function return type '" + ret_ty + "'", stmt.line, stmt.col, 6)
            }
        }
        "return_expr" -> {
            let value_ty = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
            if (env.ok == 0) { return }
            let ret_expr = expr_store_get(es, stmt.value_idx)
            if (ret_ty != "void" and ret_ty != "unknown" and value_ty != "unknown" and type_can_assign_expr(ret_ty, value_ty, ret_expr) == 0)
            {
                symtable_fail_at_len(env, "return value type '" + value_ty + "' does not match function return type '" + ret_ty + "'", stmt.line, stmt.col, 6)
            }
        }
        "print" -> {
            let __t6 = infer_expr_type(env, funcs, structs, es, store, stmt.print_idx)
        }
        "expr" -> {
            let __t7 = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
        }
        "block" -> {
            symtable_push_scope(env)
            if (stmt.stmt_indices.length > 0)
            {
                for (i in 0 .. stmt.stmt_indices.length)
                {
                    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.stmt_indices[i], ret_ty, loop_depth)
                    if (env.ok == 0)
                    {
                        symtable_pop_scope(env)
                        return
                    }
                }
            }
            else
            {
                for (i in 0 .. stmt.block_count)
                {
                    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.block_start + i, ret_ty, loop_depth)
                    if (env.ok == 0)
                    {
                        symtable_pop_scope(env)
                        return
                    }
                }
            }
            symtable_pop_scope(env)
        }
        "while" -> {
            let cond_ty = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
            if (env.ok == 0) { return }
            if (type_is_truthy(cond_ty) == 0)
            {
                symtable_fail_stmt(env, "while condition must be bool or i32, got '" + cond_ty + "'", stmt)
                return
            }
            infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.body_idx, ret_ty, loop_depth + 1)
        }
        "for_range" -> {
            if (symtable_lookup_index(env, stmt.assign_name) >= 0)
            {
                symtable_fail_stmt(env, "for iterator '" + stmt.assign_name + "' conflicts with existing symbol", stmt)
                return
            }
            let start_ty = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
            if (env.ok == 0) { return }
            let end_ty = infer_expr_type(env, funcs, structs, es, store, stmt.assign_idx)
            if (env.ok == 0) { return }
            if (type_is_integer(start_ty) == 0)
            {
                symtable_fail_stmt(env, "for range start must be integer, got '" + start_ty + "'", stmt)
                return
            }
            if (type_is_integer(end_ty) == 0)
            {
                symtable_fail_stmt(env, "for range end must be integer, got '" + end_ty + "'", stmt)
                return
            }
            symtable_push_scope(env)
            symtable_declare_mut(env, stmt.assign_name, "i32", 1)
            if (env.ok == 0)
            {
                symtable_pop_scope(env)
                return
            }
            infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.body_idx, ret_ty, loop_depth + 1)
            symtable_pop_scope(env)
        }
        "break" | "continue" -> {
            if (loop_depth <= 0)
            {
                symtable_fail_stmt(env, "'" + stmt.tag + "' used outside loop", stmt)
            }
        }
        "if" -> {
            let cond_ty = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
            if (env.ok == 0) { return }
            if (type_is_truthy(cond_ty) == 0)
            {
                symtable_fail_stmt(env, "if condition must be bool or i32, got '" + cond_ty + "'", stmt)
                return
            }
            infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.body_idx, ret_ty, loop_depth)
            if (env.ok == 0) { return }
            if (stmt.assign_idx >= 0)
            {
                infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.assign_idx, ret_ty, loop_depth)
            }
        }
        "if_eq_return" -> {
            if (ret_ty != "i32" and ret_ty != "unknown")
            {
                symtable_fail_stmt(env, "if return value type 'i32' does not match function return type '" + ret_ty + "'", stmt)
            }
        }
        "match" -> {
            let subject_ty = infer_expr_type(env, funcs, structs, es, store, stmt.value_idx)
            if (env.ok == 0) { return }
            for (i in 0 .. stmt.match_pattern_indices.length)
            {
                let pattern_idx = stmt.match_pattern_indices[i]
                if (type_is_option_text(subject_ty) == 1)
                {
                    let inner_ty = type_option_inner(subject_ty)
                    symtable_push_scope(env)
                    if (pattern_idx >= 0)
                    {
                        let pattern_expr = expr_store_get(es, pattern_idx)
                        if (pattern_expr.tag != "option")
                        {
                            symtable_fail_expr(env, "match pattern type does not match subject type '" + subject_ty + "'", pattern_expr)
                            symtable_pop_scope(env)
                            return
                        }
                        if (pattern_expr.option_has_value == 1 and pattern_expr.left_idx >= 0)
                        {
                            let bind_expr = expr_store_get(es, pattern_expr.left_idx)
                            if (bind_expr.tag == "ident" and bind_expr.text != "_")
                            {
                                symtable_declare(env, bind_expr.text, inner_ty)
                                if (env.ok == 0)
                                {
                                    symtable_pop_scope(env)
                                    return
                                }
                            }
                        }
                    }
                    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.match_body_indices[i], ret_ty, loop_depth)
                    symtable_pop_scope(env)
                    if (env.ok == 0) { return }
                }
                elif (pattern_idx >= 0)
                {
                    let pattern_ty = infer_expr_type(env, funcs, structs, es, store, pattern_idx)
                    if (env.ok == 0) { return }
                    if (type_can_assign(subject_ty, pattern_ty) == 0 and type_can_assign(pattern_ty, subject_ty) == 0)
                    {
                        let pattern_expr = expr_store_get(es, pattern_idx)
                        symtable_fail_expr(env, "match pattern type '" + pattern_ty + "' does not match subject type '" + subject_ty + "'", pattern_expr)
                        return
                    }
                    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.match_body_indices[i], ret_ty, loop_depth)
                    if (env.ok == 0) { return }
                }
                else
                {
                    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.match_body_indices[i], ret_ty, loop_depth)
                    if (env.ok == 0) { return }
                }
            }
        }
        "match_option_string" -> {
            if (ret_ty != "i32" and ret_ty != "unknown")
            {
                symtable_fail_stmt(env, "match return value type 'i32' does not match function return type '" + ret_ty + "'", stmt)
            }
        }
        _ -> {}
    }
}

pub fn infer_block_stmt_type_in_current_scope(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, stmt_idx: i32, ret_ty: string, loop_depth: i32)
{
    if (stmt_idx < 0 or env.ok == 0) { return }
    let stmt = stmt_store_get(store, stmt_idx)
    if (stmt.tag != "block")
    {
        infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt_idx, ret_ty, loop_depth)
        return
    }
    if (stmt.stmt_indices.length > 0)
    {
        for (i in 0 .. stmt.stmt_indices.length)
        {
            infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.stmt_indices[i], ret_ty, loop_depth)
            if (env.ok == 0) { return }
        }
    }
    else
    {
        for (i in 0 .. stmt.block_count)
        {
            infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.block_start + i, ret_ty, loop_depth)
            if (env.ok == 0) { return }
        }
    }
}

pub fn infer_stmt_type(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, stmt_idx: i32, ret_ty: string)
{
    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt_idx, ret_ty, 0)
}

pub fn infer_function(func: AstFunction, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore): TypeInferResult
{
    let env = symtable_new()
    for (i in 0 .. func.param_names.length)
    {
        symtable_declare(&env, func.param_names[i], func.param_types[i])
        if (env.ok == 0)
        {
            return typeinfer_error_from_env(&env, func.ret_ty, func.name)
        }
    }
    infer_stmt_type(&env, funcs, structs, es, store, func.body_idx, func.ret_ty)
    if (env.ok == 0)
    {
        return typeinfer_error_from_env(&env, func.ret_ty, func.name)
    }
    return typeinfer_ok(func.ret_ty)
}

pub fn infer(program: AstProgram): TypeInferResult
{
    if (program.ok == 0)
    {
        return typeinfer_error(program.error, "unknown", "", 0, 0)
    }
    let funcs = function_symbols_new()
    let structs = struct_symbols_new()
    for (i in 0 .. program.structs.length)
    {
        struct_symbols_declare(&structs, program.structs[i])
        if (structs.ok == 0)
        {
            return typeinfer_error(structs.error, "unknown", "", structs.error_line, structs.error_col)
        }
    }
    for (i in 0 .. program.extern_functions.length)
    {
        function_symbols_declare_full_loc(&funcs, program.extern_functions[i].name, program.extern_functions[i].ret_ty, program.extern_functions[i].param_types, program.extern_functions[i].param_names.length, program.extern_functions[i].is_var_arg, program.extern_functions[i].line, program.extern_functions[i].col)
        if (funcs.ok == 0)
        {
            return typeinfer_error(funcs.error, "unknown", "", funcs.error_line, funcs.error_col)
        }
    }
    for (i in 0 .. program.functions.length)
    {
        function_symbols_declare_full_loc(&funcs, program.functions[i].name, program.functions[i].ret_ty, program.functions[i].param_types, program.functions[i].param_names.length, 0, program.functions[i].line, program.functions[i].col)
        if (funcs.ok == 0)
        {
            return typeinfer_error(funcs.error, "unknown", "", funcs.error_line, funcs.error_col)
        }
    }
    let expr_store = program.expr_store
    let stmt_store = program.store
    for (i in 0 .. program.functions.length)
    {
        let result = infer_function(program.functions[i], &funcs, &structs, &expr_store, &stmt_store)
        if (result.ok == 0)
        {
            return result
        }
    }
    return typeinfer_ok(program.function.ret_ty)
}

pub fn typeinfer_result_debug(result: TypeInferResult, source: string, filename: string): string
{
    if (result.ok == 0)
    {
        let message = if (result.error_func != "") { "in function " + result.error_func + ": " + result.error } else { result.error }
        if (result.line > 0)
        {
            return format_diagnostic(source, filename, diag_error_level(), "TypeError", message, result.line, result.col, result.span_len)
        }
        if (result.error_func != "")
        {
            return format_diagnostic_no_loc(diag_error_level(), "TypeError", "in function " + result.error_func + ": " + result.error, filename)
        }
        return format_diagnostic_no_loc(diag_error_level(), "TypeError", result.error, filename)
    }
    return "TypeOk(return_type=" + result.return_type + ")"
}

pub fn typeck_check_program(program: AstProgram): TypeInferResult
{
    return infer(program)
}

pub fn typeck_result_debug(result: TypeInferResult, source: string, filename: string): string
{
    return typeinfer_result_debug(result, source, filename)
}
