#[no_main]

import "../util/fresh.vix"

extern "C"
{
    fn malloc(size: usize): string
    fn snprintf(buf: string, size: usize, fmt: string, ...): i32
}

pub type Ty = TyUnknown | TyError | TyVar(i32) | TyPrim(i32) | TyFun(i32) | TyTuple(i32) | TyArray(i32) | TyPtr(i32) | TyAdt(i32)

pub type TyFunData = struct {
    params: [Ty],
    ret: Ty,
    is_var_arg: i32
}

pub type TyTupleData = struct {
    elems: [Ty]
}

pub type TyArrayData = struct {
    elem: Ty
}

pub type TyPtrData = struct {
    elem: Ty
}

pub type TyAdtData = struct {
    name: string,
    args: [Ty]
}

pub type TyStore = struct {
    funs: [TyFunData],
    tuples: [TyTupleData],
    arrays: [TyArrayData],
    ptrs: [TyPtrData],
    adts: [TyAdtData]
}

pub fn ty_store_new(): TyStore
{
    return TyStore{ funs: [], tuples: [], arrays: [], ptrs: [], adts: [] }
}

pub fn ty_i32_text(n: i32): string
{
    let buf: string = malloc(32)
    snprintf(buf, 32, "%d", n)
    return buf
}

pub fn ty_prim_i32(): i32 { return 1 }
pub fn ty_prim_i64(): i32 { return 2 }
pub fn ty_prim_u32(): i32 { return 3 }
pub fn ty_prim_u64(): i32 { return 4 }
pub fn ty_prim_i16(): i32 { return 5 }
pub fn ty_prim_u16(): i32 { return 6 }
pub fn ty_prim_i8(): i32 { return 7 }
pub fn ty_prim_u8(): i32 { return 8 }
pub fn ty_prim_usize(): i32 { return 9 }
pub fn ty_prim_f32(): i32 { return 10 }
pub fn ty_prim_f64(): i32 { return 11 }
pub fn ty_prim_bool(): i32 { return 12 }
pub fn ty_prim_string(): i32 { return 13 }
pub fn ty_prim_char(): i32 { return 14 }
pub fn ty_prim_void(): i32 { return 15 }
pub fn ty_prim_ptr(): i32 { return 16 }
pub fn ty_prim_never(): i32 { return 17 }

pub fn ty_prim_is_int64(code: i32): i32
{
    return match code {
        2 -> 1
        4 -> 1
        9 -> 1
        _ -> 0
    }
}

pub fn ty_prim_is_int32(code: i32): i32
{
    return match code {
        1 -> 1
        3 -> 1
        _ -> 0
    }
}

pub fn ty_prim_is_small_int(code: i32): i32
{
    return match code {
        5 -> 1
        6 -> 1
        7 -> 1
        8 -> 1
        14 -> 1
        _ -> 0
    }
}

pub fn ty_prim_is_integer(code: i32): i32
{
    if (ty_prim_is_int64(code) == 1 or ty_prim_is_int32(code) == 1 or ty_prim_is_small_int(code) == 1) return 1
    return 0
}

pub fn ty_prim_is_float(code: i32): i32
{
    return match code {
        10 -> 1
        11 -> 1
        _ -> 0
    }
}

pub fn ty_prim_is_numeric(code: i32): i32
{
    if (ty_prim_is_integer(code) == 1 or ty_prim_is_float(code) == 1) return 1
    return 0
}

pub fn ty_prim_can_assign(target_code: i32, value_code: i32): i32
{
    if (target_code == value_code) return 1
    if (target_code == ty_prim_ptr() and value_code == ty_prim_string()) return 1
    if (target_code == ty_prim_ptr() and ty_prim_is_integer(value_code) == 1) return 1
    if (target_code == ty_prim_string() and ty_prim_is_integer(value_code) == 1) return 1
    if (target_code == ty_prim_bool() and ty_prim_is_integer(value_code) == 1) return 1
    if (ty_prim_is_integer(target_code) == 1 and ty_prim_is_integer(value_code) == 1) return 1
    if (ty_prim_is_float(target_code) == 1 and ty_prim_is_numeric(value_code) == 1) return 1
    return 0
}

pub fn ty_fresh_var(fresh: &Fresh): Ty
{
    return TyVar(fresh_tyvar_id(fresh))
}

pub fn ty_unknown(): Ty
{
    return TyUnknown
}

pub fn ty_error(): Ty
{
    return TyError
}

pub fn ty_fun(store: &TyStore, params: [Ty], ret: Ty): Ty
{
    return ty_fun_vararg(store, params, ret, 0)
}

pub fn ty_fun_vararg(store: &TyStore, params: [Ty], ret: Ty, is_var_arg: i32): Ty
{
    let idx = store.funs.length
    store.funs.push(TyFunData{ params: params, ret: ret, is_var_arg: is_var_arg })
    return TyFun(idx)
}

pub fn ty_tuple(store: &TyStore, elems: [Ty]): Ty
{
    let idx = store.tuples.length
    store.tuples.push(TyTupleData{ elems: elems })
    return TyTuple(idx)
}

pub fn ty_array(store: &TyStore, elem: Ty): Ty
{
    let idx = store.arrays.length
    store.arrays.push(TyArrayData{ elem: elem })
    return TyArray(idx)
}

pub fn ty_ptr(store: &TyStore, elem: Ty): Ty
{
    let idx = store.ptrs.length
    store.ptrs.push(TyPtrData{ elem: elem })
    return TyPtr(idx)
}

pub fn ty_adt(store: &TyStore, name: string, args: [Ty]): Ty
{
    let idx = store.adts.length
    store.adts.push(TyAdtData{ name: name, args: args })
    return TyAdt(idx)
}

pub fn ty_prim_name(code: i32): string
{
    return match code {
        1 -> "i32"
        2 -> "i64"
        3 -> "u32"
        4 -> "u64"
        5 -> "i16"
        6 -> "u16"
        7 -> "i8"
        8 -> "u8"
        9 -> "usize"
        10 -> "f32"
        11 -> "f64"
        12 -> "bool"
        13 -> "string"
        14 -> "char"
        15 -> "void"
        16 -> "ptr"
        17 -> "never"
        _ -> "unknown"
    }
}

pub fn ty_prim_from_name(name: string): Ty
{
    return match name {
        "i32" -> TyPrim(ty_prim_i32())
        "i64" -> TyPrim(ty_prim_i64())
        "u32" -> TyPrim(ty_prim_u32())
        "u64" -> TyPrim(ty_prim_u64())
        "i16" -> TyPrim(ty_prim_i16())
        "u16" -> TyPrim(ty_prim_u16())
        "i8" -> TyPrim(ty_prim_i8())
        "u8" -> TyPrim(ty_prim_u8())
        "usize" -> TyPrim(ty_prim_usize())
        "f32" -> TyPrim(ty_prim_f32())
        "f64" -> TyPrim(ty_prim_f64())
        "bool" -> TyPrim(ty_prim_bool())
        "string" -> TyPrim(ty_prim_string())
        "char" -> TyPrim(ty_prim_char())
        "void" -> TyPrim(ty_prim_void())
        "ptr" -> TyPrim(ty_prim_ptr())
        _ -> TyUnknown
    }
}

pub fn ty_is_unknown(ty: Ty): i32
{
    return match ty {
        TyUnknown -> 1
        _ -> 0
    }
}

pub fn ty_is_error(ty: Ty): i32
{
    return match ty {
        TyError -> 1
        _ -> 0
    }
}

pub fn ty_is_var(ty: Ty): i32
{
    return match ty {
        TyVar(_) -> 1
        _ -> 0
    }
}

pub fn ty_is_array(ty: Ty): i32
{
    return match ty {
        TyArray(_) -> 1
        _ -> 0
    }
}

pub fn ty_var_id_or(ty: Ty, fallback: i32): i32
{
    return match ty {
        TyVar(id) -> id
        _ -> fallback
    }
}

pub fn ty_array_contains_i32(xs: [i32], value: i32): i32
{
    for (i in 0 .. xs.length)
    {
        if (xs[i] == value) return 1
    }
    return 0
}

pub fn ty_array_append_unique_i32(xs: [i32], value: i32): [i32]
{
    for (i in 0 .. xs.length)
    {
        if (xs[i] == value) return xs
    }
    xs.push(value)
    return xs
}

pub fn ty_collect_free_vars_except(store: &TyStore, ty: Ty, excluded: &[i32], out: &[i32]): i32
{
    return match ty
    {
        TyVar(id) -> {
            let mut blocked = 0
            for (i in 0 .. excluded.length)
            {
                if (excluded[i] == id) { blocked = 1 }
            }
            let mut present = 0
            for (i in 0 .. out.length)
            {
                if (out[i] == id) { present = 1 }
            }
            if (blocked == 0 and present == 0) { out.push(id) }
            0
        }
        TyFun(idx) -> {
            let data = store.funs[idx]
            for (i in 0 .. data.params.length)
            {
                ty_collect_free_vars_except(store, data.params[i], excluded, out)
            }
            ty_collect_free_vars_except(store, data.ret, excluded, out)
            0
        }
        TyTuple(idx) -> {
            let data = store.tuples[idx]
            for (i in 0 .. data.elems.length)
            {
                ty_collect_free_vars_except(store, data.elems[i], excluded, out)
            }
            0
        }
        TyArray(idx) -> ty_collect_free_vars_except(store, store.arrays[idx].elem, excluded, out)
        TyPtr(idx) -> ty_collect_free_vars_except(store, store.ptrs[idx].elem, excluded, out)
        TyAdt(idx) -> {
            let data = store.adts[idx]
            for (i in 0 .. data.args.length)
            {
                ty_collect_free_vars_except(store, data.args[i], excluded, out)
            }
            0
        }
        _ -> 0
    }
}

pub fn ty_has_free_vars(store: &TyStore, ty: Ty): i32
{
    match ty
    {
        TyVar(_) -> return 1
        TyFun(idx) -> {
            let data = store.funs[idx]
            for (i in 0 .. data.params.length)
            {
                if (ty_has_free_vars(store, data.params[i]) == 1) { return 1 }
            }
            return ty_has_free_vars(store, data.ret)
        }
        TyTuple(idx) -> {
            let data = store.tuples[idx]
            for (i in 0 .. data.elems.length)
            {
                if (ty_has_free_vars(store, data.elems[i]) == 1) { return 1 }
            }
            return 0
        }
        TyArray(idx) -> return ty_has_free_vars(store, store.arrays[idx].elem)
        TyPtr(idx) -> return ty_has_free_vars(store, store.ptrs[idx].elem)
        TyAdt(idx) -> {
            let data = store.adts[idx]
            for (i in 0 .. data.args.length)
            {
                if (ty_has_free_vars(store, data.args[i]) == 1) { return 1 }
            }
            return 0
        }
        _ -> return 0
    }
    return 0
}

pub fn ty_free_vars(store: &TyStore, ty: Ty): [i32]
{
    let excluded: [i32] = []
    let out: [i32] = []
    ty_collect_free_vars_except(store, ty, &excluded, &out)
    return out
}

pub fn ty_occurs(store: &TyStore, var_id: i32, ty: Ty): i32
{
    match ty
    {
        TyVar(id) -> {
            if (id == var_id) return 1
            return 0
        }
        TyFun(idx) -> {
            let data = store.funs[idx]
            for (i in 0 .. data.params.length)
            {
                if (ty_occurs(store, var_id, data.params[i]) == 1) return 1
            }
            return ty_occurs(store, var_id, data.ret)
        }
        TyTuple(idx) -> {
            let data = store.tuples[idx]
            for (i in 0 .. data.elems.length)
            {
                if (ty_occurs(store, var_id, data.elems[i]) == 1) return 1
            }
            return 0
        }
        TyArray(idx) -> { return ty_occurs(store, var_id, store.arrays[idx].elem) }
        TyPtr(idx) -> { return ty_occurs(store, var_id, store.ptrs[idx].elem) }
        TyAdt(idx) -> {
            let data = store.adts[idx]
            for (i in 0 .. data.args.length)
            {
                if (ty_occurs(store, var_id, data.args[i]) == 1) return 1
            }
            return 0
        }
        _ -> {}
    }
    return 0
}

pub fn ty_eq(store: &TyStore, left: Ty, right: Ty): i32
{
    match left
    {
        TyUnknown -> { return ty_is_unknown(right) }
        TyError -> { return ty_is_error(right) }
        TyVar(a) -> {
            match right
            {
                TyVar(b) -> {
                    if (a == b) return 1
                    return 0
                }
                _ -> {}
            }
            return 0
        }
        TyPrim(a) -> {
            match right
            {
                TyPrim(b) -> {
                    if (a == b) return 1
                    return 0
                }
                _ -> {}
            }
            return 0
        }
        TyFun(aidx) -> {
            match right
            {
                TyFun(bidx) -> {
                    let a = store.funs[aidx]
                    let b = store.funs[bidx]
                    if (a.params.length != b.params.length) return 0
                    for (i in 0 .. a.params.length)
                    {
                        if (ty_eq(store, a.params[i], b.params[i]) == 0) return 0
                    }
                    return ty_eq(store, a.ret, b.ret)
                }
                _ -> {}
            }
            return 0
        }
        TyTuple(aidx) -> {
            match right
            {
                TyTuple(bidx) -> {
                    let a = store.tuples[aidx]
                    let b = store.tuples[bidx]
                    if (a.elems.length != b.elems.length) return 0
                    for (i in 0 .. a.elems.length)
                    {
                        if (ty_eq(store, a.elems[i], b.elems[i]) == 0) return 0
                    }
                    return 1
                }
                _ -> {}
            }
            return 0
        }
        TyArray(aidx) -> {
            match right
            {
                TyArray(bidx) -> { return ty_eq(store, store.arrays[aidx].elem, store.arrays[bidx].elem) }
                _ -> {}
            }
            return 0
        }
        TyPtr(aidx) -> {
            match right
            {
                TyPtr(bidx) -> { return ty_eq(store, store.ptrs[aidx].elem, store.ptrs[bidx].elem) }
                _ -> {}
            }
            return 0
        }
        TyAdt(aidx) -> {
            match right
            {
                TyAdt(bidx) -> {
                    let a = store.adts[aidx]
                    let b = store.adts[bidx]
                    if (a.name != b.name or a.args.length != b.args.length) return 0
                    for (i in 0 .. a.args.length)
                    {
                        if (ty_eq(store, a.args[i], b.args[i]) == 0) return 0
                    }
                    return 1
                }
                _ -> {}
            }
            return 0
        }
    }
    return 0
}

pub fn ty_to_string(store: &TyStore, ty: Ty): string
{
    match ty
    {
        TyUnknown -> { return "unknown" }
        TyError -> { return "<type-error>" }
        TyVar(id) -> { return "t" + ty_i32_text(id) }
        TyPrim(code) -> { return ty_prim_name(code) }
        TyFun(idx) -> {
            let data = store.funs[idx]
            let mut out = "fn("
            for (i in 0 .. data.params.length)
            {
                if (i > 0) out = out + ", "
                out = out + ty_to_string(store, data.params[i])
            }
            out = out + "): " + ty_to_string(store, data.ret)
            return out
        }
        TyTuple(idx) -> {
            let data = store.tuples[idx]
            let mut out = "("
            for (i in 0 .. data.elems.length)
            {
                if (i > 0) out = out + ", "
                out = out + ty_to_string(store, data.elems[i])
            }
            return out + ")"
        }
        TyArray(idx) -> { return "[" + ty_to_string(store, store.arrays[idx].elem) + "]" }
        TyPtr(idx) -> { return "ptr:" + ty_to_string(store, store.ptrs[idx].elem) }
        TyAdt(idx) -> {
            let data = store.adts[idx]
            if (data.args.length == 0) return data.name
            let mut out = data.name + ":["
            for (i in 0 .. data.args.length)
            {
                if (i > 0) out = out + ", "
                out = out + ty_to_string(store, data.args[i])
            }
            return out + "]"
        }
    }
    return "unknown"
}

pub fn ty_from_text(store: &TyStore, text: string): Ty
{
    let prim = text
        |> ty_prim_from_name
    if (ty_is_unknown(prim) == 0) return prim
    if (text == "unknown" or text == "") return TyUnknown
    if (text.length >= 5 and compiler_string_byte(text, 0) == 'f' and compiler_string_byte(text, 1) == 'n' and compiler_string_byte(text, 2) == '(')
    {
        let mut close: ?i32 = None
        let mut depth = 0
        for (i in 2 .. text.length)
        {
            if (compiler_string_byte(text, i) == '(' or compiler_string_byte(text, i) == '[') depth += 1
            elif (compiler_string_byte(text, i) == ')' or compiler_string_byte(text, i) == ']')
            {
                depth -= 1
                if (compiler_string_byte(text, i) == ')' and depth == 0)
                {
                    close = Some(i)
                    break
                }
            }
        }
        match close
        {
            Some(close_idx) -> {
                let mut params: [Ty] = []
                let mut start = 3
                depth = 0
                for (i in 3 .. close_idx + 1)
                {
                    let at_end = i == close_idx
                    if (at_end == 0 and (compiler_string_byte(text, i) == '(' or compiler_string_byte(text, i) == '[')) depth += 1
                    elif (at_end == 0 and (compiler_string_byte(text, i) == ')' or compiler_string_byte(text, i) == ']')) depth -= 1
                    if (at_end == 1 or (compiler_string_byte(text, i) == ',' and depth == 0))
                    {
                        let part = ty_trim(ty_slice(text, start, i))
                        if (part != "") params.push(ty_from_text(store, part))
                        start = i + 1
                    }
                }
                let mut ret_start = close_idx + 1
                while (ret_start < text.length and (compiler_string_byte(text, ret_start) == ':' or compiler_string_byte(text, ret_start) == ' '))
                {
                    ret_start += 1
                }
                return ty_fun(store, params, ty_from_text(store, ty_trim(ty_slice(text, ret_start, text.length))))
            }
            None -> {}
        }
    }
    if (text.length > 1 and compiler_string_byte(text, 0) == '&')
    {
        return ty_ptr(store, ty_from_text(store, ty_slice(text, 1, text.length)))
    }
    if (text.length > 4 and compiler_string_byte(text, 0) == 'r' and compiler_string_byte(text, 1) == 'e' and compiler_string_byte(text, 2) == 'f' and compiler_string_byte(text, 3) == ' ')
    {
        return ty_ptr(store, ty_from_text(store, ty_slice(text, 4, text.length)))
    }
    if (text.length > 4 and compiler_string_byte(text, 0) == 'p' and compiler_string_byte(text, 1) == 't' and compiler_string_byte(text, 2) == 'r' and compiler_string_byte(text, 3) == ':')
    {
        let mut inner = ""
        for (i in 4 .. text.length)
        {
            let s: string = malloc(2)
            s[0] = compiler_string_byte(text, i)
            s[1] = 0
            inner = inner + s
        }
        return ty_ptr(store, ty_from_text(store, inner))
    }
    match ty_find_char(text, '[')
    {
        Some(generic_open) -> if (generic_open > 0)
        {
            let mut base_end = generic_open
            if (base_end > 0 and compiler_string_byte(text, base_end - 1) == ':') base_end -= 1
            let base = ty_slice(text, 0, base_end)
            let mut args: [Ty] = []
            let mut start = generic_open + 1
            let mut depth = 0
            for (i in generic_open + 1 .. text.length)
            {
                if (compiler_string_byte(text, i) == '[') depth += 1
                elif (compiler_string_byte(text, i) == ']')
                {
                    if (depth == 0)
                    {
                        let arg = ty_trim(ty_slice(text, start, i))
                        if (arg != "") args.push(ty_from_text(store, arg))
                        return ty_adt(store, base, args)
                    }
                    depth -= 1
                }
                elif (compiler_string_byte(text, i) == ',' and depth == 0)
                {
                    let arg2 = ty_trim(ty_slice(text, start, i))
                    if (arg2 != "") args.push(ty_from_text(store, arg2))
                    start = i + 1
                }
            }
            return ty_adt(store, base, args)
        }
        None -> {}
    }
    if (text.length > 2 and compiler_string_byte(text, 0) == '[')
    {
        let mut inner = ""
        for (i in 1 .. text.length - 1)
        {
            if (compiler_string_byte(text, i) == '*') return ty_array(store, ty_from_text(store, inner))
            let s: string = malloc(2)
            s[0] = compiler_string_byte(text, i)
            s[1] = 0
            inner = inner + s
        }
        return ty_array(store, ty_from_text(store, inner))
    }
    return ty_adt(store, text, [])
}

pub fn ty_find_char(text: string, needle: i32): ?i32
{
    for (i in 0 .. text.length)
    {
        if (compiler_string_byte(text, i) == needle) return Some(i)
    }
    return None
}

pub fn ty_char_string(ch: i32): string
{
    let s: string = malloc(2)
    s[0] = ch
    s[1] = 0
    return s
}

pub fn ty_slice(text: string, start: i32, end: i32): string
{
    let mut out = ""
    for (i in start .. end)
    {
        out = out + ty_char_string(compiler_string_byte(text, i))
    }
    return out
}

pub fn ty_trim(text: string): string
{
    let mut start = 0
    let mut end = text.length
    while (start < end)
    {
        if (compiler_string_byte(text, start) != ' ') break
        start += 1
    }
    while (end > start)
    {
        if (compiler_string_byte(text, end - 1) != ' ') break
        end -= 1
    }
    return ty_slice(text, start, end)
}
