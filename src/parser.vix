#[no_main]
import "lexer.vix"
import "ast.vix"
import "error.vix"
import "preprocess.vix"

pub type Parser = struct {
    stream: TokenStream,
    pos: i32,
    ok: i32,
    error: string,
    expr_store: ExprStore,
    store: StmtStore,
    source: string,
    filename: string,
    current_function: string,
    lambda_counter: i32,
    lambda_functions: [AstFunction]
}

pub fn parser_new(src: string, filename: string): Parser
{
    return Parser{ stream: tokenize(src), pos: 0, ok: 1, error: "", expr_store: expr_store_new(), store: stmt_store_new(), source: src, filename: filename, current_function: "global", lambda_counter: 0, lambda_functions: [] }
}

pub fn parser_kind(parser: &Parser): i32
{
    return stream_kind_at(parser.stream, parser.pos)
}

pub fn parser_text(parser: &Parser): string
{
    return stream_text_at(parser.stream, parser.pos)
}

pub fn parser_int(parser: &Parser): i32
{
    return stream_int_at(parser.stream, parser.pos)
}

pub fn parser_line(parser: &Parser): i32
{
    return stream_line_at(parser.stream, parser.pos)
}

pub fn parser_col(parser: &Parser): i32
{
    return stream_col_at(parser.stream, parser.pos)
}

pub fn parser_expr_at(parser: &Parser, idx: i32, line: i32, col: i32): i32
{
    if (idx >= 0)
    {
        expr_store_set_loc(parser.expr_store, idx, line, col)
    }
    return idx
}

pub fn parser_stmt_at(parser: &Parser, idx: i32, line: i32, col: i32): i32
{
    if (idx >= 0)
    {
        stmt_store_set_loc(parser.store, idx, line, col)
    }
    return idx
}

pub fn parser_float(parser: &Parser): f64
{
    return stream_float_at(parser.stream, parser.pos)
}

pub fn parser_at_end(parser: &Parser): i32
{
    if (parser_kind(parser) == tk_eof()) { return 1 }
    return 0
}

pub fn parser_advance(parser: &Parser)
{
    if (parser.pos + 1 < stream_len(parser.stream))
    {
        parser.pos += 1
    }
}

pub fn parser_fail(parser: &Parser, message: string)
{
    if (parser.ok == 1)
    {
        parser.ok = 0
        let mut line = parser_line(parser)
        let mut col = parser_col(parser)
        let text = parser_text(parser)
        let mut length = 1
        if (text != "" and text != ";" and text != "," and text != "{" and text != "}" and text != "(" and text != ")" and text != "[" and text != "]" and text != "=>" and text != "->" and text != ".." and text != "..." and text != "==" and text != "!=" and text != "<=" and text != ">=" and text != "+=" and text != "-=" and text != "<<" and text != ">>")
        {
            length = diag_strlen(text)
        }
        if (parser_kind(parser) == tk_eof())
        {
            if (parser.pos > 0)
            {
                line = stream_line_at(parser.stream, parser.pos - 1)
                col = stream_col_at(parser.stream, parser.pos - 1)
            }
        }
        parser.error = format_diagnostic(parser.source, parser.filename, diag_error_level(), "ParseError", message, line, col, length)
    }
}

pub fn parser_accept_text(parser: &Parser, text: string): i32
{
    if (parser_text(parser) == text)
    {
        parser_advance(parser)
        return 1
    }
    return 0
}

pub fn parser_expect_text(parser: &Parser, text: string): i32
{
    if (parser_accept_text(parser, text) == 1)
    {
        return 1
    }
    parser_fail(parser, "expected '" + text + "', got '" + parser_text(parser) + "'")
    return 0
}

pub fn parser_expect_kind(parser: &Parser, kind: i32): i32
{
    if (parser_kind(parser) == kind)
    {
        parser_advance(parser)
        return 1
    }
    parser_fail(parser, "unexpected token '" + parser_text(parser) + "'")
    return 0
}

pub fn parse_expression(parser: &Parser): i32
{
    let mut left = parse_logical_or(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_text(parser) == "|>")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let mut right = -1
        if (parser_kind(parser) == tk_ident() and stream_text_at(parser.stream, parser.pos + 1) == "[")
        {
            let name = parser_text(parser)
            parser_advance(parser)
            let type_args = parse_generic_call_type_args(parser)
            if (parser.ok == 0) { return -1 }
            let mut explicit_args: [i32] = []
            if (parser_text(parser) == "(")
            {
                parser_advance(parser)
                if (parser_text(parser) != ")")
                {
                    explicit_args.push(parse_expression(parser))
                    if (parser.ok == 0) { return -1 }
                    while (parser_text(parser) == ",")
                    {
                        parser_advance(parser)
                        explicit_args.push(parse_expression(parser))
                        if (parser.ok == 0) { return -1 }
                    }
                }
                parser_expect_text(parser, ")")
                if (parser.ok == 0) { return -1 }
            }
            right = parser_expr_at(parser, ast_expr_call_generic(parser.expr_store, name, type_args, explicit_args), line, col)
        }
        else
        {
            right = parse_postfix(parser)
            if (parser.ok == 0) { return -1 }
        }
        let target = expr_store_get(parser.expr_store, right)
        if (target.tag == "call")
        {
            let mut args: [i32] = [left]
            for (i in 0 .. target.args.length) { args.push(target.args[i]) }
            left = parser_expr_at(parser, ast_expr_call_generic(parser.expr_store, target.text, target.type_args, args), line, col)
        }
        elif (target.tag == "ident")
        {
            left = parser_expr_at(parser, ast_expr_call(parser.expr_store, target.text, [left]), line, col)
        }
        else
        {
            parser_fail(parser, "pipeline target must be a function call or identifier")
            return -1
        }
    }
    return left
}

pub fn parse_logical_or(parser: &Parser): i32
{
    let mut left = parse_logical_and(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_kind(parser) == tk_keyword() and parser_text(parser) == "or")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_logical_and(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "or", left, right), line, col)
    }
    return left
}

pub fn parse_logical_and(parser: &Parser): i32
{
    let mut left = parse_bitwise_or(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_kind(parser) == tk_keyword() and parser_text(parser) == "and")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_bitwise_or(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "and", left, right), line, col)
    }
    return left
}

pub fn parse_bitwise_or(parser: &Parser): i32
{
    let mut left = parse_bitwise_and(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_kind(parser) == tk_symbol() and parser_text(parser) == "|")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_bitwise_and(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "|", left, right), line, col)
    }
    return left
}

pub fn parse_bitwise_and(parser: &Parser): i32
{
    let mut left = parse_comparison(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_kind(parser) == tk_symbol() and parser_text(parser) == "&")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_comparison(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "&", left, right), line, col)
    }
    return left
}

pub fn parse_comparison(parser: &Parser): i32
{
    let left = parse_shift(parser)
    if (parser.ok == 0) { return -1 }
    if (parser_kind(parser) == tk_symbol() and (parser_text(parser) == "==" or parser_text(parser) == "!=" or parser_text(parser) == "<" or parser_text(parser) == "<=" or parser_text(parser) == ">" or parser_text(parser) == ">="))
    {
        let op = parser_text(parser)
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_shift(parser)
        if (parser.ok == 0) { return -1 }
        return parser_expr_at(parser, ast_expr_binop(parser.expr_store, op, left, right), line, col)
    }
    return left
}

pub fn parse_shift(parser: &Parser): i32
{
    let mut left = parse_additive(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_kind(parser) == tk_symbol() and (parser_text(parser) == "<<" or parser_text(parser) == ">>"))
    {
        let op = parser_text(parser)
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_additive(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, op, left, right), line, col)
    }
    return left
}

pub fn parse_additive(parser: &Parser): i32
{
    let mut left = parse_multiplicative(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_kind(parser) == tk_symbol() and (parser_text(parser) == "+" or parser_text(parser) == "-"))
    {
        let op = parser_text(parser)
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_multiplicative(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, op, left, right), line, col)
    }
    return left
}

pub fn parse_multiplicative(parser: &Parser): i32
{
    let mut left = parse_unary(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_kind(parser) == tk_symbol() and (parser_text(parser) == "*" or parser_text(parser) == "/" or parser_text(parser) == "%"))
    {
        let op = parser_text(parser)
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_unary(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, op, left, right), line, col)
    }
    return left
}

pub fn parse_unary(parser: &Parser): i32
{
    if (parser_kind(parser) == tk_string())
    {
        return parse_postfix(parser)
    }
    if (parser_text(parser) == "ref" or parser_text(parser) == "&")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let name = parser_text(parser)
        if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
        return parser_expr_at(parser, ast_expr_addr(parser.expr_store, name), line, col)
    }
    return match parser_text(parser) {
        "@" -> {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let operand = parse_unary(parser)
            if (parser.ok == 0) { return -1 }
            parser_expr_at(parser, ast_expr_deref(parser.expr_store, operand), line, col)
        }
        "-" -> {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let operand = parse_unary(parser)
            if (parser.ok == 0) { return -1 }
            parser_expr_at(parser, ast_expr_unaryop(parser.expr_store, "-", operand), line, col)
        }
        "!" -> {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let operand = parse_unary(parser)
            if (parser.ok == 0) { return -1 }
            parser_expr_at(parser, ast_expr_unaryop(parser.expr_store, "!", operand), line, col)
        }
        _ -> parse_postfix(parser)
    }
}

pub fn parse_postfix(parser: &Parser): i32
{
    let mut expr = parse_primary(parser)
    if (parser.ok == 0) { return -1 }
    return parse_postfix_continue(parser, expr)
}

pub fn parse_postfix_from(parser: &Parser, expr_idx: i32): i32
{
    return parse_postfix_continue(parser, expr_idx)
}

pub fn parser_generic_call_ahead(parser: &Parser): i32
{
    let mut pos = parser.pos
    if (stream_text_at(parser.stream, pos) == ":") { pos += 1 }
    if (stream_text_at(parser.stream, pos) != "[") { return 0 }
    let mut depth = 0
    while (pos < stream_len(parser.stream))
    {
        let text = stream_text_at(parser.stream, pos)
        if (text == "[") { depth += 1 }
        elif (text == "]")
        {
            depth -= 1
            if (depth == 0)
            {
                return if (stream_text_at(parser.stream, pos + 1) == "(") { 1 } else { 0 }
            }
        }
        pos += 1
    }
    return 0
}

pub fn parse_generic_call_type_args(parser: &Parser): [string]
{
    if (parser_text(parser) == ":") { parser_advance(parser) }
    parser_expect_text(parser, "[")
    let mut args: [string] = []
    while (parser_text(parser) != "]" and parser_at_end(parser) == 0)
    {
        args.push(parse_type_text(parser))
        if (parser.ok == 0) { return args }
        if (parser_text(parser) != ",") { break }
        parser_advance(parser)
    }
    parser_expect_text(parser, "]")
    return args
}

pub fn parse_postfix_continue(parser: &Parser, expr_idx: i32): i32
{
    let mut expr = expr_idx
    while (parser_text(parser) == "[" or parser_text(parser) == "." or parser_text(parser) == "(")
    {
        if (parser_text(parser) == "[")
        {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let index_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            if (parser_text(parser) == "..")
            {
                parser_advance(parser)
                let end_idx = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                parser_expect_text(parser, "]")
                if (parser.ok == 0) { return -1 }
                expr = parser_expr_at(parser, ast_expr_slice(parser.expr_store, expr, index_idx, end_idx), line, col)
                continue
            }
            parser_expect_text(parser, "]")
            if (parser.ok == 0) { return -1 }
            expr = parser_expr_at(parser, ast_expr_index(parser.expr_store, expr, index_idx), line, col)
        }
        elif (parser_text(parser) == ".")
        {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let field_name = parser_text(parser)
            if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
            expr = parser_expr_at(parser, ast_expr_field(parser.expr_store, expr, field_name), line, col)
        }
        elif (parser_text(parser) == "(")
        {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let mut args: [i32] = []
            if (parser_text(parser) != ")")
            {
                let arg = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                args.push(arg)
                while (parser_text(parser) == ",")
                {
                    parser_advance(parser)
                    let arg2 = parse_expression(parser)
                    if (parser.ok == 0) { return -1 }
                    args.push(arg2)
                }
            }
            parser_expect_text(parser, ")")
            if (parser.ok == 0) { return -1 }
            let func_expr = expr_store_get(parser.expr_store, expr)
            if (func_expr.tag == "field")
            {
                expr = parser_expr_at(parser, ast_expr_method_call(parser.expr_store, func_expr.left_idx, func_expr.text, args), line, col)
            }
            elif (func_expr.tag == "ident")
            {
                expr = parser_expr_at(parser, ast_expr_call(parser.expr_store, func_expr.text, args), line, col)
            }
            else
            {
                expr = parser_expr_at(parser, ast_expr_call_expr(parser.expr_store, expr, args), line, col)
            }
        }
    }
    return expr
}

pub fn parse_match_expr(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    parser_expect_text(parser, "match")
    if (parser.ok == 0) { return -1 }
    
    let mut subject_idx = -1
    if ((parser_kind(parser) == tk_ident() or parser_kind(parser) == tk_keyword()) and stream_text_at(parser.stream, parser.pos + 1) == "{")
    {
        let subject_name = parser_text(parser)
        parser_advance(parser)
        subject_idx = ast_expr_identifier(parser.expr_store, subject_name)
    }
    else
    {
        subject_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
    }
    
    parser_expect_text(parser, "{")
    if (parser.ok == 0) { return -1 }
    
    let mut patterns: [i32] = []
    let mut bodies: [i32] = []
    
    while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
    {
        while (parser_text(parser) == ";") { parser_advance(parser) }
        if (parser_text(parser) == "}" or parser_at_end(parser) == 1) { break }

        let arm_start = patterns.length
        if (parser_text(parser) == "_")
        {
            parser_advance(parser)
            patterns.push(-1)
        }
        else
        {
            let pattern_idx = parse_match_pattern(parser)
            if (parser.ok == 0) { return -1 }
            patterns.push(pattern_idx)
        }
        
        while (parser_text(parser) == "|")
        {
            parser_advance(parser)
            if (parser_text(parser) == "_")
            {
                patterns.push(-1)
                parser_advance(parser)
            }
            else
            {
                let pat_idx = parse_match_pattern(parser)
                if (parser.ok == 0) { return -1 }
                patterns.push(pat_idx)
            }
        }

        parser_expect_text(parser, "->")
        if (parser.ok == 0) { return -1 }

        let mut body_idx = -1
        if (parser_text(parser) == "{")
        {
            body_idx = parse_block_expression(parser)
        }
        else
        {
            body_idx = parse_expression(parser)
        }
        if (parser.ok == 0) { return -1 }
        for (__pattern in arm_start .. patterns.length)
        {
            bodies.push(body_idx)
        }

        parser_accept_text(parser, ",")
    }
    
    parser_expect_text(parser, "}")
    if (parser.ok == 0) { return -1 }
    
    return parser_expr_at(parser, ast_expr_match(parser.expr_store, subject_idx, patterns, bodies), line, col)
}

pub fn parse_if_expr_body(parser: &Parser): i32
{
    if (parser_text(parser) == "{")
    {
        return parse_block_expression(parser)
    }
    return parse_expression(parser)
}

pub fn parse_if_expr(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    let keyword = parser_text(parser)
    if (keyword != "if" and keyword != "elif")
    {
        parser_fail(parser, "expected if or elif expression")
        return -1
    }
    parser_advance(parser)
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, "(")
    if (parser.ok == 0) { return -1 }
    let cond_idx = parse_expression(parser)
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, ")")
    if (parser.ok == 0) { return -1 }
    let then_idx = parse_if_expr_body(parser)
    if (parser.ok == 0) { return -1 }
    if (parser_text(parser) == "elif")
    {
        let else_idx = parse_if_expr(parser)
        if (parser.ok == 0) { return -1 }
        return parser_expr_at(parser, ast_expr_if(parser.expr_store, cond_idx, then_idx, else_idx), line, col)
    }
    parser_expect_text(parser, "else")
    if (parser.ok == 0) { return -1 }
    let else_idx = parse_if_expr_body(parser)
    if (parser.ok == 0) { return -1 }
    return parser_expr_at(parser, ast_expr_if(parser.expr_store, cond_idx, then_idx, else_idx), line, col)
}

pub fn parse_block_expression(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_expect_text(parser, "{") == 0) { return -1 }
    let mut indices: [i32] = []
    while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
    {
        while (parser_text(parser) == ";") { parser_advance(parser) }
        if (parser_text(parser) == "}" or parser_at_end(parser) == 1) { break }
        let text = parser_text(parser)
        let mut is_stmt_start = if (text == "let" or text == "return" or text == "print" or text == "while" or text == "for" or text == "break" or text == "continue" or text == "if" or text == "match" or text == "@") { 1 } else { 0 }
        if (parser_kind(parser) == tk_ident())
        {
            let mut next_text = ""
            let mut next_next_text = ""
            if (parser.pos + 1 < stream_len(parser.stream))
            {
                next_text = stream_text_at(parser.stream, parser.pos + 1)
            }
            if (parser.pos + 2 < stream_len(parser.stream))
            {
                next_next_text = stream_text_at(parser.stream, parser.pos + 2)
            }
            if (next_text == "=" or next_text == "+=" or next_text == "-=") { is_stmt_start = 1 }
            if (next_text == "}" or next_text == "else" or (next_text == ";" and (next_next_text == "}" or next_next_text == "else")))
            {
                is_stmt_start = 0
            }
            if (next_text == "::")
            {
                // scan past the full module path to find what follows
                let mut scan_pos = parser.pos + 2
                while (scan_pos + 1 < stream_len(parser.stream) and stream_text_at(parser.stream, scan_pos + 1) == "::")
                {
                    scan_pos += 2
                }
                let mut after_path = ""
                if (scan_pos + 1 < stream_len(parser.stream))
                {
                    after_path = stream_text_at(parser.stream, scan_pos + 1)
                }
                if (after_path == "(")
                {
                    let mut scan_pos2 = scan_pos + 2
                    let mut paren_depth2 = 1
                    while (scan_pos2 < stream_len(parser.stream) and paren_depth2 > 0)
                    {
                        let scan_text2 = stream_text_at(parser.stream, scan_pos2)
                        if (scan_text2 == "(") { paren_depth2 += 1 }
                        elif (scan_text2 == ")") { paren_depth2 -= 1 }
                        scan_pos2 += 1
                    }
                    let mut after_call2 = ""
                    if (scan_pos2 < stream_len(parser.stream))
                    {
                        after_call2 = stream_text_at(parser.stream, scan_pos2)
                    }
                    if (after_call2 == "+" or after_call2 == "-" or after_call2 == "*" or after_call2 == "/" or after_call2 == "==" or after_call2 == "!=" or after_call2 == "<" or after_call2 == "<=" or after_call2 == ">" or after_call2 == ">=" or after_call2 == "and" or after_call2 == "or")
                    {
                        is_stmt_start = 0
                    }
                    elif (scan_pos2 >= stream_len(parser.stream) or (after_call2 != "}" and after_call2 != "else"))
                    {
                        is_stmt_start = 1
                    }
                }
                elif (after_path == "=" or after_path == "+=" or after_path == "-=")
                {
                    is_stmt_start = 1
                }
            }
            if (next_text == "(")
            {
                let mut scan_pos = parser.pos + 2
                let mut paren_depth = 1
                while (scan_pos < stream_len(parser.stream) and paren_depth > 0)
                {
                    let scan_text = stream_text_at(parser.stream, scan_pos)
                    if (scan_text == "(") { paren_depth += 1 }
                    elif (scan_text == ")") { paren_depth -= 1 }
                    scan_pos += 1
                }
                let mut after_call = ""
                if (scan_pos < stream_len(parser.stream))
                {
                    after_call = stream_text_at(parser.stream, scan_pos)
                }
                if (after_call == "+" or after_call == "-" or after_call == "*" or after_call == "/" or after_call == "==" or after_call == "!=" or after_call == "<" or after_call == "<=" or after_call == ">" or after_call == ">=" or after_call == "and" or after_call == "or")
                {
                    is_stmt_start = 0
                }
                elif (scan_pos >= stream_len(parser.stream) or (after_call != "}" and after_call != "else"))
                {
                    is_stmt_start = 1
                }
            }
        }
        if (is_stmt_start == 0)
        {
            let value_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_accept_text(parser, ";")
            parser_expect_text(parser, "}")
            if (parser.ok == 0) { return -1 }
            let block_idx = parser_stmt_at(parser, ast_stmt_block_indices(parser.store, indices), line, col)
            return parser_expr_at(parser, ast_expr_block_value(parser.expr_store, block_idx, value_idx), line, col)
        }
        let before_pos = parser.pos
        let stmt_idx = parse_statement(parser)
        if (parser.ok == 0) { return -1 }
        if (parser.pos == before_pos)
        {
            parser_fail(parser, "parser made no progress in expression block")
            return -1
        }
        indices.push(stmt_idx)
    }
    parser_expect_text(parser, "}")
    if (parser.ok == 0) { return -1 }
    let block_idx = parser_stmt_at(parser, ast_stmt_block_indices(parser.store, indices), line, col)
    return parser_expr_at(parser, ast_expr_block(parser.expr_store, block_idx), line, col)
}

pub fn parse_primary(parser: &Parser): i32
{
    let kind = parser_kind(parser)
    if (kind == tk_number())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let val = parser_int(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_int(parser.expr_store, val), line, col)
    }
    if (kind == tk_float())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let val = parser_float(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_float(parser.expr_store, val), line, col)
    }
    if (kind == tk_bool())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let val = parser_int(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_bool(parser.expr_store, val), line, col)
    }
    if (kind == tk_string())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let text = parser_text(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_string(parser.expr_store, text), line, col)
    }
    if (parser_text(parser) == "fn")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let mut capture_names: [string] = []
        if (parser_text(parser) == "[")
        {
            parser_advance(parser)
            if (parser_text(parser) != "]")
            {
                while (1 == 1)
                {
                    if (parser_kind(parser) != tk_ident())
                    {
                        parser_fail(parser, "expected capture identifier, got '" + parser_text(parser) + "'")
                        return -1
                    }
                    let capture = parser_text(parser)
                    for (i in 0 .. capture_names.length)
                    {
                        if (capture_names[i] == capture)
                        {
                            parser_fail(parser, "duplicate lambda capture '" + capture + "'")
                            return -1
                        }
                    }
                    capture_names.push(capture)
                    parser_advance(parser)
                    if (parser_text(parser) != ",") { break }
                    parser_advance(parser)
                    if (parser_text(parser) == "]")
                    {
                        parser_fail(parser, "expected capture identifier after ','")
                        return -1
                    }
                }
            }
            parser_expect_text(parser, "]")
            if (parser.ok == 0) return -1
        }
        parser_expect_text(parser, "(")
        if (parser.ok == 0) return -1
        let mut param_names: [string] = []
        let mut param_types: [string] = []
        if (parser_text(parser) != ")")
        {
            let p = parse_param_name(parser)
            parser_expect_text(parser, ":")
            let pt = parse_type_text(parser)
            if (parser.ok == 0) return -1
            param_names.push(p)
            param_types.push(pt)
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                let np = parse_param_name(parser)
                parser_expect_text(parser, ":")
                let nt = parse_type_text(parser)
                if (parser.ok == 0) return -1
                param_names.push(np)
                param_types.push(nt)
            }
        }
        parser_expect_text(parser, ")")
        for (i in 0 .. capture_names.length)
        {
            for (j in 0 .. param_names.length)
            {
                if (capture_names[i] == param_names[j])
                {
                    parser_fail(parser, "lambda parameter '" + capture_names[i] + "' cannot be captured")
                    return -1
                }
            }
        }
        parser_expect_text(parser, ":")
        let ret_ty = parse_type_text(parser)
        parser_expect_text(parser, "=>")
        if (parser.ok == 0) return -1
        let body_expr = if (parser_text(parser) == "{") parse_block_expression(parser) else parse_expression(parser)
        if (parser.ok == 0) return -1
        let fn_name = "__lambda_" + parser.current_function + "_" + ast_i32(parser.lambda_counter)
        parser.lambda_counter += 1
        let body_ast = expr_store_get(parser.expr_store, body_expr)
        let mut body_stmt = -1
        if (body_ast.tag == "block_expr")
        {
            body_stmt = body_ast.left_idx
            if (body_ast.right_idx >= 0)
            {
                let block_stmt = stmt_store_get(parser.store, body_ast.left_idx)
                let mut indices: [i32] = []
                if (block_stmt.stmt_indices.length > 0)
                {
                    for (i in 0 .. block_stmt.stmt_indices.length)
                    {
                        indices.push(block_stmt.stmt_indices[i])
                    }
                }
                else
                {
                    for (i in 0 .. block_stmt.block_count)
                    {
                        indices.push(block_stmt.block_start + i)
                    }
                }
                indices.push(ast_stmt_return_expr(parser.store, body_ast.right_idx))
                body_stmt = ast_stmt_block_indices(parser.store, indices)
            }
        }
        else body_stmt = ast_stmt_return_expr(parser.store, body_expr)
        parser.lambda_functions.push(ast_function_with_loc(ast_function_full(fn_name, ret_ty, body_stmt, param_names, param_types), line, col))
        return parser_expr_at(parser, ast_expr_lambda_captured(parser.expr_store, fn_name, param_names, param_types, ret_ty, body_expr, capture_names), line, col)
    }
    if (kind == tk_ident())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let mut name = parser_text(parser)
        parser_advance(parser)
        // collect module path segments: a::b::c -> "a::b::c"
        while (parser_text(parser) == "::")
        {
            parser_advance(parser)
            match parser_kind(parser) {
                1 -> {  // tk_ident
                    name = name + "::" + parser_text(parser)
                    parser_advance(parser)
                }
                _ -> {
                    parser_fail(parser, "expected identifier after '::', got '" + parser_text(parser) + "'")
                    return -1
                }
            }
        }
        if (name == "None")
        {
            return parser_expr_at(parser, ast_expr_none(parser.expr_store), line, col)
        }
        if (parser_generic_call_ahead(parser) == 1)
        {
            let type_args = parse_generic_call_type_args(parser)
            if (parser.ok == 0) { return -1 }
            parser_expect_text(parser, "(")
            if (parser.ok == 0) { return -1 }
            let mut args: [i32] = []
            if (parser_text(parser) != ")")
            {
                args.push(parse_expression(parser))
                if (parser.ok == 0) { return -1 }
                while (parser_text(parser) == ",")
                {
                    parser_advance(parser)
                    args.push(parse_expression(parser))
                    if (parser.ok == 0) { return -1 }
                }
            }
            parser_expect_text(parser, ")")
            if (parser.ok == 0) { return -1 }
            return parser_expr_at(parser, ast_expr_call_generic(parser.expr_store, name, type_args, args), line, col)
        }
        if (parser_text(parser) == "{")
        {
            parser_advance(parser)
            let mut field_names: [string] = []
            let mut field_values: [i32] = []
            while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
            {
                if (parser_text(parser) == ",")
                {
                    parser_advance(parser)
                    continue
                }
                let field_name = parser_text(parser)
                if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
                if (parser_text(parser) != ":" and parser_text(parser) != "=")
                {
                    parser_fail(parser, "expected ':' or '=' in struct field initializer, got '" + parser_text(parser) + "'")
                    return -1
                }
                parser_advance(parser)
                let field_value = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                field_names.push(field_name)
                field_values.push(field_value)
                parser_accept_text(parser, ",")
            }
            parser_expect_text(parser, "}")
            if (parser.ok == 0) { return -1 }
            return parser_expr_at(parser, ast_expr_struct_literal(parser.expr_store, name, field_names, field_values), line, col)
        }
        if (parser_text(parser) == "(")
        {
            parser_advance(parser)
            let mut args: [i32] = []
            if (parser_text(parser) != ")")
            {
                let arg = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                args.push(arg)
                while (parser_text(parser) == ",")
                {
                    parser_advance(parser)
                    let arg2 = parse_expression(parser)
                    if (parser.ok == 0) { return -1 }
                    args.push(arg2)
                }
            }
            parser_expect_text(parser, ")")
            if (parser.ok == 0) { return -1 }
            if (name == "Some")
            {
                if (args.length != 1)
                {
                    parser_fail(parser, "Some expects one argument")
                    return -1
                }
                return parser_expr_at(parser, ast_expr_some(parser.expr_store, args[0]), line, col)
            }
            return parser_expr_at(parser, ast_expr_call(parser.expr_store, name, args), line, col)
        }
        return parser_expr_at(parser, ast_expr_identifier(parser.expr_store, name), line, col)
    }
    
    if (parser_text(parser) == "nil")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_int(parser.expr_store, 0), line, col)
    }
    if (parser_text(parser) == "(")
    {
        parser_advance(parser)
        let expr = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_expect_text(parser, ")")
        return expr
    }
    if (parser_text(parser) == "[")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let mut elements: [i32] = []
        if (parser_text(parser) != "]")
        {
            let elem = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            elements.push(elem)
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                let elem2 = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                elements.push(elem2)
            }
        }
        parser_expect_text(parser, "]")
        if (parser.ok == 0) { return -1 }
        return parser_expr_at(parser, ast_expr_array(parser.expr_store, elements), line, col)
    }
    if (parser_text(parser) == "match")
    {
        return parse_match_expr(parser)
    }
    if (parser_text(parser) == "if")
    {
        return parse_if_expr(parser)
    }
    if (parser_text(parser) == "{")
    {
        return parse_block_expression(parser)
    }
    parser_fail(parser, "unexpected token in expression: '" + parser_text(parser) + "'")
    return -1
}

pub fn parse_statement_ident(parser: &Parser): i32
{
    if (parser_kind(parser) != tk_ident())
    {
        parser_fail(parser, "unexpected statement: '" + parser_text(parser) + "'")
        return -1
    }
    let line = parser_line(parser)
    let col = parser_col(parser)
    let mut name = parser_text(parser)
    parser_advance(parser)
    // collect module path segments: math::add -> "math::add"
    while (parser_text(parser) == "::")
    {
        parser_advance(parser)
        match parser_kind(parser) {
            1 -> {
                name = name + "::" + parser_text(parser)
                parser_advance(parser)
            }
            _ -> {
                parser_fail(parser, "expected identifier after '::', got '" + parser_text(parser) + "'")
                return -1
            }
        }
    }
    if (parser_generic_call_ahead(parser) == 1)
    {
        let type_args = parse_generic_call_type_args(parser)
        if (parser.ok == 0) { return -1 }
        parser_expect_text(parser, "(")
        if (parser.ok == 0) { return -1 }
        let mut args: [i32] = []
        if (parser_text(parser) != ")")
        {
            args.push(parse_expression(parser))
            if (parser.ok == 0) { return -1 }
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                args.push(parse_expression(parser))
                if (parser.ok == 0) { return -1 }
            }
        }
        parser_expect_text(parser, ")")
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        let call_idx = parser_expr_at(parser, ast_expr_call_generic(parser.expr_store, name, type_args, args), line, col)
        return parser_stmt_at(parser, ast_stmt_expr(parser.store, call_idx), line, col)
    }
    let op = parser_text(parser)
    if (op == ".")
    {
        let ident_idx = parser_expr_at(parser, ast_expr_identifier(parser.expr_store, name), line, col)
        let expr_idx = parse_postfix_from(parser, ident_idx)
        if (parser.ok == 0) { return -1 }
        if (parser_text(parser) == "=")
        {
            parser_advance(parser)
            let val_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_accept_text(parser, ";")
            let field_expr = expr_store_get(parser.expr_store, expr_idx)
            if (field_expr.tag == "index")
            {
                return parser_stmt_at(parser, ast_stmt_store_index(parser.store, field_expr.left_idx, field_expr.right_idx, val_idx), line, col)
            }
            return parser_stmt_at(parser, ast_stmt_field_assign(parser.store, field_expr.left_idx, field_expr.text, val_idx), line, col)
        }
        if (parser_text(parser) == "+=")
        {
            parser_advance(parser)
            let rhs_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_accept_text(parser, ";")
            let field_expr = expr_store_get(parser.expr_store, expr_idx)
            let add_idx = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "+", expr_idx, rhs_idx), line, col)
            return parser_stmt_at(parser, ast_stmt_field_assign(parser.store, field_expr.left_idx, field_expr.text, add_idx), line, col)
        }
        if (parser_text(parser) == "-=")
        {
            parser_advance(parser)
            let rhs_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_accept_text(parser, ";")
            let field_expr = expr_store_get(parser.expr_store, expr_idx)
            let sub_idx = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "-", expr_idx, rhs_idx), line, col)
            return parser_stmt_at(parser, ast_stmt_field_assign(parser.store, field_expr.left_idx, field_expr.text, sub_idx), line, col)
        }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_expr(parser.store, expr_idx), line, col)
    }
    if (op == "[")
    {
        parser_advance(parser)
        let index_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_expect_text(parser, "]")
        if (parser.ok == 0) { return -1 }
        let ident_idx = parser_expr_at(parser, ast_expr_identifier(parser.expr_store, name), line, col)
        parser_expect_text(parser, "=")
        if (parser.ok == 0) { return -1 }
        let expr_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_store_index(parser.store, ident_idx, index_idx, expr_idx), line, col)
    }
    if (op == "=")
    {
        parser_advance(parser)
        let expr_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_assign(parser.store, name, expr_idx), line, col)
    }
    if (op == "+=")
    {
        parser_advance(parser)
        let rhs_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        let ident_idx = parser_expr_at(parser, ast_expr_identifier(parser.expr_store, name), line, col)
        let binop_idx = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "+", ident_idx, rhs_idx), line, col)
        return parser_stmt_at(parser, ast_stmt_assign(parser.store, name, binop_idx), line, col)
    }
    if (op == "-=")
    {
        parser_advance(parser)
        let rhs_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        let ident_idx = parser_expr_at(parser, ast_expr_identifier(parser.expr_store, name), line, col)
        let binop_idx = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "-", ident_idx, rhs_idx), line, col)
        return parser_stmt_at(parser, ast_stmt_assign(parser.store, name, binop_idx), line, col)
    }
    if (op == "(")
    {
        parser_advance(parser)
        let mut args: [i32] = []
        if (parser_text(parser) != ")")
        {
            let arg = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            args.push(arg)
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                let arg2 = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                args.push(arg2)
            }
        }
        parser_expect_text(parser, ")")
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        let call_idx = parser_expr_at(parser, ast_expr_call(parser.expr_store, name, args), line, col)
        return parser_stmt_at(parser, ast_stmt_expr(parser.store, call_idx), line, col)
    }
    parser_fail(parser, "unexpected token after identifier: '" + op + "'")
    return -1
}

pub fn parse_block_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_expect_text(parser, "{") == 0) { return -1 }
    let mut indices: [i32] = []
    while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
    {
        if (parser_text(parser) == ";")
        {
            parser_advance(parser)
            continue
        }
        let before_pos = parser.pos
        let stmt_idx = parse_statement(parser)
        if (parser.ok == 0) { return -1 }
        if (parser.pos == before_pos)
        {
            parser_fail(parser, "parser made no progress in block")
            return -1
        }
        indices.push(stmt_idx)
    }
    if (parser_expect_text(parser, "}") == 0) { return -1 }
    return parser_stmt_at(parser, ast_stmt_block_indices(parser.store, indices), line, col)
}

pub fn parse_if_statement_body(parser: &Parser): i32
{
    if (parser_text(parser) == "{")
    {
        return parse_block_statement(parser)
    }
    let line = parser_line(parser)
    let col = parser_col(parser)
    let stmt_idx = parse_statement(parser)
    if (parser.ok == 0) { return -1 }
    return parser_stmt_at(parser, ast_stmt_block_indices(parser.store, [stmt_idx]), line, col)
}

pub fn parse_if_rest(parser: &Parser): i32
{
    while (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    if (parser_text(parser) == "else")
    {
        parser_advance(parser)
        let else_idx = parse_if_statement_body(parser)
        if (parser.ok == 0) { return -1 }
        return else_idx
    }
    if (parser_text(parser) == "elif")
    {
        return parse_if_statement(parser)
    }
    return -1
}

pub fn parse_if_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    let keyword = parser_text(parser)
    if (keyword != "if" and keyword != "elif")
    {
        parser_fail(parser, "expected if or elif, got '" + keyword + "'")
        return -1
    }
    parser_advance(parser)
    parser_expect_text(parser, "(")
    if (parser.ok == 0) { return -1 }
    let cond_idx = parse_expression(parser)
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, ")")
    if (parser.ok == 0) { return -1 }
    let then_idx = parse_if_statement_body(parser)
    if (parser.ok == 0) { return -1 }
    let else_idx = parse_if_rest(parser)
    if (parser.ok == 0) { return -1 }
    return parser_stmt_at(parser, ast_stmt_if(parser.store, cond_idx, then_idx, else_idx), line, col)
}

pub fn parse_for_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    parser_advance(parser)
    parser_expect_text(parser, "(")
    if (parser.ok == 0) { return -1 }
    let name_line = parser_line(parser)
    let name_col = parser_col(parser)
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
    parser_expect_text(parser, "in")
    if (parser.ok == 0) { return -1 }
    let start_idx = parse_expression(parser)
    if (parser.ok == 0) { return -1 }
    if (parser_text(parser) == ")")
    {
        parser_advance(parser)
        let body_idx = parse_block_statement(parser)
        if (parser.ok == 0) { return -1 }
        let synthetic = "__for_each_i" + ast_i32(parser.store.stmts.length)
        let zero_idx = ast_expr_int(parser.expr_store, 0)
        let length_idx = ast_expr_field(parser.expr_store, start_idx, "length")
        let iter_idx = ast_expr_identifier(parser.expr_store, synthetic)
        let item_idx = ast_expr_index(parser.expr_store, start_idx, iter_idx)
        let bind_idx = ast_stmt_let_typed_mut(parser.store, name, "", item_idx, 0)
        let body = stmt_store_get(parser.store, body_idx)
        let mut body_indices: [i32] = [bind_idx]
        if (body.stmt_indices.length > 0)
        {
            for (i in 0 .. body.stmt_indices.length) { body_indices.push(body.stmt_indices[i]) }
        }
        else
        {
            for (i in 0 .. body.block_count) { body_indices.push(body.block_start + i) }
        }
        let combined_body = ast_stmt_block_indices(parser.store, body_indices)
        return parser_stmt_at(parser, ast_stmt_for_range(parser.store, synthetic, zero_idx, length_idx, combined_body), name_line, name_col)
    }
    parser_expect_text(parser, "..")
    if (parser.ok == 0) { return -1 }
    let end_idx = parse_expression(parser)
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, ")")
    if (parser.ok == 0) { return -1 }
    let body_idx = parse_block_statement(parser)
    if (parser.ok == 0) { return -1 }
    return parser_stmt_at(parser, ast_stmt_for_range(parser.store, name, start_idx, end_idx, body_idx), name_line, name_col)
}

pub fn parse_match_pattern(parser: &Parser): i32
{
    if (parser_text(parser) == "_")
    {
        parser_advance(parser)
        return -1
    }
    return parse_unary(parser)
}

pub fn parse_match_arm_body(parser: &Parser): i32
{
    if (parser_text(parser) == "{")
    {
        return parse_block_statement(parser)
    }
    return parse_statement(parser)
}

pub fn parse_match_arms_desugared(parser: &Parser, subject_name: string): i32
{
    while (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    if (parser_text(parser) == "}" or parser_at_end(parser) == 1)
    {
        return ast_stmt_block_indices(parser.store, [])
    }

    let first_pattern = parse_match_pattern(parser)
    if (parser.ok == 0) { return -1 }
    let mut is_default = 0
    if (first_pattern < 0) { is_default = 1 }
    let subject_expr = ast_expr_identifier(parser.expr_store, subject_name)
    let mut cond_idx = -1
    if (is_default == 0)
    {
        cond_idx = ast_expr_binop(parser.expr_store, "==", subject_expr, first_pattern)
    }
    while (parser_text(parser) == "|")
    {
        parser_advance(parser)
        let next_pattern = parse_match_pattern(parser)
        if (parser.ok == 0) { return -1 }
        if (next_pattern < 0)
        {
            is_default = 1
        }
        else
        {
            let next_subject_expr = ast_expr_identifier(parser.expr_store, subject_name)
            let next_cond = ast_expr_binop(parser.expr_store, "==", next_subject_expr, next_pattern)
            if (cond_idx < 0)
            {
                cond_idx = next_cond
            }
            else
            {
                cond_idx = ast_expr_binop(parser.expr_store, "or", cond_idx, next_cond)
            }
        }
    }
    parser_expect_text(parser, "->")
    if (parser.ok == 0) { return -1 }
    let body_idx = parse_match_arm_body(parser)
    if (parser.ok == 0) { return -1 }
    parser_accept_text(parser, ",")
    while (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    if (is_default == 1 or cond_idx < 0)
    {
        return body_idx
    }
    let else_idx = parse_match_arms_desugared(parser, subject_name)
    if (parser.ok == 0) { return -1 }
    let cond = expr_store_get(parser.expr_store, cond_idx)
    return parser_stmt_at(parser, ast_stmt_if(parser.store, cond_idx, body_idx, else_idx), cond.line, cond.col)
}

pub fn parse_match_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    parser_expect_text(parser, "match")
    if (parser.ok == 0) { return -1 }
    let mut subject_idx = -1
    if ((parser_kind(parser) == tk_ident() or parser_kind(parser) == tk_keyword()) and stream_text_at(parser.stream, parser.pos + 1) == "{")
    {
        let subject_name = parser_text(parser)
        parser_advance(parser)
        subject_idx = ast_expr_identifier(parser.expr_store, subject_name)
    }
    else
    {
        subject_idx = parse_expression(parser)
    }
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, "{")
    if (parser.ok == 0) { return -1 }
    let mut patterns: [i32] = []
    let mut bodies: [i32] = []
    while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
    {
        while (parser_text(parser) == ";") { parser_advance(parser) }
        if (parser_text(parser) == "}" or parser_at_end(parser) == 1) { break }
        let mut arm_patterns: [i32] = []
        let first_pattern = parse_match_pattern(parser)
        if (parser.ok == 0) { return -1 }
        arm_patterns.push(first_pattern)
        while (parser_text(parser) == "|")
        {
            parser_advance(parser)
            let next_pattern = parse_match_pattern(parser)
            if (parser.ok == 0) { return -1 }
            arm_patterns.push(next_pattern)
        }
        parser_expect_text(parser, "->")
        if (parser.ok == 0) { return -1 }
        let body_idx = parse_match_arm_body(parser)
        if (parser.ok == 0) { return -1 }
        for (i in 0 .. arm_patterns.length)
        {
            patterns.push(arm_patterns[i])
            bodies.push(body_idx)
        }
        parser_accept_text(parser, ",")
    }
    parser_expect_text(parser, "}")
    if (parser.ok == 0) { return -1 }
    return parser_stmt_at(parser, ast_stmt_match_indices(parser.store, subject_idx, patterns, bodies), line, col)
}

pub fn parse_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    let stmt_text = parser_text(parser)
    if (stmt_text == "match")
    {
        return parse_match_statement(parser)
    }

    if (stmt_text == "@")
    {
        parser_advance(parser)
        let pointer_idx = parse_unary(parser)
        if (parser.ok == 0) { return -1 }
        parser_expect_text(parser, "=")
        if (parser.ok == 0) { return -1 }
        let expr_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_store_deref(parser.store, pointer_idx, expr_idx), line, col)
    }
    if (stmt_text == "let")
    {
        parser_advance(parser)
        let mut is_mut = 0
        if (parser_text(parser) == "mut")
        {
            is_mut = 1
            parser_advance(parser)
        }
        let name_line = parser_line(parser)
        let name_col = parser_col(parser)
        let name = parser_text(parser)
        if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
        let mut type_text = ""
        let mut has_type = 0
        if (parser_text(parser) == ":")
        {
            parser_advance(parser)
            type_text = parse_type_text(parser)
            if (parser.ok == 0) { return -1 }
            has_type = 1
        }
        if (parser_text(parser) != "=" and has_type == 1)
        {
            parser_accept_text(parser, ";")
            return parser_stmt_at(parser, ast_stmt_let_typed_mut(parser.store, name, type_text, ast_expr_array(parser.expr_store, []), is_mut), name_line, name_col)
        }
        parser_expect_text(parser, "=")
        if (parser.ok == 0) { return -1 }
        let expr_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        if (parser_text(parser) == ":")
        {
            parser_advance(parser)
            type_text = parse_type_text(parser)
            if (parser.ok == 0) { return -1 }
        }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_let_typed_mut(parser.store, name, type_text, expr_idx, is_mut), name_line, name_col)
    }
    if (stmt_text == "return")
    {
        parser_advance(parser)
        if (parser_text(parser) == ";" or parser_text(parser) == "}" or parser_at_end(parser) == 1)
        {
            parser_accept_text(parser, ";")
            return parser_stmt_at(parser, ast_stmt_return(parser.store, parser.expr_store, 0), line, col)
        }
        let expr_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_return_expr(parser.store, expr_idx), line, col)
    }
    if (stmt_text == "print")
    {
        parser_advance(parser)
        parser_expect_text(parser, "(")
        if (parser.ok == 0) { return -1 }
        let expr_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_expect_text(parser, ")")
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_print(parser.store, expr_idx), line, col)
    }
    if (stmt_text == "while")
    {
        parser_advance(parser)
        parser_expect_text(parser, "(")
        if (parser.ok == 0) { return -1 }
        let cond_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_expect_text(parser, ")")
        if (parser.ok == 0) { return -1 }
        let body_idx = parse_block_statement(parser)
        if (parser.ok == 0) { return -1 }
        return parser_stmt_at(parser, ast_stmt_while(parser.store, cond_idx, body_idx), line, col)
    }
    if (stmt_text == "if") { return parse_if_statement(parser) }
    if (stmt_text == "for") { return parse_for_statement(parser) }
    if (stmt_text == "break" or stmt_text == "continue")
    {
        parser_advance(parser)
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_loop_control(parser.store, stmt_text), line, col)
    }
    if (parser_kind(parser) == tk_number() or parser_kind(parser) == tk_string() or parser_kind(parser) == tk_float() or parser_kind(parser) == tk_bool() or parser_text(parser) == "nil" or parser_text(parser) == "(" or parser_text(parser) == "-" or parser_text(parser) == "!" or parser_text(parser) == "match" or parser_text(parser) == "if")
    {
        let expr_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_expr(parser.store, expr_idx), line, col)
    }
    return parse_statement_ident(parser)
}

pub fn parse_type_text(parser: &Parser): string
{
    if (parser_text(parser) == "fn")
    {
        parser_advance(parser)
        parser_expect_text(parser, "(")
        if (parser.ok == 0) return "unknown"
        let mut out = "fn("
        if (parser_text(parser) != ")")
        {
            out = out + parse_type_text(parser)
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                out = out + ", " + parse_type_text(parser)
            }
        }
        parser_expect_text(parser, ")")
        parser_expect_text(parser, ":")
        if (parser.ok == 0) return "unknown"
        return out + "): " + parse_type_text(parser)
    }
    if (parser_text(parser) == "&" or parser_text(parser) == "ref")
    {
        parser_advance(parser)
        let inner = parse_type_text(parser)
        if (parser.ok == 0) { return "unknown" }
        return "ptr:" + inner
    }
    if (parser_text(parser) == "[")
    {
        parser_advance(parser)
        let inner = parse_type_text(parser)
        if (parser.ok == 0) { return "unknown" }
        if (parser_text(parser) == "*")
        {
            parser_advance(parser)
            let count = parser_int(parser)
            if (parser_expect_kind(parser, tk_number()) == 0) { return "unknown" }
            parser_expect_text(parser, "]")
            if (parser.ok == 0) { return "unknown" }
            return "[" + inner + "*" + ast_i32(count) + "]"
        }
        parser_expect_text(parser, "]")
        if (parser.ok == 0) { return "unknown" }
        return "[" + inner + "]"
    }
    if (parser_text(parser) == "?")
    {
        parser_advance(parser)
        let inner = parse_type_text(parser)
        if (parser.ok == 0) { return "unknown" }
        return "Option[" + inner + "]"
    }
    let mut ty = parser_text(parser)
    if (parser_kind(parser) != tk_ident() and parser_kind(parser) != tk_keyword())
    {
        parser_fail(parser, "expected type name, got '" + ty + "'")
        return "unknown"
    }
    parser_advance(parser)
    // collect module path segments: math::Vector
    while (parser_text(parser) == "::" and parser.pos + 1 < stream_len(parser.stream) and stream_kind_at(parser.stream, parser.pos + 1) == tk_ident())
    {
        parser_advance(parser)
        ty = ty + "::" + parser_text(parser)
        parser_advance(parser)
    }
    if (parser_text(parser) == ":" or parser_text(parser) == "[")
    {
        if (parser_text(parser) == ":") { parser_advance(parser) }
        parser_expect_text(parser, "[")
        if (parser.ok == 0) { return ty }
        let mut out = ty + ":["
        if (parser_text(parser) != "]")
        {
            out = out + parse_type_text(parser)
            if (parser.ok == 0) { return "unknown" }
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                out = out + ", " + parse_type_text(parser)
                if (parser.ok == 0) { return "unknown" }
            }
        }
        parser_expect_text(parser, "]")
        if (parser.ok == 0) { return "unknown" }
        return out + "]"
    }
    return ty
}

pub fn parse_param_name(parser: &Parser): string
{
    if (parser_text(parser) == "mut")
    {
        parser_advance(parser)
    }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return "" }
    return name
}

pub fn parse_function(parser: &Parser): AstFunction
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_text(parser) == "pub") { parser_advance(parser) }
    if (parser_expect_text(parser, "fn") == 0) { return ast_function("main", "i32", -1) }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return ast_function("main", "i32", -1) }
    parser.current_function = name
    let type_params = parse_type_params_after_name(parser)
    if (parser.ok == 0) { return ast_function("main", "i32", -1) }
    if (parser_expect_text(parser, "(") == 0) { return ast_function("main", "i32", -1) }

    let mut param_names: [string] = []
    let mut param_types: [string] = []
    if (parser_text(parser) != ")")
    {
        let param_name = parse_param_name(parser)
        if (parser.ok == 0) { return ast_function("main", "i32", -1) }
        if (parser_expect_text(parser, ":") == 0) { return ast_function("main", "i32", -1) }
        let param_ty = parse_type_text(parser)
        if (parser.ok == 0) { return ast_function("main", "i32", -1) }
        param_names.push(param_name)
        param_types.push(param_ty)
        while (parser_text(parser) == ",")
        {
            parser_advance(parser)
            let next_name = parse_param_name(parser)
            if (parser.ok == 0) { return ast_function("main", "i32", -1) }
            if (parser_expect_text(parser, ":") == 0) { return ast_function("main", "i32", -1) }
            let next_ty = parse_type_text(parser)
            if (parser.ok == 0) { return ast_function("main", "i32", -1) }
            param_names.push(next_name)
            param_types.push(next_ty)
        }
    }
    if (parser_expect_text(parser, ")") == 0) { return ast_function("main", "i32", -1) }
    let mut ret_ty = "void"
    if (parser_text(parser) == ":")
    {
        parser_advance(parser)
        ret_ty = parse_type_text(parser)
    }
    let mut body_idx = parse_block_statement(parser)
    if (parser.ok == 0) { return ast_function("main", "i32", -1) }
    if (body_idx < 0)
    {
        body_idx = ast_stmt_return(parser.store, parser.expr_store, 0)
    }
    return ast_function_with_loc(ast_function_generic_full_vararg(name, ret_ty, body_idx, param_names, param_types, type_params, 0), line, col)
}

pub fn parse_function_params_and_return(parser: &Parser, name: string): AstFunction
{
    let mut param_names: [string] = []
    let mut param_types: [string] = []
    let mut is_var_arg = 0
    if (parser_text(parser) != ")")
    {
        if (parser_text(parser) == "...")
        {
            is_var_arg = 1
            parser_advance(parser)
        }
        else
        {
            let param_name = parse_param_name(parser)
            if (parser.ok == 0) { return ast_function(name, "i32", -1) }
            if (parser_expect_text(parser, ":") == 0) { return ast_function(name, "i32", -1) }
            let param_ty = parse_type_text(parser)
            if (parser.ok == 0) { return ast_function(name, "i32", -1) }
            param_names.push(param_name)
            param_types.push(param_ty)
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                if (parser_text(parser) == "...")
                {
                    is_var_arg = 1
                    parser_advance(parser)
                    break
                }
                let next_name = parse_param_name(parser)
                if (parser.ok == 0) { return ast_function(name, "i32", -1) }
                if (parser_expect_text(parser, ":") == 0) { return ast_function(name, "i32", -1) }
                let next_ty = parse_type_text(parser)
                if (parser.ok == 0) { return ast_function(name, "i32", -1) }
                param_names.push(next_name)
                param_types.push(next_ty)
            }
        }
    }
    if (parser_expect_text(parser, ")") == 0) { return ast_function(name, "i32", -1) }
    let mut ret_ty = "void"
    if (parser_text(parser) == ":")
    {
        parser_advance(parser)
        ret_ty = parse_type_text(parser)
    }
    return ast_function_full_vararg(name, ret_ty, -1, param_names, param_types, is_var_arg)
}

pub fn parse_extern_function(parser: &Parser): AstFunction
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_expect_text(parser, "fn") == 0) { return ast_function("", "i32", -1) }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return ast_function("", "i32", -1) }
    if (parser_expect_text(parser, "(") == 0) { return ast_function(name, "i32", -1) }
    let func = parse_function_params_and_return(parser, name)
    parser_accept_text(parser, ";")
    return ast_function_with_loc(func, line, col)
}

pub fn parse_extern_block(parser: &Parser): AstFunction
{
    parser_expect_text(parser, "extern")
    if (parser.ok == 0) { return ast_function("", "i32", -1) }
    if (parser_kind(parser) == tk_string())
    {
        parser_advance(parser)
    }
    parser_expect_text(parser, "{")
    if (parser.ok == 0) { return ast_function("", "i32", -1) }
    if (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    let func = parse_extern_function(parser)
    if (parser.ok == 0) { return ast_function("", "i32", -1) }
    while (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    parser_expect_text(parser, "}")
    return func
}

pub fn parse_struct_decl(parser: &Parser): AstStructDecl
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_text(parser) == "pub") { parser_advance(parser) }
    parser_expect_text(parser, "type")
    if (parser.ok == 0) { return AstStructDecl{ name: "", field_names: [], field_types: [], line: line, col: col } }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return AstStructDecl{ name: "", field_names: [], field_types: [], line: line, col: col } }
    let ignored_type_params = parse_type_params_after_name(parser)
    if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: [], field_types: [], line: line, col: col } }
    parser_expect_text(parser, "=")
    if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: [], field_types: [], line: line, col: col } }
    parser_expect_text(parser, "struct")
    if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: [], field_types: [], line: line, col: col } }
    parser_expect_text(parser, "{")
    if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: [], field_types: [], line: line, col: col } }
    let mut field_names: [string] = []
    let mut field_types: [string] = []
    while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
    {
        if (parser_text(parser) == ",")
        {
            parser_advance(parser)
            continue
        }
        let field_name = parser_text(parser)
        if (parser_expect_kind(parser, tk_ident()) == 0) { return AstStructDecl{ name: name, field_names: field_names, field_types: field_types, line: line, col: col } }
        parser_expect_text(parser, ":")
        if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: field_names, field_types: field_types, line: line, col: col } }
        let field_type = parse_type_text(parser)
        if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: field_names, field_types: field_types, line: line, col: col } }
        field_names.push(field_name)
        field_types.push(field_type)
        parser_accept_text(parser, ",")
    }
    parser_expect_text(parser, "}")
    return AstStructDecl{ name: name, field_names: field_names, field_types: field_types, line: line, col: col }
}

pub fn parse_type_params_after_name(parser: &Parser): [string]
{
    let mut params: [string] = []
    if (parser_text(parser) == ":")
    {
        parser_advance(parser)
    }
    elif (parser_text(parser) != "[") { return params }
    parser_expect_text(parser, "[")
    if (parser.ok == 0) { return params }
    while (parser_text(parser) != "]" and parser_at_end(parser) == 0)
    {
        if (parser_text(parser) == ",")
        {
            parser_advance(parser)
            continue
        }
        let param = parser_text(parser)
        if (parser_expect_kind(parser, tk_ident()) == 0) { return params }
        params.push(param)
        parser_accept_text(parser, ",")
    }
    parser_expect_text(parser, "]")
    return params
}

pub fn parse_adt_decl(parser: &Parser): AstAdtDecl
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_text(parser) == "pub") { parser_advance(parser) }
    parser_expect_text(parser, "type")
    if (parser.ok == 0) { return AstAdtDecl{ name: "", type_params: [], variant_names: [], variant_payload_types: [], line: line, col: col } }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return AstAdtDecl{ name: "", type_params: [], variant_names: [], variant_payload_types: [], line: line, col: col } }
    let type_params = parse_type_params_after_name(parser)
    if (parser.ok == 0) { return AstAdtDecl{ name: name, type_params: type_params, variant_names: [], variant_payload_types: [], line: line, col: col } }
    parser_expect_text(parser, "=")
    if (parser.ok == 0) { return AstAdtDecl{ name: name, type_params: type_params, variant_names: [], variant_payload_types: [], line: line, col: col } }
    let mut variant_names: [string] = []
    let mut variant_payload_types: [string] = []
    while (parser_at_end(parser) == 0)
    {
        let variant_name = parser_text(parser)
        if (parser_expect_kind(parser, tk_ident()) == 0) { return AstAdtDecl{ name: name, type_params: type_params, variant_names: variant_names, variant_payload_types: variant_payload_types, line: line, col: col } }
        let mut payload_ty = ""
        if (parser_text(parser) == "(")
        {
            parser_advance(parser)
            payload_ty = parse_type_text(parser)
            if (parser.ok == 0) { return AstAdtDecl{ name: name, type_params: type_params, variant_names: variant_names, variant_payload_types: variant_payload_types, line: line, col: col } }
            parser_expect_text(parser, ")")
            if (parser.ok == 0) { return AstAdtDecl{ name: name, type_params: type_params, variant_names: variant_names, variant_payload_types: variant_payload_types, line: line, col: col } }
        }
        variant_names.push(variant_name)
        variant_payload_types.push(payload_ty)
        if (parser_text(parser) == "|")
        {
            parser_advance(parser)
            continue
        }
        break
    }
    parser_accept_text(parser, ";")
    return AstAdtDecl{ name: name, type_params: type_params, variant_names: variant_names, variant_payload_types: variant_payload_types, line: line, col: col }
}

pub fn top_level_type_is_struct(parser: &Parser): i32
{
    let mut pos = parser.pos
    if (stream_text_at(parser.stream, pos) == "pub") { pos += 1 }
    if (stream_text_at(parser.stream, pos) != "type") { return 0 }
    pos += 1
    if (stream_kind_at(parser.stream, pos) != tk_ident()) { return 0 }
    pos += 1
    if (stream_text_at(parser.stream, pos) == ":")
    {
        while (pos < stream_len(parser.stream) and stream_text_at(parser.stream, pos) != "=")
        {
            pos += 1
        }
    }
    if (stream_text_at(parser.stream, pos) != "=") { return 0 }
    pos += 1
    if (stream_text_at(parser.stream, pos) == "struct") { return 1 }
    return 0
}

pub fn parse_has_adt_name(adts: [AstAdtDecl], name: string): i32
{
    for (i in 0 .. adts.length)
    {
        if (adts[i].name == name) { return 1 }
    }
    return 0
}

pub fn parse_has_function_name(functions: [AstFunction], name: string): i32
{
    for (i in 0 .. functions.length)
    {
        if (functions[i].name == name) { return 1 }
    }
    return 0
}

pub fn parse_stream_uses_result_ctor(stream: &TokenStream): i32
{
    for (i in 0 .. stream_len(stream) - 1)
    {
        let text = stream_text_at(stream, i)
        if ((text == "Ok" or text == "Err") and stream_text_at(stream, i + 1) == "(")
        {
            return 1
        }
    }
    return 0
}

pub fn parse_builtin_result_decl(): AstAdtDecl
{
    return AstAdtDecl{ name: "Result", type_params: [], variant_names: ["Ok", "Err"], variant_payload_types: ["i32", "string"], line: 0, col: 0 }
}

// Parse a module path: ident (:: ident)*  -> returns ["math", "add"]
// Keywords are accepted as segment names (e.g. `utils::string::trim`)
pub fn parse_module_path(parser: &Parser): [string]
{
    let mut segments: [string] = []
    let first = parser_text(parser)
    if (parser_kind(parser) != tk_ident() and parser_kind(parser) != tk_keyword())
    {
        parser_fail(parser, "expected module name, got '" + first + "'")
        return segments
    }
    parser_advance(parser)
    segments.push(first)
    while (parser_text(parser) == "::")
    {
        parser_advance(parser)
        let seg = parser_text(parser)
        if (parser_kind(parser) != tk_ident() and parser_kind(parser) != tk_keyword())
        {
            parser_fail(parser, "expected identifier after '::', got '" + seg + "'")
            return segments
        }
        parser_advance(parser)
        segments.push(seg)
    }
    return segments
}

// `mod math` or `pub mod math`
pub fn parse_mod_decl(parser: &Parser): AstModDecl
{
    let line = parser_line(parser)
    let col  = parser_col(parser)
    let mut is_pub = 0
    if (parser_text(parser) == "pub")
    {
        is_pub = 1
        parser_advance(parser)
    }
    if (parser_expect_text(parser, "mod") == 0)
    {
        return AstModDecl{ name: "", is_pub: 0, line: line, col: col }
    }
    let name = parser_text(parser)
    if (parser_kind(parser) == tk_string())
    {
        parser_advance(parser)
    }
    elif (parser_expect_kind(parser, tk_ident()) == 0)
    {
        return AstModDecl{ name: "", is_pub: 0, line: line, col: col }
    }
    parser_accept_text(parser, ";")
    return AstModDecl{ name: name, is_pub: is_pub, line: line, col: col }
}

// `import math` or `import math::add` or `import math::add as plus`
// Note: quoted imports are legacy preprocessor imports and are ignored in raw mode.
pub fn parse_import_decl(parser: &Parser): AstImportDecl
{
    let line = parser_line(parser)
    let col  = parser_col(parser)
    if (parser_expect_text(parser, "import") == 0)
    {
        return AstImportDecl{ path: [], alias: "", line: line, col: col }
    }
    let path = parse_module_path(parser)
    if (parser.ok == 0)
    {
        return AstImportDecl{ path: [], alias: "", line: line, col: col }
    }
    let mut alias = ""
    if (parser_text(parser) == "as")
    {
        parser_advance(parser)
        alias = parser_text(parser)
        if (parser_expect_kind(parser, tk_ident()) == 0)
        {
            return AstImportDecl{ path: [], alias: "", line: line, col: col }
        }
    }
    parser_accept_text(parser, ";")
    return AstImportDecl{ path: path, alias: alias, line: line, col: col }
}

fn parse_strip_attr_lines(src: string): string
{
    let mut out = ""
    let mut i = 0
    while (i < src.length)
    {
        if (compiler_string_byte(src, i) == '#' and i + 1 < src.length and compiler_string_byte(src, i + 1) == '[')
        {
            i += 2
            while (i < src.length and compiler_string_byte(src, i) != ']') { i += 1 }
            if (i < src.length) { i += 1 }
            while (i < src.length and compiler_string_byte(src, i) != 10) { i += 1 }
            if (i < src.length) { out = out + char_string(10); i += 1 }
        }
        else
        {
            out = out + char_string(compiler_string_byte(src, i))
            i += 1
        }
    }
    return out
}

pub fn parse_program_impl(src: string, filename: string, do_preprocess: i32): AstProgram
{
    let mut imports = import_set_new()
    let combined = if (do_preprocess == 1) { preprocess_source(src, filename, &imports) } else { preprocess_source_local(src, filename) }

    let mut parser = parser_new(combined, filename)
    if (parser_at_end(&parser) == 1) { return ast_program_err("empty source") }
    let parser_stream = parser.stream
    let uses_builtin_result = parse_stream_uses_result_ctor(&parser_stream)
    let mut functions: [AstFunction] = []
    let mut extern_functions: [AstFunction] = []
    let mut globals: [AstStmt] = []
    let mut structs: [AstStructDecl] = []
    let mut adts: [AstAdtDecl] = []
    let mut mod_decls: [AstModDecl] = []
    let mut import_decls: [AstImportDecl] = []

    while (parser_at_end(&parser) == 0)
    {
        while (parser_text(&parser) == ";") { parser_advance(&parser) }
        if (parser_at_end(&parser) == 1) { break }
        let before_pos = parser.pos

        // `mod math` or `pub mod math`
        let is_pub_mod = parser_text(&parser) == "pub" and parser.pos + 1 < stream_len(parser.stream) and stream_text_at(parser.stream, parser.pos + 1) == "mod"
        if (parser_text(&parser) == "mod" or is_pub_mod == 1)
        {
            let mdecl = parse_mod_decl(&parser)
            if (parser.ok == 0) { return ast_program_err(parser.error) }
            mod_decls.push(mdecl)
        }
        // `import ident...`; quoted imports are legacy no-ops in raw module mode.
        elif (parser_text(&parser) == "import" and parser.pos + 1 < stream_len(parser.stream) and stream_kind_at(parser.stream, parser.pos + 1) == tk_ident())
        {
            let idecl = parse_import_decl(&parser)
            if (parser.ok == 0) { return ast_program_err(parser.error) }
            import_decls.push(idecl)
        }
        elif (parser_text(&parser) == "import" and parser.pos + 1 < stream_len(parser.stream) and stream_kind_at(parser.stream, parser.pos + 1) == tk_string())
        {
            parser_advance(&parser)
            parser_advance(&parser)
            parser_accept_text(&parser, ";")
        }
        elif (parser_text(&parser) == "extern")
        {
            parser_expect_text(&parser, "extern")
            if (parser.ok == 0) { return ast_program_err(parser.error) }
            if (parser_kind(&parser) == tk_string()) { parser_advance(&parser) }
            parser_expect_text(&parser, "{")
            if (parser.ok == 0) { return ast_program_err(parser.error) }
            while (parser_text(&parser) != "}" and parser_at_end(&parser) == 0)
            {
                if (parser_text(&parser) == ";")
                {
                    parser_advance(&parser)
                    continue
                }
                let extern_func = parse_extern_function(&parser)
                if (parser.ok == 0) { return ast_program_err(parser.error) }
                extern_functions.push(extern_func)
            }
            parser_expect_text(&parser, "}")
            if (parser.ok == 0) { return ast_program_err(parser.error) }
        }
        elif (parser_text(&parser) == "type" or (parser_text(&parser) == "pub" and stream_text_at(parser.stream, parser.pos + 1) == "type"))
        {
            if (top_level_type_is_struct(&parser) == 1)
            {
                let decl = parse_struct_decl(&parser)
                if (parser.ok == 0) { return ast_program_err(parser.error) }
                structs.push(decl)
            }
            else
            {
                let decl = parse_adt_decl(&parser)
                if (parser.ok == 0) { return ast_program_err(parser.error) }
                adts.push(decl)
            }
        }
        elif (parser_text(&parser) == "let")
        {
            let global_idx = parse_statement(&parser)
            if (parser.ok == 0) { return ast_program_err(parser.error) }
            let global_stmt = stmt_store_get(parser.store, global_idx)
            globals.push(global_stmt)
        }
        elif (parser_text(&parser) == "fn" or parser_text(&parser) == "pub")
        {
            let func = parse_function(&parser)
            if (parser.ok == 0) { return ast_program_err(parser.error) }
            functions.push(func)
        }
        else
        {
            parser_fail(&parser, "expected top-level declaration, got '" + parser_text(&parser) + "'")
            return ast_program_err(parser.error)
        }
        if (parser.pos == before_pos)
        {
            parser_fail(&parser, "parser made no progress at top-level declaration")
            return ast_program_err(parser.error)
        }
    }
    if (functions.length == 0 and extern_functions.length == 0 and globals.length == 0 and structs.length == 0 and adts.length == 0 and mod_decls.length == 0 and import_decls.length == 0)
    {
        return ast_program_err("expected function")
    }
    if (uses_builtin_result == 1 and parse_has_adt_name(adts, "Result") == 0 and parse_has_function_name(functions, "Ok") == 0 and parse_has_function_name(functions, "Err") == 0 and parse_has_function_name(extern_functions, "Ok") == 0 and parse_has_function_name(extern_functions, "Err") == 0)
    {
        adts.push(parse_builtin_result_decl())
    }
    for (i in 0 .. parser.lambda_functions.length)
    {
        functions.push(parser.lambda_functions[i])
    }
    return ast_program_full(functions, extern_functions, globals, structs, adts, mod_decls, import_decls, parser.expr_store, parser.store)
}

pub fn parse_program(src: string, filename: string): AstProgram
{
    return parse_program_impl(src, filename, 1)
}

pub fn parse_program_raw(src: string, filename: string): AstProgram
{
    return parse_program_impl(src, filename, 0)
}

pub fn parse_program_stats(src: string, filename: string): string
{
    let mut imports = import_set_new()
    return parse_program_stats_source(src, filename, &imports)
}

pub fn parse_program_stats_source(src: string, filename: string, imports: &ImportSet): string
{
    let mut extern_count = 0
    let mut type_count = 0
    let mut fn_count = 0
    let mut token_count = 0
    let mut i = 0
    while (i < src.length)
    {
        if (compiler_string_byte(src, i) == '#')
        {
            i = skip_attr_line(src, i)
            continue
        }
        let import_end = scan_import_line(src, i)
        if (import_end > i)
        {
            let path = extract_import_path(src, i)
            if (path != "")
            {
                let resolved = resolve_import_path(filename, path)
                let mut actual = resolved
                let mut content = read_file_content(actual)
                if (content == "" and path != resolved)
                {
                    actual = path
                    content = read_file_content(actual)
                }
                if (content != "" and import_set_contains(imports, actual) == 0)
                {
                    import_set_add(imports, actual)
                    let child = parse_program_stats_source(content, actual, imports)
                }
            }
            i = import_end
            continue
        }
        i += 1
    }
    let stream = tokenize(src)
    for (k in 0 .. stream_len(&stream))
    {
        let text = stream_text_at(&stream, k)
        if (text == "extern") { extern_count += 1 }
        elif (text == "type") { type_count += 1 }
        elif (text == "fn") { fn_count += 1 }
        token_count += 1
    }
    return "ParseStats(tokens=" + ast_i32(token_count) + ", imports=" + ast_i32(imports.paths.length) + ", externs=" + ast_i32(extern_count) + ", types=" + ast_i32(type_count) + ", functions=" + ast_i32(fn_count) + ")"
}
