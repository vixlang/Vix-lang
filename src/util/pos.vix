#[no_main]

pub type SourcePos = struct {
    line: i32,
    col: i32,
    span_len: i32
}

pub fn pos_none(): SourcePos
{
    return SourcePos{ line: 0, col: 0, span_len: 1 }
}

pub fn pos_at(line: i32, col: i32): SourcePos
{
    return SourcePos{ line: line, col: col, span_len: 1 }
}

pub fn pos_span(line: i32, col: i32, length: i32): SourcePos
{
    let len = if (length > 0) { length } else { 1 }
    return SourcePos{ line: line, col: col, span_len: len }
}

pub fn pos_is_known(pos: SourcePos): i32
{
    if (pos.line > 0) { return 1 }
    return 0
}
