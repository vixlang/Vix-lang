#[no_main]

pub type SymbolTable = struct {
    names: [string],
    types: [string],
    mutable: [i32],
    depths: [i32],
    active_len: i32,
    depth: i32,
    ok: i32,
    error: string,
    error_line: i32,
    error_col: i32,
    error_length: i32
}

macro symtable_default_error_fields() {
    ok: 1, error: "", error_line: 0, error_col: 0, error_length: 1
}

pub fn symtable_new(): SymbolTable
{
    return SymbolTable{ names: [], types: [], mutable: [], depths: [], active_len: 0, depth: 0, $symtable_default_error_fields() }
}

pub fn symtable_fail(table: &SymbolTable, message: string)
{
    if (table.ok == 1)
    {
        table.ok = 0
        table.error = message
    }
}

pub fn symtable_set_error_loc(table: &SymbolTable, line: i32, col: i32)
{
    if (table.ok == 0 and table.error_line == 0)
    {
        table.error_line = line
        table.error_col = col
    }
}

pub fn symtable_fail_at(table: &SymbolTable, message: string, line: i32, col: i32)
{
    symtable_fail(table, message)
    symtable_set_error_loc(table, line, col)
    table.error_length = 1
}

pub fn symtable_fail_at_len(table: &SymbolTable, message: string, line: i32, col: i32, length: i32)
{
    symtable_fail(table, message)
    symtable_set_error_loc(table, line, col)
    table.error_length = length
}

pub fn symtable_push_scope(table: &SymbolTable)
{
    table.depth += 1
}

pub fn symtable_truncate(table: &SymbolTable, keep: i32)
{
    table.active_len = keep
}

pub fn symtable_pop_scope(table: &SymbolTable)
{
    if (table.depth > 0)
    {
        let mut keep = table.active_len
        while (keep > 0)
        {
            if (table.depths[keep - 1] >= table.depth)
            {
                keep -= 1
            }
            else
            {
                break
            }
        }
        symtable_truncate(table, keep)
        table.depth -= 1
    }
}

pub fn symtable_find_current(table: &SymbolTable, name: string): i32
{
    for (i in 0 .. table.active_len)
    {
        if (table.names[i] == name and table.depths[i] == table.depth)
        {
            return i
        }
    }
    return -1
}

pub fn symtable_lookup_index(table: &SymbolTable, name: string): i32
{
    let mut i = table.active_len - 1
    while (i >= 0)
    {
        if (table.names[i] == name and table.depths[i] <= table.depth)
        {
            return i
        }
        i -= 1
    }
    return -1
}

pub fn symtable_declare(table: &SymbolTable, name: string, ty: string)
{
    symtable_declare_mut(table, name, ty, 0)
}

pub fn symtable_declare_mut(table: &SymbolTable, name: string, ty: string, is_mut: i32)
{
    if (name == "_") { return }
    if (symtable_find_current(table, name) >= 0)
    {
        symtable_fail(table, "duplicate symbol '" + name + "'")
        return
    }
    let idx = table.active_len
    if (idx < table.names.length)
    {
        table.names[idx] = name
        table.types[idx] = ty
        table.mutable[idx] = is_mut
        table.depths[idx] = table.depth
    }
    else
    {
        table.names.push(name)
        table.types.push(ty)
        table.mutable.push(is_mut)
        table.depths.push(table.depth)
    }
    table.active_len += 1
}

pub fn symtable_assign(table: &SymbolTable, name: string, ty: string)
{
    let idx = symtable_lookup_index(table, name)
    if (idx < 0)
    {
        symtable_fail(table, "undefined symbol in assign '" + name + "'")
        return
    }
    table.types[idx] = ty
}

pub fn symtable_lookup(table: &SymbolTable, name: string): string
{
    let idx = symtable_lookup_index(table, name)
    if (idx >= 0)
    {
        return table.types[idx]
    }
    symtable_fail(table, "undefined symbol in lookup '" + name + "'")
    return "unknown"
}

pub fn symtable_is_mutable(table: &SymbolTable, name: string): i32
{
    let idx = symtable_lookup_index(table, name)
    if (idx >= 0)
    {
        return table.mutable[idx]
    }
    symtable_fail(table, "undefined symbol in mutable lookup '" + name + "'")
    return 0
}

// ---------------------------------------------------------------------------
// ModuleSymTable  –  cross-module symbol registry
//
// Stores every publicly visible symbol as a qualified name.
// e.g.  "math::add"  ->  type "fn(i32,i32):i32"
//       "math::Point" ->  type "struct"
//
// Import aliases are stored as (local_name -> qualified_name) pairs so that
// `plus(1,2)` resolves to `math::add(1,2)` after `import math::add as plus`.
// ---------------------------------------------------------------------------

pub type ModuleSymTable = struct {
    qnames:    [string],    // "math::add"
    sym_types: [string],    // "fn" | "struct" | "adt" | "var"
    is_pub:    [i32],       // 1 = exported

    // alias table:  local_name -> qname
    alias_local:  [string],
    alias_qname:  [string]
}

pub fn modsym_new(): ModuleSymTable
{
    return ModuleSymTable{
        qnames:       [],
        sym_types:    [],
        is_pub:       [],
        alias_local:  [],
        alias_qname:  []
    }
}

// Register a qualified symbol.
pub fn modsym_register(ms: &ModuleSymTable, qname: string, sym_type: string, is_pub: i32)
{
    // deduplicate
    for (i in 0 .. ms.qnames.length)
    {
        if (ms.qnames[i] == qname) { return }
    }
    ms.qnames.push(qname)
    ms.sym_types.push(sym_type)
    ms.is_pub.push(is_pub)
}

// Register an alias:  `import math::add as plus`
pub fn modsym_add_alias(ms: &ModuleSymTable, local_name: string, qname: string)
{
    for (i in 0 .. ms.alias_local.length)
    {
        if (ms.alias_local[i] == local_name) { return }
    }
    ms.alias_local.push(local_name)
    ms.alias_qname.push(qname)
}

// Resolve a name (possibly an alias) to its canonical qualified name.
// Returns "" if not found.
pub fn modsym_resolve(ms: &ModuleSymTable, name: string): string
{
    // check alias table first
    for (i in 0 .. ms.alias_local.length)
    {
        if (ms.alias_local[i] == name) { return ms.alias_qname[i] }
    }
    // direct lookup
    for (i in 0 .. ms.qnames.length)
    {
        if (ms.qnames[i] == name) { return name }
    }
    return ""
}

// Look up type string for a qualified name (or alias).
pub fn modsym_type_of(ms: &ModuleSymTable, name: string): string
{
    let qname = modsym_resolve(ms, name)
    if (qname == "") { return "" }
    for (i in 0 .. ms.qnames.length)
    {
        if (ms.qnames[i] == qname) { return ms.sym_types[i] }
    }
    return ""
}

// Check visibility: returns 1 if the symbol is public.
pub fn modsym_is_pub(ms: &ModuleSymTable, qname: string): i32
{
    for (i in 0 .. ms.qnames.length)
    {
        if (ms.qnames[i] == qname) { return ms.is_pub[i] }
    }
    return 0
}

// Populate the module symbol table from an AstProgram under `module_prefix`.
// e.g. module_prefix = "math"  -> registers "math::add", "math::Point", …
pub fn modsym_populate_from_program(ms: &ModuleSymTable, prog: AstProgram, module_prefix: string)
{
    let prefix = if (module_prefix == "" or module_prefix == "root") { "" } else { module_prefix + "::" }
    for (i in 0 .. prog.functions.length)
    {
        modsym_register(ms, prefix + prog.functions[i].name, "fn", 1)
    }
    for (i in 0 .. prog.extern_functions.length)
    {
        modsym_register(ms, prefix + prog.extern_functions[i].name, "fn", 1)
    }
    for (i in 0 .. prog.structs.length)
    {
        modsym_register(ms, prefix + prog.structs[i].name, "struct", 1)
    }
    for (i in 0 .. prog.adts.length)
    {
        modsym_register(ms, prefix + prog.adts[i].name, "adt", 1)
    }
}
