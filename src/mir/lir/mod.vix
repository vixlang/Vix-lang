#[no_main]

pub type MachineLirValue = struct {
    name: string,
    ty: string,
    start: i32,
    end: i32,
    phys_reg: string,
    spilled: i32
}

pub type MachineLirBlock = struct {
    succ1: i32,
    succ2: i32,
    uses: [i32],
    defs: [i32],
    live_in: [i32],
    live_out: [i32]
}

pub type MachineLirFunction = struct {
    name: string,
    values: [MachineLirValue],
    blocks: [MachineLirBlock],
    names: [string],
    temp_name_ids: [i32],
    temp_value_ids: [i32],
    used_callee_regs: i32,
    frame_names: [string],
    frame_offsets: [i32],
    frame_is_addr: [i32],
    frame_tys: [string],
    frame_size: i32,
    frame_ready: i32
}

pub type MachineLirModule = struct {
    machine: MachineModule,
    functions: [MachineLirFunction],
    error: string,
    error_line: i32,
    error_function: string
}

pub fn machine_lir_is_register_type(ty: string): i32
{
    if (ty == "i1" or ty == "i8" or ty == "i16" or ty == "i32" or ty == "i64" or ty == "char") { return 1 }
    if (ty == "u8" or ty == "u16" or ty == "u32" or ty == "u64" or ty == "usize") { return 1 }
    if (ty == "ptr" or ty == "string") { return 1 }
    if (ty.length > 4) { if (mir2asm_starts_with(ty, "ptr:") == 1) { return 1 } }
    return 0
}

pub fn machine_lir_is_known_type(ty: string): i32
{
    if (machine_lir_is_register_type(ty) == 1 or ty == "f32" or ty == "f64") { return 1 }
    if (ty.length > 0) if (compiler_string_byte(ty, 0) == '@' or compiler_string_byte(ty, 0) == '[') return 1
    return 0
}

pub fn machine_lir_branch_target(inst: MachineInst, which: i32): string
{
    if (inst.opcode == "br") { return mir2asm_trim(mir2asm_after(inst.text, 9)) }
    if (inst.opcode == "br_cond")
    {
        let c1 = mir2asm_find(inst.text, ',', 0)
        if (c1 < 0) { return "" }
        let c2 = mir2asm_find(inst.text, ',', c1 + 1)
        if (c2 < 0) { return "" }
        if (which == 0) { return mir2asm_trim(mir2asm_after(mir2asm_trim(mir2asm_slice(inst.text, c1 + 1, c2)), 6)) }
        return mir2asm_trim(mir2asm_after(mir2asm_trim(mir2asm_after(inst.text, c2 + 1)), 6))
    }
    return ""
}

pub fn machine_lir_temp_number(name: string): i32
{
    if (name.length < 3) { return -1 }
    if (compiler_string_byte(name, 0) != '%' or compiler_string_byte(name, 1) != 't') return -1
    let mut value = 0
    for (i in 2 .. name.length)
    {
        if (compiler_string_byte(name, i) < '0' or compiler_string_byte(name, i) > '9') return -1
        value = value * 10 + (compiler_string_byte(name, i) - '0')
    }
    return value
}

pub fn machine_lir_name_index(lir: MachineLirFunction, name: string): i32
{
    let temp = machine_lir_temp_number(name)
    if (temp >= 0 and temp < lir.temp_name_ids.length)
    {
        if (lir.temp_name_ids[temp] >= 0) { return lir.temp_name_ids[temp] }
    }
    for (i in 0 .. lir.names.length) { if (lir.names[i] == name) { return i } }
    return -1
}

pub fn machine_lir_value_index(lir: MachineLirFunction, name: string): i32
{
    let temp = machine_lir_temp_number(name)
    if (temp >= 0 and temp < lir.temp_value_ids.length)
    {
        if (lir.temp_value_ids[temp] >= 0) { return lir.temp_value_ids[temp] }
    }
    if (lir.values.length <= 4096)
    {
        for (i in 0 .. lir.values.length) { if (lir.values[i].name == name) { return i } }
    }
    return -1
}

pub fn machine_lir_block_index(f: MachineFunction, name: string): i32
{
    for (i in 0 .. f.blocks.length) { if (f.blocks[i].name == name) { return i } }
    return -1
}

pub fn machine_lir_int_has(values: [i32], value: i32): i32
{
    for (i in 0 .. values.length) { if (values[i] == value) { return 1 } }
    return 0
}

pub fn machine_lir_add_name(lir: &MachineLirFunction, name: string)
{
    if (name == "") { return }
    lir.names.push(name)
}

pub fn machine_lir_collect_params(lir: &MachineLirFunction, f: MachineFunction)
{
    let at = mir2asm_find(f.header, '(', 0)
    if (at < 0) { return }
    let rp = mir2asm_find_matching_paren(f.header, at)
    if (rp < 0) { return }
    let mut p = at + 1
    while (p < rp)
    {
        let percent = mir2asm_find(f.header, '%', p)
        if (percent < 0 or percent >= rp) { return }
        let colon = mir2asm_find(f.header, ':', percent)
        if (colon < 0 or colon >= rp) { return }
        machine_lir_add_name(lir, mir2asm_slice(f.header, percent, colon))
        p = colon + 1
    }
}

pub fn machine_lir_init_temp_ids(lir: &MachineLirFunction)
{
    let mut max_temp = -1
    for (i in 0 .. lir.names.length)
    {
        let temp = machine_lir_temp_number(lir.names[i])
        if (temp > max_temp) { max_temp = temp }
    }
    for (i2 in 0 .. max_temp + 1) { lir.temp_name_ids.push(-1); lir.temp_value_ids.push(-1) }
    for (i3 in 0 .. lir.names.length)
    {
        let temp2 = machine_lir_temp_number(lir.names[i3])
        if (temp2 >= 0) { lir.temp_name_ids[temp2] = i3 }
    }
    for (i4 in 0 .. lir.values.length)
    {
        let temp3 = machine_lir_temp_number(lir.values[i4].name)
        if (temp3 >= 0) { lir.temp_value_ids[temp3] = i4 }
    }
}

pub fn machine_lir_build_function(f: MachineFunction, force_spill: i32): MachineLirFunction
{
    let mut lir = MachineLirFunction{ name: f.name, values: [], blocks: [], names: [], temp_name_ids: [], temp_value_ids: [], used_callee_regs: 0, frame_names: [], frame_offsets: [], frame_is_addr: [], frame_tys: [], frame_size: 0, frame_ready: 0 }
    machine_lir_collect_params(&lir, f)
    let mut candidate_count = 0
    for (count_b in 0 .. f.blocks.length)
    {
        for (count_i in 0 .. f.blocks[count_b].insts.length)
        {
            let count_inst = f.blocks[count_b].insts[count_i]
            if (count_inst.opcode == "load" and count_inst.dest != "" and machine_lir_is_register_type(count_inst.ty) == 1) { candidate_count += 1 }
        }
    }
    let mut position = 0
    for (bi in 0 .. f.blocks.length)
    {
        for (ii in 0 .. f.blocks[bi].insts.length)
        {
            let inst = f.blocks[bi].insts[ii]
            machine_lir_add_name(&lir, inst.dest)
            if (force_spill == 0 and candidate_count <= 4096 and inst.opcode == "load" and inst.dest != "" and machine_lir_is_register_type(inst.ty) == 1)
            {
                lir.values.push(MachineLirValue{ name: inst.dest, ty: inst.ty, start: position, end: position, phys_reg: "", spilled: 0 })
            }
            position += 1
        }
    }
    machine_lir_init_temp_ids(&lir)
    position = 0
    let mut seen_defs: [i32] = []
    let mut seen_uses: [i32] = []
    for (mark0 in 0 .. lir.values.length) { seen_defs.push(0); seen_uses.push(0) }
    for (bi2 in 0 .. f.blocks.length)
    {
        let mut block = MachineLirBlock{ succ1: -1, succ2: -1, uses: [], defs: [], live_in: [], live_out: [] }
        if (f.blocks[bi2].insts.length > 0)
        {
            let last = f.blocks[bi2].insts[f.blocks[bi2].insts.length - 1]
            let target1 = machine_lir_branch_target(last, 0)
            let target2 = machine_lir_branch_target(last, 1)
            if (target1 != "") { block.succ1 = machine_lir_block_index(f, target1) }
            if (target2 != "") { block.succ2 = machine_lir_block_index(f, target2) }
        }
        for (ii2 in 0 .. f.blocks[bi2].insts.length)
        {
            let inst2 = f.blocks[bi2].insts[ii2]
            let operands = machine_collect_operands(inst2.text, inst2.dest)
            for (oi in 0 .. operands.length)
            {
                let value_id = machine_lir_value_index(lir, operands[oi])
                if (value_id >= 0)
                {
                    if (seen_defs[value_id] != bi2 + 1 and seen_uses[value_id] != bi2 + 1) { block.uses.push(value_id); seen_uses[value_id] = bi2 + 1 }
                    if (position > lir.values[value_id].end) { lir.values[value_id].end = position }
                }
            }
            let def_id = machine_lir_value_index(lir, inst2.dest)
            if (def_id >= 0)
            {
                if (seen_defs[def_id] != bi2 + 1) { block.defs.push(def_id) }
                seen_defs[def_id] = bi2 + 1
            }
            position += 1
        }
        lir.blocks.push(block)
    }
    let mut changed = 1
    while (changed == 1)
    {
        changed = 0
        for (back in 0 .. lir.blocks.length)
        {
            let bi3 = lir.blocks.length - 1 - back
            let s1 = lir.blocks[bi3].succ1
            let s2 = lir.blocks[bi3].succ2
            if (s1 >= 0)
            {
                for (x in 0 .. lir.blocks[s1].live_in.length)
                {
                    let value = lir.blocks[s1].live_in[x]
                    if (machine_lir_int_has(lir.blocks[bi3].live_out, value) == 0) { lir.blocks[bi3].live_out.push(value); changed = 1 }
                }
            }
            if (s2 >= 0)
            {
                for (x2 in 0 .. lir.blocks[s2].live_in.length)
                {
                    let value2 = lir.blocks[s2].live_in[x2]
                    if (machine_lir_int_has(lir.blocks[bi3].live_out, value2) == 0) { lir.blocks[bi3].live_out.push(value2); changed = 1 }
                }
            }
            for (u in 0 .. lir.blocks[bi3].uses.length)
            {
                let value3 = lir.blocks[bi3].uses[u]
                if (machine_lir_int_has(lir.blocks[bi3].live_in, value3) == 0) { lir.blocks[bi3].live_in.push(value3); changed = 1 }
            }
            if (s1 >= 0)
            {
                for (o in 0 .. lir.blocks[s1].live_in.length)
                {
                    let value4 = lir.blocks[s1].live_in[o]
                    if (machine_lir_int_has(lir.blocks[bi3].defs, value4) == 0 and machine_lir_int_has(lir.blocks[bi3].live_in, value4) == 0) { lir.blocks[bi3].live_in.push(value4); changed = 1 }
                }
            }
            if (s2 >= 0)
            {
                for (o2 in 0 .. lir.blocks[s2].live_in.length)
                {
                    let value5 = lir.blocks[s2].live_in[o2]
                    if (machine_lir_int_has(lir.blocks[bi3].defs, value5) == 0 and machine_lir_int_has(lir.blocks[bi3].live_in, value5) == 0) { lir.blocks[bi3].live_in.push(value5); changed = 1 }
                }
            }
        }
    }
    position = 0
    for (bi4 in 0 .. f.blocks.length)
    {
        let block_start = position
        position += f.blocks[bi4].insts.length
        let block_end = position - 1
        for (live in 0 .. lir.blocks[bi4].live_in.length)
        {
            let value5 = lir.blocks[bi4].live_in[live]
            if (block_start < lir.values[value5].start) { lir.values[value5].start = block_start }
            if (block_end > lir.values[value5].end) { lir.values[value5].end = block_end }
        }
        for (live2 in 0 .. lir.blocks[bi4].live_out.length)
        {
            let value6 = lir.blocks[bi4].live_out[live2]
            if (block_start < lir.values[value6].start) { lir.values[value6].start = block_start }
            if (block_end > lir.values[value6].end) { lir.values[value6].end = block_end }
        }
    }
    return lir
}

pub fn machine_lir_linear_scan(lir: &MachineLirFunction)
{
    let mut owners: [i32] = [-1, -1, -1, -1]
    for (i in 0 .. lir.values.length)
    {
        for (reg in 0 .. 4)
        {
            let old = owners[reg]
            if (old >= 0) { if (lir.values[old].end < lir.values[i].start) { owners[reg] = -1 } }
        }
        let mut free = -1
        for (reg2 in 0 .. 4) { if (owners[reg2] < 0 and free < 0) { free = reg2 } }
        if (free >= 0)
        {
            lir.values[i].phys_reg = match free { 0 -> "r12" 1 -> "r13" 2 -> "r14" _ -> "r15" }
            lir.values[i].spilled = 0
            owners[free] = i
        }
        else
        {
            let spill_reg = 0
            for (reg3 in 1 .. 4)
            {
                let old2 = owners[reg3]
                let spill = owners[spill_reg]
                if (lir.values[old2].end > lir.values[spill].end or (lir.values[old2].end == lir.values[spill].end and old2 > spill)) { spill_reg = reg3 }
            }
            let spill2 = owners[spill_reg]
            if (lir.values[spill2].end > lir.values[i].end)
            {
                lir.values[i].phys_reg = lir.values[spill2].phys_reg
                lir.values[i].spilled = 0
                lir.values[spill2].phys_reg = ""
                lir.values[spill2].spilled = 1
                owners[spill_reg] = i
            }
            else { lir.values[i].phys_reg = ""; lir.values[i].spilled = 1 }
        }
    }
    let mut used12 = 0
    let mut used13 = 0
    let mut used14 = 0
    let mut used15 = 0
    for (i2 in 0 .. lir.values.length)
    {
        if (lir.values[i2].spilled == 0)
        {
            if (lir.values[i2].phys_reg == "r12") { used12 = 1 }
            elif (lir.values[i2].phys_reg == "r13") { used13 = 1 }
            elif (lir.values[i2].phys_reg == "r14") { used14 = 1 }
            elif (lir.values[i2].phys_reg == "r15") { used15 = 1 }
        }
    }
    lir.used_callee_regs = used12 + used13 * 2 + used14 * 4 + used15 * 8
}

pub fn machine_lir_error(out: &MachineLirModule, f: MachineFunction, inst: MachineInst, text: string)
{
    out.error = text
    out.error_line = inst.line_no
    out.error_function = f.name
}

pub fn machine_lir_build(module: MachineModule): MachineLirModule
{
    let mut out = MachineLirModule{ machine: module, functions: [], error: "", error_line: 0, error_function: "" }
    let mut module_candidates = 0
    for (count_f in 0 .. module.functions.length)
    {
        for (count_b in 0 .. module.functions[count_f].blocks.length)
        {
            for (count_i in 0 .. module.functions[count_f].blocks[count_b].insts.length)
            {
                let count_inst = module.functions[count_f].blocks[count_b].insts[count_i]
                if (count_inst.opcode == "load" and count_inst.dest != "" and machine_lir_is_register_type(count_inst.ty) == 1) { module_candidates += 1 }
            }
        }
    }
    let force_spill = if (module_candidates > 20000) { 1 } else { 0 }
    for (i in 0 .. module.functions.length)
    {
        let f = module.functions[i]
        let mut lir = machine_lir_build_function(f, force_spill)
        for (bi in 0 .. f.blocks.length)
        {
            if (f.blocks[bi].insts.length > 0)
            {
                let last = f.blocks[bi].insts[f.blocks[bi].insts.length - 1]
                let target1 = machine_lir_branch_target(last, 0)
                let target2 = machine_lir_branch_target(last, 1)
                if (target1 != "" and lir.blocks[bi].succ1 < 0 and out.error == "") { machine_lir_error(&out, f, last, "unknown branch target " + target1) }
                if (target2 != "" and lir.blocks[bi].succ2 < 0 and out.error == "") { machine_lir_error(&out, f, last, "unknown branch target " + target2) }
            }
        }
        for (bi2 in 0 .. f.blocks.length)
        {
            for (ii in 0 .. f.blocks[bi2].insts.length)
            {
                let inst = f.blocks[bi2].insts[ii]
                if (inst.opcode == "load" and inst.dest != "" and machine_lir_is_known_type(inst.ty) == 0 and out.error == "") { machine_lir_error(&out, f, inst, "invalid load type " + inst.ty) }
                let operands2 = machine_collect_operands(inst.text, inst.dest)
                for (oi in 0 .. operands2.length)
                {
                    let operand = operands2[oi]
                    let is_label = if (operand == machine_lir_branch_target(inst, 0) or operand == machine_lir_branch_target(inst, 1)) { 1 } else { 0 }
                    if (operand.length > 0)
                    {
                        if (compiler_string_byte(operand, 0) == '%' and is_label == 0 and machine_lir_name_index(lir, operand) < 0 and out.error == "") machine_lir_error(&out, f, inst, "undefined local SSA operand " + operand)
                    }
                }
            }
        }
        if (out.error != "") { return out }
        machine_lir_linear_scan(&lir)
        lir.blocks = []
        lir.names = []
        lir.temp_name_ids = []
        lir.temp_value_ids = []
        for (drop_b in 0 .. module.functions[i].blocks.length)
        {
            for (drop_i in 0 .. module.functions[i].blocks[drop_b].insts.length) { module.functions[i].blocks[drop_b].insts[drop_i].operands = [] }
        }
        out.functions.push(lir)
    }
    return out
}

pub fn mir2lir(mir: string): MachineLirModule => machine_lir_build(machine_parse(mir))

pub fn machine_lir_finish_frame(lir: &MachineLirFunction, names: [string], offsets: [i32], is_addr: [i32], tys: [string], frame_size: i32)
{
    lir.frame_names = names
    lir.frame_offsets = offsets
    lir.frame_is_addr = is_addr
    lir.frame_tys = tys
    lir.frame_size = frame_size
    lir.frame_ready = 1
}

pub fn machine_lir_debug(lir: MachineLirModule): string
{
    let mut out = "machine_lir {\n"
    for (fi in 0 .. lir.functions.length)
    {
        let f = lir.functions[fi]
        out = out + "  fn @" + f.name + " frame=" + if (f.frame_ready == 1) { i32_to_str(f.frame_size) } else { "pending" } + " {\n"
        for (vi in 0 .. f.values.length)
        {
            let v = f.values[vi]
            let location = if (v.spilled == 1 or v.phys_reg == "") { "spill" } else { v.phys_reg }
            out = out + "    vreg " + v.name + ": " + v.ty + " [" + i32_to_str(v.start) + "," + i32_to_str(v.end) + "] -> " + location + "\n"
        }
        out = out + "  }\n"
    }
    return out + "}\n"
}
