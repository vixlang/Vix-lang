#[no_main]
import "types.vix"

extern "C"
{
    fn vix_join_lines(lines: [string]): string
    fn vix_substr(text: string, start: i32, end: i32): string
    fn vix_trim_ascii(text: string): string
    fn vix_clean_symbol_name(name: string): string
}

pub fn mir2asm_trim(text: string): string
{
    return vix_trim_ascii(text)
}

pub fn mir2asm_starts_with(text: string, prefix: string): i32
{
    if (text.length < prefix.length) { return 0 }
    for (i in 0 .. prefix.length)
    {
        if (text[i] != prefix[i]) { return 0 }
    }
    return 1
}

pub fn mir2asm_find(text: string, needle: i8, start: i32): i32
{
    for (i in start .. text.length)
    {
        if (text[i] == needle) { return i }
    }
    return -1
}

pub fn mir2asm_find_unescaped(text: string, needle: i8, start: i32): i32
{
    let mut escaped = 0
    for (i in start .. text.length)
    {
        let c = text[i]
        if (escaped == 1)
        {
            escaped = 0
        }
        elif (c == 92)
        {
            escaped = 1
        }
        elif (c == needle)
        {
            return i
        }
    }
    return -1
}

pub fn mir2asm_find_matching_paren(text: string, lp: i32): i32
{
    if (lp < 0 or lp >= text.length or text[lp] != '(') { return -1 }
    let mut depth = 0
    for (i in lp .. text.length)
    {
        if (text[i] == '(') { depth += 1 }
        elif (text[i] == ')')
        {
            depth -= 1
            if (depth == 0) { return i }
        }
    }
    return -1
}

pub fn mir2asm_slice(text: string, start: i32, end: i32): string
{
    return vix_substr(text, start, end)
}

pub fn mir2asm_after(text: string, start: i32): string
{
    return mir2asm_slice(text, start, text.length)
}

pub fn mir2asm_clean_name(name: string): string
{
    return vix_clean_symbol_name(name)
}

pub fn mir2asm_dest(line: string): string
{
    let eq = mir2asm_find(line, '=', 0)
    if (eq < 0) { return "" }
    return mir2asm_trim(mir2asm_slice(line, 0, eq))
}

pub fn mir2asm_rhs(line: string): string
{
    let eq = mir2asm_find(line, '=', 0)
    if (eq < 0) { return line }
    return mir2asm_trim(mir2asm_after(line, eq + 1))
}

pub fn mir2asm_line(b: &MirAsm, text: string)
{
    b.out.push(text)
}

pub fn mir2asm_data_line(b: &MirAsm, text: string)
{
    b.data.push(text)
}

pub fn mir2asm_comment_text(text: string): string
{
    let mut out = ""
    for (i in 0 .. text.length)
    {
        if (text[i] == 10 or text[i] == 13) { out = out + " " }
        else { out = out + char_string(text[i]) }
    }
    return out
}

pub fn mir2asm_mir_comment(b: &MirAsm, line: string, line_no: i32)
{
    if (b.debug_mir_comments == 1 and line != "")
    {
        mir2asm_line(b, "    ; MIR: " + mir2asm_comment_text(line) + " (line " + i32_to_str(line_no) + ")")
    }
}

pub fn mir2asm_type_is_64(ty: string): i32
{
    if (ty == "i64" or ty == "u64" or ty == "usize" or ty == "ptr" or ty == "string") { return 1 }
    if (ty == "f64") { return 1 }
    if (mir2asm_starts_with(ty, "ptr:") == 1) { return 1 }
    return 0
}

pub fn mir2asm_type_is_float(ty: string): i32
{
    if (ty == "f32" or ty == "f64") { return 1 }
    return 0
}

pub fn mir2asm_mem_word(ty: string): string
{
    if (mir2asm_type_is_64(ty) == 1) { return "qword" }
    if (ty == "i8" or ty == "u8" or ty == "char") { return "byte" }
    return "dword"
}

pub fn mir2asm_type_size(ty: string): i32
{
    if (ty == "i8" or ty == "u8" or ty == "char") { return 1 }
    if (ty == "i64" or ty == "u64" or ty == "usize" or ty == "ptr" or ty == "string") { return 8 }
    if (ty == "f64") { return 8 }
    if (ty == "f32") { return 4 }
    if (mir2asm_starts_with(ty, "ptr:") == 1) { return 8 }
    return 4
}

pub fn mir2asm_align_to(n: i32, align: i32): i32
{
    if (align <= 1) { return n }
    let rem = n % align
    if (rem == 0) { return n }
    return n + (align - rem)
}

pub fn mir2asm_struct_index(b: &MirAsm, ty: string): i32
{
    let clean = mir2asm_clean_name(ty)
    for (i in 0 .. b.struct_names.length)
    {
        if (b.struct_names[i] == clean) { return i }
        if ("@" + b.struct_names[i] == clean) { return i }
        if (b.struct_names[i] == "@" + clean) { return i }
    }
    return -1
}

pub fn mir2asm_type_is_struct_value(b: &MirAsm, ty: string): i32
{
    if (ty.length > 0 and ty[0] == '@') { return 1 }
    if (mir2asm_struct_index(b, ty) >= 0) { return 1 }
    return 0
}

pub fn mir2asm_type_size_for(b: &MirAsm, ty: string): i32
{
    let idx = mir2asm_struct_index(b, ty)
    if (idx >= 0) { return b.struct_sizes[idx] }
    return mir2asm_type_size(ty)
}

pub fn mir2asm_slot_size_for(b: &MirAsm, ty: string): i32
{
    let size = mir2asm_type_size_for(b, ty)
    if (size < 8) { return 8 }
    return mir2asm_align_to(size, 8)
}

pub fn mir2asm_struct_field_base(b: &MirAsm, ty: string): i32
{
    let clean = mir2asm_clean_name(ty)
    let mut base = 0
    for (i in 0 .. b.struct_names.length)
    {
        if (b.struct_names[i] == clean) { return base }
        base += b.struct_field_counts[i]
    }
    return -1
}

pub fn mir2asm_struct_field_ty(b: &MirAsm, ty: string, field_index: i32): string
{
    let base = mir2asm_struct_field_base(b, ty)
    let sidx = mir2asm_struct_index(b, ty)
    if (base < 0 or sidx < 0 or field_index < 0 or field_index >= b.struct_field_counts[sidx]) { return "i32" }
    return b.struct_field_tys[base + field_index]
}

pub fn mir2asm_struct_field_offset(b: &MirAsm, ty: string, field_index: i32): i32
{
    let base = mir2asm_struct_field_base(b, ty)
    let sidx = mir2asm_struct_index(b, ty)
    if (base < 0 or sidx < 0 or field_index < 0 or field_index >= b.struct_field_counts[sidx]) { return 0 }
    return b.struct_field_offsets[base + field_index]
}

pub fn mir2asm_mem_at(offset: i32, field_offset: i32): string
{
    let effective = offset - field_offset
    if (effective == 0) { return "[rbp]" }
    if (effective > 0) { return "[rbp-" + i32_to_str(effective) + "]" }
    return "[rbp+" + i32_to_str(0 - effective) + "]"
}

pub fn mir2asm_unescape_string(text: string): string
{
    let mut out = ""
    let mut i = 0
    while (i < text.length)
    {
        let c = text[i]
        if (c == 92 and i + 1 < text.length)
        {
            let n = text[i + 1]
            if (n == 'n') { out = out + char_string(10) }
            elif (n == 't') { out = out + char_string(9) }
            elif (n == 'r') { out = out + char_string(13) }
            elif (n == '"') { out = out + char_string('"') }
            elif (n == 92) { out = out + char_string(92) }
            else { out = out + char_string(n) }
            i += 2
        }
        else
        {
            out = out + char_string(c)
            i += 1
        }
    }
    return out
}

pub fn mir2asm_string_label(b: &MirAsm, text: string): string
{
    for (i in 0 .. b.string_values.length)
    {
        if (b.string_values[i] == text) { return b.string_labels[i] }
    }
    let label = "Lstr" + i32_to_str(b.string_counter)
    b.string_counter += 1
    b.string_values.push(text)
    b.string_labels.push(label)
    let mut bytes = ""
    for (i in 0 .. text.length)
    {
        if (i > 0) { bytes = bytes + ", " }
        bytes = bytes + i32_to_str(text[i])
    }
    if (bytes != "") { bytes = bytes + ", " }
    mir2asm_data_line(b, label + ": db " + bytes + "0")
    return label
}
