#[no_main]
import "types.vix"
import "target.vix"
import "registers.vix"

pub fn mir2asm_label(b: &MirAsm, name: string): string
{
    return b.fn_name + "__" + mir2asm_clean_name(name)
}

pub fn mir2asm_find_name(b: &MirAsm, name: string): i32
{
    let clean = mir2asm_clean_name(name)
    for (i in 0 .. b.names.length)
    {
        if (b.names[i] == clean) { return i }
    }
    return -1
}

pub fn mir2asm_alloc_slot(b: &MirAsm, name: string, addr: i32): i32
{
    return mir2asm_alloc_slot_typed(b, name, addr, "i32")
}

pub fn mir2asm_alloc_slot_typed(b: &MirAsm, name: string, addr: i32, ty: string): i32
{
    let clean = mir2asm_clean_name(name)
    let existing = mir2asm_find_name(b, clean)
    if (existing >= 0) { return b.offsets[existing] }
    b.stack_next += mir2asm_slot_size_for(b, ty)
    b.names.push(clean)
    b.offsets.push(b.stack_next)
    b.is_addr.push(addr)
    b.slot_tys.push(ty)
    return b.stack_next
}

pub fn mir2asm_mem(offset: i32): string
{
    return "[rbp-" + i32_to_str(offset) + "]"
}

pub fn mir2asm_operand32(b: &MirAsm, value: string): string
{
    return mir2asm_operand_typed(b, value, "i32")
}

pub fn mir2asm_slot_ty(b: &MirAsm, value: string): string
{
    let clean = mir2asm_clean_name(mir2asm_trim(value))
    let idx = mir2asm_find_name(b, clean)
    if (idx >= 0) { return b.slot_tys[idx] }
    for (i in 0 .. b.param_names.length)
    {
        if (b.param_names[i] == clean) { return b.param_tys[i] }
    }
    return "i32"
}

pub fn mir2asm_set_slot_ty(b: &MirAsm, value: string, ty: string)
{
    let idx = mir2asm_find_name(b, value)
    if (idx >= 0) { b.slot_tys[idx] = ty }
}

pub fn mir2asm_value_slot_ty(b: &MirAsm, value: string): string
{
    let idx = mir2asm_find_name(b, value)
    if (idx >= 0) { return b.slot_tys[idx] }
    return ""
}

pub fn mir2asm_type_is_byte(ty: string): i32
{
    if (ty == "i8" or ty == "u8" or ty == "char") { return 1 }
    return 0
}

pub fn mir2asm_pointee_ty(ty: string): string
{
    if (mir2asm_starts_with(ty, "ptr:") == 1) { return mir2asm_after(ty, 4) }
    if (ty == "string") { return "i8" }
    return "i32"
}

pub fn mir2asm_operand_typed(b: &MirAsm, value: string, ty: string): string
{
    let v = mir2asm_trim(value)
    if (v == "null" or v == "undef") { return "0" }
    if (v.length == 0) { return "0" }
    if (mir2asm_starts_with(v, "sizeof(") == 1 and v[v.length - 1] == ')')
    {
        let size_ty = mir2asm_trim(mir2asm_slice(v, 7, v.length - 1))
        return i32_to_str(mir2asm_type_size_for(b, size_ty))
    }
    if (v[0] >= '0' and v[0] <= '9') { return v }
    if (v[0] == '-' and v.length > 1) { return v }
    let clean = mir2asm_clean_name(v)
    let idx = mir2asm_find_name(b, clean)
    if (idx >= 0) { return mir2asm_mem_word(ty) + " " + mir2asm_mem(b.offsets[idx]) }
    for (i in 0 .. b.param_names.length)
    {
        if (b.param_names[i] == clean) { return mir2asm_arg_reg_typed(i, ty) }
    }
    return "0"
}

pub fn mir2asm_address(b: &MirAsm, value: string): string
{
    let clean = mir2asm_clean_name(mir2asm_trim(value))
    let idx = mir2asm_find_name(b, clean)
    if (idx >= 0) { return mir2asm_mem(b.offsets[idx]) }
    let off = mir2asm_alloc_slot(b, clean, 1)
    return mir2asm_mem(off)
}
