#[no_main]

pub fn mir2asm_syscall_reg(index: i32): string
{
    if (index == 0) { return "rax" }
    if (index == 1) { return "rdi" }
    if (index == 2) { return "rsi" }
    if (index == 3) { return "rdx" }
    if (index == 4) { return "r10" }
    if (index == 5) { return "r8" }
    if (index == 6) { return "r9" }
    return "rax"
}

pub fn mir2asm_call_arg_reg(index: i32): string
{
    return mir2asm_arg_reg_typed(index, "i32")
}
