#[no_main]

pub fn mir2asm_icmp_setcc(pred: string): string
{
    if (pred == "eq") { return "sete" }
    if (pred == "ne") { return "setne" }
    if (pred == "ult") { return "setb" }
    if (pred == "ule") { return "setbe" }
    if (pred == "ugt") { return "seta" }
    if (pred == "uge") { return "setae" }
    if (pred == "slt") { return "setl" }
    if (pred == "sle") { return "setle" }
    if (pred == "sgt") { return "setg" }
    return "setge"
}
