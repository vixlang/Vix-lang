#[no_main]

pub fn mir2asm_begin_function(b: &MirAsm, line: string)
{
    let at = mir2asm_find(line, '@', 0)
    let lp = mir2asm_find(line, '(', at)
    if (at < 0 or lp < 0) { return }
    b.names = []
    b.offsets = []
    b.is_addr = []
    b.slot_tys = []
    b.param_names = []
    b.param_tys = []
    b.param_regs = []
    b.stack_next = 0
    b.in_fn = 1
    b.fn_name = mir2asm_clean_name(mir2asm_slice(line, at, lp))
    let rp2 = mir2asm_find(line, ')', lp)
    let colon2 = mir2asm_find(line, ':', rp2)
    let brace2 = mir2asm_find(line, '{', rp2)
    if (colon2 >= 0)
    {
        let ret_end = if (brace2 > colon2) { brace2 } else { line.length }
        b.fn_ret_ty = mir2asm_trim(mir2asm_slice(line, colon2 + 1, ret_end))
    }
    else
    {
    b.fn_ret_ty = "void"
    }
    b.fn_sret = mir2asm_type_is_struct_value(b, b.fn_ret_ty)
    b.ret_label = b.fn_name + "__return"
    b.frame_patch_index = -1
    mir2asm_line(b, "global " + b.fn_name)
    mir2asm_line(b, b.fn_name + ":")
    mir2asm_line(b, "    push rbp")
    mir2asm_line(b, "    mov rbp, rsp")
    b.frame_patch_index = b.out.length
    mir2asm_line(b, "    sub rsp, 0")
    let rp = mir2asm_find(line, ')', lp)
    let mut pos = lp + 1
    let mut arg = if (b.fn_sret == 1) { 1 } else { 0 }
    let mut float_arg = 0
    if (b.fn_sret == 1)
    {
        let sret_off = mir2asm_alloc_slot_typed(b, "__sret", 0, "ptr:" + b.fn_ret_ty)
        mir2asm_line(b, "    mov qword " + mir2asm_mem(sret_off) + ", rdi")
    }
    while (rp > 0 and pos < rp)
    {
        if (line[pos] == '%')
        {
            let colon = mir2asm_find(line, ':', pos)
            if (colon > pos and colon < rp)
            {
                let mut ty_end = mir2asm_find(line, ',', colon)
                if (ty_end < 0 or ty_end > rp) { ty_end = rp }
                let param_ty = mir2asm_trim(mir2asm_slice(line, colon + 1, ty_end))
                let param_name = mir2asm_clean_name(mir2asm_slice(line, pos, colon))
                let param_reg = if (mir2asm_type_is_float(param_ty) == 1) { mir2asm_arg_reg_typed(float_arg, param_ty) } elif (mir2asm_type_is_struct_value(b, param_ty) == 1) { mir2asm_arg_reg_typed(arg, "ptr") } else { mir2asm_arg_reg_typed(arg, param_ty) }
                b.param_names.push(param_name)
                b.param_tys.push(param_ty)
                b.param_regs.push(param_reg)
                let param_off = mir2asm_alloc_slot_typed(b, param_name, 0, param_ty)
                if (mir2asm_type_is_struct_value(b, param_ty) == 1)
                {
                    mir2asm_emit_copy_reg_to_stack(b, param_off, param_reg, mir2asm_type_size_for(b, param_ty))
                }
                else
                {
                    mir2asm_emit_save_arg(b, param_ty, mir2asm_mem(param_off), param_reg)
                }
                if (mir2asm_type_is_float(param_ty) == 1) { float_arg += 1 }
                else { arg += 1 }
                pos = ty_end
            }
        }
        pos += 1
    }
}

pub fn mir2asm_end_function(b: &MirAsm)
{
    if (b.in_fn == 0) { return }
    if (b.frame_patch_index >= 0)
    {
        let frame_size = mir2asm_align_to(b.stack_next, 16)
        b.out[b.frame_patch_index] = "    sub rsp, " + i32_to_str(frame_size)
    }
    mir2asm_line(b, b.ret_label + ":")
    mir2asm_line(b, "    mov rsp, rbp")
    mir2asm_line(b, "    pop rbp")
    mir2asm_line(b, "    ret")
    b.in_fn = 0
}

pub fn mir2asm_emit_unsupported(b: &MirAsm, line: string)
{
    mir2asm_line(b, "    ; unsupported MIR: " + line)
    mir2asm_line(b, "    %error \"unsupported MIR instruction in self backend\"")
}

pub fn mir2asm_emit_save_arg(b: &MirAsm, ty: string, dest: string, reg: string)
{
    if (ty == "f64")
    {
        mir2asm_line(b, "    movq qword " + dest + ", " + reg)
        return
    }
    if (ty == "f32")
    {
        mir2asm_line(b, "    movd dword " + dest + ", " + reg)
        return
    }
    mir2asm_line(b, "    mov " + mir2asm_mem_word(ty) + " " + dest + ", " + reg)
}

pub fn mir2asm_emit_load_float_arg(b: &MirAsm, reg: string, val: string, ty: string)
{
    let v = mir2asm_trim(val)
    if (v == "0" or v == "0.0" or v == "0.000000")
    {
        mir2asm_line(b, "    pxor " + reg + ", " + reg)
        return
    }
    let val_idx = mir2asm_find_name(b, v)
    if (val_idx >= 0)
    {
        if (ty == "f64") { mir2asm_line(b, "    movq " + reg + ", qword " + mir2asm_mem(b.offsets[val_idx])) }
        else { mir2asm_line(b, "    movd " + reg + ", dword " + mir2asm_mem(b.offsets[val_idx])) }
        return
    }
    mir2asm_line(b, "    pxor " + reg + ", " + reg)
}

pub fn mir2asm_emit_load_int_reg(b: &MirAsm, reg: string, val: string, ty: string)
{
    let idx = mir2asm_find_name(b, val)
    if (idx >= 0 and mir2asm_type_is_byte(b.slot_tys[idx]) == 1 and mir2asm_type_is_byte(ty) == 0)
    {
        mir2asm_line(b, "    movzx " + reg + ", byte " + mir2asm_mem(b.offsets[idx]))
        return
    }
    mir2asm_line(b, "    mov " + reg + ", " + mir2asm_operand_typed(b, val, ty))
}

pub fn mir2asm_emit_prepare_int_operand(b: &MirAsm, reg: string, val: string, ty: string): string
{
    let idx = mir2asm_find_name(b, val)
    if (idx >= 0 and mir2asm_type_is_byte(b.slot_tys[idx]) == 1 and mir2asm_type_is_byte(ty) == 0)
    {
        mir2asm_line(b, "    movzx " + reg + ", byte " + mir2asm_mem(b.offsets[idx]))
        return reg
    }
    return mir2asm_operand_typed(b, val, ty)
}

pub fn mir2asm_parse_type_decl(b: &MirAsm, line: string)
{
    let at = mir2asm_find(line, '@', 0)
    let eq = mir2asm_find(line, '=', at)
    let lb = mir2asm_find(line, '{', eq)
    let rb = mir2asm_find(line, '}', lb)
    if (at < 0 or eq < 0 or lb < 0 or rb < 0) { return }
    let name = mir2asm_clean_name(mir2asm_trim(mir2asm_slice(line, at, eq)))
    if (mir2asm_struct_index(b, name) >= 0) { return }
    let mut pos = lb + 1
    let mut count = 0
    let mut offset = 0
    let mut max_align = 1
    while (pos < rb)
    {
        let comma = mir2asm_find(line, ',', pos)
        let end = if (comma < 0 or comma > rb) { rb } else { comma }
        let ty = mir2asm_trim(mir2asm_slice(line, pos, end))
        if (ty != "")
        {
            let mut align = mir2asm_type_size_for(b, ty)
            if (align > 8) { align = 8 }
            if (align < 1) { align = 1 }
            offset = mir2asm_align_to(offset, align)
            b.struct_field_tys.push(ty)
            b.struct_field_offsets.push(offset)
            offset += mir2asm_type_size_for(b, ty)
            if (align > max_align) { max_align = align }
            count += 1
        }
        pos = end + 1
    }
    b.struct_names.push(name)
    b.struct_field_counts.push(count)
    b.struct_sizes.push(mir2asm_align_to(offset, max_align))
}

pub fn mir2asm_emit_zero_bytes(b: &MirAsm, dest_offset: i32, size: i32)
{
    let mut copied = 0
    while (copied < size)
    {
        let remain = size - copied
        if (remain >= 8)
        {
            mir2asm_line(b, "    mov qword " + mir2asm_mem_at(dest_offset, copied) + ", 0")
            copied += 8
        }
        elif (remain >= 4)
        {
            mir2asm_line(b, "    mov dword " + mir2asm_mem_at(dest_offset, copied) + ", 0")
            copied += 4
        }
        else
        {
            mir2asm_line(b, "    mov byte " + mir2asm_mem_at(dest_offset, copied) + ", 0")
            copied += 1
        }
    }
}

pub fn mir2asm_emit_copy_stack_bytes(b: &MirAsm, dest_offset: i32, src_offset: i32, size: i32)
{
    let mut copied = 0
    while (copied < size)
    {
        let remain = size - copied
        if (remain >= 8)
        {
            mir2asm_line(b, "    mov rax, qword " + mir2asm_mem_at(src_offset, copied))
            mir2asm_line(b, "    mov qword " + mir2asm_mem_at(dest_offset, copied) + ", rax")
            copied += 8
        }
        elif (remain >= 4)
        {
            mir2asm_line(b, "    mov eax, dword " + mir2asm_mem_at(src_offset, copied))
            mir2asm_line(b, "    mov dword " + mir2asm_mem_at(dest_offset, copied) + ", eax")
            copied += 4
        }
        else
        {
            mir2asm_line(b, "    mov al, byte " + mir2asm_mem_at(src_offset, copied))
            mir2asm_line(b, "    mov byte " + mir2asm_mem_at(dest_offset, copied) + ", al")
            copied += 1
        }
    }
}

pub fn mir2asm_emit_copy_ptr_to_stack(b: &MirAsm, dest_offset: i32, ptr_value: string, size: i32)
{
    mir2asm_line(b, "    mov r11, " + mir2asm_operand_typed(b, ptr_value, "ptr"))
    let mut copied = 0
    while (copied < size)
    {
        let remain = size - copied
        if (remain >= 8)
        {
            mir2asm_line(b, "    mov rax, qword [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov qword " + mir2asm_mem_at(dest_offset, copied) + ", rax")
            copied += 8
        }
        elif (remain >= 4)
        {
            mir2asm_line(b, "    mov eax, dword [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov dword " + mir2asm_mem_at(dest_offset, copied) + ", eax")
            copied += 4
        }
        else
        {
            mir2asm_line(b, "    mov al, byte [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov byte " + mir2asm_mem_at(dest_offset, copied) + ", al")
            copied += 1
        }
    }
}

pub fn mir2asm_emit_copy_ptr_field_to_stack(b: &MirAsm, dest_offset: i32, ptr_value: string, field_offset: i32, size: i32)
{
    mir2asm_line(b, "    mov r11, " + mir2asm_operand_typed(b, ptr_value, "ptr"))
    if (field_offset != 0) { mir2asm_line(b, "    add r11, " + i32_to_str(field_offset)) }
    let mut copied = 0
    while (copied < size)
    {
        let remain = size - copied
        if (remain >= 8)
        {
            mir2asm_line(b, "    mov rax, qword [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov qword " + mir2asm_mem_at(dest_offset, copied) + ", rax")
            copied += 8
        }
        elif (remain >= 4)
        {
            mir2asm_line(b, "    mov eax, dword [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov dword " + mir2asm_mem_at(dest_offset, copied) + ", eax")
            copied += 4
        }
        else
        {
            mir2asm_line(b, "    mov al, byte [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov byte " + mir2asm_mem_at(dest_offset, copied) + ", al")
            copied += 1
        }
    }
}

pub fn mir2asm_emit_copy_reg_to_stack(b: &MirAsm, dest_offset: i32, reg: string, size: i32)
{
    mir2asm_line(b, "    mov r11, " + reg)
    let mut copied = 0
    while (copied < size)
    {
        let remain = size - copied
        if (remain >= 8)
        {
            mir2asm_line(b, "    mov rax, qword [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov qword " + mir2asm_mem_at(dest_offset, copied) + ", rax")
            copied += 8
        }
        elif (remain >= 4)
        {
            mir2asm_line(b, "    mov eax, dword [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov dword " + mir2asm_mem_at(dest_offset, copied) + ", eax")
            copied += 4
        }
        else
        {
            mir2asm_line(b, "    mov al, byte [r11+" + i32_to_str(copied) + "]")
            mir2asm_line(b, "    mov byte " + mir2asm_mem_at(dest_offset, copied) + ", al")
            copied += 1
        }
    }
}

pub fn mir2asm_emit_copy_stack_to_ptr(b: &MirAsm, ptr_value: string, src_offset: i32, size: i32)
{
    mir2asm_line(b, "    mov r11, " + mir2asm_operand_typed(b, ptr_value, "ptr"))
    let mut copied = 0
    while (copied < size)
    {
        let remain = size - copied
        if (remain >= 8)
        {
            mir2asm_line(b, "    mov rax, qword " + mir2asm_mem_at(src_offset, copied))
            mir2asm_line(b, "    mov qword [r11+" + i32_to_str(copied) + "], rax")
            copied += 8
        }
        elif (remain >= 4)
        {
            mir2asm_line(b, "    mov eax, dword " + mir2asm_mem_at(src_offset, copied))
            mir2asm_line(b, "    mov dword [r11+" + i32_to_str(copied) + "], eax")
            copied += 4
        }
        else
        {
            mir2asm_line(b, "    mov al, byte " + mir2asm_mem_at(src_offset, copied))
            mir2asm_line(b, "    mov byte [r11+" + i32_to_str(copied) + "], al")
            copied += 1
        }
    }
}

pub fn mir2asm_index_in_brackets(text: string, start: i32): i32
{
    let lb = mir2asm_find(text, '[', start)
    let rb = mir2asm_find(text, ']', lb)
    if (lb < 0 or rb < 0) { return 0 }
    let raw = mir2asm_trim(mir2asm_slice(text, lb + 1, rb))
    let comma = mir2asm_find(raw, ',', 0)
    let value = if (comma >= 0) { mir2asm_trim(mir2asm_after(raw, comma + 1)) } else { raw }
    let mut out = 0
    for (i in 0 .. value.length)
    {
        if (value[i] >= '0' and value[i] <= '9')
        {
            out = out * 10 + (value[i] - '0')
        }
    }
    return out
}

pub fn mir2asm_emit_const_struct(b: &MirAsm, dest: string, rhs: string)
{
    let sp = mir2asm_find(rhs, ' ', 6)
    let ty = if (sp >= 0) { mir2asm_trim(mir2asm_slice(rhs, 6, sp)) } else { "i32" }
    let off = mir2asm_alloc_slot_typed(b, dest, 0, ty)
    mir2asm_emit_zero_bytes(b, off, mir2asm_type_size_for(b, ty))
}

pub fn mir2asm_emit_insertvalue(b: &MirAsm, dest: string, rhs: string)
{
    let ty_start = 12
    let ty_end = mir2asm_find(rhs, ' ', ty_start)
    let comma1 = mir2asm_find(rhs, ',', ty_end)
    let comma2 = mir2asm_find(rhs, ',', comma1 + 1)
    if (ty_end < 0 or comma1 < 0 or comma2 < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(rhs, ty_start, ty_end))
    let src = mir2asm_trim(mir2asm_slice(rhs, ty_end + 1, comma1))
    let val = mir2asm_trim(mir2asm_slice(rhs, comma1 + 1, comma2))
    let field_index = mir2asm_index_in_brackets(rhs, comma2)
    let dest_off = mir2asm_alloc_slot_typed(b, dest, 0, ty)
    let size = mir2asm_type_size_for(b, ty)
    let src_idx = mir2asm_find_name(b, src)
    if (src_idx >= 0) { mir2asm_emit_copy_stack_bytes(b, dest_off, b.offsets[src_idx], size) }
    else { mir2asm_emit_zero_bytes(b, dest_off, size) }
    let field_ty = mir2asm_struct_field_ty(b, ty, field_index)
    let field_off = mir2asm_struct_field_offset(b, ty, field_index)
    if (mir2asm_type_is_struct_value(b, field_ty) == 1)
    {
        let val_idx2 = mir2asm_find_name(b, val)
        if (val_idx2 >= 0)
        {
            mir2asm_emit_copy_stack_bytes(b, dest_off - field_off, b.offsets[val_idx2], mir2asm_type_size_for(b, field_ty))
        }
        else
        {
            mir2asm_emit_zero_bytes(b, dest_off - field_off, mir2asm_type_size_for(b, field_ty))
        }
        return
    }
    mir2asm_line(b, "    mov " + mir2asm_acc(field_ty) + ", " + mir2asm_operand_typed(b, val, field_ty))
    mir2asm_line(b, "    mov " + mir2asm_mem_word(field_ty) + " " + mir2asm_mem_at(dest_off, field_off) + ", " + mir2asm_acc(field_ty))
}

pub fn mir2asm_emit_extractvalue(b: &MirAsm, dest: string, rhs: string)
{
    let ty_start = 13
    let ty_end = mir2asm_find(rhs, ' ', ty_start)
    let comma = mir2asm_find(rhs, ',', ty_end)
    if (ty_end < 0 or comma < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(rhs, ty_start, ty_end))
    let src = mir2asm_trim(mir2asm_slice(rhs, ty_end + 1, comma))
    let field_index = mir2asm_index_in_brackets(rhs, comma)
    let field_ty = mir2asm_struct_field_ty(b, ty, field_index)
    let field_off = mir2asm_struct_field_offset(b, ty, field_index)
    let src_idx = mir2asm_find_name(b, src)
    if (src_idx < 0) { return }
    if (b.slot_tys[src_idx] == "ptr:" + ty)
    {
        let dest_off_ptr = mir2asm_alloc_slot_typed(b, dest, 0, field_ty)
        if (mir2asm_type_is_struct_value(b, field_ty) == 1 or (field_ty.length > 0 and field_ty[0] == '@'))
        {
            mir2asm_emit_copy_ptr_field_to_stack(b, dest_off_ptr, src, field_off, mir2asm_type_size_for(b, field_ty))
            return
        }
        mir2asm_line(b, "    mov r11, " + mir2asm_operand_typed(b, src, "ptr"))
        if (field_off != 0) { mir2asm_line(b, "    add r11, " + i32_to_str(field_off)) }
        mir2asm_line(b, "    mov " + mir2asm_acc(field_ty) + ", " + mir2asm_mem_word(field_ty) + " [r11]")
        mir2asm_line(b, "    mov " + mir2asm_mem(dest_off_ptr) + ", " + mir2asm_acc(field_ty))
        return
    }
    if (mir2asm_type_is_struct_value(b, field_ty) == 1 or (field_ty.length > 0 and field_ty[0] == '@'))
    {
        let dest_off = mir2asm_alloc_slot_typed(b, dest, 0, field_ty)
        mir2asm_emit_copy_stack_bytes(b, dest_off, b.offsets[src_idx] - field_off, mir2asm_type_size_for(b, field_ty))
        return
    }
    let dest_off2 = mir2asm_alloc_slot_typed(b, dest, 0, field_ty)
    mir2asm_line(b, "    mov " + mir2asm_acc(field_ty) + ", " + mir2asm_mem_word(field_ty) + " " + mir2asm_mem_at(b.offsets[src_idx], field_off))
    mir2asm_line(b, "    mov " + mir2asm_mem(dest_off2) + ", " + mir2asm_acc(field_ty))
}

pub fn mir2asm_emit_binop(b: &MirAsm, dest: string, rhs: string, op: string, asm_op: string)
{
    let start = op.length + 1
    let sp = mir2asm_find(rhs, ' ', start)
    let comma = mir2asm_find(rhs, ',', sp)
    if (sp < 0 or comma < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(rhs, start, sp))
    let left = mir2asm_trim(mir2asm_slice(rhs, sp + 1, comma))
    let right = mir2asm_trim(mir2asm_after(rhs, comma + 1))
    mir2asm_alloc_slot_typed(b, dest, 0, ty)
    let acc = mir2asm_acc(ty)
    mir2asm_emit_load_int_reg(b, acc, left, ty)
    if (op == "sdiv" or op == "srem")
    {
        if (mir2asm_type_is_64(ty) == 1) { mir2asm_line(b, "    cqo") }
        else { mir2asm_line(b, "    cdq") }
        mir2asm_emit_load_int_reg(b, mir2asm_cx(ty), right, ty)
        mir2asm_line(b, "    idiv " + mir2asm_cx(ty))
        if (op == "srem") { mir2asm_line(b, "    mov " + acc + ", " + mir2asm_dx(ty)) }
    }
    elif (op == "shl" or op == "ashr")
    {
        mir2asm_line(b, "    mov ecx, " + mir2asm_operand_typed(b, right, "i32"))
        mir2asm_line(b, "    " + asm_op + " " + acc + ", cl")
    }
    else
    {
        let right_op = mir2asm_emit_prepare_int_operand(b, mir2asm_cx(ty), right, ty)
        mir2asm_line(b, "    " + asm_op + " " + acc + ", " + right_op)
    }
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", " + acc)
}

pub fn mir2asm_emit_unary(b: &MirAsm, dest: string, rhs: string, op: string, asm_op: string)
{
    let start = op.length + 1
    let sp = mir2asm_find(rhs, ' ', start)
    if (sp < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(rhs, start, sp))
    let val = mir2asm_trim(mir2asm_after(rhs, sp + 1))
    mir2asm_alloc_slot_typed(b, dest, 0, ty)
    let acc = mir2asm_acc(ty)
    mir2asm_line(b, "    mov " + acc + ", " + mir2asm_operand_typed(b, val, ty))
    mir2asm_line(b, "    " + asm_op + " " + acc)
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", " + acc)
}

pub fn mir2asm_emit_cast(b: &MirAsm, dest: string, rhs: string)
{
    let p1 = mir2asm_find(rhs, ' ', 0)
    if (p1 < 0) { return }
    let op = mir2asm_trim(mir2asm_slice(rhs, 0, p1))
    let rest = mir2asm_trim(mir2asm_after(rhs, p1 + 1))
    let p2 = mir2asm_find(rest, ' ', 0)
    let to_pos = mir2asm_find(rest, ' ', p2 + 1)
    if (p2 < 0 or to_pos < 0) { return }
    let from_ty = mir2asm_trim(mir2asm_slice(rest, 0, p2))
    let val = mir2asm_trim(mir2asm_slice(rest, p2 + 1, to_pos))
    let to_ty = mir2asm_trim(mir2asm_after(rest, to_pos + 4))
    mir2asm_alloc_slot_typed(b, dest, 0, to_ty)
    if (op == "zext")
    {
        if (from_ty == "i8" or from_ty == "u8" or from_ty == "char")
        {
            mir2asm_line(b, "    movzx eax, " + mir2asm_operand_typed(b, val, from_ty))
        }
        else
        {
            mir2asm_line(b, "    mov eax, " + mir2asm_operand_typed(b, val, from_ty))
        }
        if (mir2asm_type_is_64(to_ty) == 1) { mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", rax") }
        else { mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", eax") }
        return
    }
    if (op == "trunc" and mir2asm_type_is_64(from_ty) == 1 and mir2asm_type_is_64(to_ty) == 0)
    {
        mir2asm_line(b, "    mov rax, " + mir2asm_operand_typed(b, val, from_ty))
        mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", " + mir2asm_acc(to_ty))
        return
    }
    if (op == "sitofp")
    {
        mir2asm_line(b, "    mov eax, " + mir2asm_operand_typed(b, val, from_ty))
        mir2asm_line(b, "    cvtsi2sd xmm0, eax")
        mir2asm_line(b, "    movq " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", xmm0")
        return
    }
    mir2asm_line(b, "    mov " + mir2asm_acc(to_ty) + ", " + mir2asm_operand_typed(b, val, from_ty))
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", " + mir2asm_acc(to_ty))
}

pub fn mir2asm_emit_gep(b: &MirAsm, dest: string, rhs: string)
{
    let comma1 = mir2asm_find(rhs, ',', 0)
    let comma2 = mir2asm_find(rhs, ',', comma1 + 1)
    let lb = mir2asm_find(rhs, '[', comma2)
    let rb = mir2asm_find(rhs, ']', lb)
    if (comma1 < 0 or comma2 < 0 or lb < 0 or rb < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(rhs, 4, comma1))
    let base = mir2asm_trim(mir2asm_slice(rhs, comma1 + 1, comma2))
    let index = mir2asm_trim(mir2asm_slice(rhs, lb + 1, rb))
    let comma_idx = mir2asm_find(index, ',', 0)
    let idx_val = if (comma_idx >= 0) { mir2asm_trim(mir2asm_after(index, comma_idx + 1)) } else { index }
    if (mir2asm_type_is_struct_value(b, ty) == 1 and comma_idx >= 0)
    {
        let field_index = mir2asm_index_in_brackets(rhs, comma2)
        let field_ty = mir2asm_struct_field_ty(b, ty, field_index)
        let field_off = mir2asm_struct_field_offset(b, ty, field_index)
        mir2asm_alloc_slot_typed(b, dest, 0, "ptr:" + field_ty)
        let base_idx = mir2asm_find_name(b, base)
        if (base_idx >= 0 and b.is_addr[base_idx] == 1 and b.slot_tys[base_idx] == ty)
        {
            mir2asm_line(b, "    lea rax, " + mir2asm_mem(b.offsets[base_idx]))
        }
        else
        {
            mir2asm_line(b, "    mov rax, " + mir2asm_operand_typed(b, base, "ptr"))
        }
        if (field_off != 0) { mir2asm_line(b, "    add rax, " + i32_to_str(field_off)) }
        mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", rax")
        return
    }
    let base_ty = mir2asm_slot_ty(b, base)
    let elem_ty = if (base_ty == "string" and ty == "i32") { "i8" } else { ty }
    let elem_size = mir2asm_type_size_for(b, elem_ty)
    mir2asm_alloc_slot_typed(b, dest, 0, "ptr:" + elem_ty)
    mir2asm_line(b, "    mov rax, " + mir2asm_operand_typed(b, base, "ptr"))
    mir2asm_line(b, "    mov ecx, " + mir2asm_operand_typed(b, idx_val, "i32"))
    if (elem_size != 1) { mir2asm_line(b, "    imul rcx, " + i32_to_str(elem_size)) }
    mir2asm_line(b, "    add rax, rcx")
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", rax")
}

pub fn mir2asm_emit_icmp(b: &MirAsm, dest: string, rhs: string)
{
    let mut p = mir2asm_find(rhs, ' ', 0)
    if (p < 0) { return }
    let rest = mir2asm_trim(mir2asm_after(rhs, p + 1))
    p = mir2asm_find(rest, ' ', 0)
    if (p < 0) { return }
    let pred = mir2asm_trim(mir2asm_slice(rest, 0, p))
    let typed = mir2asm_trim(mir2asm_after(rest, p + 1))
    p = mir2asm_find(typed, ' ', 0)
    let comma = mir2asm_find(typed, ',', p)
    if (p < 0 or comma < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(typed, 0, p))
    let left = mir2asm_trim(mir2asm_slice(typed, p + 1, comma))
    let right = mir2asm_trim(mir2asm_after(typed, comma + 1))
    mir2asm_alloc_slot_typed(b, dest, 0, "i32")
    mir2asm_emit_load_int_reg(b, mir2asm_acc(ty), left, ty)
    let right_op = mir2asm_emit_prepare_int_operand(b, mir2asm_cx(ty), right, ty)
    mir2asm_line(b, "    cmp " + mir2asm_acc(ty) + ", " + right_op)
    mir2asm_line(b, "    " + mir2asm_icmp_setcc(pred) + " al")
    mir2asm_line(b, "    movzx eax, al")
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", eax")
}

pub fn mir2asm_emit_syscall(b: &MirAsm, dest: string, rhs: string)
{
    let lp = mir2asm_find(rhs, '(', 0)
    let rp = mir2asm_find_matching_paren(rhs, lp)
    if (lp < 0 or rp < 0) { return }
    let mut pos = lp + 1
    let mut arg = 0
    while (pos < rp and arg < 7)
    {
        let comma = mir2asm_find(rhs, ',', pos)
        let end = if (comma < 0 or comma > rp) { rp } else { comma }
        let part = mir2asm_trim(mir2asm_slice(rhs, pos, end))
        let sp = mir2asm_find(part, ' ', 0)
        if (sp >= 0)
        {
            let arg_ty = mir2asm_trim(mir2asm_slice(part, 0, sp))
            let val = mir2asm_trim(mir2asm_after(part, sp + 1))
            mir2asm_line(b, "    mov " + mir2asm_syscall_reg(arg) + ", " + mir2asm_operand_typed(b, val, arg_ty))
            arg += 1
        }
        pos = end + 1
    }
    mir2asm_line(b, "    syscall")
    if (dest != "") { mir2asm_line(b, "    mov " + mir2asm_mem(mir2asm_alloc_slot_typed(b, dest, 0, "i64")) + ", rax") }
}

pub fn mir2asm_emit_call(b: &MirAsm, dest: string, rhs: string)
{
    let at = mir2asm_find(rhs, '@', 0)
    let lp = mir2asm_find(rhs, '(', at)
    if (at < 0 or lp < 0) { return }
    let func = mir2asm_clean_name(mir2asm_slice(rhs, at, lp))
    if (func == "syscall")
    {
        mir2asm_emit_syscall(b, dest, rhs)
        return
    }
    let rp = mir2asm_find_matching_paren(rhs, lp)
    let colon = mir2asm_find(rhs, ':', rp)
    let ret_ty = if (colon >= 0) { mir2asm_trim(mir2asm_after(rhs, colon + 1)) } else { "i32" }
    let sret = mir2asm_type_is_struct_value(b, ret_ty)
    if (dest != "" and sret == 1)
    {
        let dest_off = mir2asm_alloc_slot_typed(b, dest, 0, ret_ty)
        mir2asm_line(b, "    lea rdi, " + mir2asm_mem(dest_off))
    }
    let mut pos = lp + 1
    let mut arg = if (sret == 1) { 1 } else { 0 }
    let mut float_arg = 0
    while (rp > 0 and pos < rp)
    {
        let comma = mir2asm_find(rhs, ',', pos)
        let end = if (comma < 0 or comma > rp) { rp } else { comma }
        let part = mir2asm_trim(mir2asm_slice(rhs, pos, end))
        let sp = mir2asm_find(part, ' ', 0)
        if (sp >= 0)
        {
            let arg_ty = mir2asm_trim(mir2asm_slice(part, 0, sp))
            let val = mir2asm_trim(mir2asm_after(part, sp + 1))
            let val_idx = mir2asm_find_name(b, val)
            let mut pass_stack_addr = 0
            if (val_idx >= 0 and (arg_ty == "ptr" or mir2asm_starts_with(arg_ty, "ptr:") == 1))
            {
                if (b.is_addr[val_idx] == 1) { pass_stack_addr = 1 }
                elif (arg_ty == "ptr" and mir2asm_type_is_struct_value(b, b.slot_tys[val_idx]) == 1) { pass_stack_addr = 1 }
                elif (mir2asm_starts_with(arg_ty, "ptr:") == 1 and mir2asm_type_is_struct_value(b, b.slot_tys[val_idx]) == 1) { pass_stack_addr = 1 }
            }
            if (mir2asm_type_is_float(arg_ty) == 1)
            {
                if (float_arg < 8) { mir2asm_emit_load_float_arg(b, mir2asm_arg_reg_typed(float_arg, arg_ty), val, arg_ty) }
                float_arg += 1
            }
            elif (mir2asm_type_is_struct_value(b, arg_ty) == 1)
            {
                if (arg < 6 and val_idx >= 0)
                {
                    mir2asm_line(b, "    lea " + mir2asm_arg_reg_typed(arg, "ptr") + ", " + mir2asm_mem(b.offsets[val_idx]))
                }
                arg += 1
            }
            elif (arg < 6 and pass_stack_addr == 1)
            {
                mir2asm_line(b, "    lea " + mir2asm_arg_reg_typed(arg, arg_ty) + ", " + mir2asm_mem(b.offsets[val_idx]))
                arg += 1
            }
            elif (arg < 6)
            {
                mir2asm_line(b, "    mov " + mir2asm_arg_reg_typed(arg, arg_ty) + ", " + mir2asm_operand_typed(b, val, arg_ty))
                arg += 1
            }
        }
        pos = end + 1
    }
    mir2asm_line(b, "    mov al, " + i32_to_str(float_arg))
    mir2asm_line(b, "    call " + func)
    if (dest != "" and sret == 0)
    {
        let dest_off = mir2asm_alloc_slot_typed(b, dest, 0, ret_ty)
        if (ret_ty == "f64") { mir2asm_line(b, "    movq qword " + mir2asm_mem(dest_off) + ", xmm0") }
        elif (ret_ty == "f32") { mir2asm_line(b, "    movd dword " + mir2asm_mem(dest_off) + ", xmm0") }
        else { mir2asm_line(b, "    mov " + mir2asm_mem(dest_off) + ", " + mir2asm_acc(ret_ty)) }
    }
}

pub fn mir2asm_emit_instruction(b: &MirAsm, line: string)
{
    if (line == "" or mir2asm_starts_with(line, "mir_module") == 1 or line == "{") { return }
    if (mir2asm_starts_with(line, "type @") == 1)
    {
        mir2asm_parse_type_decl(b, line)
        return
    }
    if (mir2asm_starts_with(line, "extern") == 1)
    {
        let at = mir2asm_find(line, '@', 0)
        let lp = mir2asm_find(line, '(', at)
        let name = if (at >= 0 and lp > at) { mir2asm_clean_name(mir2asm_slice(line, at, lp)) } else { "" }
        if (name != "" and name != "syscall") { mir2asm_line(b, "extern " + name) }
        return
    }
    if (mir2asm_starts_with(line, "fn @") == 1)
    {
        mir2asm_begin_function(b, line)
        return
    }
    if (line == "}")
    {
        mir2asm_end_function(b)
        return
    }
    if (b.in_fn == 0) { return }
    if (mir2asm_starts_with(line, "block ") == 1)
    {
        let name = mir2asm_trim(mir2asm_slice(line, 6, line.length - 1))
        if (name != "%entry") { mir2asm_line(b, mir2asm_label(b, name) + ":") }
        return
    }
    if (mir2asm_starts_with(line, "ret void") == 1)
    {
        mir2asm_line(b, "    jmp " + b.ret_label)
        return
    }
    if (mir2asm_starts_with(line, "ret ") == 1)
    {
        let rest = mir2asm_trim(mir2asm_after(line, 4))
        let sp = mir2asm_find(rest, ' ', 0)
        let ty = if (sp >= 0) { mir2asm_trim(mir2asm_slice(rest, 0, sp)) } else { "i32" }
        let val = if (sp >= 0) { mir2asm_trim(mir2asm_after(rest, sp + 1)) } else { "0" }
        if (mir2asm_type_is_struct_value(b, ty) == 1)
        {
            let val_idx = mir2asm_find_name(b, val)
            let sret_idx = mir2asm_find_name(b, "__sret")
            if (val_idx >= 0 and sret_idx >= 0)
            {
                mir2asm_emit_copy_stack_to_ptr(b, "__sret", b.offsets[val_idx], mir2asm_type_size_for(b, ty))
                mir2asm_line(b, "    mov rax, qword " + mir2asm_mem(b.offsets[sret_idx]))
            }
            mir2asm_line(b, "    jmp " + b.ret_label)
            return
        }
        if (ty == "f64") { mir2asm_line(b, "    movq xmm0, " + mir2asm_operand_typed(b, val, ty)) }
        elif (ty == "f32") { mir2asm_line(b, "    movd xmm0, " + mir2asm_operand_typed(b, val, ty)) }
        else { mir2asm_line(b, "    mov " + mir2asm_acc(ty) + ", " + mir2asm_operand_typed(b, val, ty)) }
        mir2asm_line(b, "    jmp " + b.ret_label)
        return
    }
    if (mir2asm_starts_with(line, "br label ") == 1)
    {
        mir2asm_line(b, "    jmp " + mir2asm_label(b, mir2asm_trim(mir2asm_after(line, 9))))
        return
    }
    if (mir2asm_starts_with(line, "br_cond ") == 1)
    {
        let c1 = mir2asm_find(line, ',', 0)
        let c2 = mir2asm_find(line, ',', c1 + 1)
        if (c1 > 0 and c2 > c1)
        {
            let cond = mir2asm_trim(mir2asm_slice(line, 8, c1))
            let true_label = mir2asm_trim(mir2asm_after(mir2asm_trim(mir2asm_slice(line, c1 + 1, c2)), 6))
            let false_label = mir2asm_trim(mir2asm_after(mir2asm_trim(mir2asm_after(line, c2 + 1)), 6))
            mir2asm_line(b, "    cmp " + mir2asm_operand_typed(b, cond, "i32") + ", 0")
            mir2asm_line(b, "    je " + mir2asm_label(b, false_label))
            mir2asm_line(b, "    jmp " + mir2asm_label(b, true_label))
        }
        return
    }
    if (mir2asm_starts_with(line, "store ") == 1)
    {
        let comma = mir2asm_find(line, ',', 0)
        let sp = mir2asm_find(line, ' ', 6)
        if (comma > 0 and sp > 0)
        {
            let ty = mir2asm_trim(mir2asm_slice(line, 6, sp))
            let val = mir2asm_trim(mir2asm_slice(line, sp + 1, comma))
            let addr = mir2asm_trim(mir2asm_after(line, comma + 1))
            if (mir2asm_type_is_struct_value(b, ty) == 1)
            {
                let val_idx = mir2asm_find_name(b, val)
                let addr_idx2 = mir2asm_find_name(b, addr)
                if (val_idx >= 0 and addr_idx2 >= 0 and b.is_addr[addr_idx2] == 1)
                {
                    mir2asm_emit_copy_stack_bytes(b, b.offsets[addr_idx2], b.offsets[val_idx], mir2asm_type_size_for(b, ty))
                }
                elif (val_idx >= 0)
                {
                    mir2asm_emit_copy_stack_to_ptr(b, addr, b.offsets[val_idx], mir2asm_type_size_for(b, ty))
                }
                return
            }
            if (mir2asm_type_is_float(ty) == 1)
            {
                mir2asm_emit_load_float_arg(b, "xmm0", val, ty)
            }
            elif (ty == "i8" or ty == "u8" or ty == "char")
            {
                mir2asm_line(b, "    mov al, " + mir2asm_operand_typed(b, val, ty))
            }
            else
            {
                mir2asm_line(b, "    mov " + mir2asm_acc(ty) + ", " + mir2asm_operand_typed(b, val, ty))
            }
            let addr_idx = mir2asm_find_name(b, addr)
            if (addr_idx >= 0 and b.is_addr[addr_idx] == 1)
            {
                b.slot_tys[addr_idx] = ty
                if (ty == "f64") { mir2asm_line(b, "    movq qword " + mir2asm_mem(b.offsets[addr_idx]) + ", xmm0") }
                elif (ty == "f32") { mir2asm_line(b, "    movd dword " + mir2asm_mem(b.offsets[addr_idx]) + ", xmm0") }
                else { mir2asm_line(b, "    mov " + mir2asm_mem_word(ty) + " " + mir2asm_mem(b.offsets[addr_idx]) + ", " + mir2asm_acc(ty)) }
                if (ty == "ptr" and mir2asm_slot_ty(b, val) == "string") { b.slot_tys[addr_idx] = "string" }
            }
            else
            {
                mir2asm_line(b, "    mov r11, " + mir2asm_operand_typed(b, addr, "ptr"))
                if (ty == "f64") { mir2asm_line(b, "    movq qword [r11], xmm0") }
                elif (ty == "f32") { mir2asm_line(b, "    movd dword [r11], xmm0") }
                else { mir2asm_line(b, "    mov " + mir2asm_mem_word(ty) + " [r11], " + mir2asm_acc(ty)) }
            }
        }
        return
    }
    if (mir2asm_starts_with(line, "call ") == 1)
    {
        mir2asm_emit_call(b, "", line)
        return
    }
    let dest = mir2asm_dest(line)
    let rhs = mir2asm_rhs(line)
    if (dest == "")
    {
        mir2asm_emit_unsupported(b, line)
        return
    }
    if (mir2asm_starts_with(rhs, "alloca ") == 1)
    {
        mir2asm_alloc_slot_typed(b, dest, 1, mir2asm_trim(mir2asm_after(rhs, 7)))
        return
    }
    if (mir2asm_starts_with(rhs, "load ") == 1)
    {
        let comma = mir2asm_find(rhs, ',', 0)
        if (comma > 0)
        {
            let ty = mir2asm_trim(mir2asm_slice(rhs, 5, comma))
            let addr = mir2asm_trim(mir2asm_after(rhs, comma + 1))
            if (mir2asm_type_is_struct_value(b, ty) == 1)
            {
                let dest_off = mir2asm_alloc_slot_typed(b, dest, 0, ty)
                let addr_idx2 = mir2asm_find_name(b, addr)
                if (addr_idx2 >= 0 and b.is_addr[addr_idx2] == 1)
                {
                    mir2asm_emit_copy_stack_bytes(b, dest_off, b.offsets[addr_idx2], mir2asm_type_size_for(b, ty))
                }
                else
                {
                    mir2asm_emit_copy_ptr_to_stack(b, dest_off, addr, mir2asm_type_size_for(b, ty))
                }
                return
            }
            let addr_idx = mir2asm_find_name(b, addr)
            let addr_ty = if (addr_idx >= 0) { b.slot_tys[addr_idx] } else { "" }
            let src_ty = if (addr_ty == "ptr:i8" and ty == "i32") { "i8" } elif (addr_idx >= 0 and b.is_addr[addr_idx] == 1 and (addr_ty == "ptr" or addr_ty == "string") and ty == "i32") { addr_ty } else { ty }
            let dest_ty = if (src_ty == "i8" and ty == "i32") { "i32" } else { src_ty }
            if (addr_idx >= 0 and b.is_addr[addr_idx] == 1)
            {
                if (src_ty == "i8" or src_ty == "u8" or src_ty == "char")
                {
                    mir2asm_line(b, "    movzx eax, byte " + mir2asm_mem(b.offsets[addr_idx]))
                }
                else
                {
                    mir2asm_line(b, "    mov " + mir2asm_acc(src_ty) + ", " + mir2asm_mem_word(src_ty) + " " + mir2asm_mem(b.offsets[addr_idx]))
                }
            }
            else
            {
                mir2asm_line(b, "    mov rax, " + mir2asm_operand_typed(b, addr, "ptr"))
                if (src_ty == "i8" or src_ty == "u8" or src_ty == "char")
                {
                    mir2asm_line(b, "    movzx eax, byte [rax]")
                }
                else
                {
                    mir2asm_line(b, "    mov " + mir2asm_acc(src_ty) + ", " + mir2asm_mem_word(src_ty) + " [rax]")
                }
            }
            mir2asm_line(b, "    mov " + mir2asm_mem(mir2asm_alloc_slot_typed(b, dest, 0, dest_ty)) + ", " + mir2asm_acc(dest_ty))
        }
        return
    }
    if (mir2asm_starts_with(rhs, "add ") == 1) { mir2asm_emit_binop(b, dest, rhs, "add", "add"); return }
    if (mir2asm_starts_with(rhs, "sub ") == 1) { mir2asm_emit_binop(b, dest, rhs, "sub", "sub"); return }
    if (mir2asm_starts_with(rhs, "mul ") == 1) { mir2asm_emit_binop(b, dest, rhs, "mul", "imul"); return }
    if (mir2asm_starts_with(rhs, "sdiv ") == 1) { mir2asm_emit_binop(b, dest, rhs, "sdiv", "idiv"); return }
    if (mir2asm_starts_with(rhs, "srem ") == 1) { mir2asm_emit_binop(b, dest, rhs, "srem", "idiv"); return }
    if (mir2asm_starts_with(rhs, "and ") == 1) { mir2asm_emit_binop(b, dest, rhs, "and", "and"); return }
    if (mir2asm_starts_with(rhs, "or ") == 1) { mir2asm_emit_binop(b, dest, rhs, "or", "or"); return }
    if (mir2asm_starts_with(rhs, "xor ") == 1) { mir2asm_emit_binop(b, dest, rhs, "xor", "xor"); return }
    if (mir2asm_starts_with(rhs, "shl ") == 1) { mir2asm_emit_binop(b, dest, rhs, "shl", "shl"); return }
    if (mir2asm_starts_with(rhs, "ashr ") == 1) { mir2asm_emit_binop(b, dest, rhs, "ashr", "sar"); return }
    if (mir2asm_starts_with(rhs, "neg ") == 1) { mir2asm_emit_unary(b, dest, rhs, "neg", "neg"); return }
    if (mir2asm_starts_with(rhs, "icmp ") == 1) { mir2asm_emit_icmp(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "zext ") == 1 or mir2asm_starts_with(rhs, "trunc ") == 1 or mir2asm_starts_with(rhs, "sitofp ") == 1) { mir2asm_emit_cast(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "gep ") == 1) { mir2asm_emit_gep(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "call ") == 1) { mir2asm_emit_call(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "insertvalue ") == 1) { mir2asm_emit_insertvalue(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "extractvalue ") == 1) { mir2asm_emit_extractvalue(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "const ptr \"") == 1)
    {
        let q1 = mir2asm_find_unescaped(rhs, '"', 0)
        let q2 = mir2asm_find_unescaped(rhs, '"', q1 + 1)
        let text = if (q1 >= 0 and q2 > q1) { mir2asm_unescape_string(mir2asm_slice(rhs, q1 + 1, q2)) } else { "" }
        let label = mir2asm_string_label(b, text)
        mir2asm_line(b, "    lea rax, [" + label + "]")
        mir2asm_line(b, "    mov " + mir2asm_mem(mir2asm_alloc_slot_typed(b, dest, 0, "string")) + ", rax")
        return
    }
    if (mir2asm_starts_with(rhs, "const @") == 1)
    {
        mir2asm_emit_const_struct(b, dest, rhs)
        return
    }
    if (mir2asm_starts_with(rhs, "const ") == 1)
    {
        let sp = mir2asm_find(rhs, ' ', 6)
        let ty = if (sp >= 0) { mir2asm_trim(mir2asm_slice(rhs, 6, sp)) } else { "i32" }
        let val = if (sp >= 0) { mir2asm_trim(mir2asm_after(rhs, sp + 1)) } else { "0" }
        let dest_off = mir2asm_alloc_slot_typed(b, dest, 0, ty)
        if (mir2asm_type_is_float(ty) == 1)
        {
            mir2asm_emit_load_float_arg(b, "xmm0", val, ty)
            if (ty == "f64") { mir2asm_line(b, "    movq qword " + mir2asm_mem(dest_off) + ", xmm0") }
            else { mir2asm_line(b, "    movd dword " + mir2asm_mem(dest_off) + ", xmm0") }
        }
        else
        {
            mir2asm_line(b, "    mov " + mir2asm_acc(ty) + ", " + mir2asm_operand_typed(b, val, ty))
            mir2asm_line(b, "    mov " + mir2asm_mem(dest_off) + ", " + mir2asm_acc(ty))
        }
        return
    }
    mir2asm_emit_unsupported(b, line)
}
