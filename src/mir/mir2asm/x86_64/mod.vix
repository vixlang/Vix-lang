#[no_main]
import "abi.vix"
import "instructions.vix"
import "codegen.vix"

extern "C"
{
    fn fopen(path: ptr, mode: ptr): ptr
    fn fclose(file: ptr): i32
}

pub fn mir2asm_x86_64_debug(mir: string, debug_mir_comments: i32): string
{
    let mut b = mir2asm_new()
    b.debug_mir_comments = debug_mir_comments
    mir2asm_x86_64_emit(mir, &b)
    let text = vix_join_lines(b.out)
    if (b.sink.data.length > 0) { return text + "section .data\n" + vix_join_lines(b.sink.data) }
    return text
}

pub fn mir2asm_x86_64_emit(mir: string, b: &MirAsm)
{
    let module = machine_parse(mir)
    mir2asm_emit_machine_items(module, b)
    for (fi in 0 .. module.functions.length)
    {
        mir2asm_emit_direct_machine_function(b, module.functions[fi])
    }
}

pub fn mir2asm_emit_machine_items(module: MachineModule, b: &MirAsm)
{
    for (ti in 0 .. module.top_items.length)
    {
        let item = module.top_items[ti]
        mir2asm_mir_comment(b, item.text, item.line_no)
        mir2asm_emit_instruction(b, item.text)
    }
}

pub fn mir2asm_emit_machine_body(b: &MirAsm, f: MachineFunction, comments: i32)
{
    if (comments == 1) { mir2asm_mir_comment(b, f.header, f.line_no) }
    mir2asm_begin_function(b, f.header)
    for (bi in 0 .. f.blocks.length)
    {
        let block_line = "block " + f.blocks[bi].name + ":"
        if (comments == 1) { mir2asm_mir_comment(b, block_line, f.line_no) }
        mir2asm_emit_instruction(b, block_line)
        for (ii in 0 .. f.blocks[bi].insts.length)
        {
            let inst = f.blocks[bi].insts[ii]
            if (comments == 1) { mir2asm_mir_comment(b, inst.text, inst.line_no) }
            mir2asm_emit_instruction(b, inst.text)
        }
    }
    mir2asm_end_function(b)
}

pub fn mir2asm_emit_direct_machine_function(b: &MirAsm, f: MachineFunction)
{
    let mut planner = mir2asm_new()
    planner.sink.discard_output = 1
    planner.struct_names = b.struct_names
    planner.struct_field_counts = b.struct_field_counts
    planner.struct_sizes = b.struct_sizes
    planner.struct_field_tys = b.struct_field_tys
    planner.struct_field_offsets = b.struct_field_offsets
    mir2asm_emit_machine_body(&planner, f, 0)
    b.names = planner.names
    b.offsets = planner.offsets
    b.is_addr = planner.is_addr
    b.slot_tys = planner.slot_tys
    b.stack_next = mir2asm_align_to(planner.stack_next, 16)
    b.param_names = planner.param_names
    b.param_tys = planner.param_tys
    b.param_regs = planner.param_regs
    b.layout_ready = 1
    b.planned_frame_size = b.stack_next
    b.lir_names = []
    b.lir_tys = []
    b.lir_regs = []
    b.lir_used_callee_regs = 0
    mir2asm_emit_machine_body(b, f, b.debug_mir_comments)
}

pub fn mir2asm_x86_64_write(mir: string, path: string): i32
{
    let file = fopen(path, "w")
    if (file == nil) { return 1 }
    let mut b = mir2asm_new_stream(file)
    mir2asm_line(&b, "default rel")
    mir2asm_line(&b, "section .text")
    mir2asm_x86_64_emit(mir, &b)
    if (fclose(file) != 0) { b.sink.write_failed = 1 }
    return b.sink.write_failed
}
