#[no_main]

extern "C"
{
    fn vix_join_lines(lines: [string]): string
    fn vix_substr(text: string, start: i32, end: i32): string
    fn vix_trim_ascii(text: string): string
    fn vix_mir_opt_scalar(text: string): string
}

pub fn mir_opt_starts_with(text: string, prefix: string): i32
{
    if (text.length < prefix.length) { return 0 }
    for (i in 0 .. prefix.length)
    {
        if (compiler_string_byte(text, i) != compiler_string_byte(prefix, i)) return 0
    }
    return 1
}

pub fn mir_opt_slice(text: string, start: i32, end: i32): string
{
    return vix_substr(text, start, end)
}

pub fn mir_opt_after(text: string, start: i32): string
{
    return mir_opt_slice(text, start, text.length)
}

pub fn mir_opt_trim(text: string): string
{
    return vix_trim_ascii(text)
}

pub fn mir_opt_find(text: string, needle: i32, start: i32): i32
{
    for (i in start .. text.length)
    {
        if (compiler_string_byte(text, i) == needle) return i
    }
    return -1
}

pub fn mir_opt_is_name_char(c: i32): i32
{
    if (c >= 'a' and c <= 'z') { return 1 }
    if (c >= 'A' and c <= 'Z') { return 1 }
    if (c >= '0' and c <= '9') { return 1 }
    if (c == '_' or c == '.' or c == '%' or c == '@') { return 1 }
    return 0
}

pub fn mir_opt_contains_name(text: string, name: string): i32
{
    if (name == "" or text.length < name.length) { return 0 }
    let limit = text.length - name.length + 1
    for (i in 0 .. limit)
    {
        let mut ok = 1
        for (j in 0 .. name.length)
        {
            if (compiler_string_byte(text, i + j) != compiler_string_byte(name, j)) ok = 0
        }
        if (ok == 1)
        {
            let left_ok = if (i == 0) 1 else 1 - mir_opt_is_name_char(compiler_string_byte(text, i - 1))
            let right_pos = i + name.length
            let right_ok = if (right_pos >= text.length) 1 else 1 - mir_opt_is_name_char(compiler_string_byte(text, right_pos))
            if (left_ok == 1 and right_ok == 1) { return 1 }
        }
    }
    return 0
}

pub fn mir_opt_replace_name(text: string, name: string, replacement: string): string
{
    if (name == "") { return text }
    let mut out = ""
    let mut i = 0
    let mut in_string = 0
    let mut escaped = 0
    while (i < text.length)
    {
        if (in_string == 1)
        {
            let c = compiler_string_byte(text, i)
            out = out + char_string(c)
            if (escaped == 1) { escaped = 0 }
            elif (c == 92) { escaped = 1 }
            elif (c == '"') { in_string = 0 }
            i += 1
            continue
        }
        if (compiler_string_byte(text, i) == '"')
        {
            out = out + char_string(compiler_string_byte(text, i))
            in_string = 1
            i += 1
            continue
        }
        let mut ok = 0
        if (i + name.length <= text.length)
        {
            ok = 1
            for (j in 0 .. name.length)
            {
                if (compiler_string_byte(text, i + j) != compiler_string_byte(name, j)) ok = 0
            }
            if (ok == 1)
            {
                let left_ok = if (i == 0) 1 else 1 - mir_opt_is_name_char(compiler_string_byte(text, i - 1))
                let right_pos = i + name.length
                let right_ok = if (right_pos >= text.length) 1 else 1 - mir_opt_is_name_char(compiler_string_byte(text, right_pos))
                if (left_ok == 0 or right_ok == 0) { ok = 0 }
            }
        }
        if (ok == 1)
        {
            out = out + replacement
            i += name.length
        }
        else
        {
            out = out + char_string(compiler_string_byte(text, i))
            i += 1
        }
    }
    return out
}

pub fn mir_opt_dest(line: string): string
{
    let eq = mir_opt_find(line, '=', 0)
    if (eq < 0) { return "" }
    return mir_opt_trim(mir_opt_slice(line, 0, eq))
}

pub fn mir_opt_rhs(line: string): string
{
    let eq = mir_opt_find(line, '=', 0)
    if (eq < 0) { return line }
    return mir_opt_trim(mir_opt_after(line, eq + 1))
}

pub fn mir_opt_parse_load_addr(rhs: string): string
{
    if (mir_opt_starts_with(rhs, "load ") == 0) { return "" }
    let comma = mir_opt_find(rhs, ',', 0)
    if (comma < 0) { return "" }
    return mir_opt_trim(mir_opt_after(rhs, comma + 1))
}

pub fn mir_opt_parse_store_addr(line: string): string
{
    if (mir_opt_starts_with(line, "store ") == 0) { return "" }
    let comma = mir_opt_find(line, ',', 0)
    if (comma < 0) { return "" }
    return mir_opt_trim(mir_opt_after(line, comma + 1))
}

pub fn mir_opt_parse_store_value(line: string): string
{
    if (mir_opt_starts_with(line, "store ") == 0) { return "" }
    let comma = mir_opt_find(line, ',', 0)
    if (comma < 0) { return "" }
    let before = mir_opt_trim(mir_opt_slice(line, 6, comma))
    let sp = mir_opt_find(before, ' ', 0)
    if (sp < 0) { return "" }
    return mir_opt_trim(mir_opt_after(before, sp + 1))
}

pub fn mir_opt_split_lines(text: string): [string]
{
    let mut lines: [string] = []
    let mut start = 0
    for (i in 0 .. text.length)
    {
        if (compiler_string_byte(text, i) == 10)
        {
            lines.push(mir_opt_slice(text, start, i))
            start = i + 1
        }
    }
    if (start < text.length)
    {
        lines.push(mir_opt_after(text, start))
    }
    return lines
}

pub fn mir_opt_is_block(line: string): i32
{
    return mir_opt_starts_with(line, "block ")
}

pub fn mir_opt_is_terminator(line: string): i32
{
    if (mir_opt_starts_with(line, "ret ") == 1) { return 1 }
    if (mir_opt_starts_with(line, "br label ") == 1) { return 1 }
    if (mir_opt_starts_with(line, "br_cond ") == 1) { return 1 }
    return 0
}

pub fn mir_opt_branch_target(line: string): string
{
    if (mir_opt_starts_with(line, "br label ") == 0) { return "" }
    return mir_opt_trim(mir_opt_after(line, 9))
}

pub fn mir_opt_block_name(line: string): string
{
    if (mir_opt_is_block(line) == 0) { return "" }
    let mut end = line.length
    if (end > 0 and compiler_string_byte(line, end - 1) == ':') end -= 1
    return mir_opt_trim(mir_opt_slice(line, 6, end))
}

pub fn mir_opt_next_nonempty_trimmed(lines: [string], start: i32): string
{
    for (i in start .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (line != "") { return line }
    }
    return ""
}

pub fn mir_opt_remove_unreachable(lines: [string]): [string]
{
    let mut out: [string] = []
    let mut unreachable = 0
    for (i in 0 .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (line == "")
        {
            if (unreachable == 0) { out.push(lines[i]) }
        }
        elif (mir_opt_is_block(line) == 1 or line == "}")
        {
            unreachable = 0
            out.push(lines[i])
        }
        elif (unreachable == 0)
        {
            out.push(lines[i])
            if (mir_opt_is_terminator(line) == 1) { unreachable = 1 }
        }
    }
    return out
}

pub fn mir_opt_remove_fallthrough_branches(lines: [string]): [string]
{
    let mut out: [string] = []
    for (i in 0 .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (mir_opt_starts_with(line, "br label ") == 1)
        {
            let target = mir_opt_branch_target(line)
            let next = mir_opt_next_nonempty_trimmed(lines, i + 1)
            if (target != "" and mir_opt_block_name(next) == target)
            {
                continue
            }
        }
        out.push(lines[i])
    }
    return out
}

pub fn mir_opt_is_alloca(line: string): i32
{
    if (mir_opt_dest(line) != "" and mir_opt_starts_with(mir_opt_rhs(line), "alloca ") == 1) { return 1 }
    return 0
}

pub fn mir_opt_slot_is_address_only(lines: [string], slot: string): i32
{
    for (i in 0 .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (mir_opt_contains_name(line, slot) == 1)
        {
            if (mir_opt_dest(line) == slot and mir_opt_starts_with(mir_opt_rhs(line), "alloca ") == 1) {}
            elif (mir_opt_parse_load_addr(mir_opt_rhs(line)) == slot) {}
            elif (mir_opt_parse_store_addr(line) == slot) {}
            else { return 0 }
        }
    }
    return 1
}

pub fn mir_opt_single_entry_store_value(lines: [string], slot: string): string
{
    let mut current_block = ""
    let mut store_count = 0
    let mut value = ""
    let mut block = ""
    for (i in 0 .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (mir_opt_is_block(line) == 1) { current_block = mir_opt_block_name(line) }
        elif (mir_opt_parse_store_addr(line) == slot)
        {
            store_count += 1
            value = mir_opt_parse_store_value(line)
            block = current_block
        }
    }
    if (store_count == 1 and block == "%entry") { return value }
    return ""
}

pub fn mir_opt_promotable_value(lines: [string], slot: string): string
{
    if (mir_opt_slot_is_address_only(lines, slot) == 0) { return "" }
    return mir_opt_single_entry_store_value(lines, slot)
}

pub fn mir_opt_known_slot_index(slots: [string], slot: string): i32
{
    for (i in 0 .. slots.length)
    {
        if (slots[i] == slot) { return i }
    }
    return -1
}

pub fn mir_opt_promote_single_store_allocas(lines: [string]): [string]
{
    let mut slots: [string] = []
    let mut values: [string] = []
    for (i in 0 .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (mir_opt_is_alloca(line) == 1)
        {
            let slot = mir_opt_dest(line)
            let value = mir_opt_promotable_value(lines, slot)
            if (value != "")
            {
                slots.push(slot)
                values.push(value)
            }
        }
    }
    if (slots.length == 0) { return lines }

    let mut out: [string] = []
    let mut aliases: [string] = []
    let mut replacements: [string] = []
    for (i in 0 .. lines.length)
    {
        let raw = lines[i]
        let line = mir_opt_trim(raw)
        let dest = mir_opt_dest(line)
        let rhs = mir_opt_rhs(line)
        let alloca_idx = mir_opt_known_slot_index(slots, dest)
        if (alloca_idx >= 0 and mir_opt_starts_with(rhs, "alloca ") == 1) { continue }

        let store_addr = mir_opt_parse_store_addr(line)
        let store_idx = mir_opt_known_slot_index(slots, store_addr)
        if (store_idx >= 0) { continue }

        let load_addr = mir_opt_parse_load_addr(rhs)
        let load_idx = mir_opt_known_slot_index(slots, load_addr)
        if (dest != "" and load_idx >= 0)
        {
            aliases.push(dest)
            replacements.push(values[load_idx])
            continue
        }

        let mut rewritten = raw
        for (j in 0 .. aliases.length)
        {
            rewritten = mir_opt_replace_name(rewritten, aliases[j], replacements[j])
        }
        out.push(rewritten)
    }
    return out
}

pub fn mir_opt_empty_block_index(blocks: [string], block: string): i32
{
    for (i in 0 .. blocks.length)
    {
        if (blocks[i] == block) { return i }
    }
    return -1
}

pub fn mir_opt_next_block_after_empty(lines: [string], index: i32): string
{
    let mut i = index + 1
    while (i < lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (line == "") { i += 1 }
        elif (mir_opt_is_block(line) == 1) { return mir_opt_block_name(line) }
        else { return "" }
    }
    return ""
}

pub fn mir_opt_remove_empty_blocks(lines: [string]): [string]
{
    let mut empty_blocks: [string] = []
    let mut next_blocks: [string] = []
    for (i in 0 .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (mir_opt_is_block(line) == 1)
        {
            let name = mir_opt_block_name(line)
            let next = mir_opt_next_block_after_empty(lines, i)
            if (name != "%entry" and next != "")
            {
                empty_blocks.push(name)
                next_blocks.push(next)
            }
        }
    }
    if (empty_blocks.length == 0) { return lines }

    let mut out: [string] = []
    for (i in 0 .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        let mut skip = 0
        if (mir_opt_is_block(line) == 1 and mir_opt_empty_block_index(empty_blocks, mir_opt_block_name(line)) >= 0)
        {
            skip = 1
        }
        if (skip == 0)
        {
            let mut rewritten = lines[i]
            for (j in 0 .. empty_blocks.length)
            {
                rewritten = mir_opt_replace_name(rewritten, empty_blocks[j], next_blocks[j])
            }
            out.push(rewritten)
        }
    }
    return out
}

pub fn mir_opt_promote_functions(lines: [string]): [string]
{
    let mut out: [string] = []
    let mut fn_lines: [string] = []
    let mut in_fn = 0
    for (i in 0 .. lines.length)
    {
        let line = mir_opt_trim(lines[i])
        if (in_fn == 0 and mir_opt_starts_with(line, "fn @") == 1)
        {
            in_fn = 1
            fn_lines = []
            fn_lines.push(lines[i])
        }
        elif (in_fn == 1)
        {
            fn_lines.push(lines[i])
            if (line == "}")
            {
                let promoted = mir_opt_promote_single_store_allocas(fn_lines)
                for (j in 0 .. promoted.length) { out.push(promoted[j]) }
                in_fn = 0
            }
        }
        else
        {
            out.push(lines[i])
        }
    }
    if (in_fn == 1)
    {
        let promoted2 = mir_opt_promote_single_store_allocas(fn_lines)
        for (j in 0 .. promoted2.length) { out.push(promoted2[j]) }
    }
    return out
}

pub fn mir_opt_program(mir: string): string
{
    let lines = mir_opt_split_lines(mir)
    let promoted_lines = mir_opt_promote_functions(lines)
    let scalar_lines = mir_opt_split_lines(vix_mir_opt_scalar(vix_join_lines(promoted_lines)))
    let live_lines = mir_opt_remove_unreachable(scalar_lines)
    let no_empty_lines = mir_opt_remove_empty_blocks(live_lines)
    let compact_lines = mir_opt_remove_fallthrough_branches(no_empty_lines)
    return vix_join_lines(compact_lines)
}
