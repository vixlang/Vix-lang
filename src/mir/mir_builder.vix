#[no_main]
import "builder.vix"

pub type MirBuilder = struct {
    out: string,
    temp_counter: i32,
    label_counter: i32,
    terminated: i32,
    ret_ty: string
}

pub fn mir_builder_new(): MirBuilder
{
    return MirBuilder{ out: "", temp_counter: 0, label_counter: 0, terminated: 0, ret_ty: "void" }
}

pub fn mir_block_is_open(b: &MirBuilder): i32
{
    if (b.terminated == 0) { return 1 }
    return 0
}

pub fn mir_i32(n: i32): string
{
    return i32_to_str(n)
}

pub fn mir_temp(b: &MirBuilder): string
{
    let n = b.temp_counter
    b.temp_counter = n + 1
    return "%t" + mir_i32(n)
}

pub fn mir_label(b: &MirBuilder, prefix: string): string
{
    let n = b.label_counter
    b.label_counter = n + 1
    return "%" + prefix + mir_i32(n)
}

pub fn mir_line(b: &MirBuilder, text: string)
{
    b.out = b.out + text + "\n"
}

pub fn mir_inst(b: &MirBuilder, text: string)
{
    mir_line(b, "        " + text)
}

pub fn mir_block(b: &MirBuilder, name: string)
{
    mir_line(b, "")
    mir_line(b, "    block " + name + ":")
    b.terminated = 0
}

pub fn mir_emit_term(b: &MirBuilder, text: string)
{
    if (mir_block_is_open(b) == 1)
    {
        mir_inst(b, text)
        b.terminated = 1
    }
}
