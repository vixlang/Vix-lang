#[no_main]
use "../../lir/mod.vix" as lir
use "../../mir2asm/target.vix" as target
use "../../mir2asm/types.vix" as types
use "../../mir2asm/x86_64/mod.vix" as x86_64
use "../../mir2asm/machine.vix" as machine

pub fn lir2asm_x86_64_emit(lir: lir::MachineLirModule, b: &types::MirAsm)
{
    let module = lir.machine
    x86_64::mir2asm_emit_machine_items(module, b)
    for (fi in 0 .. module.functions.length) { lir2asm_emit_function(b, module.functions[fi], lir.functions[fi]) }
}

pub fn lir2asm_install(b: &types::MirAsm, lir: lir::MachineLirFunction)
{
    b.lir_names = []
    b.lir_tys = []
    b.lir_regs = []
    for (i in 0 .. lir.values.length)
    {
        if (lir.values[i].spilled == 0 and lir.values[i].phys_reg != "")
        {
            b.lir_names.push(target::mir2asm_clean_name(lir.values[i].name))
            b.lir_tys.push(lir.values[i].ty)
            b.lir_regs.push(lir.values[i].phys_reg)
        }
    }
    b.lir_used_callee_regs = lir.used_callee_regs
}

pub fn lir2asm_plan(b: &types::MirAsm, f: machine::MachineFunction, lir: lir::MachineLirFunction): types::MirAsm
{
    let mut p = types::mir2asm_new()
    p.sink.discard_output = 1
    p.struct_names = b.struct_names
    p.struct_field_counts = b.struct_field_counts
    p.struct_sizes = b.struct_sizes
    p.struct_field_tys = b.struct_field_tys
    p.struct_field_offsets = b.struct_field_offsets
    lir2asm_install(&p, lir)
    x86_64::mir2asm_emit_machine_body(&p, f, 0)
    return p
}

pub fn lir2asm_emit_function(b: &types::MirAsm, f: machine::MachineFunction, lir: lir::MachineLirFunction)
{
    let p = lir2asm_plan(b, f, lir)
    let mut laid = lir
    lir::machine_lir_finish_frame(&laid, p.names, p.offsets, p.is_addr, p.slot_tys, target::mir2asm_align_to(p.stack_next, 16))
    b.names = laid.frame_names
    b.offsets = laid.frame_offsets
    b.is_addr = laid.frame_is_addr
    b.slot_tys = laid.frame_tys
    b.stack_next = laid.frame_size
    b.param_names = p.param_names
    b.param_tys = p.param_tys
    b.param_regs = p.param_regs
    b.layout_ready = 1
    b.planned_frame_size = laid.frame_size
    lir2asm_install(b, laid)
    x86_64::mir2asm_emit_machine_body(b, f, b.debug_mir_comments)
}

pub fn lir2asm_x86_64_debug_lir(input: lir::MachineLirModule): string
{
    let mut lir = input
    let module = lir.machine
    let mut metadata = types::mir2asm_new()
    metadata.sink.discard_output = 1
    x86_64::mir2asm_emit_machine_items(module, &metadata)
    for (fi in 0 .. module.functions.length)
    {
        let p = lir2asm_plan(&metadata, module.functions[fi], lir.functions[fi])
        let mut laid = lir.functions[fi]
        lir::machine_lir_finish_frame(&laid, p.names, p.offsets, p.is_addr, p.slot_tys, target::mir2asm_align_to(p.stack_next, 16))
        lir.functions[fi] = laid
    }
    return lir::machine_lir_debug(lir)
}

pub fn lir2asm_x86_64_debug(lir: lir::MachineLirModule, comments: i32): string
{
    let mut b = types::mir2asm_new()
    b.debug_mir_comments = comments
    lir2asm_x86_64_emit(lir, &b)
    let text = vix_join_lines(b.out)
    if (b.sink.data.length > 0) { return text + "section .data\n" + vix_join_lines(b.sink.data) }
    return text
}

pub fn lir2asm_x86_64_write(lir: lir::MachineLirModule, path: string): i32
{
    let file = fopen(path, "w")
    if (file == nil) { return 1 }
    let mut b = types::mir2asm_new_stream(file)
    target::mir2asm_line(&b, "default rel")
    target::mir2asm_line(&b, "section .text")
    lir2asm_x86_64_emit(lir, &b)
    if (fclose(file) != 0) { b.sink.write_failed = 1 }
    return b.sink.write_failed
}
