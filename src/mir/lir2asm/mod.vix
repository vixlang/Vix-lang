#[no_main]
use "../mir2asm/mod.vix" as mir2asm
use "../lir/mod.vix" as lir
use "x86_64/mod.vix" as x86_64
use "../../lexer.vix" as lexer

extern "C" { fn vix_print_stderr(s: string) }

pub fn lir2asm_error_text(lir: lir::MachineLirModule): string
{
    return "vixc: error: MIR line " + lexer::i32_to_str(lir.error_line) + " in function @" + lir.error_function + ": " + lir.error
}

pub fn lir2asm_validate(mir: string): string
{
    return lir2asm_validate_lir(lir::mir2lir(mir))
}

pub fn lir2asm_validate_lir(lir: lir::MachineLirModule): string
{
    if (lir.error == "") { return "" }
    return lir2asm_error_text(lir)
}

pub fn lir2asm_debug(mir: string): string
{
    return lir2asm_debug_lir_built(lir::mir2lir(mir))
}

pub fn lir2asm_debug_lir_built(lir: lir::MachineLirModule): string
{
    if (lir.error != "") { return "" }
    return x86_64::lir2asm_x86_64_debug(lir, 1)
}

pub fn lir2asm_debug_lir(mir: string): string
{
    return lir2asm_debug_machine_lir(lir::mir2lir(mir))
}

pub fn lir2asm_debug_machine_lir(lir: lir::MachineLirModule): string
{
    if (lir.error != "") { return "" }
    return x86_64::lir2asm_x86_64_debug_lir(lir)
}

pub fn lir2asm_write_file(mir: string, path: string): i32
{
    return lir2asm_write_built(lir::mir2lir(mir), path)
}

pub fn lir2asm_write_built(lir: lir::MachineLirModule, path: string): i32
{
    if (lir.error != "") { vix_print_stderr(lir2asm_error_text(lir)); return 2 }
    return x86_64::lir2asm_x86_64_write(lir, path)
}
