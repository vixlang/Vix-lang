#[no_main]

import "ast.vix"
import "error.vix"
import "type/typeck.vix"

pub type SemanticResult = struct {
    ok: i32,
    error_count: i32,
    type_error_count: i32,
    warning_count: i32,
    emit_warnings: i32,
    bag: DiagBag,
    source: string,
    filename: string,
    type_result: TypeInferResult
}

pub fn semantic_result_new(): SemanticResult
{
    return semantic_result_new_with_warnings(1)
}

pub fn semantic_result_new_with_warnings(emit_warnings: i32): SemanticResult
{
    return SemanticResult{ ok: 1, error_count: 0, type_error_count: 0, warning_count: 0, emit_warnings: emit_warnings, bag: diag_bag_new(), source: "", filename: "", type_result: typeinfer_ok("unknown") }
}

pub fn semantic_phase(error_type: string): DiagPhase
{
    return match error_type {
        "NameError" -> DiagName
        "TypeError" -> DiagType
        "OwnershipError" -> DiagOwnership
        _ -> DiagSemantic
    }
}

pub fn semantic_diagnostic(source: string, filename: string, code: string, level: DiagLevel, phase: DiagPhase, title: string, message: string, func_name: string, line: i32, col: i32, length: i32): Diagnostic
{
    let full_message = if (func_name != "") "in function " + func_name + ": " + message else message
    let mut diagnostic = diag_new(code, level, phase, title)
        |> diag_message(full_message)
        |> diag_function(func_name)
    if (line > 0)
    {
        diagnostic = diag_primary(diagnostic, diag_span_at(source, filename, line, col, length), message)
    }
    return diagnostic
}

pub fn semantic_emit_diag(result: &SemanticResult, diagnostic: Diagnostic): i32
{
    let mut bag = result.bag
    let emitted = diag_emit(&bag, diagnostic)
    result.bag = bag
    return emitted
}

pub fn semantic_add_error(result: &SemanticResult, source: string, filename: string, error_type: string, message: string, func_name: string)
{
    let code = error_code_for_type(error_type, message)
    let diagnostic = semantic_diagnostic(source, filename, code, DiagError, semantic_phase(error_type), diagnostic_title(code, message), message, func_name, 0, 0, 1)
    if (semantic_emit_diag(result, diagnostic) == 0) { return }
    result.error_count += 1
    if (error_type == "TypeError") { result.type_error_count += 1 }
    result.ok = 0
}

pub fn semantic_add_error_loc(result: &SemanticResult, source: string, filename: string, error_type: string, message: string, func_name: string, line: i32, col: i32, length: i32)
{
    let code = error_code_for_type(error_type, message)
    let diagnostic = semantic_diagnostic(source, filename, code, DiagError, semantic_phase(error_type), diagnostic_title(code, message), message, func_name, line, col, length)
    if (semantic_emit_diag(result, diagnostic) == 0) { return }
    result.error_count += 1
    if (error_type == "TypeError") { result.type_error_count += 1 }
    result.ok = 0
}

pub fn semantic_add_warning(result: &SemanticResult, filename: string, error_type: string, message: string)
{
    if (result.emit_warnings == 0) { return }
    let code = error_code_for_type(error_type, message)
    let diagnostic = semantic_diagnostic("", filename, code, DiagWarning, DiagSemantic, diagnostic_title(code, message), message, "", 0, 0, 1)
    if (semantic_emit_diag(result, diagnostic) == 0) { return }
    result.warning_count += 1
}

pub fn semantic_add_warning_loc(result: &SemanticResult, source: string, filename: string, error_type: string, message: string, line: i32, col: i32, length: i32)
{
    if (result.emit_warnings == 0) { return }
    let code = error_code_for_type(error_type, message)
    let diagnostic = semantic_diagnostic(source, filename, code, DiagWarning, DiagSemantic, diagnostic_title(code, message), message, "", line, col, length)
    if (semantic_emit_diag(result, diagnostic) == 0) { return }
    result.warning_count += 1
}

pub fn semantic_add_typeck_error(result: &SemanticResult, source: string, filename: string, check: TypeInferResult)
{
    if (check.ok == 1) { return }
    let diagnostic = semantic_diagnostic(source, filename, check.code, DiagError, check.phase, check.title, check.error, check.error_func, check.line, check.col, check.span_len)
    if (semantic_emit_diag(result, diagnostic) == 0) { return }
    result.error_count += 1
    result.type_error_count += 1
    result.ok = 0
}

pub type SemanticScope = struct {
    names: [string],
    depths: [i32],
    used: [i32],
    mutable: [i32],
    lines: [i32],
    cols: [i32],
    warn_unused: [i32],
    active_len: i32,
    depth: i32
}

pub fn semantic_scope_new(): SemanticScope
{
    return SemanticScope{ names: [], depths: [], used: [], mutable: [], lines: [], cols: [], warn_unused: [], active_len: 0, depth: 0 }
}

pub fn semantic_scope_push(scope: &SemanticScope)
{
    scope.depth += 1
}

pub fn semantic_scope_truncate(scope: &SemanticScope, keep: i32)
{
    scope.active_len = keep
}

pub fn semantic_scope_warn_unused_current(scope: &SemanticScope, result: &SemanticResult, source: string, filename: string)
{
    let mut i = scope.active_len - 1
    while (i >= 0)
    {
        if (scope.depths[i] < scope.depth) { return }
        if (scope.depths[i] == scope.depth and scope.warn_unused[i] == 1 and scope.used[i] == 0)
        {
            semantic_add_warning_loc(result, source, filename, "SemanticWarning", "unused variable '" + scope.names[i] + "'", scope.lines[i], scope.cols[i], diag_strlen(scope.names[i]))
        }
        i -= 1
    }
}

pub fn semantic_scope_pop(scope: &SemanticScope, result: &SemanticResult, source: string, filename: string)
{
    if (scope.depth > 0)
    {
        if (result.error_count == 0)
        {
            semantic_scope_warn_unused_current(scope, result, source, filename)
        }
        let mut keep = scope.active_len
        while (keep > 0)
        {
            if (scope.depths[keep - 1] >= scope.depth)
            {
                keep -= 1
            }
            else
            {
                break
            }
        }
        semantic_scope_truncate(scope, keep)
        scope.depth -= 1
    }
}

pub fn semantic_scope_find_current(scope: &SemanticScope, name: string): ?i32
{
    for (i in 0 .. scope.active_len)
    {
        if (scope.names[i] == name and scope.depths[i] == scope.depth)
        {
            return Some(i)
        }
    }
    return None
}

pub fn semantic_scope_lookup(scope: &SemanticScope, name: string): ?i32
{
    let mut i = scope.active_len - 1
    while (i >= 0)
    {
        if (scope.names[i] == name and scope.depths[i] <= scope.depth)
        {
            return Some(i)
        }
        i -= 1
    }
    return None
}

pub fn semantic_scope_contains(scope: &SemanticScope, name: string): i32
{
    return match semantic_scope_lookup(scope, name)
    {
        Some(_) -> 1
        None -> 0
    }
}

pub fn semantic_scope_declare(scope: &SemanticScope, result: &SemanticResult, source: string, filename: string, func_name: string, name: string, line: i32, col: i32): i32
{
    if (name == "_") { return 1 }
    match semantic_scope_find_current(scope, name)
    {
        Some(_) -> {
            semantic_add_error_loc(result, source, filename, "NameError", "duplicate symbol '" + name + "'", func_name, line, col, diag_strlen(name))
            return 0
        }
        None -> {}
    }
    let idx = scope.active_len
    if (idx < scope.names.length)
    {
        scope.names[idx] = name
        scope.depths[idx] = scope.depth
        scope.used[idx] = 0
        scope.mutable[idx] = 0
        scope.lines[idx] = line
        scope.cols[idx] = col
        scope.warn_unused[idx] = if (name == "_") { 0 } else { 1 }
    }
    else
    {
        scope.names.push(name)
        scope.depths.push(scope.depth)
        scope.used.push(0)
        scope.mutable.push(0)
        scope.lines.push(line)
        scope.cols.push(col)
        scope.warn_unused.push(if (name == "_") { 0 } else { 1 })
    }
    scope.active_len += 1
    return 1
}

pub fn semantic_scope_mark_mutable(scope: &SemanticScope, name: string)
{
    match semantic_scope_find_current(scope, name)
    {
        Some(idx) -> scope.mutable[idx] = 1
        None -> {}
    }
}

pub fn semantic_scope_declare_existing(scope: &SemanticScope, name: string)
{
    match semantic_scope_find_current(scope, name)
    {
        Some(_) -> {}
        None -> {
            let idx = scope.active_len
            if (idx < scope.names.length)
            {
                scope.names[idx] = name
                scope.depths[idx] = scope.depth
                scope.used[idx] = 0
                scope.mutable[idx] = 0
                scope.lines[idx] = 0
                scope.cols[idx] = 0
                scope.warn_unused[idx] = 0
            }
            else
            {
                scope.names.push(name)
                scope.depths.push(scope.depth)
                scope.used.push(0)
                scope.mutable.push(0)
                scope.lines.push(0)
                scope.cols.push(0)
                scope.warn_unused.push(0)
            }
            scope.active_len += 1
        }
    }
}

pub fn semantic_scope_mark_used(scope: &SemanticScope, name: string)
{
    match semantic_scope_lookup(scope, name)
    {
        Some(idx) -> scope.used[idx] = 1
        None -> {}
    }
}

pub fn semantic_scope_require(scope: &SemanticScope, result: &SemanticResult, source: string, filename: string, func_name: string, name: string, line: i32, col: i32)
{
    if (name == "_") { return }
    match semantic_scope_lookup(scope, name)
    {
        Some(_) -> {}
        None -> {
            let is_lambda = func_name.length >= 9 and compiler_string_byte(func_name, 0) == '_' and compiler_string_byte(func_name, 1) == '_' and compiler_string_byte(func_name, 2) == 'l' and compiler_string_byte(func_name, 3) == 'a' and compiler_string_byte(func_name, 4) == 'm' and compiler_string_byte(func_name, 5) == 'b' and compiler_string_byte(func_name, 6) == 'd' and compiler_string_byte(func_name, 7) == 'a' and compiler_string_byte(func_name, 8) == '_'
            if (is_lambda) semantic_add_error_loc(result, source, filename, "NameError", "variable `" + name + "` must be explicitly captured", func_name, line, col, diag_strlen(name))
            else semantic_add_error_loc(result, source, filename, "NameError", "undefined symbol '" + name + "'", func_name, line, col, diag_strlen(name))
        }
    }
}

pub fn semantic_find_extern_function(funcs: [AstFunction], name: string): i32
{
    for (i in 0 .. funcs.length)
    {
        if (funcs[i].name == name) { return i }
    }
    return -1
}

pub fn semantic_find_function_any(funcs: [AstFunction], externs: [AstFunction], name: string): i32
{
    let idx = semantic_find_function(funcs, name)
    if (idx >= 0) { return idx }
    return semantic_find_extern_function(externs, name)
}

pub fn semantic_find_struct(structs: [AstStructDecl], name: string): i32
{
    for (i in 0 .. structs.length)
    {
        if (structs[i].name == name) { return i }
    }
    return -1
}

pub fn semantic_find_adt_variant(adts: [AstAdtDecl], name: string): i32
{
    for (i in 0 .. adts.length)
    {
        for (j in 0 .. adts[i].variant_names.length)
        {
            if (adts[i].variant_names[j] == name) { return i }
        }
    }
    return -1
}

pub fn semantic_check_generic_call(program: AstProgram, expr: AstExpr, result: &SemanticResult, source: string, filename: string, func_name: string)
{
    let function_idx = semantic_find_function(program.functions, expr.text)
    if (function_idx < 0) { return }
    let function = program.functions[function_idx]
    if (function.type_params.length == 0)
    {
        if (expr.type_args.length > 0)
        {
            semantic_add_error_loc(result, source, filename, "TypeError", "function '" + expr.text + "' is not generic", func_name, expr.line, expr.col, diag_strlen(expr.text))
        }
        return
    }
    if (expr.type_args.length != function.type_params.length)
    {
        semantic_add_error_loc(result, source, filename, "TypeError", "generic function '" + expr.text + "' requires " + ast_i32(function.type_params.length) + " type arguments", func_name, expr.line, expr.col, diag_strlen(expr.text))
    }
}

pub fn semantic_match_check_exhaustive(program: AstProgram, patterns: [i32], result: &SemanticResult, source: string, filename: string, func_name: string, line: i32, col: i32)
{
    let es = program.expr_store
    let mut adt_idx = -1
    for (i in 0 .. patterns.length)
    {
        if (patterns[i] < 0) { return }
        let pattern = expr_store_get(&es, patterns[i])
        let candidate = semantic_find_adt_variant(program.adts, pattern.text)
        if (candidate >= 0 and adt_idx < 0) { adt_idx = candidate }
    }
    if (adt_idx < 0) { return }
    let decl = program.adts[adt_idx]
    let mut missing = ""
    for (v in 0 .. decl.variant_names.length)
    {
        let mut found = 0
        for (p in 0 .. patterns.length)
        {
            let pattern2 = expr_store_get(&es, patterns[p])
            if (pattern2.text == decl.variant_names[v]) { found = 1 }
        }
        if (found == 0)
        {
            if (missing != "") { missing = missing + ", " }
            missing = missing + decl.variant_names[v]
        }
    }
    if (missing != "")
    {
        semantic_add_error_loc(result, source, filename, "SemanticError", "non-exhaustive match for '" + decl.name + "': missing " + missing, func_name, line, col, 5)
    }
}

pub fn semantic_struct_find_field(decl: AstStructDecl, field_name: string): i32
{
    for (i in 0 .. decl.field_names.length)
    {
        if (decl.field_names[i] == field_name) { return i }
    }
    return -1
}

pub fn semantic_check_struct_literal_fields(expr: AstExpr, structs: [AstStructDecl], result: &SemanticResult, source: string, filename: string, func_name: string)
{
    let struct_idx = semantic_find_struct(structs, expr.text)
    if (struct_idx < 0)
    {
        semantic_add_error_loc(result, source, filename, "NameError", "unknown struct '" + expr.text + "'", func_name, expr.line, expr.col, diag_strlen(expr.text))
        return
    }
    let decl = structs[struct_idx]
    for (i in 0 .. expr.field_names.length)
    {
        let field_name = expr.field_names[i]
        for (j in (i + 1) .. expr.field_names.length)
        {
            if (field_name == expr.field_names[j])
            {
                semantic_add_error_loc(result, source, filename, "NameError", "duplicate initializer field '" + field_name + "' in struct '" + expr.text + "'", func_name, expr.line, expr.col, diag_strlen(field_name))
            }
        }
        if (semantic_struct_find_field(decl, field_name) < 0)
        {
            semantic_add_error_loc(result, source, filename, "NameError", "unknown field '" + field_name + "' on struct '" + expr.text + "'", func_name, expr.line, expr.col, diag_strlen(field_name))
        }
    }
    for (i in 0 .. decl.field_names.length)
    {
        let mut found = 0
        for (j in 0 .. expr.field_names.length)
        {
            if (decl.field_names[i] == expr.field_names[j]) { found = 1 }
        }
        if (found == 0)
        {
            semantic_add_error_loc(result, source, filename, "NameError", "missing field '" + decl.field_names[i] + "' in struct '" + expr.text + "'", func_name, expr.line, expr.col, diag_strlen(decl.field_names[i]))
        }
    }
}

pub fn semantic_check_expr(scope: &SemanticScope, program: AstProgram, idx: i32, result: &SemanticResult, source: string, filename: string, func_name: string)
{
    if (idx < 0) { return }
    let expr_store = program.expr_store
    let expr = expr_store_get(&expr_store, idx)
    match expr.tag
    {
        "ident" -> {
            if (semantic_find_adt_variant(program.adts, expr.text) < 0 and semantic_find_function_any(program.functions, program.extern_functions, expr.text) < 0)
            {
                semantic_scope_require(scope, result, source, filename, func_name, expr.text, expr.line, expr.col)
                semantic_scope_mark_used(scope, expr.text)
            }
        }
        "addr" -> {
            semantic_scope_require(scope, result, source, filename, func_name, expr.text, expr.line, expr.col)
            semantic_scope_mark_used(scope, expr.text)
        }
        "deref" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
        }
        "field" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
        }
        "struct_literal" -> {
            semantic_check_struct_literal_fields(expr, program.structs, result, source, filename, func_name)
            for (i in 0 .. expr.args.length)
            {
                semantic_check_expr(scope, program, expr.args[i], result, source, filename, func_name)
            }
        }
        "call" -> {
            if (expr.left_idx >= 0)
            {
                semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
            }
            elif (expr.text != "clone" and semantic_find_function_any(program.functions, program.extern_functions, expr.text) < 0 and semantic_find_adt_variant(program.adts, expr.text) < 0 and semantic_scope_contains(scope, expr.text) == 0)
            {
                semantic_add_error_loc(result, source, filename, "NameError", "undefined function '" + expr.text + "'", func_name, expr.line, expr.col, diag_strlen(expr.text))
            }
            if (expr.left_idx < 0 and expr.text != "clone") semantic_check_generic_call(program, expr, result, source, filename, func_name)
            for (i in 0 .. expr.args.length)
            {
                semantic_check_expr(scope, program, expr.args[i], result, source, filename, func_name)
            }
        }
        "lambda" -> {
            for (i in 0 .. expr.capture_names.length)
            {
                let capture = expr.capture_names[i]
                match semantic_scope_lookup(scope, capture)
                {
                    Some(capture_idx) -> {
                        if (scope.mutable[capture_idx] == 1)
                        {
                            semantic_add_error_loc(result, source, filename, "TypeError", "mutable capture '" + capture + "' is not supported", func_name, expr.line, expr.col, diag_strlen(capture))
                        }
                        else
                        {
                            semantic_scope_mark_used(scope, capture)
                        }
                    }
                    None -> {
                        if (semantic_find_function_any(program.functions, program.extern_functions, capture) < 0 and semantic_find_adt_variant(program.adts, capture) < 0)
                        {
                            semantic_add_error_loc(result, source, filename, "NameError", "undefined capture '" + capture + "'", func_name, expr.line, expr.col, diag_strlen(capture))
                        }
                        else
                        {
                            semantic_scope_mark_used(scope, capture)
                        }
                    }
                }
            }
        }
        "index" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, expr.right_idx, result, source, filename, func_name)
        }
        "slice" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, expr.right_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, expr.args[0], result, source, filename, func_name)
        }
        "unaryop" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
        }
        "binop" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, expr.right_idx, result, source, filename, func_name)
        }
        "array_literal" -> {
            for (i in 0 .. expr.args.length)
            {
                semantic_check_expr(scope, program, expr.args[i], result, source, filename, func_name)
            }
        }
        "option" -> {
            if (expr.left_idx >= 0)
            {
                semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
            }
        }
        "method_call" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
            for (i in 0 .. expr.args.length)
            {
                semantic_check_expr(scope, program, expr.args[i], result, source, filename, func_name)
            }
        }
        "match_expr" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
            let num_arms = expr.args.length / 2
            let mut patterns: [i32] = []
            for (m in 0 .. num_arms)
            {
                patterns.push(expr.args[m * 2])
            }
            semantic_match_check_exhaustive(program, patterns, result, source, filename, func_name, expr.line, expr.col)
            for (i in 0 .. num_arms)
            {
                let pattern_idx = expr.args[i * 2]
                let body_idx = expr.args[i * 2 + 1]
                if (pattern_idx >= 0)
                {
                    semantic_check_match_pattern(scope, program, pattern_idx, result, source, filename, func_name)
                }
                if (body_idx >= 0)
                {
                    semantic_scope_push(scope)
                    semantic_declare_match_binding(scope, program, pattern_idx, result, source, filename, func_name)
                    semantic_check_expr(scope, program, body_idx, result, source, filename, func_name)
                    semantic_scope_pop(scope, result, source, filename)
                }
            }
        }
        "if_expr" -> {
            semantic_check_expr(scope, program, expr.left_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, expr.right_idx, result, source, filename, func_name)
            if (expr.args.length > 0)
            {
                semantic_check_expr(scope, program, expr.args[0], result, source, filename, func_name)
            }
        }
        "block_expr" -> {
            semantic_scope_push(scope)
            semantic_check_block_stmt_in_current_scope(scope, program, expr.left_idx, result, source, filename, func_name)
            if (expr.right_idx >= 0)
            {
                semantic_check_expr(scope, program, expr.right_idx, result, source, filename, func_name)
            }
            semantic_scope_pop(scope, result, source, filename)
        }
        _ -> {}
    }
}

pub fn semantic_check_match_pattern(scope: &SemanticScope, program: AstProgram, idx: i32, result: &SemanticResult, source: string, filename: string, func_name: string)
{
    if (idx < 0) { return }
    let expr_store = program.expr_store
    let expr = expr_store_get(&expr_store, idx)
    if (expr.tag == "option" and expr.option_has_value == 1 and expr.left_idx >= 0)
    {
        let bind_expr = expr_store_get(&expr_store, expr.left_idx)
        if (bind_expr.tag == "ident")
        {
            return
        }
    }
    if (expr.tag == "call" and semantic_find_adt_variant(program.adts, expr.text) >= 0)
    {
        for (i in 0 .. expr.args.length)
        {
            let arg = expr_store_get(&expr_store, expr.args[i])
            if (arg.tag != "ident")
            {
                semantic_check_match_pattern(scope, program, expr.args[i], result, source, filename, func_name)
            }
        }
        return
    }
    semantic_check_expr(scope, program, idx, result, source, filename, func_name)
}

pub fn semantic_declare_match_binding(scope: &SemanticScope, program: AstProgram, pattern_idx: i32, result: &SemanticResult, source: string, filename: string, func_name: string)
{
    if (pattern_idx < 0) { return }
    let expr_store = program.expr_store
    let pattern_expr = expr_store_get(&expr_store, pattern_idx)
    if (pattern_expr.tag == "option" and pattern_expr.option_has_value == 1 and pattern_expr.left_idx >= 0)
    {
        let bind_expr = expr_store_get(&expr_store, pattern_expr.left_idx)
        if (bind_expr.tag == "ident" and bind_expr.text != "_")
        {
            let __decl = semantic_scope_declare(scope, result, source, filename, func_name, bind_expr.text, bind_expr.line, bind_expr.col)
        }
    }
    if (pattern_expr.tag == "call" and semantic_find_adt_variant(program.adts, pattern_expr.text) >= 0)
    {
        for (i in 0 .. pattern_expr.args.length)
        {
            let bind_expr2 = expr_store_get(&expr_store, pattern_expr.args[i])
            if (bind_expr2.tag == "ident" and bind_expr2.text != "_")
            {
                let __decl2 = semantic_scope_declare(scope, result, source, filename, func_name, bind_expr2.text, bind_expr2.line, bind_expr2.col)
            }
        }
    }
}

pub fn semantic_check_stmt(scope: &SemanticScope, program: AstProgram, stmt_idx: i32, result: &SemanticResult, source: string, filename: string, func_name: string)
{
    if (stmt_idx < 0) { return }
    let stmt_store = program.store
    let stmt = stmt_store_get(&stmt_store, stmt_idx)
    match stmt.tag
    {
        "let" -> {
            semantic_check_expr(scope, program, stmt.assign_idx, result, source, filename, func_name)
            let __decl = semantic_scope_declare(scope, result, source, filename, func_name, stmt.assign_name, stmt.line, stmt.col)
            if (stmt.is_mut == 1) { semantic_scope_mark_mutable(scope, stmt.assign_name) }
        }
        "assign" -> {
            semantic_scope_require(scope, result, source, filename, func_name, stmt.assign_name, stmt.line, stmt.col)
            semantic_check_expr(scope, program, stmt.assign_idx, result, source, filename, func_name)
        }
        "store_deref" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, stmt.assign_idx, result, source, filename, func_name)
        }
        "store_index" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, stmt.direct_ret, result, source, filename, func_name)
            semantic_check_expr(scope, program, stmt.assign_idx, result, source, filename, func_name)
        }
        "field_assign" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, stmt.assign_idx, result, source, filename, func_name)
        }
        "return_expr" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
        }
        "print" -> {
            semantic_check_expr(scope, program, stmt.print_idx, result, source, filename, func_name)
        }
        "expr" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
        }
        "block" -> {
            semantic_scope_push(scope)
            if (stmt.stmt_indices.length > 0)
            {
                for (i in 0 .. stmt.stmt_indices.length)
                {
                    semantic_check_stmt(scope, program, stmt.stmt_indices[i], result, source, filename, func_name)
                }
            }
            else
            {
                for (i in 0 .. stmt.block_count)
                {
                    semantic_check_stmt(scope, program, stmt.block_start + i, result, source, filename, func_name)
                }
            }
            semantic_scope_pop(scope, result, source, filename)
        }
        "while" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
            semantic_check_stmt(scope, program, stmt.body_idx, result, source, filename, func_name)
        }
        "for_range" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
            semantic_check_expr(scope, program, stmt.assign_idx, result, source, filename, func_name)
            if (semantic_scope_contains(scope, stmt.assign_name) == 1)
            {
                semantic_add_error_loc(result, source, filename, "NameError", "for iterator '" + stmt.assign_name + "' conflicts with existing symbol", func_name, stmt.line, stmt.col, diag_strlen(stmt.assign_name))
            }
            semantic_scope_push(scope)
            semantic_scope_declare(scope, result, source, filename, func_name, stmt.assign_name, stmt.line, stmt.col)
            semantic_check_stmt(scope, program, stmt.body_idx, result, source, filename, func_name)
            semantic_scope_pop(scope, result, source, filename)
        }
        "if" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
            semantic_check_stmt(scope, program, stmt.body_idx, result, source, filename, func_name)
            if (stmt.assign_idx >= 0)
            {
                semantic_check_stmt(scope, program, stmt.assign_idx, result, source, filename, func_name)
            }
        }
        "match" -> {
            semantic_check_expr(scope, program, stmt.value_idx, result, source, filename, func_name)
            semantic_match_check_exhaustive(program, stmt.match_pattern_indices, result, source, filename, func_name, stmt.line, stmt.col)
            for (i in 0 .. stmt.match_pattern_indices.length)
            {
                let pattern_idx = stmt.match_pattern_indices[i]
                if (pattern_idx >= 0)
                {
                    semantic_check_match_pattern(scope, program, pattern_idx, result, source, filename, func_name)
                }
                semantic_scope_push(scope)
                semantic_declare_match_binding(scope, program, pattern_idx, result, source, filename, func_name)
                semantic_check_stmt(scope, program, stmt.match_body_indices[i], result, source, filename, func_name)
                semantic_scope_pop(scope, result, source, filename)
            }
        }
        _ -> {}
    }
}

pub fn semantic_check_block_stmt_in_current_scope(scope: &SemanticScope, program: AstProgram, stmt_idx: i32, result: &SemanticResult, source: string, filename: string, func_name: string)
{
    if (stmt_idx < 0) { return }
    let stmt_store = program.store
    let stmt = stmt_store_get(&stmt_store, stmt_idx)
    if (stmt.tag != "block")
    {
        semantic_check_stmt(scope, program, stmt_idx, result, source, filename, func_name)
        return
    }
    if (stmt.stmt_indices.length > 0)
    {
        for (i in 0 .. stmt.stmt_indices.length)
        {
            semantic_check_stmt(scope, program, stmt.stmt_indices[i], result, source, filename, func_name)
        }
    }
    else
    {
        for (i in 0 .. stmt.block_count)
        {
            semantic_check_stmt(scope, program, stmt.block_start + i, result, source, filename, func_name)
        }
    }
}

pub fn semantic_check_function_body(func: AstFunction, program: AstProgram, result: &SemanticResult, source: string, filename: string)
{
    let scope = semantic_scope_new()
    for (i in 0 .. program.globals.length)
    {
        semantic_scope_declare_existing(&scope, program.globals[i].assign_name)
    }
    for (i in 0 .. func.param_names.length)
    {
        semantic_scope_declare_existing(&scope, func.param_names[i])
    }
    // Synthetic lambda functions get their explicitly captured names as
    // read-only locals for semantic checking. The enclosing expression has
    // already validated that each capture is defined in the outer scope.
    if (func.name.length >= 9 and compiler_string_byte(func.name, 0) == '_' and compiler_string_byte(func.name, 1) == '_' and compiler_string_byte(func.name, 2) == 'l' and compiler_string_byte(func.name, 3) == 'a' and compiler_string_byte(func.name, 4) == 'm' and compiler_string_byte(func.name, 5) == 'b' and compiler_string_byte(func.name, 6) == 'd' and compiler_string_byte(func.name, 7) == 'a' and compiler_string_byte(func.name, 8) == '_')
    {
        let expr_store = program.expr_store
        for (i in 0 .. expr_store.exprs.length)
        {
            let lambda_expr = expr_store.exprs[i]
            if (lambda_expr.tag == "lambda" and lambda_expr.text == func.name)
            {
                for (j in 0 .. lambda_expr.capture_names.length)
                {
                    semantic_scope_declare_existing(&scope, lambda_expr.capture_names[j])
                }
                break
            }
        }
    }
    semantic_check_stmt(&scope, program, func.body_idx, result, source, filename, func.name)
}

pub fn semantic_function_signature_equal(a: AstFunction, b: AstFunction): i32
{
    if (a.ret_ty != b.ret_ty) { return 0 }
    if (a.type_params.length != b.type_params.length) { return 0 }
    if (a.param_types.length != b.param_types.length) { return 0 }
    if (a.is_var_arg != b.is_var_arg) { return 0 }
    for (i in 0 .. a.param_types.length)
    {
        if (a.param_types[i] != b.param_types[i]) { return 0 }
    }
    return 1
}

pub fn semantic_check_duplicate_functions(funcs: [AstFunction], externs: [AstFunction], result: &SemanticResult, source: string, filename: string)
{
    for (i in 0 .. funcs.length)
    {
        for (j in (i + 1) .. funcs.length)
        {
            if (funcs[i].name == funcs[j].name and semantic_function_signature_equal(funcs[i], funcs[j]) == 0)
            {
                semantic_add_error_loc(result, source, filename, "NameError", "duplicate function '" + funcs[i].name + "'", "", funcs[j].line, funcs[j].col, diag_strlen(funcs[j].name))
            }
        }
    }
    for (i in 0 .. externs.length)
    {
        for (j in (i + 1) .. externs.length)
        {
            if (externs[i].name == externs[j].name and semantic_function_signature_equal(externs[i], externs[j]) == 0)
            {
                semantic_add_error_loc(result, source, filename, "NameError", "duplicate function '" + externs[i].name + "'", "", externs[j].line, externs[j].col, diag_strlen(externs[j].name))
            }
        }
    }
    for (i in 0 .. funcs.length)
    {
        for (j in 0 .. externs.length)
        {
            if (funcs[i].name == externs[j].name)
            {
                semantic_add_error_loc(result, source, filename, "NameError", "function '" + funcs[i].name + "' redeclared as extern", "", funcs[i].line, funcs[i].col, diag_strlen(funcs[i].name))
            }
        }
    }
}

pub fn semantic_check_duplicate_structs(structs: [AstStructDecl], result: &SemanticResult, source: string, filename: string)
{
    for (i in 0 .. structs.length)
    {
        for (j in (i + 1) .. structs.length)
        {
            if (structs[i].name == structs[j].name)
            {
                semantic_add_error_loc(result, source, filename, "NameError", "duplicate struct '" + structs[i].name + "'", "", structs[j].line, structs[j].col, diag_strlen(structs[j].name))
            }
        }
    }
}

pub fn semantic_check_duplicate_params(func: AstFunction, result: &SemanticResult, source: string, filename: string)
{
    for (i in 0 .. func.param_names.length)
    {
        for (j in (i + 1) .. func.param_names.length)
        {
            if (func.param_names[i] == func.param_names[j])
            {
                semantic_add_error_loc(result, source, filename, "NameError", "duplicate parameter '" + func.param_names[i] + "' in function '" + func.name + "'", "", func.line, func.col, diag_strlen(func.param_names[i]))
            }
        }
    }
}

pub fn semantic_check_duplicate_fields(decl: AstStructDecl, result: &SemanticResult, source: string, filename: string)
{
    for (i in 0 .. decl.field_names.length)
    {
        for (j in (i + 1) .. decl.field_names.length)
        {
            if (decl.field_names[i] == decl.field_names[j])
            {
                semantic_add_error_loc(result, source, filename, "NameError", "duplicate field '" + decl.field_names[i] + "' in struct '" + decl.name + "'", "", decl.line, decl.col, diag_strlen(decl.field_names[i]))
            }
        }
    }
}

pub fn semantic_cabi_type_allowed(program: AstProgram, ty: string): i32
{
    if (ty == "i8" or ty == "u8" or ty == "i16" or ty == "u16" or ty == "i32" or ty == "u32" or ty == "i64" or ty == "u64" or ty == "f32" or ty == "f64" or ty == "ptr") return 1
    if (ty == "bool") return 0
    if (ty.length > 0 and compiler_string_byte(ty, 0) == '[')
    {
        for (i in 0 .. ty.length)
        {
            if (compiler_string_byte(ty, i) == '*') return 1
        }
        return 0
    }
    for (i in 0 .. program.structs.length)
    {
        if (program.structs[i].name == ty and program.structs[i].is_c_abi == 1) return 1
    }
    return 0
}

pub fn semantic_check_cabi_structs(program: AstProgram, result: &SemanticResult, source: string, filename: string)
{
    for (i in 0 .. program.structs.length)
    {
        let decl = program.structs[i]
        if (decl.is_c_abi == 0) continue
        for (j in 0 .. decl.field_types.length)
        {
            let ty = decl.field_types[j]
            if (ty == "bool")
            {
                semantic_add_error_loc(result, source, filename, "TypeError", "bool is not supported as a C ABI struct field", "", decl.line, decl.col, decl.name.length)
            }
            elif (semantic_cabi_type_allowed(program, ty) == 0)
            {
                semantic_add_error_loc(result, source, filename, "TypeError", "illegal C ABI struct field type '" + ty + "'", "", decl.line, decl.col, decl.name.length)
            }
        }
    }
}

pub fn semantic_find_function(funcs: [AstFunction], name: string): i32
{
    for (i in 0 .. funcs.length)
    {
        if (funcs[i].name == name) { return i }
    }
    return -1
}

pub fn semantic_check_main(funcs: [AstFunction], result: &SemanticResult, filename: string)
{
    let idx = semantic_find_function(funcs, "main")
    if (idx < 0)
    {
        semantic_add_warning(result, filename, "SemanticWarning", "no 'main' function defined")
        return
    }
    if (funcs[idx].ret_ty != "i32")
    {
        semantic_add_warning(result, filename, "SemanticWarning", "entry function 'main' should return 'i32', got '" + funcs[idx].ret_ty + "'")
    }
}

pub fn semantic_check_program(program: AstProgram, source: string, filename: string): SemanticResult
{
    return semantic_check_program_with_warnings(program, source, filename, 1)
}

pub fn semantic_check_program_with_warnings(program: AstProgram, source: string, filename: string, emit_warnings: i32): SemanticResult
{
    let mut result = semantic_result_new_with_warnings(emit_warnings)
    result.source = source
    result.filename = filename
    if (program.ok == 0)
    {
        return result
    }
    semantic_check_duplicate_functions(program.functions, program.extern_functions, &result, source, filename)
    semantic_check_duplicate_structs(program.structs, &result, source, filename)
    semantic_check_cabi_structs(program, &result, source, filename)
    for (i in 0 .. program.functions.length)
    {
        semantic_check_duplicate_params(program.functions[i], &result, source, filename)
    }
    for (i in 0 .. program.structs.length)
    {
        semantic_check_duplicate_fields(program.structs[i], &result, source, filename)
    }
    for (i in 0 .. program.functions.length)
    {
        semantic_check_function_body(program.functions[i], program, &result, source, filename)
    }
    if (result.error_count == 0)
    {
        let type_result = typeck_check_program(program)
        result.type_result = type_result
        semantic_add_typeck_error(&result, source, filename, type_result)
    }
    semantic_check_main(program.functions, &result, filename)
    return result
}

pub fn semantic_result_debug(result: SemanticResult): string
{
    if (result.bag.diagnostics.length == 0)
    {
        return "SemanticOk"
    }
    let mut bag = result.bag
    return diag_render_bag_body(&bag, diag_render_options(result.source, result.filename))
}
