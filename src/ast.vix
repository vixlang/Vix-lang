pub fn ast_stmt_match_some_none(store: &StmtStore, es: &ExprStore, bind: string, option_value: string, compare_right: string, some_then_ret: i32, some_else_ret: i32, none_ret: i32): i32
{
    let expr_idx = ast_expr_some_string(es, option_value)
    return stmt_store_add(store, AstStmt{ tag: "match_option_string", value_idx: expr_idx, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: bind, match_compare_right: compare_right, match_some_then_ret: some_then_ret, match_some_else_ret: some_else_ret, match_none_ret: none_ret, match_option_value: option_value, direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: -1, block_count: 0, body_idx: -1, type_text: "", stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_match(store: &StmtStore, subject_idx: i32, arms: [AstMatchArm]): i32
{
    let mut pattern_indices: [i32] = []
    let mut body_indices: [i32] = []
    for (i in 0 .. arms.length)
    {
        pattern_indices.push(arms[i].pattern_idx)
        body_indices.push(arms[i].body_idx)
    }
    return stmt_store_add(store, AstStmt{ tag: "match", value_idx: subject_idx, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: -1, block_count: 0, body_idx: -1, type_text: "", stmt_indices: [], match_pattern_indices: pattern_indices, match_body_indices: body_indices, match_arms: arms, $ast_default_loc_fields() })
}

pub fn ast_stmt_match_indices(store: &StmtStore, subject_idx: i32, pattern_indices: [i32], body_indices: [i32]): i32
{
    return stmt_store_add(store, AstStmt{ tag: "match", value_idx: subject_idx, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: -1, block_count: 0, body_idx: -1, type_text: "", stmt_indices: [], match_pattern_indices: pattern_indices, match_body_indices: body_indices, match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_block(store: &StmtStore, start: i32, count: i32): i32
{
    return stmt_store_add(store, AstStmt{ tag: "block", value_idx: -1, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: start, block_count: count, body_idx: -1, type_text: "", stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_block_indices(store: &StmtStore, indices: [i32]): i32
{
    return stmt_store_add(store, AstStmt{ tag: "block", value_idx: -1, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: -1, block_count: 0, body_idx: -1, type_text: "", stmt_indices: indices, match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_while(store: &StmtStore, cond_idx: i32, body_idx: i32): i32
{
    return stmt_store_add(store, AstStmt{ tag: "while", value_idx: cond_idx, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: -1, block_count: 0, body_idx: body_idx, type_text: "", stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_for_range(store: &StmtStore, name: string, start_idx: i32, end_idx: i32, body_idx: i32): i32
{
    return stmt_store_add(store, AstStmt{ tag: "for_range", value_idx: start_idx, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 1, assign_name: name, assign_idx: end_idx, print_idx: -1, block_start: -1, block_count: 0, body_idx: body_idx, type_text: "", stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_loop_control(store: &StmtStore, tag: string): i32
{
    return stmt_store_add(store, AstStmt{ tag: tag, value_idx: -1, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: -1, block_count: 0, body_idx: -1, type_text: "", stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_if(store: &StmtStore, cond_idx: i32, then_idx: i32, else_idx: i32): i32
{
    return stmt_store_add(store, AstStmt{ tag: "if", value_idx: cond_idx, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: else_idx, print_idx: -1, block_start: -1, block_count: 0, body_idx: then_idx, type_text: "", stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_function(name: string, ret_ty: string, body_idx: i32): AstFunction
{
    return AstFunction{ name: name, ret_ty: ret_ty, body_idx: body_idx, param_names: [], param_types: [], is_var_arg: 0, $ast_default_loc_fields() }
}

pub fn ast_function_full(name: string, ret_ty: string, body_idx: i32, param_names: [string], param_types: [string]): AstFunction
{
    return AstFunction{ name: name, ret_ty: ret_ty, body_idx: body_idx, param_names: param_names, param_types: param_types, is_var_arg: 0, $ast_default_loc_fields() }
}

pub fn ast_function_full_vararg(name: string, ret_ty: string, body_idx: i32, param_names: [string], param_types: [string], is_var_arg: i32): AstFunction
{
    return AstFunction{ name: name, ret_ty: ret_ty, body_idx: body_idx, param_names: param_names, param_types: param_types, is_var_arg: is_var_arg, $ast_default_loc_fields() }
}

pub fn ast_function_with_loc(func: AstFunction, line: i32, col: i32): AstFunction
{
    return AstFunction{ name: func.name, ret_ty: func.ret_ty, body_idx: func.body_idx, param_names: func.param_names, param_types: func.param_types, is_var_arg: func.is_var_arg, line: line, col: col }
}

pub fn ast_program_ok(function: AstFunction, expr_store: ExprStore, store: StmtStore): AstProgram
{
    let entry = ast_function_with_loc(function, function.line, function.col)
    return AstProgram{ function: entry, functions: [function], extern_functions: [], structs: [], adts: [], expr_store: expr_store, store: store, ok: 1, error: "" }
}

pub fn ast_program_ok_functions(functions: [AstFunction], expr_store: ExprStore, store: StmtStore): AstProgram
{
    return ast_program_ok_functions_with_externs_and_structs(functions, [], [], expr_store, store)
}

pub fn ast_program_ok_functions_with_externs(functions: [AstFunction], extern_functions: [AstFunction], expr_store: ExprStore, store: StmtStore): AstProgram
{
    return ast_program_ok_functions_with_externs_and_structs(functions, extern_functions, [], expr_store, store)
}

pub fn ast_program_ok_functions_with_externs_and_structs(functions: [AstFunction], extern_functions: [AstFunction], structs: [AstStructDecl], expr_store: ExprStore, store: StmtStore): AstProgram
{
    return ast_program_ok_functions_with_externs_structs_and_adts(functions, extern_functions, structs, [], expr_store, store)
}

pub fn ast_program_ok_functions_with_externs_structs_and_adts(functions: [AstFunction], extern_functions: [AstFunction], structs: [AstStructDecl], adts: [AstAdtDecl], expr_store: ExprStore, store: StmtStore): AstProgram
{
    let mut entry = ast_function("main", "i32", -1)
    if (functions.length > 0)
    {
        entry = functions[0]
        for (i in 0 .. functions.length)
        {
            if (functions[i].name == "main")
            {
                entry = functions[i]
            }
        }
    }
    return AstProgram{ function: entry, functions: functions, extern_functions: extern_functions, structs: structs, adts: adts, expr_store: expr_store, store: store, ok: 1, error: "" }
}

pub fn ast_program_err(message: string): AstProgram
{
    return AstProgram{ function: ast_function("main", "i32", -1), functions: [], extern_functions: [], structs: [], adts: [], expr_store: expr_store_new(), store: stmt_store_new(), ok: 0, error: message }
}

pub fn ast_expr_debug(store: &ExprStore, idx: i32): string
{
    if (idx < 0) { return "nil" }
    let expr = expr_store_get(store, idx)
    return match expr.tag
    {
        "int" -> ast_i32(expr.int_value)
        "bool" -> if (expr.int_value == 1) { "true" } else { "false" }
        "float" -> ast_f64(expr.float_value)
        "string" -> "\"" + expr.text + "\""
        "ident" -> expr.text
        "binop" -> "(" + ast_expr_debug(store, expr.left_idx) + " " + expr.text + " " + ast_expr_debug(store, expr.right_idx) + ")"
        "unaryop" -> "(" + expr.text + ast_expr_debug(store, expr.left_idx) + ")"
        "call" -> expr.text + "(...)"
        "index" -> ast_expr_debug(store, expr.left_idx) + "[" + ast_expr_debug(store, expr.right_idx) + "]"
        "addr" -> "&" + expr.text
        "deref" -> "@" + ast_expr_debug(store, expr.left_idx)
        "field" -> ast_expr_debug(store, expr.left_idx) + "." + expr.text
        "struct_literal" -> expr.text + "{...}"
        "option" -> if (expr.option_has_value == 1) { "Some(" + expr.option_value + ")" } else { "None" }
        "if_expr" -> "if (...)"
        _ -> expr.tag
    }
}

pub fn ast_type_base_name(ty: string): string
{
    let mut result = ""
    for (i in 0 .. ty.length)
    {
        if (ty[i] == '[' or ty[i] == ':') { return result }
        let s: string = malloc(2)
        s[0] = ty[i]
        s[1] = 0
        result = result + s
    }
    return result
}

pub fn ast_generic_arg_count(ty: string): i32
{
    let mut in_args = 0
    let mut count = 0
    let mut has_arg = 0
    for (i in 0 .. ty.length)
    {
        if (ty[i] == '[')
        {
            in_args = 1
            has_arg = 0
        }
        elif (ty[i] == ']')
        {
            if (in_args == 1 and has_arg == 1) { count += 1 }
            in_args = 0
        }
        elif (in_args == 1 and ty[i] == ',')
        {
            count += 1
            has_arg = 0
        }
        elif (in_args == 1 and ty[i] != ' ')
        {
            has_arg = 1
        }
    }
    return count
}

pub fn ast_generic_arg_at(ty: string, target: i32): string
{
    let mut in_args = 0
    let mut idx = 0
    let mut result = ""
    for (i in 0 .. ty.length)
    {
        if (ty[i] == '[')
        {
            in_args = 1
            idx = 0
            result = ""
        }
        elif (ty[i] == ']')
        {
            if (in_args == 1 and idx == target) { return result }
            in_args = 0
        }
        elif (in_args == 1 and ty[i] == ',')
        {
            if (idx == target) { return result }
            idx += 1
            result = ""
        }
        elif (in_args == 1 and idx == target and ty[i] != ' ')
        {
            let s: string = malloc(2)
            s[0] = ty[i]
            s[1] = 0
            result = result + s
        }
    }
    return result
}

pub fn ast_adt_variant_index(adts: [AstAdtDecl], variant_name: string): i32
{
    let mut ordinal = 0
    for (i in 0 .. adts.length)
    {
        for (j in 0 .. adts[i].variant_names.length)
        {
            if (adts[i].variant_names[j] == variant_name) { return ordinal }
            ordinal += 1
        }
    }
    return -1
}

pub fn ast_adt_find_by_name(adts: [AstAdtDecl], name: string): i32
{
    let base = ast_type_base_name(name)
    for (i in 0 .. adts.length)
    {
        if (adts[i].name == base) { return i }
    }
    return -1
}

pub fn ast_adt_find_variant_decl(adts: [AstAdtDecl], variant_name: string): i32
{
    for (i in 0 .. adts.length)
    {
        for (j in 0 .. adts[i].variant_names.length)
        {
            if (adts[i].variant_names[j] == variant_name) { return i }
        }
    }
    return -1
}

pub fn ast_adt_variant_local_index(decl: AstAdtDecl, variant_name: string): i32
{
    for (i in 0 .. decl.variant_names.length)
    {
        if (decl.variant_names[i] == variant_name) { return i }
    }
    return -1
}

pub fn ast_adt_payload_type_for_subject(adts: [AstAdtDecl], subject_ty: string, variant_name: string): string
{
    let decl_idx = ast_adt_find_by_name(adts, subject_ty)
    if (decl_idx < 0) { return "unknown" }
    let decl = adts[decl_idx]
    let local_idx = ast_adt_variant_local_index(decl, variant_name)
    if (local_idx < 0) { return "unknown" }
    let payload_ty = decl.variant_payload_types[local_idx]
    if (payload_ty == "") { return "" }
    for (i in 0 .. decl.type_params.length)
    {
        if (payload_ty == decl.type_params[i])
        {
            let arg = ast_generic_arg_at(subject_ty, i)
            if (arg != "") { return arg }
        }
    }
    return payload_ty
}
pub fn ast_program_debug(program: AstProgram): string
{
    if (program.ok == 0)
    {
        return program.error
    }
    return "Program(functions=" + ast_i32(program.functions.length) + ", entry=" + program.function.name + ": " + program.function.ret_ty + ")"
}

pub fn yaml_indent(depth: i32): string
{
    let mut out = ""
    for (__d in 0 .. depth)
    {
        out = out + "  "
    }
    return out
}

pub fn expr_tag_to_type(tag: string): string
{
    return match tag {
        "int" | "bool" | "float" | "string" -> "Literal"
        "ident" -> "Identifier"
        "binop" -> "BinaryExpression"
        "unaryop" -> "UnaryExpression"
        "call" -> "CallExpression"
        "index" -> "IndexExpression"
        "addr" -> "AddressOfExpression"
        "deref" -> "DerefExpression"
        "field" -> "FieldExpression"
        "struct_literal" -> "StructLiteral"
        "option" -> "OptionExpression"
        "if_expr" -> "IfExpression"
        _ -> tag
    }
}

pub fn ast_expr_yaml(store: &ExprStore, idx: i32, depth: i32): string
{
    if (idx < 0) { return yaml_indent(depth) + "null\n" }
    let expr = expr_store_get(store, idx)
    let indent = yaml_indent(depth)
    let indent1 = yaml_indent(depth + 1)
    return match expr.tag
    {
        "int" -> indent + "type: Literal\n" + indent1 + "value: " + ast_i32(expr.int_value) + "\n"
        "bool" -> indent + "type: Literal\n" + indent1 + "value: " + (if (expr.int_value == 1) { "true" } else { "false" }) + "\n"
        "float" -> indent + "type: Literal\n" + indent1 + "value: " + ast_f64(expr.float_value) + "\n"
        "string" -> indent + "type: Literal\n" + indent1 + "value: \"" + expr.text + "\"\n"
        "ident" -> indent + "type: Identifier\n" + indent1 + "name: " + expr.text + "\n"
        "binop" ->
        {
            let mut out = indent + "type: BinaryExpression\n"
            out = out + indent1 + "operator: \"" + expr.text + "\"\n"
            out = out + indent1 + "left:\n"
            out = out + ast_expr_yaml(store, expr.left_idx, depth + 2)
            out = out + indent1 + "right:\n"
            out = out + ast_expr_yaml(store, expr.right_idx, depth + 2)
            out
        }
        "unaryop" ->
        {
            let mut out = indent + "type: UnaryExpression\n"
            out = out + indent1 + "operator: \"" + expr.text + "\"\n"
            out = out + indent1 + "operand:\n"
            out = out + ast_expr_yaml(store, expr.left_idx, depth + 2)
            out
        }
        "call" ->
        {
            let mut out = indent + "type: CallExpression\n"
            out = out + indent1 + "name: " + expr.text + "\n"
            out = out + indent1 + "arguments:\n"
            for (i in 0 .. expr.args.length)
            {
                out = out + ast_expr_yaml(store, expr.args[i], depth + 2)
            }
            out
        }
        "index" ->
        {
            let mut out = indent + "type: IndexExpression\n"
            out = out + indent1 + "base:\n"
            out = out + ast_expr_yaml(store, expr.left_idx, depth + 2)
            out = out + indent1 + "index:\n"
            out = out + ast_expr_yaml(store, expr.right_idx, depth + 2)
            out
        }
        "addr" -> indent + "type: AddressOfExpression\n" + indent1 + "name: " + expr.text + "\n"
        "deref" ->
        {
            let mut out = indent + "type: DerefExpression\n"
            out = out + indent1 + "operand:\n"
            out = out + ast_expr_yaml(store, expr.left_idx, depth + 2)
            out
        }
        "field" ->
        {
            let mut out = indent + "type: FieldExpression\n"
            out = out + indent1 + "field: " + expr.text + "\n"
            out = out + indent1 + "base:\n"
            out = out + ast_expr_yaml(store, expr.left_idx, depth + 2)
            out
        }
        "struct_literal" ->
        {
            let mut out = indent + "type: StructLiteral\n"
            out = out + indent1 + "name: " + expr.text + "\n"
            out = out + indent1 + "fields:\n"
            for (i in 0 .. expr.field_names.length)
            {
                out = out + yaml_indent(depth + 2) + "- " + expr.field_names[i] + "\n"
            }
            out = out + indent1 + "values:\n"
            for (i in 0 .. expr.args.length)
            {
                out = out + ast_expr_yaml(store, expr.args[i], depth + 2)
            }
            out
        }
        "option" -> if (expr.option_has_value == 1)
        {
            indent + "type: OptionExpression\n" + indent1 + "some: \"" + expr.option_value + "\"\n"
        } else
        {
            indent + "type: OptionExpression\n" + indent1 + "none: true\n"
        }
        "if_expr" ->
        {
            let mut out = indent + "type: IfExpression\n"
            out = out + indent1 + "condition:\n"
            out = out + ast_expr_yaml(store, expr.left_idx, depth + 2)
            out = out + indent1 + "then:\n"
            out = out + ast_expr_yaml(store, expr.right_idx, depth + 2)
            out = out + indent1 + "else:\n"
            out = out + ast_expr_yaml(store, expr.args[0], depth + 2)
            out
        }
        _ -> indent + "type: " + expr.tag + "\n"
    }
}

pub fn stmt_tag_to_type(tag: string): string
{
    return match tag
    {
        "return" | "return_expr" -> "ReturnStatement"
        "let" -> "LetStatement"
        "assign" -> "AssignStatement"
        "field_assign" -> "FieldAssignStatement"
        "store_deref" -> "DerefAssignStatement"
        "print" -> "PrintStatement"
        "expr" -> "ExpressionStatement"
        "block" -> "BlockStatement"
        "while" -> "WhileStatement"
        "for_range" -> "ForStatement"
        "break" -> "BreakStatement"
        "continue" -> "ContinueStatement"
        "if" -> "IfStatement"
        "if_eq_return" -> "IfEqReturnStatement"
        "match" -> "MatchStatement"
        "match_option_string" -> "MatchOptionStringStatement"
        _ -> tag
    }
}

pub fn ast_stmt_yaml(es: &ExprStore, store: &StmtStore, idx: i32, depth: i32): string
{
    if (idx < 0) { return yaml_indent(depth) + "null\n" }
    let stmt = stmt_store_get(store, idx)
    let indent = yaml_indent(depth)
    let indent1 = yaml_indent(depth + 1)
    return match stmt.tag {
        "return" -> indent + "type: ReturnStatement\n" + indent1 + "value: " + ast_i32(stmt.direct_ret) + "\n"
        "return_expr" -> {
            let mut out = indent + "type: ReturnStatement\n"
            out = out + indent1 + "value:\n"
            out = out + ast_expr_yaml(es, stmt.value_idx, depth + 2)
            out
        }
        "let" -> {
            let mut out = indent + "type: LetStatement\n"
            out = out + indent1 + "name: " + stmt.assign_name + "\n"
            if (stmt.is_mut == 1)
            {
                out = out + indent1 + "mutable: true\n"
            }
            if (stmt.type_text != "")
            {
                out = out + indent1 + "declared_type: " + stmt.type_text + "\n"
            }
            out = out + indent1 + "value:\n"
            out = out + ast_expr_yaml(es, stmt.assign_idx, depth + 2)
            out
        }
        "assign" -> {
            let mut out = indent + "type: AssignStatement\n"
            out = out + indent1 + "name: " + stmt.assign_name + "\n"
            out = out + indent1 + "value:\n"
            out = out + ast_expr_yaml(es, stmt.assign_idx, depth + 2)
            out
        }
        "field_assign" -> {
            let mut out = indent + "type: FieldAssignStatement\n"
            out = out + indent1 + "base:\n"
            out = out + ast_expr_yaml(es, stmt.value_idx, depth + 2)
            out = out + indent1 + "field: " + stmt.assign_name + "\n"
            out = out + indent1 + "value:\n"
            out = out + ast_expr_yaml(es, stmt.assign_idx, depth + 2)
            out
        }
        "store_deref" -> {
            let mut out = indent + "type: DerefAssignStatement\n"
            out = out + indent1 + "pointer:\n"
            out = out + ast_expr_yaml(es, stmt.value_idx, depth + 2)
            out = out + indent1 + "value:\n"
            out = out + ast_expr_yaml(es, stmt.assign_idx, depth + 2)
            out
        }
        "print" -> {
            let mut out = indent + "type: PrintStatement\n"
            out = out + indent1 + "value:\n"
            out = out + ast_expr_yaml(es, stmt.print_idx, depth + 2)
            out
        }
        "expr" -> {
            let mut out = indent + "type: ExpressionStatement\n"
            out = out + indent1 + "expression:\n"
            out = out + ast_expr_yaml(es, stmt.value_idx, depth + 2)
            out
        }
        "block" -> {
            let mut out = indent + "type: BlockStatement\n"
            out = out + indent1 + "body:\n"
            if (stmt.stmt_indices.length > 0)
            {
                for (i in 0 .. stmt.stmt_indices.length)
                {
                    out = out + ast_stmt_yaml(es, store, stmt.stmt_indices[i], depth + 2)
                }
            }
            else
            {
                for (i in 0 .. stmt.block_count)
                {
                    out = out + ast_stmt_yaml(es, store, stmt.block_start + i, depth + 2)
                }
            }
            out
        }
        "while" -> {
            let mut out = indent + "type: WhileStatement\n"
            out = out + indent1 + "condition:\n"
            out = out + ast_expr_yaml(es, stmt.value_idx, depth + 2)
            out = out + indent1 + "body:\n"
            out = out + ast_stmt_yaml(es, store, stmt.body_idx, depth + 2)
            out
        }
        "for_range" -> {
            let mut out = indent + "type: ForStatement\n"
            out = out + indent1 + "iterator: " + stmt.assign_name + "\n"
            out = out + indent1 + "start:\n"
            out = out + ast_expr_yaml(es, stmt.value_idx, depth + 2)
            out = out + indent1 + "end:\n"
            out = out + ast_expr_yaml(es, stmt.assign_idx, depth + 2)
            out = out + indent1 + "body:\n"
            out = out + ast_stmt_yaml(es, store, stmt.body_idx, depth + 2)
            out
        }
        "if" -> {
            let mut out = indent + "type: IfStatement\n"
            out = out + indent1 + "condition:\n"
            out = out + ast_expr_yaml(es, stmt.value_idx, depth + 2)
            out = out + indent1 + "then:\n"
            out = out + ast_stmt_yaml(es, store, stmt.body_idx, depth + 2)
            if (stmt.assign_idx >= 0)
            {
                out = out + indent1 + "else:\n"
                out = out + ast_stmt_yaml(es, store, stmt.assign_idx, depth + 2)
            }
            out
        }
        "if_eq_return" -> {
            let mut out = indent + "type: IfEqReturnStatement\n"
            out = out + indent1 + "condition_left: \"" + stmt.cond_left + "\"\n"
            out = out + indent1 + "condition_right: \"" + stmt.cond_right + "\"\n"
            out = out + indent1 + "then_return: " + ast_i32(stmt.then_ret) + "\n"
            out = out + indent1 + "else_return: " + ast_i32(stmt.else_ret) + "\n"
            out
        }
        "match" -> {
            let mut out = indent + "type: MatchStatement\n"
            out = out + indent1 + "subject:\n"
            out = out + ast_expr_yaml(es, stmt.value_idx, depth + 2)
            out = out + indent1 + "arms:\n"
            for (i in 0 .. stmt.match_pattern_indices.length)
            {
                out = out + yaml_indent(depth + 2) + "- pattern:\n"
                if (stmt.match_pattern_indices[i] < 0)
                {
                    out = out + yaml_indent(depth + 3) + "type: Wildcard\n"
                }
                else
                {
                    out = out + ast_expr_yaml(es, stmt.match_pattern_indices[i], depth + 3)
                }
                out = out + yaml_indent(depth + 2) + "  body:\n"
                out = out + ast_stmt_yaml(es, store, stmt.match_body_indices[i], depth + 3)
            }
            out
        }
        "match_option_string" -> {
            let mut out = indent + "type: MatchOptionStringStatement\n"
            out = out + indent1 + "bind: " + stmt.match_bind + "\n"
            out = out + indent1 + "compare_right: \"" + stmt.match_compare_right + "\"\n"
            out = out + indent1 + "some_then_return: " + ast_i32(stmt.match_some_then_ret) + "\n"
            out = out + indent1 + "some_else_return: " + ast_i32(stmt.match_some_else_ret) + "\n"
            out = out + indent1 + "none_return: " + ast_i32(stmt.match_none_ret) + "\n"
            out
        }
        _ -> indent + "type: " + stmt.tag + "\n"
    }
}

pub fn ast_function_yaml(func: AstFunction, es: &ExprStore, store: &StmtStore, depth: i32): string
{
    let indent = yaml_indent(depth)
    let indent1 = yaml_indent(depth + 1)
    let indent2 = yaml_indent(depth + 2)
    let mut out = indent + "type: Function\n"
    out = out + indent1 + "name: " + func.name + "\n"
    out = out + indent1 + "return_type: " + func.ret_ty + "\n"
    if (func.is_var_arg == 1)
    {
        out = out + indent1 + "varargs: true\n"
    }
    out = out + indent1 + "params:\n"
    for (i in 0 .. func.param_names.length)
    {
        out = out + indent2 + "- name: " + func.param_names[i] + "\n"
        out = out + indent2 + "  type: " + func.param_types[i] + "\n"
    }
    out = out + indent1 + "body:\n"
    out = out + ast_stmt_yaml(es, store, func.body_idx, depth + 2)
    return out
}

pub fn ast_struct_yaml(decl: AstStructDecl, depth: i32): string
{
    let indent = yaml_indent(depth)
    let indent1 = yaml_indent(depth + 1)
    let indent2 = yaml_indent(depth + 2)
    let mut out = indent + "type: Struct\n"
    out = out + indent1 + "name: " + decl.name + "\n"
    out = out + indent1 + "fields:\n"
    for (i in 0 .. decl.field_names.length)
    {
        out = out + indent2 + "- name: " + decl.field_names[i] + "\n"
        out = out + indent2 + "  type: " + decl.field_types[i] + "\n"
    }
    return out
}

pub fn ast_adt_yaml(decl: AstAdtDecl, depth: i32): string
{
    let indent = yaml_indent(depth)
    let indent1 = yaml_indent(depth + 1)
    let indent2 = yaml_indent(depth + 2)
    let mut out = indent + "type: Adt\n"
    out = out + indent1 + "name: " + decl.name + "\n"
    if (decl.type_params.length > 0)
    {
        out = out + indent1 + "params:\n"
        for (i in 0 .. decl.type_params.length)
        {
            out = out + indent2 + "- " + decl.type_params[i] + "\n"
        }
    }
    out = out + indent1 + "variants:\n"
    for (i in 0 .. decl.variant_names.length)
    {
        out = out + indent2 + "- name: " + decl.variant_names[i] + "\n"
        if (decl.variant_payload_types[i] != "")
        {
            out = out + indent2 + "  payload: " + decl.variant_payload_types[i] + "\n"
        }
    }
    return out
}

pub fn ast(program: AstProgram): string
{
    if (program.ok == 0)
    {
        return "type: ParseError\nmessage: \"" + program.error + "\"\n"
    }
    let mut out = "type: Program\n"
    if (program.structs.length > 0)
    {
        out = out + "structs:\n"
        for (i in 0 .. program.structs.length)
        {
            out = out + ast_struct_yaml(program.structs[i], 1)
        }
    }
    if (program.adts.length > 0)
    {
        out = out + "adts:\n"
        for (i in 0 .. program.adts.length)
        {
            out = out + ast_adt_yaml(program.adts[i], 1)
        }
    }
    if (program.extern_functions.length > 0)
    {
        out = out + "externs:\n"
        for (i in 0 .. program.extern_functions.length)
        {
            out = out + ast_function_yaml(program.extern_functions[i], program.expr_store, program.store, 1)
        }
    }
    out = out + "functions:\n"
    for (i in 0 .. program.functions.length)
    {
        out = out + ast_function_yaml(program.functions[i], program.expr_store, program.store, 1)
    }
    return out
}
