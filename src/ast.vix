}

pub fn ast_stmt_let_typed(store: &StmtStore, name: string, type_text: string, expr_idx: i32): i32
{
    return ast_stmt_let_typed_mut(store, name, type_text, expr_idx, 0)
}

pub fn ast_stmt_let_typed_mut(store: &StmtStore, name: string, type_text: string, expr_idx: i32, is_mut: i32): i32
{
    return stmt_store_add(store, AstStmt{ tag: "let", value_idx: -1, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: is_mut, assign_name: name, assign_idx: expr_idx, print_idx: -1, block_start: -1, block_count: 0, body_idx: -1, type_text: type_text, stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

