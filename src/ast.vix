{
    return expr_store_add(store, AstExpr{ tag: "if_expr", text: "", int_value: 0, float_value: 0.0, left_idx: cond_idx, right_idx: then_idx, args: [else_idx], field_names: [], option_has_value: 0, option_value: "", $ast_default_loc_fields() })
}

