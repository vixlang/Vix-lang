#[no_main]
extern "C"
{
    fn malloc(size: usize): string
    fn snprintf(buf: string, size: usize, fmt: string, ...): i32
}

pub fn ast_i32(n: i32): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%d", n)
    return buf
}

pub fn ast_f64(n: f64): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%g", n)
    return buf
}

pub type AstExpr = struct {
    tag: string,
    text: string,
    int_value: i32,
    float_value: f64,
    left_idx: i32,
    right_idx: i32,
    args: [i32],
    field_names: [string],
    option_has_value: i32,
    option_value: string,
    line: i32,
    col: i32
}

pub type ExprStore = struct {
    exprs: [AstExpr]
}

pub fn expr_store_new(): ExprStore
{
    return ExprStore{ exprs: [] }
}

pub fn expr_store_add(store: &ExprStore, expr: AstExpr): i32
{
    let idx = store.exprs.length
    store.exprs.push(expr)
    return idx
}

pub fn expr_store_get(store: &ExprStore, idx: i32): AstExpr
{
    return store.exprs[idx]
}

pub type AstMatchArm = struct {
    pattern_idx: i32,
    body_idx: i32
}

pub type AstStmt = struct {
    tag: string,
    value_idx: i32,
    cond_left: string,
    cond_right: string,
    then_ret: i32,
    else_ret: i32,
    match_bind: string,
    match_compare_right: string,
    match_some_then_ret: i32,
    match_some_else_ret: i32,
    match_none_ret: i32,
    match_option_value: string,
    direct_ret: i32,
    is_mut: i32,
    assign_name: string,
    assign_idx: i32,
    print_idx: i32,
    block_start: i32,
    block_count: i32,
    body_idx: i32,
    type_text: string,
    stmt_indices: [i32],
    match_pattern_indices: [i32],
    match_body_indices: [i32],
    match_arms: [AstMatchArm],
    line: i32,
    col: i32
}

pub type StmtStore = struct {
    stmts: [AstStmt]
}

pub fn stmt_store_new(): StmtStore
{
    return StmtStore{ stmts: [] }
}

pub fn stmt_store_add(store: &StmtStore, stmt: AstStmt): i32
{
    let idx = store.stmts.length
    store.stmts.push(stmt)
    return idx
}

pub fn stmt_store_get(store: &StmtStore, idx: i32): AstStmt
{
    return store.stmts[idx]
}

pub fn expr_store_set_loc(store: &ExprStore, idx: i32, line: i32, col: i32)
{
    store.exprs[idx].line = line
    store.exprs[idx].col = col
}

pub fn stmt_store_set_loc(store: &StmtStore, idx: i32, line: i32, col: i32)
{
    store.stmts[idx].line = line
    store.stmts[idx].col = col
}

pub fn stmt_store_len(store: &StmtStore): i32
{
    return store.stmts.length
}

pub type AstFunction = struct {
    name: string,
    ret_ty: string,
    body_idx: i32,
    param_names: [string],
    param_types: [string],
    is_var_arg: i32,
    line: i32,
    col: i32
}

pub type AstStructDecl = struct {
    name: string,
    field_names: [string],
    field_types: [string],
    line: i32,
    col: i32
}

pub type AstAdtDecl = struct {
    name: string,
    type_params: [string],
    variant_names: [string],
    variant_payload_types: [string],
    line: i32,
    col: i32
}

pub type AstProgram = struct {
    function: AstFunction,
    functions: [AstFunction],
    extern_functions: [AstFunction],
    structs: [AstStructDecl],
    adts: [AstAdtDecl],
    expr_store: ExprStore,
    store: StmtStore,
    ok: i32,
    error: string
}

macro ast_default_loc_fields() {
    line: 0, col: 0
}

pub fn ast_expr_int(store: &ExprStore, value: i32): i32
{
    return expr_store_add(store, AstExpr{ tag: "int", text: "", int_value: value, float_value: 0.0, left_idx: -1, right_idx: -1, args: [], field_names: [], option_has_value: 0, option_value: "", $ast_default_loc_fields() })
}

pub fn ast_expr_bool(store: &ExprStore, value: i32): i32
{
    return expr_store_add(store, AstExpr{ tag: "bool", text: "", int_value: value, float_value: 0.0, left_idx: -1, right_idx: -1, args: [], field_names: [], option_has_value: 0, option_value: "", $ast_default_loc_fields() })
}

