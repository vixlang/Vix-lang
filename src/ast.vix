pub fn ast_expr_match(store: &ExprStore, subject_idx: i32, patterns: [i32], bodies: [i32]): i32
{
    let mut merged: [i32] = []
    let mut idx = 0
    let mut body_idx = 0
    while (idx < patterns.length or body_idx < bodies.length)
    {
        if (idx < patterns.length)
        {
            merged.push(patterns[idx])
            idx += 1
        }
        else
        {
            merged.push(-2)
        }
        if (body_idx < bodies.length)
        {
            merged.push(bodies[body_idx])
            body_idx += 1
        }
        else
        {
            merged.push(-1)
        }
    }
    return expr_store_add(store, AstExpr{ tag: "match_expr", text: "", int_value: 0, float_value: 0.0, left_idx: subject_idx, right_idx: -1, args: merged, field_names: [], option_has_value: 0, option_value: "", $ast_default_loc_fields() })
}

