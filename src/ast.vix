}

pub fn ast_stmt_return(store: &StmtStore, expr_store: &ExprStore, value: i32): i32
{
    let expr_idx = ast_expr_int(expr_store, value)
    return stmt_store_add(store, AstStmt{ tag: "return", value_idx: expr_idx, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: value, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: -1, block_count: 0, body_idx: -1, type_text: "", stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_return_expr(store: &StmtStore, expr_idx: i32): i32
{
    return stmt_store_add(store, AstStmt{ tag: "return_expr", value_idx: expr_idx, cond_left: "", cond_right: "", then_ret: 0, else_ret: 0, match_bind: "", match_compare_right: "", match_some_then_ret: 0, match_some_else_ret: 0, match_none_ret: 0, match_option_value: "", direct_ret: 0, is_mut: 0, assign_name: "", assign_idx: -1, print_idx: -1, block_start: -1, block_count: 0, body_idx: -1, type_text: "", stmt_indices: [], match_pattern_indices: [], match_body_indices: [], match_arms: [], $ast_default_loc_fields() })
}

pub fn ast_stmt_let(store: &StmtStore, name: string, expr_idx: i32): i32
{
