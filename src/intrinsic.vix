// Intrinsic methods.
//
// Some methods are not user declarations: the array push is provided by the
// runtime and lowered by each backend. Before this registry existed the name
// "push" was compared against the method name in the semantic analysis, in the
// type inference solver and in the LLVM backend independently. The registry is
// the single definition; every phase asks it instead of matching on names.

#[no_main]

extern "C"
{
    fn compiler_string_byte(text: string, index: i32): i32
}

pub type IntrinsicKind = IntrinsicArrayPush

pub type IntrinsicSignature = struct {
    kind: IntrinsicKind,
    name: string,
    arity: i32,
    ret_ty: string
}

pub fn intrinsic_array_push(): IntrinsicSignature
{
    return IntrinsicSignature{ kind: IntrinsicArrayPush, name: "push", arity: 1, ret_ty: "void" }
}

pub fn intrinsic_signatures(): [IntrinsicSignature]
{
    let mut signatures: [IntrinsicSignature] = []
    signatures.push(intrinsic_array_push())
    return signatures
}

pub fn intrinsic_signature(index: i32): IntrinsicSignature
{
    return intrinsic_signatures()[index]
}

// True when a type text denotes a slice, i.e. "[i32]".
pub fn intrinsic_receiver_is_array(receiver_type: string): i32
{
    let mut i = 0
    let mut text = receiver_type
    if (text.length > 7 and intrinsic_text_has_prefix(text, "refptr:") == 1) { i = 7 }
    elif (text.length > 4 and intrinsic_text_has_prefix(text, "ptr:") == 1) { i = 4 }
    while (i < text.length and compiler_string_byte(text, i) == ' ') { i += 1 }
    if (i < text.length and compiler_string_byte(text, i) == '[') { return 1 }
    return 0
}

pub fn intrinsic_text_has_prefix(text: string, prefix: string): i32
{
    if (text.length < prefix.length) { return 0 }
    for (i in 0 .. prefix.length)
    {
        if (compiler_string_byte(text, i) != compiler_string_byte(prefix, i)) { return 0 }
    }
    return 1
}

// Receiver aware lookup: the index into intrinsic_signatures(), or -1.
//
// Used by the solver and the backends, which know the static receiver type.
pub fn intrinsic_lookup(receiver_type: string, name: string): i32
{
    let signatures = intrinsic_signatures()
    for (i in 0 .. signatures.length)
    {
        if (signatures[i].name != name) { continue }
        if (signatures[i].kind == IntrinsicArrayPush and intrinsic_receiver_is_array(receiver_type) == 1) { return i }
    }
    return -1
}

// Name only lookup, used by the semantic analysis, which is purely syntactic and
// has no type information to match a receiver against.
pub fn intrinsic_has_name(name: string): i32
{
    let signatures = intrinsic_signatures()
    for (i in 0 .. signatures.length)
    {
        if (signatures[i].name == name) { return 1 }
    }
    return 0
}
