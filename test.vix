extern "C"
{
	fn printf(fmt:string, ...): i32
}

fn ack(m: i32, n: i32): i32 {
    if (m == 0) {
        return n + 1
    }
    if (n == 0 ){
        return ack(m - 1, 1)
    }
    return ack(m - 1, ack(m, n - 1))
}

fn main(): i32 {	
    let result = ack(3,4) 
    printf("%d\n",result)
    return 0 
}
