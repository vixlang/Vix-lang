type Point = struct {
    x: i32,
    y: i32
}

fn (Point) copy(): Point {
    return self
}

fn (&Point) sum(): i32 {
    return self.x + self.y
}

fn (&mut Point) shift(dx: i32, dy: i32) {
    self.x = self.x + dx
    self.y = self.y + dy
}

fn main(): i32 {
    let mut p = Point{ x: 2, y: 3 }
    p.shift(4, 5)
    return p.sum()
}
