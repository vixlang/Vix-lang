macro $twice(x: expr) { ($x + $x) }
macro $nest(x: expr) { $twice($twice($x)) }
macro $make(name: ident) {
    fn $name(x: i32): i32 { return $nest(x) }
}
macro $list[items: expr*] { [$(items),*] }

$make(gen_a)
$make(gen_b)

fn main(): i32 {
    let values = $list[$twice(1), $nest(2), gen_a(3), gen_b($twice(4))]
    return values[0] + values[1] + values[2] + values[3]
}
