macro $make_affine(name: ident)
{
    fn $name(x: i32): i32
    {
        let base = x * 6
        let shifted = base + 8
        return shifted
    }
}

macro $pack[items: expr*]
{
    [$(items),*]
}

macro $twice(x: expr)
{
    ($x + $x)
}

macro $bias(x: expr)
{
    ($x + 4)
}

