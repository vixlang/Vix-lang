macro $make_affine(name: ident)
{
    fn $name(x: i32): i32
    {
        let base = x * 3
        let shifted = base + 13
        return shifted
    }
}

macro $pack[items: expr*]
{
    [$(items),*]
}

macro $twice(x: expr)
{
    ($x + $x)
}

macro $bias(x: expr)
{
    ($x + 2)
}

