type Inner = struct { left: i32, right: i32 }
type Outer = struct { inner: Inner, rows: [[i32]] }

fn mutate(x: &Outer): i32 {
    x.inner.left = x.inner.left + 10
    x.rows[1][1] = 77
    return x.inner.left + x.inner.right + x.rows[1][1]
}

fn main(): i32 {
    let mut x = Outer{
        inner: Inner{ left: 1, right: 2 },
        rows: [[3, 4], [5, 6]]
    }
    let a = mutate(&x)
    let b = mutate(&x)
    return a + b + x.inner.left
}
