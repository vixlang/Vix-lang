type Cell:[T] = struct { value: T }
type Pair:[A, B] = struct { left: A, right: B }

fn id:[T](x: T): T { return x }
fn unwrap:[T](x: Cell:[T]): T { return x.value }

fn main(): i32 {
    let c = Cell:[Pair:[Cell:[i32], bool]]{ value: Pair:[Cell:[i32], bool]{ left: Cell:[i32]{ value: 41 }, right: true } }
    let p = id[Pair:[Cell:[i32], bool]](c.value)
    let n = unwrap[Pair:[Cell:[i32], bool]](Cell:[Pair:[Cell:[i32], bool]]{ value: p })
    return n.left.value + id[i32](1)
}
