fn main(): i32 {
    let mut i = 0
    let mut sum = 0
    while (i < 5) {
        if (i == 3) {
            i = i + 1
            continue
        }
        sum = sum + i
        if (sum > 10) { break }
        i = i + 1
    }
    print(sum)
    for (j in 0 .. 3) {
        print(j)
    }
    return 0
}
