{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vix Aurora Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#10131A",
    "editor.foreground": "#D8DEE9",
    "editorLineNumber.foreground": "#4D566A",
    "editorLineNumber.activeForeground": "#AAB4C8",
    "editorCursor.foreground": "#7FDBCA",
    "editor.selectionBackground": "#33415C99",
    "editor.inactiveSelectionBackground": "#29344A88",
    "editor.lineHighlightBackground": "#171C26",
    "editorIndentGuide.background1": "#252C3A",
    "editorIndentGuide.activeBackground1": "#53617A",
    "editorBracketMatch.background": "#7FDBCA22",
    "editorBracketMatch.border": "#7FDBCAAA",
    "editorWhitespace.foreground": "#303849",
    "editor.findMatchBackground": "#E8B86D66",
    "editor.findMatchHighlightBackground": "#E8B86D33",
    "editor.wordHighlightBackground": "#63A8FF22",
    "editor.wordHighlightStrongBackground": "#B58CFF2E"
  },
  "tokenColors": [
    {
      "name": "Vix comments",
      "scope": [
        "comment.line.double-slash.vix",
        "comment.block.vix",
        "comment.block.documentation.vix"
      ],
      "settings": {
        "foreground": "#667085",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vix declaration keywords",
      "scope": [
        "storage.type.variable.vix",
        "storage.type.function.vix",
        "keyword.declaration.vix",
        "keyword.declaration.variable.vix"
      ],
      "settings": {
        "foreground": "#FF7A90",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vix control flow",
      "scope": [
        "keyword.control.vix",
        "storage.modifier.extern.vix"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Vix modifiers",
      "scope": [
        "storage.modifier.vix",
        "storage.modifier.mutable.vix"
      ],
      "settings": {
        "foreground": "#FFB86C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vix functions",
      "scope": [
        "entity.name.function.vix",
        "support.function.vix"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "Vix types",
      "scope": [
        "storage.type.vix",
        "entity.name.type.vix",
        "entity.name.type.parameter.vix"
      ],
      "settings": {
        "foreground": "#7FDBCA"
      }
    },
    {
      "name": "Vix strings",
      "scope": [
        "string.quoted.double.vix",
        "string.quoted.single.vix"
      ],
      "settings": {
        "foreground": "#A8D279"
      }
    },
    {
      "name": "Vix escapes and placeholders",
      "scope": [
        "constant.character.escape.vix",
        "constant.other.placeholder.vix"
      ],
      "settings": {
        "foreground": "#FFD580",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vix numbers and booleans",
      "scope": [
        "constant.numeric.integer.vix",
        "constant.numeric.float.vix",
        "constant.language.boolean.vix"
      ],
      "settings": {
        "foreground": "#F6A96B"
      }
    },
    {
      "name": "Vix declared variables",
      "scope": "variable.other.readwrite.declaration.vix",
      "settings": {
        "foreground": "#E6EDF7"
      }
    },
    {
      "name": "Vix parameters",
      "scope": "variable.parameter.vix",
      "settings": {
        "foreground": "#F0C987"
      }
    },
    {
      "name": "Vix variables",
      "scope": [
        "variable.other.vix",
        "variable.other.object.vix"
      ],
      "settings": {
        "foreground": "#C8D3E3"
      }
    },
    {
      "name": "Vix properties",
      "scope": "variable.other.property.vix",
      "settings": {
        "foreground": "#63A8FF"
      }
    },
    {
      "name": "Vix operators",
      "scope": [
        "keyword.operator.arithmetic.vix",
        "keyword.operator.address.vix",
        "keyword.operator.at.vix",
        "keyword.operator.multiplication.vix",
        "keyword.operator.arrow.vix"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Vix punctuation",
      "scope": [
        "punctuation.separator.vix",
        "punctuation.separator.type.vix",
        "punctuation.separator.comma.vix",
        "punctuation.accessor.dot.vix"
      ],
      "settings": {
        "foreground": "#8B98AE"
      }
    },
    {
      "name": "Vix brackets",
      "scope": [
        "meta.brace.curly.vix",
        "meta.brace.square.vix",
        "meta.brace.round.vix"
      ],
      "settings": {
        "foreground": "#AAB4C8"
      }
    },
    {
      "name": "Vix TODO markers",
      "scope": "markup.todo.vix",
      "settings": {
        "foreground": "#10131A",
        "background": "#FFD166",
        "fontStyle": "bold"
      }
    }
  ]
}
