use "adt_import_defs.vix" as defs

fn eval(e: defs::ImportedExpr): i32
{
    match e
    {
        defs::ImportedNum(n) -> { return n }
        defs::ImportedNil -> { return 0 }
    }
    return 0
}

fn main(): i32
{
    let x = defs::ImportedNum(42)
    let y = defs::ImportedNil
    print(eval(x))
    print(eval(y))
    return 0
}
