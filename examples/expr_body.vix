// Expression-bodied control flow and functions.
//
// `=>` is reserved for a single expression. Use `{ ... }` when a construct
// needs more than one statement.

fn square(value: i32): i32 => value * value

fn classify(value: i32): i32 {
    return if (value > 0) => 1 else => 0
}

fn main(): i32 {
    let mut total = 0
    let mut index = 0

    while (index < 4) => index = index + 1
    for (value in [1, 2, 3]) => total = total + square(value)

    if (classify(total) == 1) => print("positive")
    return total
}
