#[no_main]

use "ids.vix" as ids
use "position.vix" as position
use "util.vix" as util
use "stub_tree.vix" as stub_tree
use "symbol_index.vix" as symbol_index
use "diagnostics.vix" as diagnostics
use "incremental.vix" as incremental
use "ast_fragment.vix" as ast_fragment
use "sema_cache.vix" as sema_cache
use "source_text.vix" as source_text
use "../src/diag.vix" as diag
use "../src/lexer.vix" as lexer
use "../src/parser.vix" as parser
use "../src/semantic.vix" as semantic
use "../src/ast.vix" as ast
use "../src/receiver.vix" as receiver

pub type DocumentAnalysis = struct
{
    file: ids::FileId,
    tree: stub_tree::StubTree,
    fragments: [ast_fragment::AstFragment],
    symbols: symbol_index::SymbolIndex,
    diagnostics: [diagnostics::AnalyzerDiagnostic],
    sema_cache: sema_cache::SemaCache,
    ok: i32,
    reused_nodes: i32,
    fresh_nodes: i32,
    full_file: i32,
    // Semantic pass accounting: how many function bodies came from the cache.
    reused_functions: i32,
    checked_functions: i32
}

// Renders a declaration the way it was written: receiver methods show their
// receiver, and the implicit self parameter is not repeated in the argument list.
pub fn analyzer_function_signature(function: ast::AstFunction): string
{
    let mut signature = "fn "
    let is_method = receiver::receiver_is_method(function.receiver_kind)
    if (is_method == 1)
    {
        signature = signature + "(" + analyzer_receiver_text(function.receiver_kind, function.receiver_type) + ") "
    }
    signature = signature + "("
    let start = if (is_method == 1) { 1 } else { 0 }
    for (i in start .. function.param_names.length)
    {
        if (i > start) { signature = signature + ", " }
        signature = signature + function.param_names[i] + ": " + function.param_types[i]
    }
    signature = signature + "): " + function.ret_ty
    return signature
}

// The receiver as written in source: "Point", "&Point" or "&mut Point".
pub fn analyzer_receiver_text(kind: receiver::ReceiverKind, receiver_type: string): string
{
    if (receiver::receiver_is_mut_borrow(kind) == 1) { return "&mut " + receiver_type }
    if (receiver::receiver_is_borrow(kind) == 1) { return "&" + receiver_type }
    return receiver_type
}

pub fn analyzer_enrich_types(symbols: &symbol_index::SymbolIndex, program: ast::AstProgram)
{
    for (i in 0 .. program.functions.length)
    {
        let function = program.functions[i]
        let signature = analyzer_function_signature(function)
        for (d in 0 .. symbols.declarations.length)
        {
            if (symbols.declarations[d].kind == symbol_index::FunctionSymbol and symbols.declarations[d].name == function.name)
            {
                symbols.declarations[d].type_text = signature
            }
        }
    }
    for (i in 0 .. program.globals.length)
    {
        let global = program.globals[i]
        for (d in 0 .. symbols.declarations.length)
        {
            if (symbols.declarations[d].name == global.assign_name and global.type_text != "")
            {
                symbols.declarations[d].type_text = global.type_text
            }
        }
    }
}

pub fn analyzer_push_reference(symbols: &symbol_index::SymbolIndex, file: ids::FileId, symbol: ids::SymbolId, range: position::LspRange)
{
    for (i in 0 .. symbols.references.length)
    {
        let existing = symbols.references[i]
        if (existing.symbol.index == symbol.index and existing.file.value == file.value and existing.range.start.line == range.start.line and existing.range.start.character == range.start.character)
        {
            return
        }
    }
    symbols.references.push(symbol_index::Reference{ symbol: symbol, file: file, range: range })
}

pub fn analyzer_record_reference(symbols: &symbol_index::SymbolIndex, file: ids::FileId, text: string, index: position::LineIndex, name: string, line: i32, column: i32)
{
    if (name == "")
    {
        return
    }
    for (d in 0 .. symbols.declarations.length)
    {
        if (symbols.declarations[d].name == name)
        {
            let start = diag::diag_offset_at(text, line, column)
            let end = start + name.length
            analyzer_push_reference(symbols, file, symbols.declarations[d].id, position::text_range_to_lsp(index, position::text_range(start, end), text))
        }
    }
}

pub fn analyzer_record_method_reference(symbols: &symbol_index::SymbolIndex, file: ids::FileId, text: string, index: position::LineIndex, method: string, line: i32, column: i32)
{
    let symbol = symbol_index::symbol_index_find_method(@symbols, method)
    if (symbol.index < 0) { return }
    let start = diag::diag_offset_at(text, line, column)
    let end = start + method.length
    analyzer_push_reference(symbols, file, symbol, position::text_range_to_lsp(index, position::text_range(start, end), text))
}

pub fn analyzer_walk_expr(symbols: &symbol_index::SymbolIndex, program: ast::AstProgram, file: ids::FileId, text: string, index: position::LineIndex, expr_idx: i32)
{
    if (expr_idx < 0 or expr_idx >= program.expr_store.exprs.length)
    {
        return
    }
    let expr = ast::expr_store_get(program.expr_store, expr_idx)
    if (expr.tag == "ident" or expr.tag == "call")
    {
        analyzer_record_reference(symbols, file, text, index, expr.text, expr.line, expr.col)
    }
    elif (expr.tag == "method_call")
    {
        analyzer_record_method_reference(symbols, file, text, index, expr.text, expr.line, expr.col)
    }
    analyzer_walk_expr(symbols, program, file, text, index, expr.left_idx)
    analyzer_walk_expr(symbols, program, file, text, index, expr.right_idx)
    for (i in 0 .. expr.args.length)
    {
        analyzer_walk_expr(symbols, program, file, text, index, expr.args[i])
    }
}

// Mirrors the per-tag field usage of semantic_check_stmt. Walking every index
// field regardless of tag would follow statement indices as expressions, and
// vice versa.
pub fn analyzer_walk_stmt(symbols: &symbol_index::SymbolIndex, program: ast::AstProgram, file: ids::FileId, text: string, index: position::LineIndex, stmt_idx: i32)
{
    if (stmt_idx < 0 or stmt_idx >= program.store.stmts.length)
    {
        return
    }
    let stmt = ast::stmt_store_get(program.store, stmt_idx)
    let tag = stmt.tag
    if (tag == "let" or tag == "assign")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.assign_idx)
    }
    elif (tag == "store_deref")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
        analyzer_walk_expr(symbols, program, file, text, index, stmt.assign_idx)
    }
    elif (tag == "store_index")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
        analyzer_walk_expr(symbols, program, file, text, index, stmt.direct_ret)
        analyzer_walk_expr(symbols, program, file, text, index, stmt.assign_idx)
    }
    elif (tag == "field_assign")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
        analyzer_walk_expr(symbols, program, file, text, index, stmt.assign_idx)
    }
    elif (tag == "return_expr" or tag == "expr" or tag == "return")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
    }
    elif (tag == "print")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.print_idx)
    }
    elif (tag == "block")
    {
        if (stmt.stmt_indices.length > 0)
        {
            for (i in 0 .. stmt.stmt_indices.length)
            {
                analyzer_walk_stmt(symbols, program, file, text, index, stmt.stmt_indices[i])
            }
        }
        else
        {
            for (i in 0 .. stmt.block_count)
            {
                analyzer_walk_stmt(symbols, program, file, text, index, stmt.block_start + i)
            }
        }
    }
    elif (tag == "while")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
        analyzer_walk_stmt(symbols, program, file, text, index, stmt.body_idx)
    }
    elif (tag == "for_range")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
        analyzer_walk_expr(symbols, program, file, text, index, stmt.assign_idx)
        analyzer_walk_stmt(symbols, program, file, text, index, stmt.body_idx)
    }
    elif (tag == "if")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
        analyzer_walk_stmt(symbols, program, file, text, index, stmt.body_idx)
        if (stmt.assign_idx >= 0)
        {
            analyzer_walk_stmt(symbols, program, file, text, index, stmt.assign_idx)
        }
    }
    elif (tag == "match")
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
        for (i in 0 .. stmt.match_pattern_indices.length)
        {
            analyzer_walk_expr(symbols, program, file, text, index, stmt.match_pattern_indices[i])
            if (i < stmt.match_body_indices.length)
            {
                analyzer_walk_stmt(symbols, program, file, text, index, stmt.match_body_indices[i])
            }
        }
    }
    else
    {
        analyzer_walk_expr(symbols, program, file, text, index, stmt.value_idx)
    }
}

pub fn analyzer_collect_references(symbols: &symbol_index::SymbolIndex, program: ast::AstProgram, file: ids::FileId, text: string)
{
    let index = position::line_index_new(text)
    for (d in 0 .. symbols.declarations.length)
    {
        analyzer_push_reference(symbols, file, symbols.declarations[d].id, symbols.declarations[d].selection_range)
    }
    for (i in 0 .. program.functions.length)
    {
        analyzer_walk_stmt(symbols, program, file, text, index, program.functions[i].body_idx)
    }
    for (i in 0 .. program.extern_functions.length)
    {
        analyzer_walk_stmt(symbols, program, file, text, index, program.extern_functions[i].body_idx)
    }
    for (i in 0 .. program.globals.length)
    {
        analyzer_walk_expr(symbols, program, file, text, index, program.globals[i].value_idx)
        analyzer_walk_expr(symbols, program, file, text, index, program.globals[i].assign_idx)
    }
}

// Parses every top-level declaration on its own. Slice boundaries start at the
// declaration's first line so token columns line up with the file.
pub fn analyzer_build_fragments(tree: stub_tree::StubTree, text: string): [ast_fragment::AstFragment]
{
    let index = position::line_index_new(text)
    let order = stub_tree::stub_tree_sorted_declarations(tree)
    let mut fragments: [ast_fragment::AstFragment] = []
    for (o in 0 .. order.length)
    {
        let node = tree.nodes[order[o]]
        let line = position::line_index_position(index, node.range.start).line
        let start = util::analyzer_line_start(text, line)
        let mut end = node.range.end
        if (end > text.length)
        {
            end = text.length
        }
        if (end > start)
        {
            let slice = util::analyzer_copy(text, start, end)
            fragments.push(ast_fragment::ast_fragment_parse(slice, line, line, start, end))
        }
    }
    return fragments
}

// Rebuilds the fragment list for the current text. A declaration whose slice text
// is unchanged keeps its previously parsed AST, so reuse depends on content
// rather than on offset arithmetic.
pub fn analyzer_reuse_fragments(tree: stub_tree::StubTree, text: string, previous: [ast_fragment::AstFragment]): [ast_fragment::AstFragment]
{
    let index = position::line_index_new(text)
    let order = stub_tree::stub_tree_sorted_declarations(tree)
    let mut used: [i32] = []
    let mut fragments: [ast_fragment::AstFragment] = []
    for (o in 0 .. order.length)
    {
        let node = tree.nodes[order[o]]
        let line = position::line_index_position(index, node.range.start).line
        let start = util::analyzer_line_start(text, line)
        let mut end = node.range.end
        if (end > text.length)
        {
            end = text.length
        }
        if (end <= start)
        {
            continue
        }
        let slice = util::analyzer_copy(text, start, end)
        let mut picked = -1
        for (p in 0 .. previous.length)
        {
            if (picked < 0 and previous[p].ok == 1 and previous[p].text == slice)
            {
                let mut already = 0
                for (u in 0 .. used.length)
                {
                    if (used[u] == p)
                    {
                        already = 1
                    }
                }
                if (already == 0)
                {
                    picked = p
                }
            }
        }
        if (picked >= 0)
        {
            used.push(picked)
            fragments.push(ast_fragment::ast_fragment_moved(previous[picked], start, end, line))
        }
        else
        {
            fragments.push(ast_fragment::ast_fragment_parse(slice, line, line, start, end))
        }
    }
    return fragments
}

pub fn analyzer_finish(file: ids::FileId, text: string, tree: stub_tree::StubTree, fragments: [ast_fragment::AstFragment], program: ast::AstProgram, previous_cache: sema_cache::SemaCache): DocumentAnalysis
{
    let mut diagnostics: [diagnostics::AnalyzerDiagnostic] = []
    if (program.ok == 0)
    {
        diagnostics.push(diagnostics::analyzer_diagnostic("E1000", program.error, diagnostics::SeverityError, file, position::lsp_range(position::lsp_position(0, 0), position::lsp_position(0, 0))))
        return DocumentAnalysis{
            file: file,
            tree: tree,
            fragments: fragments,
            symbols: symbol_index::symbol_index_new(),
            diagnostics: diagnostics,
            sema_cache: sema_cache::sema_cache_empty(),
            ok: 0,
            reused_nodes: 0,
            fresh_nodes: tree.nodes.length,
            full_file: 1,
            reused_functions: 0,
            checked_functions: 0
        }
    }
    let outcome = sema_cache::analyzer_semantic_run(file, text, program, fragments, previous_cache)
    for (i in 0 .. outcome.diagnostics.length)
    {
        diagnostics.push(outcome.diagnostics[i])
    }
    let symbols = symbol_index::symbol_index_build(file, text, tree)
    analyzer_enrich_types(&symbols, program)
    analyzer_collect_references(&symbols, program, file, text)
    let ok = if (outcome.error_count > 0) 0 else 1
    return DocumentAnalysis{
        file: file,
        tree: tree,
        fragments: fragments,
        symbols: symbols,
        diagnostics: diagnostics,
        sema_cache: outcome.cache,
        ok: ok,
        reused_nodes: 0,
        fresh_nodes: tree.nodes.length,
        full_file: 1,
        reused_functions: outcome.reused_functions,
        checked_functions: outcome.checked_functions
    }
}

// Default: incremental stub tree, whole-file parse for the AST. Verified by the
// differential test against analyze_document_legacy.
pub fn analyze_document(file: ids::FileId, text: string): DocumentAnalysis
{
    let tree = stub_tree::stub_tree_parse(file, text)
    return analyzer_finish(file, text, tree, [], parser::parse_program_raw(text, ""), sema_cache::sema_cache_empty())
}

// Experimental: the AST is assembled from per-declaration fragments. Still fails
// the differential test, so nothing uses it unless the mode is forced.
pub fn analyze_document_fragments(file: ids::FileId, text: string): DocumentAnalysis
{
    let tree = stub_tree::stub_tree_parse(file, text)
    let fragments = analyzer_build_fragments(tree, text)
    let program = ast_fragment::ast_assemble(fragments)
    if (program.ok == 0)
    {
        return analyzer_finish(file, text, tree, [], parser::parse_program_raw(text, ""), sema_cache::sema_cache_empty())
    }
    // Safety net: if the assembled program has an out-of-range index, fall back
    // to the whole-file parse rather than running the semantic pass on it.
    if (ast_fragment::ast_program_validate(program) != "")
    {
        return analyzer_finish(file, text, tree, [], parser::parse_program_raw(text, ""), sema_cache::sema_cache_empty())
    }
    return analyzer_finish(file, text, tree, fragments, program, sema_cache::sema_cache_empty())
}

// Default: the stub tree is spliced, the AST is still parsed whole.
pub fn analyze_document_incremental(file: ids::FileId, previous: DocumentAnalysis, old_text: string, new_text: string): DocumentAnalysis
{
    let old_source = source_text::source_text_new(file, 0, old_text)
    let new_source = source_text::source_text_new(file, 0, new_text)
    let repair = incremental::incremental_reparse(previous.tree, old_source, new_source)
    let analysis = analyzer_finish(file, new_text, repair.tree, [], parser::parse_program_raw(new_text, ""), sema_cache::sema_cache_empty())
    analysis.reused_nodes = repair.reused_nodes
    analysis.fresh_nodes = repair.fresh_nodes
    analysis.full_file = repair.full_file
    return analysis
}

// Experimental: fragments are rebuilt from the current text, reusing every
// declaration whose slice text did not change.
pub fn analyze_document_incremental_fragments(file: ids::FileId, previous: DocumentAnalysis, old_text: string, new_text: string): DocumentAnalysis
{
    let old_source = source_text::source_text_new(file, 0, old_text)
    let new_source = source_text::source_text_new(file, 0, new_text)
    let repair = incremental::incremental_reparse(previous.tree, old_source, new_source)
    let fragments = analyzer_reuse_fragments(repair.tree, new_text, previous.fragments)
    let program = ast_fragment::ast_assemble(fragments)
    if (program.ok == 0)
    {
        let fallback = analyzer_finish(file, new_text, repair.tree, [], parser::parse_program_raw(new_text, ""), sema_cache::sema_cache_empty())
        fallback.reused_nodes = repair.reused_nodes
        fallback.fresh_nodes = repair.fresh_nodes
        fallback.full_file = 1
        return fallback
    }
    let analysis = analyzer_finish(file, new_text, repair.tree, fragments, program, previous.sema_cache)
    analysis.reused_nodes = repair.reused_nodes
    analysis.fresh_nodes = repair.fresh_nodes
    analysis.full_file = repair.full_file
    return analysis
}

// Ground truth for the differential test: a fresh stub tree and a fresh
// whole-file parse on every change, with no reuse at all.
pub fn analyze_document_legacy(file: ids::FileId, text: string): DocumentAnalysis
{
    let tree = stub_tree::stub_tree_parse(file, text)
    return analyzer_finish(file, text, tree, [], parser::parse_program_raw(text, ""), sema_cache::sema_cache_empty())
}