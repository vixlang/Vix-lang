#[no_main]

import "ids.vix"
import "source_text.vix"
import "stub_tree.vix"
import "incremental.vix"

pub type DocumentState = struct
{
    file: FileId,
    uri: string,
    path: string,
    source: SourceText,
    stub: StubTree,
    open: i32,
}
pub fn document_new(file: FileId, uri: string, path: string, version: i32, text: string): DocumentState
{
    let source = source_text_new(file, version, text);
    return DocumentState{ file: file, uri: uri, path: path, source: source, stub: stub_tree_parse(file, text), open: 0 }
}
pub fn document_open(document: DocumentState): DocumentState
{
    document.open = 1;
    return document
}
pub fn document_close(document: DocumentState): DocumentState
{
    document.open = 0;
    return document
}
pub fn document_replace(document: DocumentState, version: i32, text: string): DocumentState
{
    let old = document.source;
    document.source = source_text_replace(old, text, version);
    document.stub = stub_tree_parse(document.file, text);
    return document
}
pub fn document_apply_edit(document: DocumentState, version: i32, edit: TextEdit): DocumentState
{
    let old = document.source;
    document.source = source_text_apply_edit(old, edit, version);
    let result = incremental_reparse(document.stub, old, document.source);
    document.stub = result.tree;
    return document
}
pub fn document_rebuild_stub(document: DocumentState): DocumentState
{
    document.stub = stub_tree_parse(document.file, document.source.text);
    return document
}
