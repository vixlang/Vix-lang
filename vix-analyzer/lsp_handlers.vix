#[no_main]

use "ids.vix" as ids
use "position.vix" as position
use "util.vix" as util
use "../src/json.vix" as json
use "workspace.vix" as workspace
use "queries.vix" as queries
use "lsp_protocol.vix" as lsp_protocol
use "../src/fmt.vix" as fmt

pub type TextDocumentParams = struct
{
    uri: string,
    version: i32,
    text: string,
    position: position::LspPosition
}

pub fn lsp_params_document(params: string): ?TextDocumentParams
{
    let doc = json::json_parse(params)
    let root = json::json_root(doc)
    if (root < 0)
    {
        return None
    }
    let text_document = json::json_object_get(doc, root, "textDocument")
    if (text_document < 0)
    {
        return None
    }
    let mut position = position::lsp_position(0, 0)
    let position_node = json::json_object_get(doc, root, "position")
    if (position_node >= 0)
    {
        position = position::lsp_position(
            json::json_int_at(doc, json::json_object_get(doc, position_node, "line")),
            json::json_int_at(doc, json::json_object_get(doc, position_node, "character"))
        )
    }
    return Some(TextDocumentParams{
        uri: json::json_string_at(doc, json::json_object_get(doc, text_document, "uri")),
        version: json::json_int_at(doc, json::json_object_get(doc, text_document, "version")),
        text: json::json_string_at(doc, json::json_object_get(doc, text_document, "text")),
        position: position
    })
}

pub fn lsp_apply_changes(current: string, params: string): string
{
    let doc = json::json_parse(params)
    let root = json::json_root(doc)
    if (root < 0)
    {
        return current
    }
    let changes = json::json_object_get(doc, root, "contentChanges")
    let count = json::json_array_length(doc, changes)
    let mut text = current
    for (i in 0 .. count)
    {
        let change = json::json_array_item(doc, changes, i)
        let replacement = json::json_string_at(doc, json::json_object_get(doc, change, "text"))
        let range = json::json_object_get(doc, change, "range")
        if (range < 0)
        {
            text = replacement
        }
        else
        {
            let index = position::line_index_new(text)
            let start_node = json::json_object_get(doc, range, "start")
            let end_node = json::json_object_get(doc, range, "end")
            let start_position = position::lsp_position(
                json::json_int_at(doc, json::json_object_get(doc, start_node, "line")),
                json::json_int_at(doc, json::json_object_get(doc, start_node, "character"))
            )
            let end_position = position::lsp_position(
                json::json_int_at(doc, json::json_object_get(doc, end_node, "line")),
                json::json_int_at(doc, json::json_object_get(doc, end_node, "character"))
            )
            let mut start_byte = position::line_index_byte(index, start_position, text)
            let mut end_byte = position::line_index_byte(index, end_position, text)
            if (start_byte < 0)
            {
                start_byte = 0
            }
            if (end_byte < start_byte)
            {
                end_byte = start_byte
            }
            text = util::analyzer_copy(text, 0, start_byte) + replacement + util::analyzer_copy(text, end_byte, text.length)
        }
    }
    return text
}

pub fn handle_did_open(workspace: &workspace::Workspace, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            workspace::workspace_open(workspace, document.uri, document.version, document.text)
            return document.uri
        }
        None -> {}
    }
    return ""
}

pub fn handle_did_change(workspace: &workspace::Workspace, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let text = lsp_apply_changes(workspace::workspace_text(workspace, document.uri), params)
            workspace::workspace_set_text(workspace, document.uri, document.version, text)
            return document.uri
        }
        None -> {}
    }
    return ""
}

pub fn handle_did_close(workspace: &workspace::Workspace, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            workspace::workspace_close(workspace, document.uri)
            return document.uri
        }
        None -> {}
    }
    return ""
}

pub fn handle_hover(workspace: workspace::Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace::workspace_file(workspace, document.uri)
            let result = queries::query_hover(workspace, file, document.position)
            if (result.contents == "")
            {
                return lsp_protocol::lsp_response(id, "null")
            }
            return lsp_protocol::lsp_response(id, lsp_protocol::lsp_encode_hover(result))
        }
        None -> {}
    }
    return lsp_protocol::lsp_response(id, "null")
}

pub fn handle_definition(workspace: workspace::Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace::workspace_file(workspace, document.uri)
            let declaration = queries::query_definition(workspace, file, document.position)
            if (declaration.name == "")
            {
                return lsp_protocol::lsp_response(id, "null")
            }
            // A non-empty uri means the declaration lives in a used module's
            // file and the jump has to target that document.
            let target_uri = if (declaration.uri != "") declaration.uri else document.uri
            return lsp_protocol::lsp_response(id, lsp_protocol::lsp_encode_location(target_uri, declaration.selection_range))
        }
        None -> {}
    }
    return lsp_protocol::lsp_response(id, "null")
}

pub fn handle_references(workspace: workspace::Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace::workspace_file(workspace, document.uri)
            let references = queries::query_references(workspace, file, document.position)
            return lsp_protocol::lsp_response(id, lsp_protocol::lsp_encode_locations(document.uri, references))
        }
        None -> {}
    }
    return lsp_protocol::lsp_response(id, "[]")
}

pub fn handle_document_symbol(workspace: workspace::Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace::workspace_file(workspace, document.uri)
            let declarations = queries::query_document_symbols(workspace, file)
            return lsp_protocol::lsp_response(id, lsp_protocol::lsp_encode_symbols(declarations))
        }
        None -> {}
    }
    return lsp_protocol::lsp_response(id, "[]")
}

pub fn handle_completion(workspace: workspace::Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace::workspace_file(workspace, document.uri)
            let items = queries::query_completion(workspace, file, document.position)
            return lsp_protocol::lsp_response(id, lsp_protocol::lsp_encode_completion(items))
        }
        None -> {}
    }
    return lsp_protocol::lsp_response(id, "[]")
}

pub fn handle_rename(workspace: workspace::Workspace, id: i32, params: string): string
{
    let doc = json::json_parse(params)
    let root = json::json_root(doc)
    let new_name = json::json_string_at(doc, json::json_object_get(doc, root, "newName"))
    match lsp_params_document(params)
    {
        Some(document) -> {
            if (new_name == "")
            {
                return lsp_protocol::lsp_response(id, "null")
            }
            let file = workspace::workspace_file(workspace, document.uri)
            let references = queries::query_references(workspace, file, document.position)
            if (references.length == 0)
            {
                return lsp_protocol::lsp_response(id, "null")
            }
            return lsp_protocol::lsp_response(id, lsp_protocol::lsp_encode_rename(document.uri, references, new_name))
        }
        None -> {}
    }
    return lsp_protocol::lsp_response(id, "null")
}
// A "file://" URI as a filesystem path, so a vix-fmt.toml next to the document
// can be found.
pub fn lsp_uri_to_path(uri: string): string
{
    return util::analyzer_uri_to_path(uri)
}

// Indentation comes from the editor's own settings, max width from vix-fmt.toml.
// This is the same configuration the compiler CLI uses, so the editor and
// "vixc --fmt" cannot disagree.
pub fn lsp_format_config(document: TextDocumentParams, params: string): fmt::FmtConfig
{
    let mut config = fmt::fmt_config_default()
    config = fmt::fmt_config_load(config, fmt::fmt_config_path_for(lsp_uri_to_path(document.uri)))
    let doc = json::json_parse(params)
    let root = json::json_root(doc)
    if (root >= 0)
    {
        let options = json::json_object_get(doc, root, "options")
        if (options >= 0)
        {
            let tab_size = json::json_int_at(doc, json::json_object_get(doc, options, "tabSize"))
            if (tab_size > 0) { config.indent_width = tab_size }
            let insert_spaces = json::json_object_get(doc, options, "insertSpaces")
            if (insert_spaces >= 0)
            {
                if (json::json_int_at(doc, insert_spaces) == 1) { config.use_tabs = 0 } else { config.use_tabs = 1 }
            }
        }
    }
    return fmt::fmt_config_normalize(config)
}

pub fn handle_formatting(workspace: workspace::Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let text = workspace::workspace_text(workspace, document.uri)
            if (text == "")
            {
                return lsp_protocol::lsp_response(id, "[]")
            }
            let result = fmt::fmt_format(text, lsp_format_config(document, params))
            if (result.ok == 0 or result.text == text)
            {
                return lsp_protocol::lsp_response(id, "[]")
            }
            return lsp_protocol::lsp_response(id, lsp_protocol::lsp_encode_format_edits(text, result.text))
        }
        None -> {}
    }
    return lsp_protocol::lsp_response(id, "[]")
}
