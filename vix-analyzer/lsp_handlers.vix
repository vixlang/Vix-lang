#[no_main]

import "ids.vix"
import "position.vix"
import "util.vix"
import "json.vix"
import "workspace.vix"
import "queries.vix"
import "lsp_protocol.vix"
import "../src/fmt.vix"

pub type TextDocumentParams = struct
{
    uri: string,
    version: i32,
    text: string,
    position: LspPosition
}

pub fn lsp_params_document(params: string): ?TextDocumentParams
{
    let doc = json_parse(params)
    let root = json_root(doc)
    if (root < 0)
    {
        return None
    }
    let text_document = json_object_get(doc, root, "textDocument")
    if (text_document < 0)
    {
        return None
    }
    let mut position = lsp_position(0, 0)
    let position_node = json_object_get(doc, root, "position")
    if (position_node >= 0)
    {
        position = lsp_position(
            json_int_at(doc, json_object_get(doc, position_node, "line")),
            json_int_at(doc, json_object_get(doc, position_node, "character"))
        )
    }
    return Some(TextDocumentParams{
        uri: json_string_at(doc, json_object_get(doc, text_document, "uri")),
        version: json_int_at(doc, json_object_get(doc, text_document, "version")),
        text: json_string_at(doc, json_object_get(doc, text_document, "text")),
        position: position
    })
}

pub fn lsp_apply_changes(current: string, params: string): string
{
    let doc = json_parse(params)
    let root = json_root(doc)
    if (root < 0)
    {
        return current
    }
    let changes = json_object_get(doc, root, "contentChanges")
    let count = json_array_length(doc, changes)
    let mut text = current
    for (i in 0 .. count)
    {
        let change = json_array_item(doc, changes, i)
        let replacement = json_string_at(doc, json_object_get(doc, change, "text"))
        let range = json_object_get(doc, change, "range")
        if (range < 0)
        {
            text = replacement
        }
        else
        {
            let index = line_index_new(text)
            let start_node = json_object_get(doc, range, "start")
            let end_node = json_object_get(doc, range, "end")
            let start_position = lsp_position(
                json_int_at(doc, json_object_get(doc, start_node, "line")),
                json_int_at(doc, json_object_get(doc, start_node, "character"))
            )
            let end_position = lsp_position(
                json_int_at(doc, json_object_get(doc, end_node, "line")),
                json_int_at(doc, json_object_get(doc, end_node, "character"))
            )
            let mut start_byte = line_index_byte(index, start_position, text)
            let mut end_byte = line_index_byte(index, end_position, text)
            if (start_byte < 0)
            {
                start_byte = 0
            }
            if (end_byte < start_byte)
            {
                end_byte = start_byte
            }
            text = analyzer_copy(text, 0, start_byte) + replacement + analyzer_copy(text, end_byte, text.length)
        }
    }
    return text
}

pub fn handle_did_open(workspace: &Workspace, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            workspace_open(workspace, document.uri, document.version, document.text)
            return document.uri
        }
        None -> {}
    }
    return ""
}

pub fn handle_did_change(workspace: &Workspace, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let text = lsp_apply_changes(workspace_text(workspace, document.uri), params)
            workspace_set_text(workspace, document.uri, document.version, text)
            return document.uri
        }
        None -> {}
    }
    return ""
}

pub fn handle_did_close(workspace: &Workspace, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            workspace_close(workspace, document.uri)
            return document.uri
        }
        None -> {}
    }
    return ""
}

pub fn handle_hover(workspace: Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace_file(workspace, document.uri)
            let result = query_hover(workspace, file, document.position)
            if (result.contents == "")
            {
                return lsp_response(id, "null")
            }
            return lsp_response(id, lsp_encode_hover(result))
        }
        None -> {}
    }
    return lsp_response(id, "null")
}

pub fn handle_definition(workspace: Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace_file(workspace, document.uri)
            let declaration = query_definition(workspace, file, document.position)
            if (declaration.name == "")
            {
                return lsp_response(id, "null")
            }
            return lsp_response(id, lsp_encode_location(document.uri, declaration.selection_range))
        }
        None -> {}
    }
    return lsp_response(id, "null")
}

pub fn handle_references(workspace: Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace_file(workspace, document.uri)
            let references = query_references(workspace, file, document.position)
            return lsp_response(id, lsp_encode_locations(document.uri, references))
        }
        None -> {}
    }
    return lsp_response(id, "[]")
}

pub fn handle_document_symbol(workspace: Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace_file(workspace, document.uri)
            let declarations = query_document_symbols(workspace, file)
            return lsp_response(id, lsp_encode_symbols(declarations))
        }
        None -> {}
    }
    return lsp_response(id, "[]")
}

pub fn handle_completion(workspace: Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let file = workspace_file(workspace, document.uri)
            let items = query_completion(workspace, file, document.position)
            return lsp_response(id, lsp_encode_completion(items))
        }
        None -> {}
    }
    return lsp_response(id, "[]")
}

pub fn handle_rename(workspace: Workspace, id: i32, params: string): string
{
    let doc = json_parse(params)
    let root = json_root(doc)
    let new_name = json_string_at(doc, json_object_get(doc, root, "newName"))
    match lsp_params_document(params)
    {
        Some(document) -> {
            if (new_name == "")
            {
                return lsp_response(id, "null")
            }
            let file = workspace_file(workspace, document.uri)
            let references = query_references(workspace, file, document.position)
            if (references.length == 0)
            {
                return lsp_response(id, "null")
            }
            return lsp_response(id, lsp_encode_rename(document.uri, references, new_name))
        }
        None -> {}
    }
    return lsp_response(id, "null")
}
// A "file://" URI as a filesystem path, so a vix-fmt.toml next to the document
// can be found.
pub fn lsp_uri_to_path(uri: string): string
{
    if (analyzer_starts_with(uri, "file://") == 1)
    {
        return analyzer_copy(uri, 7, uri.length)
    }
    return uri
}

// Indentation comes from the editor's own settings, max width from vix-fmt.toml.
// This is the same configuration the compiler CLI uses, so the editor and
// "vixc --fmt" cannot disagree.
pub fn lsp_format_config(document: TextDocumentParams, params: string): FmtConfig
{
    let mut config = fmt_config_default()
    config = fmt_config_load(config, fmt_config_path_for(lsp_uri_to_path(document.uri)))
    let doc = json_parse(params)
    let root = json_root(doc)
    if (root >= 0)
    {
        let options = json_object_get(doc, root, "options")
        if (options >= 0)
        {
            let tab_size = json_int_at(doc, json_object_get(doc, options, "tabSize"))
            if (tab_size > 0) { config.indent_width = tab_size }
            let insert_spaces = json_object_get(doc, options, "insertSpaces")
            if (insert_spaces >= 0)
            {
                if (json_int_at(doc, insert_spaces) == 1) { config.use_tabs = 0 } else { config.use_tabs = 1 }
            }
        }
    }
    return fmt_config_normalize(config)
}

pub fn handle_formatting(workspace: Workspace, id: i32, params: string): string
{
    match lsp_params_document(params)
    {
        Some(document) -> {
            let text = workspace_text(workspace, document.uri)
            if (text == "")
            {
                return lsp_response(id, "[]")
            }
            let result = fmt_format(text, lsp_format_config(document, params))
            if (result.ok == 0 or result.text == text)
            {
                return lsp_response(id, "[]")
            }
            return lsp_response(id, lsp_encode_format_edits(text, result.text))
        }
        None -> {}
    }
    return lsp_response(id, "[]")
}
