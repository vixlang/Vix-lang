#[no_main]

include "ids.vix"
include "source_db.vix"

 pub type ModuleId = struct
{
    value: i32,
}
pub type Module = struct
{
    id: ModuleId,
    file: FileId,
    name: string,
    parent: ModuleId,
    imports: [string],
    exports: [SymbolId],
}
pub type ModuleGraph = struct
{
    modules: [Module],
    revision: Revision,
    ok: i32,
}
pub fn module_id(value: i32): ModuleId
{
    return ModuleId{value: 0}
}
pub fn module_graph_new(): ModuleGraph
{
    return ModuleGraph{modules: [], revision: Revision{value: 0}, ok: 0}
}
pub fn module_graph_build(db: SourceDatabase): ModuleGraph
{
    return ModuleGraph{modules: [], revision: Revision{value: 0}, ok: 0}
}
pub fn module_graph_find_file(graph: ModuleGraph, file: FileId): ModuleId
{
    return ModuleId{value: 0}
}
pub fn module_graph_find_name(graph: ModuleGraph, name: string): ModuleId
{
    return ModuleId{value: 0}
}
pub fn module_graph_importers(graph: ModuleGraph, module: ModuleId): [ModuleId]
{
}
pub fn module_graph_exports(graph: ModuleGraph, module: ModuleId): [SymbolId]
{
}
pub fn module_graph_is_stale(graph: ModuleGraph, revision: Revision): i32
{
    return 0
}
