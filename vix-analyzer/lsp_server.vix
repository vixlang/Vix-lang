#[no_main]

use "util.vix" as util
use "workspace.vix" as workspace
use "lsp_transport.vix" as lsp_transport
use "lsp_protocol.vix" as lsp_protocol
use "lsp_handlers.vix" as lsp_handlers
use "diagnostics.vix" as diagnostics
use "../src/json.vix" as json

// Temporary analyzer bridge: the analyzer still uses a flat legacy namespace.

pub type LspServer = struct
{
    transport: lsp_transport::TransportState,
    workspace: workspace::Workspace,
    initialized: i32
}

pub fn lsp_server_new(root_uri: string, root_path: string): LspServer
{
    return LspServer{
        transport: lsp_transport::transport_new(),
        workspace: workspace::workspace_new(root_uri, root_path),
        initialized: 0
    }
}

pub fn lsp_server_publish(server: &LspServer, uri: string)
{
    if (uri == "")
    {
        return
    }
    let analysis = workspace::workspace_analysis(server.workspace, uri)
    lsp_transport::transport_write_frame(lsp_protocol::lsp_publish_diagnostics(uri, analysis.diagnostics))
}

pub fn lsp_server_dispatch(server: &LspServer, frame: string)
{
    let message = lsp_protocol::lsp_parse_message(frame)
    if (message.method == "")
    {
        return
    }
    let mut workspace = server.workspace
    if (message.method == "initialize")
    {
        server.initialized = 1
        lsp_transport::transport_write_frame(lsp_protocol::lsp_response(message.id, lsp_protocol::lsp_initialize_result()))
    }
    elif (message.method == "initialized")
    {
        return
    }
    elif (message.method == "vix/setAnalysisMode")
    {
        let doc = json::json_parse(message.params)
        let mode = json::json_string_at(doc, json::json_object_get(doc, json::json_root(doc), "mode"))
        workspace.analysis_mode = 0
        if (mode == "stub")
        {
            workspace.analysis_mode = 1
        }
        elif (mode == "legacy")
        {
            workspace.analysis_mode = 2
        }
        server.workspace = workspace
        return
    }
    elif (message.method == "shutdown")
    {
        lsp_transport::transport_write_frame(lsp_protocol::lsp_response(message.id, "null"))
        server.transport.shutdown = 1
        server.transport.running = 0
    }
    elif (message.method == "exit")
    {
        server.transport.shutdown = 1
        server.transport.running = 0
    }
    elif (message.method == "textDocument/didOpen")
    {
        let uri = lsp_handlers::handle_did_open(&workspace, message.params)
        server.workspace = workspace
        lsp_server_publish(server, uri)
    }
    elif (message.method == "textDocument/didChange")
    {
        let uri = lsp_handlers::handle_did_change(&workspace, message.params)
        server.workspace = workspace
        if (uri != "")
        {
            lsp_transport::transport_write_frame(lsp_protocol::lsp_analysis_stats(uri, workspace::workspace_analysis(server.workspace, uri)))
        }
        lsp_server_publish(server, uri)
    }
    elif (message.method == "textDocument/didClose")
    {
        let uri = lsp_handlers::handle_did_close(&workspace, message.params)
        server.workspace = workspace
        lsp_server_publish(server, uri)
    }
    elif (message.method == "textDocument/hover")
    {
        lsp_transport::transport_write_frame(lsp_handlers::handle_hover(workspace, message.id, message.params))
    }
    elif (message.method == "textDocument/definition")
    {
        lsp_transport::transport_write_frame(lsp_handlers::handle_definition(workspace, message.id, message.params))
    }
    elif (message.method == "textDocument/references")
    {
        lsp_transport::transport_write_frame(lsp_handlers::handle_references(workspace, message.id, message.params))
    }
    elif (message.method == "textDocument/documentSymbol")
    {
        lsp_transport::transport_write_frame(lsp_handlers::handle_document_symbol(workspace, message.id, message.params))
    }
    elif (message.method == "textDocument/completion")
    {
        lsp_transport::transport_write_frame(lsp_handlers::handle_completion(workspace, message.id, message.params))
    }
    elif (message.method == "textDocument/formatting")
    {
        lsp_transport::transport_write_frame(lsp_handlers::handle_formatting(workspace, message.id, message.params))
    }
    elif (message.method == "textDocument/rename")
    {
        lsp_transport::transport_write_frame(lsp_handlers::handle_rename(workspace, message.id, message.params))
    }
    elif (message.has_id == 1)
    {
        lsp_transport::transport_write_frame(lsp_protocol::lsp_error(message.id, -32601, "method not found: " + message.method))
    }
}

pub fn lsp_server_run(server: &LspServer)
{
    server.transport.running = 1
    while (server.transport.shutdown == 0)
    {
        let frame = lsp_transport::transport_read_frame()
        if (frame == "")
        {
            break
        }
        lsp_server_dispatch(server, frame)
    }
}