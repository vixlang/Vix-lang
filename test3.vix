
let inc = fn (x: i32): i32 => x + 1

let add = fn (a: i32, b: i32): i32 => a + b

let twice = fn (x: i32): i32 =>
{
      let y = x * 2
      y
}
fn apply(f: fn(i32): i32, x: i32): i32
{
      return f(x)
}

fn main(): i32
{
    let double = fn (x: i32): i32 => x * 2
    print(apply(double, 21))
    return 0
}
