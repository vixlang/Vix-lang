extern "C"
{
	fn printf(fmt:string , ...): i32
    fn syscall(num: i64, a: i64, b: ptr, c: i64): i64
}

pub fn io_stdout(buf: string, len: i64): i64
{
        return syscall(1, 1, buf, len)
}
pub fn puts(s: string): i32
{
	let len = s.length + 1
	syscall(1, 1, s, len)
	return 0
}
pub fn readln(s:string): string
{
	let buf:[u8 * 256]
	puts(s)
	let bytes = syscall(0,0,buf,255)
	if(bytes > 0)
	{
		return buf
	}
	else 
	{
		return ""
	}
}

pub macro $println(fmt: expr, $(args: expr)*)
{
    let _ = printf($fmt, $(args),*)
	let _ = printf("\n")
}
