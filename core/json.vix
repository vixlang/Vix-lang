/*
 * Core JSON support.
 *
 * Layout:
 *   1. C runtime dependencies
 *   2. Public value/result structures
 *   3. Lexer-style character helpers
 *   4. Parsers for each JSON value kind
 *   5. Public constructors and accessors
 *   6. Formatting helpers
 *
 * Strings returned by parse_json_string_raw are allocated with malloc. The
 * caller owns those buffers and must release them with free when no longer used.
 */

/* --- Runtime dependencies ------------------------------------------------ */
extern "C"
{
    fn printf(format: ptr, ...): i32
    fn strcmp(a: ptr, b: ptr): i32
    fn strlen(s: ptr): usize
    fn malloc(size: usize): ptr
    fn free(ptr: ptr): void
}


/* --- Public data model --------------------------------------------------- */

/*
 * A tagged JSON value. The tag values are stable and intentionally explicit:
 *   0 = null, 1 = boolean, 2 = number, 3 = string, 4 = array, 5 = object.
 * Only the fields associated with the active tag should be read.
 */
pub type JsonValue = struct
{
    tag: i32,
    bool_val: i32,
    num_val: f64,
    str_val: ptr,
    arr_items: ptr,
    arr_len: i32,
    obj_keys: ptr,
    obj_vals: ptr,
    obj_len: i32
}

/*
 * Result returned by every parser. `pos` is the first unconsumed byte and
 * `ok` is 1 on success or 0 on failure.
 */
pub type ParseResult = struct
{
    value: JsonValue,
    pos: i32,
    ok: i32
}

/* --- Character and cursor helpers --------------------------------------- */

pub fn is_digit(c: i32): i32
{
    if (c >= '0' and c <= '9')
    {
        return 1
    }
    return 0
}

pub fn is_space(c: i32): i32
{
    if (c == ' ' or c == '\t' or c == '\n' or c == '\r')
    {
        return 1
    }
    return 0
}

pub fn skip_ws(json: ptr, pos: i32, len: i32): i32
{
    let mut p = pos
    while (p < len)
    {
        if (is_space(json[p]) == 0)
        {
            return p
        }
        p = p + 1
    }
    return p
}

pub fn str_eq(a: ptr, b: ptr): i32
{
    return strcmp(a, b)
}

/* --- Value parsers ------------------------------------------------------- */

pub fn parse_json_null(json: ptr, pos: i32, len: i32): ParseResult
{
    let fail = JsonValue{ tag: -1, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    if (pos + 4 > len)
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    if (json[pos] == 'n' and json[pos + 1] == 'u' and json[pos + 2] == 'l' and json[pos + 3] == 'l')
    {
        let val = JsonValue{ tag: 0, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
        return ParseResult{ value: val, pos: pos + 4, ok: 1 }
    }
    return ParseResult{ value: fail, pos: pos, ok: 0 }
}

pub fn parse_json_bool(json: ptr, pos: i32, len: i32): ParseResult
{
    let fail = JsonValue{ tag: -1, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    if (pos + 4 <= len)
    {
        if (json[pos] == 't' and json[pos + 1] == 'r' and json[pos + 2] == 'u' and json[pos + 3] == 'e')
        {
            let val = JsonValue{ tag: 1, bool_val: 1, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
            return ParseResult{ value: val, pos: pos + 4, ok: 1 }
        }
    }
    if (pos + 5 <= len)
    {
        if (json[pos] == 'f' and json[pos + 1] == 'a' and json[pos + 2] == 'l' and json[pos + 3] == 's' and json[pos + 4] == 'e')
        {
            let val = JsonValue{ tag: 1, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
            return ParseResult{ value: val, pos: pos + 5, ok: 1 }
        }
    }
    return ParseResult{ value: fail, pos: pos, ok: 0 }
}

pub fn parse_json_number(json: ptr, pos: i32, len: i32): ParseResult
{
    let fail = JsonValue{ tag: -1, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    let mut p = pos
    let mut sign = 1.0
    if (p < len and json[p] == '-')
    {
        sign = -1.0
        p = p + 1
    }
    if (p >= len or is_digit(json[p]) == 0)
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    let mut int_part = 0.0
    while (p < len and is_digit(json[p]) == 1)
    {
        int_part = int_part * 10.0 + (json[p] - '0')
        p = p + 1
    }
    let mut result = int_part
    if (p < len and json[p] == '.')
    {
        p = p + 1
        let mut frac = 0.1
        while (p < len and is_digit(json[p]) == 1)
        {
            result = result + (json[p] - '0') * frac
            frac = frac * 0.1
            p = p + 1
        }
    }
    result = result * sign
    if (p < len and (json[p] == 'e' or json[p] == 'E'))
    {
        p = p + 1
        let mut exp_sign = 1.0
        if (p < len and json[p] == '-')
        {
            exp_sign = -1.0
            p = p + 1
        }
        elif (p < len and json[p] == '+')
        {
            p = p + 1
        }
        let mut exp_val = 0.0
        while (p < len and is_digit(json[p]) == 1)
        {
            exp_val = exp_val * 10.0 + (json[p] - '0')
            p = p + 1
        }
        let mut i = 0
        while (i < exp_val)
        {
            if (exp_sign > 0.0)
            {
                result = result * 10.0
            }
            else
            {
                result = result / 10.0
            }
            i = i + 1
        }
    }
    let val = JsonValue{ tag: 2, bool_val: 0, num_val: result, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    return ParseResult{ value: val, pos: p, ok: 1 }
}

pub fn parse_json_string_raw(json: ptr, pos: i32, len: i32): ParseResult
{
    let fail = JsonValue{ tag: -1, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    if (pos >= len or json[pos] != '"')
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    let mut p = pos + 1
    let mut buf_len = 0
    let mut tmp = p
    while (tmp < len and json[tmp] != '"')
    {
        if (json[tmp] == '\\')
        {
            tmp = tmp + 1
        }
        tmp = tmp + 1
        buf_len = buf_len + 1
    }
    if (tmp >= len)
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    let buf = malloc(buf_len + 1)
    if (buf == 0)
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    let mut j = 0
    p = pos + 1
    while (p < len and json[p] != '"')
    {
        if (json[p] == '\\')
        {
            p = p + 1
            if (p >= len)
            {
                free(buf)
                return ParseResult{ value: fail, pos: pos, ok: 0 }
            }
            if (json[p] == 'n')
            {
                buf[j] = '\n'
            }
            elif (json[p] == 't')
            {
                buf[j] = '\t'
            }
            elif (json[p] == 'r')
            {
                buf[j] = '\r'
            }
            elif (json[p] == '\\')
            {
                buf[j] = '\\'
            }
            elif (json[p] == '"')
            {
                buf[j] = '"'
            }
            elif (json[p] == '/')
            {
                buf[j] = '/'
            }
            elif (json[p] == '0')
            {
                buf[j] = 0
            }
            else
            {
                buf[j] = json[p]
            }
        }
        else
        {
            buf[j] = json[p]
        }
        p = p + 1
        j = j + 1
    }
    buf[j] = 0
    p = p + 1
    let val = JsonValue{ tag: 3, bool_val: 0, num_val: 0.0, str_val: buf, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    return ParseResult{ value: val, pos: p, ok: 1 }
}

pub fn parse_json_array(json: ptr, pos: i32, len: i32): ParseResult
{
    let fail = JsonValue{ tag: -1, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    if (pos >= len or json[pos] != '[')
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    let mut p = pos + 1
    p = skip_ws(json, p, len)
    let mut items: [JsonValue] = []
    let mut first = 1
    while (p < len and json[p] != ']')
    {
        if (first == 0)
        {
            if (json[p] != ',')
            {
                return ParseResult{ value: fail, pos: p, ok: 0 }
            }
            p = p + 1
            p = skip_ws(json, p, len)
        }
        first = 0
        let r = parse_json_value(json, p, len)
        if (r.ok == 0)
        {
            return r
        }
        items.push(r.value)
        p = r.pos
        p = skip_ws(json, p, len)
    }
    if (p >= len)
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    p = p + 1
    let arr_ptr = malloc(items.length * 80)
    let mut i = 0
    while (i < items.length)
    {
        let base = arr_ptr + i * 80
        base[0] = items[i].tag
        base[4] = items[i].bool_val
        i = i + 1
    }
    let val = JsonValue{ tag: 4, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: arr_ptr, arr_len: items.length, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    return ParseResult{ value: val, pos: p, ok: 1 }
}

pub fn parse_json_object(json: ptr, pos: i32, len: i32): ParseResult
{
    let fail = JsonValue{ tag: -1, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    if (pos >= len or json[pos] != '{')
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    let mut p = pos + 1
    p = skip_ws(json, p, len)
    let mut keys: [ptr] = []
    let mut vals: [JsonValue] = []
    let mut first = 1
    while (p < len and json[p] != '}')
    {
        if (first == 0)
        {
            if (json[p] != ',')
            {
                return ParseResult{ value: fail, pos: p, ok: 0 }
            }
            p = p + 1
            p = skip_ws(json, p, len)
        }
        first = 0
        let kr = parse_json_string_raw(json, p, len)
        if (kr.ok == 0)
        {
            return kr
        }
        keys.push(kr.value.str_val)
        p = kr.pos
        p = skip_ws(json, p, len)
        if (p >= len or json[p] != ':')
        {
            return ParseResult{ value: fail, pos: p, ok: 0 }
        }
        p = p + 1
        p = skip_ws(json, p, len)
        let vr = parse_json_value(json, p, len)
        if (vr.ok == 0)
        {
            return vr
        }
        vals.push(vr.value)
        p = vr.pos
        p = skip_ws(json, p, len)
    }
    if (p >= len)
    {
        return ParseResult{ value: fail, pos: pos, ok: 0 }
    }
    p = p + 1
    let val = JsonValue{ tag: 5, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: keys.length }
    return ParseResult{ value: val, pos: p, ok: 1 }
}

pub fn parse_json_value(json: ptr, pos: i32, len: i32): ParseResult
{
    let fail = JsonValue{ tag: -1, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
    let p = skip_ws(json, pos, len)
    if (p >= len)
    {
        return ParseResult{ value: fail, pos: p, ok: 0 }
    }
    let c = json[p]
    if (c == 'n')
    {
        return parse_json_null(json, p, len)
    }
    if (c == 't' or c == 'f')
    {
        return parse_json_bool(json, p, len)
    }
    if (c == '-' or is_digit(c) == 1)
    {
        return parse_json_number(json, p, len)
    }
    if (c == '"')
    {
        return parse_json_string_raw(json, p, len)
    }
    if (c == '[')
    {
        return parse_json_array(json, p, len)
    }
    if (c == '{')
    {
        return parse_json_object(json, p, len)
    }
    return ParseResult{ value: fail, pos: p, ok: 0 }
}

/* Parse one JSON value from a null-terminated UTF-8 byte string. */
pub fn parse(json: ptr): ParseResult
{
    let len = strlen(json)
    return parse_json_value(json, 0, len)
}

/* --- Constructors and accessors ----------------------------------------- */

pub fn new_null(): JsonValue
{
    return JsonValue{ tag: 0, bool_val: 0, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
}

pub fn new_bool(val: i32): JsonValue
{
    return JsonValue{ tag: 1, bool_val: val, num_val: 0.0, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
}

pub fn new_number(val: f64): JsonValue
{
    return JsonValue{ tag: 2, bool_val: 0, num_val: val, str_val: nil, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
}

pub fn new_string_val(val: ptr): JsonValue
{
    return JsonValue{ tag: 3, bool_val: 0, num_val: 0.0, str_val: val, arr_items: nil, arr_len: 0, obj_keys: nil, obj_vals: nil, obj_len: 0 }
}

pub fn is_null(val: JsonValue): i32
{
    if (val.tag == 0)
    {
        return 1
    }
    return 0
}

pub fn is_bool(val: JsonValue): i32
{
    if (val.tag == 1)
    {
        return 1
    }
    return 0
}

pub fn is_number(val: JsonValue): i32
{
    if (val.tag == 2)
    {
        return 1
    }
    return 0
}

pub fn is_string(val: JsonValue): i32
{
    if (val.tag == 3)
    {
        return 1
    }
    return 0
}

pub fn is_array(val: JsonValue): i32
{
    if (val.tag == 4)
    {
        return 1
    }
    return 0
}

pub fn is_object(val: JsonValue): i32
{
    if (val.tag == 5)
    {
        return 1
    }
    return 0
}

pub fn get_bool(val: JsonValue): i32
{
    return val.bool_val
}

pub fn get_number(val: JsonValue): f64
{
    return val.num_val
}

pub fn get_string(val: JsonValue): ptr
{
    return val.str_val
}

/* --- Formatting helpers ------------------------------------------------- */

pub fn str_append_char(buf: ptr, pos: i32, c: i32): i32
{
    buf[pos] = c
    return pos + 1
}

pub fn str_append_str(buf: ptr, pos: i32, s: ptr): i32
{
    let mut i = 0
    let mut p = pos
    while (s[i] != 0)
    {
        buf[p] = s[i]
        i = i + 1
        p = p + 1
    }
    return p
}

pub fn num_to_str(val: f64, buf: ptr): i32
{
    if (val < 0.0)
    {
        buf[0] = '-'
        return num_to_str(-val, buf + 1) + 1
    }
    let int_part = val
    let mut pos = 0
    let mut tmp = int_part
    if (tmp < 1.0)
    {
        buf[0] = '0'
        pos = 1
    }
    else
    {
        let mut digits: [i32] = []
        while (tmp >= 1.0)
        {
            let d = tmp % 10
            digits.push(d)
            tmp = (tmp - d) / 10
        }
        let mut i = digits.length - 1
        while (i >= 0)
        {
            buf[pos] = '0' + digits[i]
            pos = pos + 1
            i = i - 1
        }
    }
    let frac = val - int_part
    if (frac > 0.0000001)
    {
        buf[pos] = '.'
        pos = pos + 1
        let mut f = frac
        let mut count = 0
        while (f > 0.0000001 and count < 6)
        {
            f = f * 10.0
            let d = f
            buf[pos] = '0' + d
            pos = pos + 1
            f = f - d
            count = count + 1
        }
    }
    buf[pos] = 0
    return pos
}
